# Self-contained reproduction for this candidate. patch.diff is a real source change to
# symphonia-core/src/io/bit.rs (BitReaderLtr::fetch_bits, BitReaderRtl::fetch_bits).

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp "{{justfile_directory()}}/bench_decode.rs" clone/symphonia/examples/bench_decode.rs
    cp "{{justfile_directory()}}/master.flac" "{{justfile_directory()}}/master.mp3" \
       "{{justfile_directory()}}/master.ogg" "{{justfile_directory()}}/master.wav" \
       "{{justfile_directory()}}/master.m4a" clone/

build-baseline:
    cd clone && cargo build --release --example bench_decode -p symphonia --features symphonia/mp3,symphonia/alac,symphonia/isomp4
    cp clone/target/release/examples/bench_decode ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone && cargo build --release --example bench_decode -p symphonia --features symphonia/mp3,symphonia/alac,symphonia/isomp4
    cp clone/target/release/examples/bench_decode ./bin_patched

bench:
    @echo "=== baseline ==="
    taskset -c 2 ./bin_baseline clone/master.flac 25
    taskset -c 2 ./bin_baseline clone/master.ogg 25
    taskset -c 2 ./bin_baseline clone/master.wav 25
    taskset -c 2 ./bin_baseline clone/master.mp3 25
    taskset -c 2 ./bin_baseline clone/master.m4a 25
    @echo "=== patched (fetch_bits #[inline]) ==="
    taskset -c 2 ./bin_patched clone/master.flac 25
    taskset -c 2 ./bin_patched clone/master.ogg 25
    taskset -c 2 ./bin_patched clone/master.wav 25
    taskset -c 2 ./bin_patched clone/master.mp3 25
    taskset -c 2 ./bin_patched clone/master.m4a 25

clean:
    rm -rf clone bin_baseline bin_patched
