# Self-contained verification harness for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate's Status is "Not reproducible", so there is no patch.diff and no `apply` /
# `reproduce-after` step - `just test` runs the harness that established the negative result.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

# Clone pristine, then run the bounds-check harness against it.
test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone harness against the pristine clone. Prints, for each crafted input,
# the peak RSS actually reached against the size of the file that produced it. `ulimit -c 0` stops
# a crashing repro from dumping a core file.
#
# REPRO_MB controls the crafted-file size per case (default 64).
reproduce-before:
    ulimit -c 0 && cd repro && cargo run --release

clean:
    rm -rf clone repro/target repro/work
