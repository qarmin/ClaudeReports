# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# This candidate's Status is "Not reproducible" - there is no patch.diff and no "after" state.
# `just test` just runs the two supplementary/real-end-to-end binaries and shows they don't panic.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Run the exhaustive/differential boundary-value probe (approach 1+2, no crate dependency), then
# the real end-to-end repro against the actual public VorbisDecoder::try_new entry point (approach
# 3) - in both debug and release builds, both with overflow-checks on. None of these should panic.
reproduce:
    cd repro && cargo run --release --bin boundary_probe
    cd repro && cargo run --bin repro
    cd repro && cargo run --release --bin repro

clean:
    rm -rf clone
