# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the panic on
# traf_overflow.m4a and traf_overflow2.m4a, and demux control_ok.m4a cleanly. The panic makes
# `cargo run` exit non-zero, which is the expected outcome here (leading `-` lets `just test`
# continue on to `apply`/`reproduce-after` instead of aborting the chain).
reproduce-before:
    -ulimit -c 0 && cd repro && cargo run -- all

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - the two overflow assets should now return a
# clean Err(...) instead of panicking (exit 0); control_ok.m4a is unaffected.
reproduce-after:
    ulimit -c 0 && cd repro && cargo run -- all

clean:
    rm -rf clone
