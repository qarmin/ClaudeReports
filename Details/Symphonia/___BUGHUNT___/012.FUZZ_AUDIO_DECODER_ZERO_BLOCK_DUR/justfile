# Self-contained reproduction for candidate 012: fuzz_audio_decoder always passes
# Packet::new(..., Duration::ZERO, ...), so any decoder that derives per-packet work from
# Packet::block_dur() (confirmed: symphonia-codec-adpcm) never runs its block-decode loop no
# matter what packet_data the fuzzer generates.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Should print "block-decode loop entered = false, output frames = 0, decode err = None" and
# exit 1 (REPRODUCED) - the real ADPCM block-decode loop never runs on the given packet_data.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now print "block-decode loop entered = true, ..." and exit 0 - the loop actually runs
# (and correctly errors on the deliberately truncated/garbage packet_data).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
