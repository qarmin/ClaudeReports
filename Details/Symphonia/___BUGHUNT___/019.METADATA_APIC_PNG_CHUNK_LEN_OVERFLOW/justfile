# Self-contained reproduction for candidate 019: symphonia-metadata APIC/PNG chunk-length
# arithmetic overflow, reached via the real standalone Id3v2Reader entry point.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Should panic with "attempt to add with overflow" (non-zero exit is the expected, demonstrated
# bug -- don't let it stop `just test` before reaching apply/reproduce-after).
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now print "parsed OK (no crash)", no panic.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
