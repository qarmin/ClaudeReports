# Self-contained reproduction for candidate 004: ID3v2 CTOC dfs unbounded recursion.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Should abort with a stack overflow (non-zero exit is the expected, demonstrated bug -- don't
# let it stop `just test` before reaching apply/reproduce-after). Disable core dumps so an
# aborted run doesn't leave a multi-hundred-MB core file behind.
reproduce-before:
    -cd repro && ulimit -c 0 && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now print "parsed OK (no crash)" or a normal parse error, no crash.
reproduce-after:
    cd repro && ulimit -c 0 && cargo run --release

clean:
    rm -rf clone repro/target repro/Cargo.lock repro/core.*
