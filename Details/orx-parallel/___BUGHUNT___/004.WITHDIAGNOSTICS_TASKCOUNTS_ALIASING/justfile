# Self-contained reproduction attempt for this candidate.
#
# Status: Not reproducible (see RESULT.md) - there is no patch.diff, so this justfile only runs
# the "before" side (against pristine `base_commit`) under Miri, exactly as this session ran it.
# Everything needed is either already in this folder or fetched by `just clone` into ./clone
# (gitignored).

repo_url := "git@github.com:orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

# Full cycle: clone pristine, run both repro shapes under Miri (both aliasing models).
test: clone reproduce-before

clone:
    rm -rf clone
    mkdir -p clone
    git clone {{repo_url}} clone/orx-parallel
    cd clone/orx-parallel && git checkout {{base_commit}}

# Runs both binaries (the real end-to-end multithreaded repro, and the isolated single-threaded
# minimal repro) under both Miri aliasing models - matches output.txt exactly. Requires a nightly
# toolchain with the `miri` component installed (`rustup +nightly component add miri`).
#
# Note: `multithread` always exits non-zero due to an unrelated Miri leak-check artifact ("main
# thread terminated without waiting for all remaining threads" - see RESULT.md) that is NOT the
# aliasing UB this candidate investigates; `|| true` keeps the recipe going so every invocation's
# real output is still printed (this is expected, not a script bug hiding a failure).
reproduce-before:
    cd repro && MIRIFLAGS="-Zmiri-disable-isolation" cargo +nightly miri run --bin multithread || true
    cd repro && MIRIFLAGS="-Zmiri-disable-isolation -Zmiri-tree-borrows" cargo +nightly miri run --bin multithread || true
    cd repro && MIRIFLAGS="-Zmiri-disable-isolation" cargo +nightly miri run --bin minimal
    cd repro && MIRIFLAGS="-Zmiri-disable-isolation -Zmiri-tree-borrows" cargo +nightly miri run --bin minimal

clean:
    rm -rf clone
