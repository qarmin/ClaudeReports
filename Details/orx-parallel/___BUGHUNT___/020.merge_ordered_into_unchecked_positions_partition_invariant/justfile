# Self-contained verification for this candidate.
#
# Status: Not reproducible - no violation of merge_ord_into_vec's implicit
# "positions exactly partitions values" invariant was found. `just test` clones
# the project fresh at base_commit, drops in the stress test that was actually
# run this session (stress_test.rs, next to this justfile - copied into the
# clone's tests/ dir, not referencing the main project), and re-runs it under a
# debug-assertions build (and, via `just miri-run`, under miri) so the claim can
# be independently re-checked without this folder's prose.

repo_url := "https://github.com/orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

test: clone stress-test debug-run

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Copies the exact stress test used this session into the freshly cloned tree.
stress-test:
    cp "{{justfile_directory()}}/stress_test.rs" clone/tests/bughunt_020_merge_stress.rs

# Re-run under a plain debug-assertions build (fast: seconds).
debug-run:
    cd clone && cargo test --test bughunt_020_merge_stress

# Re-run under miri (slow: ~2-3 minutes). Requires a nightly toolchain with miri
# installed (`rustup +nightly component add miri`).
miri-run:
    cd clone && rustup run nightly cargo miri test --test bughunt_020_merge_stress

clean:
    rm -rf clone
