     /// Returns the mutable worker-local value for `thread_idx`, creating it if needed.
+    ///
+    /// # Safety
+    ///
+    /// The caller must ensure that, for a given `thread_idx`, no other call to `init_get` with
+    /// the same `thread_idx` is in progress or has already returned a reference that is still
+    /// alive. Concretely: at most one live `&mut Self::Item` may exist for a given `thread_idx`
+    /// at any time, and this method may be called at most once per `thread_idx` while any
+    /// previously returned reference for that same `thread_idx` is still live. Violating this
+    /// produces aliased mutable references, which is undefined behavior.
     #[allow(clippy::mut_from_ref)]
-    fn init_get(&self, thread_idx: usize) -> &mut Self::Item;
+    unsafe fn init_get(&self, thread_idx: usize) -> &mut Self::Item;
 
