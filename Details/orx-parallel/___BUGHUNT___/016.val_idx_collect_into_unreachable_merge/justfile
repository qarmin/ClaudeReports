# Self-contained verification for this candidate.
#
# Status: Not reproducible - there is no bug/crash to reproduce here. This candidate confirmed
# that `ValIdx::collect_into` (src/results/val_idx.rs) is genuinely dead code (no caller anywhere
# in the crate). `just test` re-runs the actual checks that established that, against a pristine
# clone of the repo at base_commit, so the claim can be re-verified independently of this folder's
# prose.

repo_url := "https://github.com/orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

test: clone check

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Re-run the reachability checks from RESULT.md/output.txt against the pristine clone.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd clone
    echo "=== callers of ValIdx::collect_into (expect: none) ==="
    grep -rn "ValIdx::collect_into" --include=*.rs . || echo "(none found - confirms dead code)"
    echo
    echo "=== the only ValIdx consumers (expect: first/first_res/first_opt only) ==="
    grep -rn "ValIdx::first" --include=*.rs src/
    echo
    echo "=== the live merge logic used by every real collector ==="
    grep -rn "push_then_pop" --include=*.rs src/collectables/

clean:
    rm -rf clone
