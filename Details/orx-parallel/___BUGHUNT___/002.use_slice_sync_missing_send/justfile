# Self-contained reproduction for candidate 002 (UseSlice unsound blanket Sync impl).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone.
# Expected: either a printed "REPRODUCED: Rc strong_count corrupted ..." (exit 1), or the
# process crashing outright (e.g. "Illegal instruction (core dumped)") from heap corruption -
# both are the bug. Run more than once if the first run happens to land on the milder,
# non-crashing corrupted-count outcome.
reproduce-before:
    cd repro && cargo run --release

# NOTE: applying the fix changes `UseSlice`'s `Sync` impl (and `Par::use_slice`'s bound) to
# require `U: Send`. Since this repro's whole point is a witness type that is `Sync` but
# deliberately `!Send`, `cargo run` here is expected to FAIL TO COMPILE (E0277: `Rc<Cell<i64>>`
# cannot be sent between threads safely) - that compile-time rejection *is* the fix working,
# not a broken repro. It is not expected to run to completion and print anything.
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
