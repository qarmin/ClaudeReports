# Self-contained reproduction notes for this candidate.
#
# Status: Not reproducible through the crate's public API (see RESULT.md) - there is no
# patch.diff and no repro/ crate, since `kaiser`/`bessel_i0` are `pub(crate)` and no public entry
# point can reach either defect (generate_weights, the only caller, always passes a bounded
# non-negative argument). The actual reproduction of the two function-level defects was done with
# temporary #[cfg(test)] probes added directly inside src/math/kaiser.rs in the main checkout
# (reverted immediately after, see output.txt for the captured output) - that approach only
# works from inside the crate itself, so it's reproduced here as a `clone`+patch-in-a-test-module
# recipe rather than a standalone `repro/` crate.

repo_url := "https://github.com/awxkee/pic-scale-safe.git"
base_commit := "83c4801428c436678d7c6b6bea74af800924a469"

# Clone pristine and re-run the same in-crate probes used for this candidate's output.txt.
test: clone probe

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Reinserts the same temporary #[cfg(test)] probe module used to produce output.txt, builds,
# and runs each probe individually with a timeout (the hang probe is expected to time out).
# inject_probe.py lives alongside this justfile in the same candidate folder.
probe:
    cd clone && python3 "{{justfile_directory()}}/inject_probe.py"
    cd clone && cargo test --lib math::kaiser::bughunt_probe --no-run
    cd clone && (timeout 8 $(find target/debug/deps -maxdepth 1 -type f -executable -name 'pic_scale_safe-*' | head -1) --test-threads=1 --nocapture math::kaiser::bughunt_probe::probe_negative_out_of_domain; echo "exit: $?")
    cd clone && (timeout 8 $(find target/debug/deps -maxdepth 1 -type f -executable -name 'pic_scale_safe-*' | head -1) --test-threads=1 --nocapture math::kaiser::bughunt_probe::probe_bessel_i0_nan; echo "exit: $?")
    cd clone && (timeout 8 $(find target/debug/deps -maxdepth 1 -type f -executable -name 'pic_scale_safe-*' | head -1) --test-threads=1 --nocapture math::kaiser::bughunt_probe::probe_bessel_i0_large_f32_overflow; echo "exit: $? (124 == timed out == hang reproduced)")

clean:
    rm -rf clone
