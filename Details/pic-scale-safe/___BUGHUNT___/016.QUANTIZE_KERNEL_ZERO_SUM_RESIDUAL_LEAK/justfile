# Self-contained reproduction notes for this candidate.
#
# Status: Not reproducible through the crate's public API (see RESULT.md) - there is no
# patch.diff and no repro/ crate. `quantize_kernel` and `FilterWeights::numerical_approximation_i16`
# are pub(crate), so the function-level defect can only be demonstrated from inside the crate
# itself; the public-API side (does it ever produce a wrong output byte) was checked with a
# second in-crate probe and found no divergence. Reproduced here as a clone+patch-in-a-test-module
# recipe, same pattern as candidates 011/012.

repo_url := "https://github.com/awxkee/pic-scale-safe.git"
base_commit := "83c4801428c436678d7c6b6bea74af800924a469"

# Clone pristine and re-run the same in-crate probes used for this candidate's output.txt.
test: clone probe

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Reinserts the same temporary #[cfg(test)] probe module used to produce output.txt, builds,
# and runs both probes. inject_probe.py lives alongside this justfile in the same candidate folder.
probe:
    cd clone && python3 "{{justfile_directory()}}/inject_probe.py"
    cd clone && cargo test --lib filter_weights::bughunt_probe -- --nocapture --test-threads=1

clean:
    rm -rf clone
