# Self-contained reproduction for this MEASUREMENT-ONLY candidate (no patch.diff - no source
# change was made, see RESULT.md). Clones pic-scale-safe at the pinned commit, unmodified, and
# builds/benches it twice: once with default RUSTFLAGS, once with -C target-feature=+avx2.
#
# NOTE: this candidate's own RESULT.md numbers come from `image` repo's ___OPTIMIZATIONS___
# workspace (a different bench harness/scenario). This justfile's `bench` step exercises THIS
# crate's own bench suite instead, since that's the only harness available from a fresh clone of
# this repo.

repo_url := "https://github.com/awxkee/pic-scale-safe.git"
base_commit := "b50e020d72a1c0063f39c2c0166343d4e44790ca"

test: clone bench-baseline bench-avx2

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

bench-baseline:
    @echo "=== baseline (default RUSTFLAGS) ==="
    cd clone/app && cargo bench --bench resize_rgb

bench-avx2:
    @echo "=== +avx2 rebuild (no source change, only RUSTFLAGS) ==="
    cd clone/app && RUSTFLAGS="-C target-feature=+avx2" cargo bench --bench resize_rgb --target-dir target-avx2

clean:
    rm -rf clone
