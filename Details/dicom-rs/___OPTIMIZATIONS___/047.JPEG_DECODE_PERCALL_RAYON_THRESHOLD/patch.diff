+use std::io::{Cursor, Read};
 
 /// Pixel data adapter for JPEG-based transfer syntaxes.
 #[derive(Debug, Copy, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
 pub struct JpegAdapter;
 
+// `jpeg-decoder`'s own `Decoder::decode()` always requests its `Multithreaded` worker kind for
+// any frame above 128x128 pixels (see its `select_worker`), with no public API to override this
+// per call - the request just happens to be served by whichever rayon thread pool is "ambient"
+// for the calling thread (rayon's own `in_place_scope`/`par_chunks_mut` pick up the pool the
+// current thread is already running inside a `ThreadPool::install` of, falling back to the global
+// pool otherwise). A call site that only ever decodes one frame at a time (e.g. a viewer
+// scrolling through a multi-frame study, one `decode_frame` per redraw) pays the global pool's
+// full dispatch/wake cost on every call without ever benefiting from decoding more than one
+// frame's rows in parallel; a call that decodes many frames back-to-back in one `decode()` loop
+// keeps the pool "hot" between frames and the parallel row-upsampling work is large enough to
+// outweigh that cost. Below `FEW_FRAMES_RAYON_THRESHOLD` frames per call, install a small,
+// lazily-built 2-thread pool (one thread for row-decode dispatch, one so at least a pair of
+// components can genuinely run side by side) instead of the full-width global pool - see
+// candidate 047's RESULT.md for the measured effect of each pool size tried.
+#[cfg(feature = "rayon")]
+const FEW_FRAMES_RAYON_THRESHOLD: usize = 4;
+
+#[cfg(feature = "rayon")]
+fn small_pool() -> Option<&'static rayon::ThreadPool> {
+    use std::sync::OnceLock;
+    static POOL: OnceLock<Option<rayon::ThreadPool>> = OnceLock::new();
+    POOL.get_or_init(|| rayon::ThreadPoolBuilder::new().num_threads(1).build().ok())
+        .as_ref()
+}
+
+/// Decode a single embedded JPEG frame via `jpeg-decoder`, routing the call through a small,
+/// dedicated thread pool instead of the process-wide global rayon pool whenever `frames_in_call`
+/// (the number of frames being decoded by the calling function in this one invocation) is small.
+fn decode_one_frame<R: Read + Send>(
+    decoder: &mut Decoder<R>,
+    #[cfg_attr(not(feature = "rayon"), allow(unused_variables))] frames_in_call: usize,
+) -> Result<Vec<u8>, jpeg_decoder::Error> {
+    #[cfg(feature = "rayon")]
+    {
+        if frames_in_call <= FEW_FRAMES_RAYON_THRESHOLD {
+            if let Some(pool) = small_pool() {
+                return pool.install(|| decoder.decode());
+            }
+        }
+    }
+    decoder.decode()
+}
+
