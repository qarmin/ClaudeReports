+    /// Consume this value and retrieve the owned raw pixel data bytes.
+    ///
+    /// Unlike `data().to_vec()`, this never clones the pixel bytes when they are already
+    /// owned - which is always the case for a value obtained via
+    /// [`decode_pixel_data`](PixelDecoder::decode_pixel_data) or
+    /// [`decode_pixel_data_frame`](PixelDecoder::decode_pixel_data_frame), since both always
+    /// construct this value with owned data. It only copies if the underlying data was
+    /// genuinely borrowed.
+    #[inline]
+    pub fn into_data(self) -> Vec<u8> {
+        self.data.into_owned()
+    }
+
     /// Retrieve a copy of all raw pixel data samples
     /// as unsigned 16-bit integers.
     ///
