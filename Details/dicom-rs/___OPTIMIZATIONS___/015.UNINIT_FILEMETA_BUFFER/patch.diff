+/// Reads exactly `len` bytes from `source` into a freshly-allocated buffer, without
+/// zero-initializing it first - the immediately following `read_exact` fully overwrites every
+/// byte (or errors, in which case the buffer is discarded without ever being read), so a
+/// `resize(len, 0)` beforehand would only pay a real, measured memset cost for content that gets
+/// discarded a few instructions later. Sound because `u8` has no `Drop` glue and every bit
+/// pattern is a valid `u8`, so an unwritten tail is never unsound to hold, only unsound to read
+/// as meaningful data - which no caller here does.
+fn read_exact_uninit<S: Read>(source: &mut S, len: usize) -> Result<Vec<u8>> {
+    let mut v = Vec::new();
+    v.try_reserve_exact(len).context(AllocationSizeSnafu)?;
+    // SAFETY: capacity is now >= len (just reserved above); see function doc.
+    unsafe {
+        v.set_len(len);
+    }
+    source.read_exact(&mut v).context(ReadValueDataSnafu)?;
+    Ok(v)
+}
