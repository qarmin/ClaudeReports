+#[cfg(feature = "image")]
+fn convert_colorspace_u16_scalar(i: &mut [u16]) {
+    for pixel in i.chunks_exact_mut(3) {
+        let y = pixel[0] as i64;
+        let b = pixel[1] as i64 - 32768;
+        let r = pixel[2] as i64 - 32768;
