+            let cg_lanes = [_mm_extract_epi64::<0>(cg64), _mm_extract_epi64::<1>(cg64)];
+            let cb_lanes = [_mm_extract_epi64::<0>(cb64), _mm_extract_epi64::<1>(cb64)];
