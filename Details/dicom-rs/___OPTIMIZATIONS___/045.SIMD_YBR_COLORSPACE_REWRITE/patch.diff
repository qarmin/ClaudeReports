+        let cr = ((y << YBR_SHIFT) + YBR16_C_CR_R * r + YBR16_HALF) >> YBR_SHIFT;
+        let cg = ((y << YBR_SHIFT) + YBR16_C_CG_B * b + YBR16_C_CG_R * r + YBR16_HALF) >> YBR_SHIFT;
+        let cb = ((y << YBR_SHIFT) + YBR16_C_CB_B * b + YBR16_HALF) >> YBR_SHIFT;
