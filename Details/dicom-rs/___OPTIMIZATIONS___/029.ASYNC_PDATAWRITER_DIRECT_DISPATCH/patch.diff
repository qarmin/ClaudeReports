+    fn poll_write_direct<W: AsyncWrite + Unpin>(
+        mut this: Pin<&mut AsyncPDataWriter<W>>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+        mut header_pos: usize,
+        mut payload_pos: usize,
+        payload_len: usize,
+    ) -> Poll<std::result::Result<usize, std::io::Error>> {
+        if header_pos < PDU_PDV_HEADER_SIZE {
+            loop {
+                let w: &mut AsyncPDataWriter<W> = this.as_mut().get_mut();
+                match Pin::new(&mut w.stream).poll_write(cx, &w.buffer[header_pos..PDU_PDV_HEADER_SIZE]) {
+                    Poll::Ready(Ok(0)) => {
+                        return Poll::Ready(Err(std::io::Error::new(
+                            std::io::ErrorKind::WriteZero,
+                            "failed to write whole buffer",
+                        )));
+                    }
+                    Poll::Ready(Ok(n)) => {
+                        header_pos += n;
+                        if header_pos == PDU_PDV_HEADER_SIZE {
+                            break;
+                        }
+                    }
+                    Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+                    Poll::Pending => {
+                        w.state = WriteState::WritingDirect {
+                            header_pos,
+                            payload_pos: 0,
+                            payload_len,
