# Self-contained reproduction for candidate 029.ASYNC_PDATAWRITER_DIRECT_DISPATCH.
#
# Uses dicom-rs's own bench_pipeline harness (untracked in the main repo - see SKILL.md's
# "shape 3" pattern). Self-contained given the WHOLE ___OPTIMIZATIONS___ folder kept together.
# The harness's own `async-pdatawriter-inprocess` mode (added this candidate) is part of the
# harness copy below.
#
# `async-pdatawriter-inprocess` needs a small BENCHMARK-ONLY shim
# (AsyncPDataWriter::new_for_bench + ul/Cargo.toml's `bench-internals` feature) that is NOT part
# of patch.diff - see RESULT.md's "Bench" section for why (same pattern as candidate 020's own
# `PDataWriter::new_for_bench`). `bench-shim.diff` in this folder carries that shim; it's applied
# as its own step, separate from patch.diff, for both the baseline and patched builds (both need
# it to run async-pdatawriter-inprocess at all).

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline

# baseline = unpatched fix, but WITH the benchmark-only shim, so async-pdatawriter-inprocess can
# run against it too (see RESULT.md - the shim is orthogonal to the real fix, needed on both sides)
build-baseline:
    cd clone && git apply "{{justfile_directory()}}/bench-shim.diff"
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release --features async-pdatawriter-inprocess,dicom-ul/async,dicom-ul/bench-internals
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline
    cd clone && git checkout -- ul/src/association/pdata.rs ul/Cargo.toml

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && git apply "{{justfile_directory()}}/bench-shim.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release --features async-pdatawriter-inprocess,dicom-ul/async,dicom-ul/bench-internals
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

bench:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== 100MB, in-memory sink - expect NO consistent change (too small to clear noise floor) ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched \
        -- async-pdatawriter-inprocess 100 10
    echo ""
    echo "=== 300MB, in-memory sink - expect a small, consistent ~2-3% win ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched \
        -- async-pdatawriter-inprocess 300 5

clean:
    rm -rf clone bin_baseline bin_patched
