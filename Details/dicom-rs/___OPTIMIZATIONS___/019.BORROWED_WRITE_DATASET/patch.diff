+/// Write this object's data set directly to a [`DataSetWriter`],
+/// without cloning primitive values, pixel data fragments, or the offset table first.
+///
+/// This produces the same token stream that `IntoTokens for &InMemDicomObject` above would
+/// (including the same [`IntoTokensOptions::force_invalidate_sq_length`] propagation rules,
+/// and the same pre-existing quirk that encapsulated pixel data fragments and the offset
+/// table never have their own item length invalidated regardless of `options` - confirmed by
+/// reading `ItemValueTokens`/`OffsetTableItemTokens` in `dicom_parser`, not assumed), but
+/// reaches straight into the writer's borrowed methods
+/// ([`DataSetWriter::write_primitive_value_borrowed`],
+/// [`DataSetWriter::write_item_value_borrowed`],
+/// [`DataSetWriter::write_offset_table_borrowed`]) for the three payload-carrying token kinds,
+/// instead of producing an owned [`DataToken`] (and thus cloning the value) for each one first.
+///
+/// This is the borrowing counterpart discussed in
+/// <https://github.com/Enet4/dicom-rs/issues/641>: since the object is only ever borrowed
+/// here, writing a large object (e.g. one with 1 GB of native pixel data) no longer needs a
+/// second, transient clone of that data to reach the writer.
+pub(crate) fn write_dataset_borrowed<W, E, D>(
+    writer: &mut DataSetWriter<W, E>,
+    obj: &InMemDicomObject<D>,
+    options: IntoTokensOptions,
+) -> WriteResult<()>
+where
+    W: Write,
+    E: EncodeTo<W>,
+{
+    let mut options = options;
+    options.force_invalidate_sq_length |= obj.charset_changed;
+    for elem in obj {
+        write_element_borrowed(writer, elem, options)?;
+    }
+    Ok(())
+}
+
+fn write_element_borrowed<W, E, D>(
+    writer: &mut DataSetWriter<W, E>,
+    elem: &InMemElement<D>,
+    options: IntoTokensOptions,
+) -> WriteResult<()>
+where
+    W: Write,
+    E: EncodeTo<W>,
+{
+    match elem.value() {
+        Value::Primitive(v) => {
+            writer.write(DataToken::ElementHeader(*elem.header()))?;
+            writer.write_primitive_value_borrowed(v)?;
+        }
+        Value::Sequence(seq) => {
+            let tag = elem.header().tag;
+            let mut len = elem.header().len;
+            if options.force_invalidate_sq_length {
+                len = Length::UNDEFINED;
+            }
+            writer.write(DataToken::SequenceStart { tag, len })?;
+            for item in seq.items() {
+                let mut item_len = item.length();
+                if item_len.0 != 0 && options.force_invalidate_sq_length {
+                    item_len = Length::UNDEFINED;
+                }
+                writer.write(DataToken::ItemStart { len: item_len })?;
+                write_dataset_borrowed(writer, item, options)?;
+                writer.write(DataToken::ItemEnd)?;
+            }
+            writer.write(DataToken::SequenceEnd)?;
+        }
+        Value::PixelSequence(seq) => {
+            writer.write(DataToken::PixelSequenceStart)?;
+
+            // offset table: always its own item, length never invalidated
+            // (matches OffsetTableItemTokens, which ignores `options` entirely)
+            let offset_table = seq.offset_table();
+            writer.write(DataToken::ItemStart {
+                len: Length(offset_table.len() as u32 * 4),
+            })?;
+            if !offset_table.is_empty() {
+                writer.write_offset_table_borrowed(offset_table)?;
+            }
+            writer.write(DataToken::ItemEnd)?;
+
+            // fragments: also never invalidated regardless of `options` (same reasoning as
+            // the offset table above)
+            for fragment in seq.fragments() {
+                let bytes: &[u8] = fragment.as_slice();
+                writer.write(DataToken::ItemStart {
+                    len: Length(bytes.len() as u32),
+                })?;
+                if !bytes.is_empty() {
+                    writer.write_item_value_borrowed(bytes)?;
+                }
+                writer.write(DataToken::ItemEnd)?;
+            }
+
+            writer.write(DataToken::SequenceEnd)?;
+        }
+    }
+    Ok(())
+}
