# Self-contained reproduction for candidate 043.READ_VALUE_DATETIME_NUMERIC_SINGLE_VALUE_FASTPATH.
#
# patch.diff is a real, new fix to parser/src/stateful/decode.rs, extending candidate 042's
# single-value fast path to read_value_da/ds/dt/is/tm. Uses dicom-rs's own bench_pipeline harness
# (untracked in the main repo - see SKILL.md's "shape 3" pattern), self-contained given the WHOLE
# ___OPTIMIZATIONS___ folder kept together.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched genfixtures bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline
    rm -rf clone/___OPTIMIZATIONS___/harness/bench_pipeline/target

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

genfixtures:
    ./bin_baseline gen-datetime-vrs testdata_datetime10k.dcm 10000

bench:
    @echo "=== parse, 50,000 DA/DS/DT/IS/TM single-value elements ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- parse testdata_datetime10k.dcm 30

clean:
    rm -rf clone bin_baseline bin_patched testdata_datetime10k.dcm
