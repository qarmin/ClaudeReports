+/// Allocates a `SmallVec` of the given length without zero-initializing it, for a caller that is
+/// about to fully overwrite every element (via `read_exact` or a `decode_*_into` call that writes
+/// every `dst` element in order) - `smallvec![0; n]` / `vec![0; n]` pay a real, measured memset
+/// cost for content that gets fully discarded a few instructions later. Sound for any `T: Copy`
+/// with no `Drop` glue (all of `u8`/`u16`/`u32`/`u64`/`i16`/`i32`/`i64`/`f32`/`f64` here): if the
+/// subsequent write is interrupted by an error, the partially-written `SmallVec` is dropped
+/// without any of its elements ever being read by safe code, and every bit pattern is already a
+/// valid value for these types, so no uninitialized-memory read ever occurs.
+#[inline]
+fn uninit_smallvec<T: Copy, A: Array<Item = T>>(len: usize) -> SmallVec<A> {
+    let mut v: SmallVec<A> = SmallVec::with_capacity(len);
+    // SAFETY: see function doc - T has no Drop glue and every bit pattern is a valid T.
+    unsafe {
+        v.set_len(len);
+    }
+    v
+}
