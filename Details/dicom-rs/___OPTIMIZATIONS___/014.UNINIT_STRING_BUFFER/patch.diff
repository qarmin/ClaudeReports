+    /// Resizes `self.buffer` to exactly `len` bytes without zero-initializing any newly-added
+    /// capacity, for a caller about to immediately fully overwrite it via `read_exact` -
+    /// `Vec::resize_with(len, Default::default)` pays a real, measured memset cost for content
+    /// that gets fully discarded a few instructions later (the same anti-pattern as
+    /// `read_value_ob`'s `smallvec![0u8; len]`, but here `self.buffer` is a persistent scratch
+    /// buffer reused across many calls, so this also benefits from not re-zeroing capacity that
+    /// was already reserved by a previous, larger call).
+    #[inline]
+    fn resize_buffer_uninit(&mut self, len: usize) {
+        self.buffer.clear();
+        self.buffer.reserve(len);
+        // SAFETY: capacity is now >= len (just reserved above); every byte in [0, len) is either
+        // fully written by the caller's subsequent `read_exact` before being read, or never read
+        // at all if `read_exact` errors and the error is propagated (u8 has no Drop glue and
+        // every bit pattern is valid, so an unwritten tail is never unsound to hold, only unsound
+        // to treat as meaningful data - which no caller of this method does).
+        unsafe {
+            self.buffer.set_len(len);
+        }
+    }
