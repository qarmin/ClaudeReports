diff --git a/pixeldata/src/attribute.rs b/pixeldata/src/attribute.rs
index dc3aed5d..22d21b06 100644
--- a/pixeldata/src/attribute.rs
+++ b/pixeldata/src/attribute.rs
@@ -156,7 +156,19 @@ pub fn bits_allocated<D: DataDictionary + Clone>(
 pub fn bits_stored<D: DataDictionary + Clone>(
     obj: &FileDicomObject<InMemDicomObject<D>>,
 ) -> Result<u16> {
-    retrieve_required_u16(obj, tags::BITS_STORED, AttributeName::BitsStored)
+    let value = retrieve_required_u16(obj, tags::BITS_STORED, AttributeName::BitsStored)?;
+    // `Lut::new_with_fn` builds a table of `2^bits_stored` entries and asserts this bound
+    // itself - reject an out-of-range value here instead of letting it reach that assertion,
+    // which would otherwise panic deep inside LUT construction on any attempt to render pixel
+    // data from a file with a malformed (attacker-controlled) BitsStored of 0.
+    ensure!(
+        (1..=32).contains(&value),
+        InvalidValueSnafu {
+            name: AttributeName::BitsStored,
+            value: value.to_string(),
+        }
+    );
+    Ok(value)
 }
 
