# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (a "DS"-declared element deserializes InlineBinary raw bytes into a mismatched
# PrimitiveValue::U8, and round-trips through a real file write/read with no panic but silent
# reinterpretation).
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should now be correctly rejected at
# deserialization time instead of silently accepted.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
