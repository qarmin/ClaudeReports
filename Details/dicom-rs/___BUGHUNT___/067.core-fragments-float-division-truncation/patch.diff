+    #[test]
+    fn fragments_new_large_data_truncation_repro() {
+        // f32 can't exactly represent 16_777_217 (2^24 + 1); the f32 division
+        // used to compute the fragment count rounds down, silently dropping
+        // the trailing byte(s) of `data`.
+        let len = 16_777_217usize;
+        let data = vec![0xABu8; len];
+        let fragments = Fragments::new(data, 2);
+        let total: usize = fragments.fragments.iter().map(|f| f.len()).sum();
+        // fragment_size is rounded up to an even number (2) and data is padded
+        // to a whole multiple of it, so the correct total is len rounded up to
+        // the next even number - not less than len, and not off by a whole
+        // fragment (16_777_216, one fragment short) like the f32-based
+        // computation produced.
+        assert_eq!(
+            total,
+            len.div_ceil(2) * 2,
+            "fragments should cover every byte of input data (plus at most 1 padding byte)"
+        );
+    }
