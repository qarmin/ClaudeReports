+/// Resolve an attribute which the DICOM standard gives a default value for.
+///
+/// An element which is absent or carries no value resolves to `default`,
+/// but one which is present with a value that could not be read
+/// is reported instead of being silently mistaken for the default
+/// by the conformance checks which follow every call to this.
+fn u16_or_default<D>(
+    obj: &FileDicomObject<InMemDicomObject<D>>,
+    tag: Tag,
+    read: std::result::Result<u16, attribute::GetAttributeError>,
+    default: u16,
+) -> Result<u16>
+where
+    D: DataDictionary + Clone,
+{
+    match read {
+        Ok(value) => Ok(value),
+        Err(e) => match obj.element_opt(tag) {
+            Ok(Some(elem)) if !elem.is_empty() => Err(e.into()),
+            Ok(_) => Ok(default),
+            Err(_) => Err(e.into()),
+        },
+    }
+}
