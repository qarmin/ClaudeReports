+    #[test]
+    fn unreadable_attribute_is_not_taken_for_the_default() {
+        // a non-conformant Overlay Bits Allocated which is also unreadable
+        // (encoded with the wrong VR) must not pass as the default of 1
+        let mut obj = dummy_dicom();
+        put_overlay_plane(&mut obj, 0x6000, 4, 8);
+        obj.put_element(DataElement::new(
+            Tag(0x6000, 0x0100),
+            VR::SS,
+            dicom_value!(I16, 16),
+        ));
+        assert!(obj.decode_overlay(0).is_err());
+
+        // likewise for Overlay Bit Position against its default of 0
+        let mut obj = dummy_dicom();
+        put_overlay_plane(&mut obj, 0x6000, 4, 8);
+        obj.put_element(DataElement::new(
+            Tag(0x6000, 0x0102),
+            VR::SS,
+            dicom_value!(I16, 3),
+        ));
+        assert!(obj.decode_overlay(0).is_err());
+
+        // and for Samples per Pixel in the embedded overlay path
+        let mut obj = dummy_dicom();
+        obj.put_element(DataElement::new(
+            dicom_dictionary_std::tags::ROWS,
+            VR::US,
+            dicom_value!(U16, 2),
+        ));
+        obj.put_element(DataElement::new(
+            dicom_dictionary_std::tags::COLUMNS,
+            VR::US,
+            dicom_value!(U16, 4),
+        ));
+        obj.put_element(DataElement::new(
+            dicom_dictionary_std::tags::BITS_ALLOCATED,
+            VR::US,
+            dicom_value!(U16, 16),
+        ));
+        obj.put_element(DataElement::new(
+            dicom_dictionary_std::tags::SAMPLES_PER_PIXEL,
+            VR::SS,
+            dicom_value!(I16, 3),
+        ));
+        obj.put_element(DataElement::new(
+            dicom_dictionary_std::tags::PIXEL_DATA,
+            VR::OW,
+            PrimitiveValue::U16(vec![0x8000u16; 24].into()),
+        ));
+        put_overlay_plane(&mut obj, 0x6000, 2, 4);
+        obj.remove_element(Tag(0x6000, 0x3000));
+        obj.put_element(DataElement::new(
+            Tag(0x6000, 0x0102),
+            VR::US,
+            dicom_value!(U16, 15),
+        ));
+        assert!(obj.decode_overlay(0).is_err());
+
+        // an absent element still resolves to its standard default
+        let mut obj = dummy_dicom();
+        put_overlay_plane(&mut obj, 0x6000, 4, 8);
+        obj.remove_element(Tag(0x6000, 0x0100));
+        obj.remove_element(Tag(0x6000, 0x0102));
+        assert!(obj.decode_overlay(0).unwrap().is_some());
+
+        // so does an element which is present but carries no value
+        let mut obj = dummy_dicom();
+        put_overlay_plane(&mut obj, 0x6000, 4, 8);
+        obj.put_element(DataElement::new(
+            Tag(0x6000, 0x0100),
+            VR::US,
+            PrimitiveValue::Empty,
+        ));
+        assert!(obj.decode_overlay(0).unwrap().is_some());
+    }
