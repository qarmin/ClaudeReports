# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# NOTE: requires the `gdcm` feature (native GDCM library bindings via the `gdcm-rs` crate),
# which builds its own vendored C++ dependency from source via CMake on first build.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic
# ("chunk size must be non-zero") from pixeldata/src/gdcm.rs.
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic, and should
# return the correctly bit-unpacked 64-byte frame.
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone repro/target
