# Self-contained reproduction for this candidate.
#
# Real end-to-end reproduction (per CONFIRMATION.md section 11): `repro/run_e2e.sh` runs the
# actual `dicom-echoscu` binary against `fake_scp` (a minimal but genuine SCP built on
# `dicom-ul`'s own real, public server association API), communicating over a real loopback
# TCP socket.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Runs the real two-participant exchange against the pristine clone - should exit 1 (bug
# reproduced: echoscu panicked).
reproduce-before:
    ./repro/run_e2e.sh clone; test "$?" -eq 1 && echo "(exit 1 expected here: bug reproduced)"; true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Confirm the fix: the same real exchange now exits 0 (echoscu handles the empty response
# gracefully instead of panicking).
reproduce-after:
    ./repro/run_e2e.sh clone

clean:
    rm -rf clone
    rm -rf repro/fake_scp/target repro/fake_scp/Cargo.lock
