+/// Narrow a per-frame metadata array down to the single entry for `frame`, keeping it at
+/// index 0, so that a `DecodedPixelData` describing only one already-selected frame still
+/// gets indexed correctly by callers that address it as frame 0. Arrays with 0 or 1 entries
+/// (no per-frame data, or a value shared across all frames) are returned unchanged.
+fn select_frame_metadata<T: Clone>(values: Vec<T>, frame: usize) -> Vec<T> {
+    if values.len() <= 1 {
+        return values;
+    }
+    match values.get(frame) {
+        Some(v) => vec![v.clone()],
+        None => vec![values[0].clone()],
+    }
+}
