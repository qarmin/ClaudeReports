+    /// After reading `len / elem_size` whole elements of a fixed-width-VR
+    /// value, discard any trailing slack bytes left over from a declared
+    /// `len` that isn't an exact multiple of `elem_size` (logging a
+    /// warning) instead of leaving them unconsumed in the stream - which
+    /// would otherwise desynchronize this decoder's own position
+    /// bookkeeping from the real reader position and corrupt the parse of
+    /// whatever follows. PS3.5 never allows a misaligned length, but
+    /// real-world files exist that violate it and other readers (dcmtk,
+    /// dcmjs) already tolerate it this way - see Enet4/dicom-rs#698.
+    fn skip_misaligned_remainder(
+        &mut self,
+        header: &DataElementHeader,
+        len: usize,
+        elem_size: usize,
+    ) -> Result<()> {
+        let remainder = len % elem_size;
+        if remainder != 0 {
+            tracing::warn!(
+                tag = %header.tag,
+                declared_length = len,
+                elem_size,
+                remainder,
+                "Value length is not a multiple of the element size; skipping trailing byte(s) to keep the stream in sync",
+            );
+            std::io::copy(
+                &mut self.from.by_ref().take(remainder as u64),
+                &mut std::io::sink(),
+            )
+            .context(ReadValueDataSnafu {
+                position: self.position,
+            })?;
+        }
+        Ok(())
+    }
