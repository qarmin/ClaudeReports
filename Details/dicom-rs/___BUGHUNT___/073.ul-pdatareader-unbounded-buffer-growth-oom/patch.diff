+    /// A fake peer that dribbles out a fixed total amount of data in small
+    /// chunks, then closes the connection (returns Ok(0)) - simulating a
+    /// malicious/slow peer sending a P-Data-TF header that declares a huge
+    /// `pdu_length` it never actually finishes delivering.
+    struct DribblingStream {
+        remaining: usize,
+        chunk_size: usize,
+    }
+
+    impl Read for DribblingStream {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            let n = self.chunk_size.min(self.remaining).min(buf.len());
+            for b in &mut buf[..n] {
+                *b = 0x41;
+            }
+            self.remaining -= n;
+            Ok(n)
+        }
+    }
+
+    #[test]
+    fn pdata_reader_unbounded_buffer_growth_repro() {
+        // P-Data-TF header declaring a huge pdu_length (10,000,000 bytes) -
+        // far larger than max_pdu_length - that a malicious/misbehaving peer
+        // never actually finishes sending (only 2,000,000 bytes follow, then
+        // the connection closes).
+        let mut header = vec![0x04u8, 0x00];
+        header.extend_from_slice(&10_000_000u32.to_be_bytes());
+
+        let stream = std::io::Read::chain(
+            std::io::Cursor::new(header),
+            DribblingStream {
+                remaining: 2_000_000,
+                chunk_size: 4096,
+            },
+        );
+
+        let mut remaining = BytesMut::new();
+        let mut reader = PDataReader::new(stream, MINIMUM_PDU_SIZE, &mut remaining);
+
+        let mut out = vec![0u8; 4096];
+        let result = std::io::Read::read(&mut reader, &mut out);
+
+        // the read should fail quickly (PDU too large) rather than buffering
+        // the entire 2,000,000 bytes the peer was willing to send before
+        // finally erroring with "Connection closed by peer"
+        assert!(result.is_err(), "expected an error, got {result:?}");
+        let msg = result.unwrap_err().to_string();
+        assert!(
+            !msg.contains("Connection closed by peer"),
+            "BUG: buffered the peer's entire stream (unbounded growth) before finally failing \
+             with a generic disconnect error, instead of rejecting the oversized PDU declaration \
+             early: {msg}"
+        );
+    }
