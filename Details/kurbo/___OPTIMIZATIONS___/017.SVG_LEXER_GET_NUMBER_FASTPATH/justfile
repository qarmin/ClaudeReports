# Self-contained reproduction for candidate 017.
#
# NOTE (shape 3, see templates/candidate_justfile): kurbo's own benchmarks don't reach this code
# path, so this uses two harnesses:
#   * `../harness/kurbo_bench` - the workspace's canonical harness, for the `svg-parse` scene
#     (the same input the other candidates' numbers are anchored to). It is UNTRACKED in the
#     kurbo repo, so `clone:` copies it in and rewrites its kurbo dependency path.
#   * `./bench/svgbench` - written for THIS candidate, because `kurbo_bench`'s `svg-parse` scene
#     builds its input with `BezPath::to_svg`, which emits ~17-significant-digit numbers. Real
#     SVG path data carries 1-6 decimals, and the two hit completely different parts of `core`'s
#     `dec2flt`. `svgbench` takes the decimal count as a parameter, and its `verify` scene
#     cross-checks every number `from_svg` produces against `str::parse::<f64>()` bit for bit.
#
# That makes this folder self-contained *given the whole ___OPTIMIZATIONS___ folder kept
# together*, not as a single isolated subfolder.
#
# `just test` clones at the pinned commit, builds baseline binaries, applies patch.diff, builds
# patched binaries, runs the bit-exactness cross-check, and prints a real before/after plus the
# paired comparisons that carry the conclusion.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"
harness_dir := "../harness/kurbo_bench"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout --quiet {{base_commit}}
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/kurbo_bench
    rm -rf clone/kurbo_bench/target
    # The harness lives at ___OPTIMIZATIONS___/harness/kurbo_bench in the workspace, but at
    # clone/kurbo_bench here, so its relative path to the kurbo crate changes.
    sed -i 's|path = "../../../kurbo"|path = "../kurbo"|' clone/kurbo_bench/Cargo.toml
    # svgbench already uses `path = "../kurbo"`, which is correct at clone/svgbench.
    cp -r "{{justfile_directory()}}/bench/svgbench" clone/svgbench
    rm -rf clone/svgbench/target

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd clone/kurbo_bench && cargo build --release
    cd clone/svgbench && cargo build --release
    cp clone/kurbo_bench/target/release/kurbo_bench ./bin_baseline
    cp clone/svgbench/target/release/svgbench ./svg_baseline

build-patched:
    find clone/kurbo/src -name '*.rs' -exec touch {} +
    cd clone/kurbo_bench && cargo build --release
    cd clone/svgbench && cargo build --release
    cp clone/kurbo_bench/target/release/kurbo_bench ./bin_patched
    cp clone/svgbench/target/release/svgbench ./svg_patched

bench:
    @echo "=== the binaries must differ, or the patch didn't apply ==="
    md5sum ./bin_baseline ./bin_patched ./svg_baseline ./svg_patched
    @echo ""
    @echo "=== bit-exactness cross-check against core's own str::parse::<f64>() ==="
    @echo "    (400k generated number tokens; both builds must report 0 mismatches)"
    ./svg_baseline verify | tail -1
    ./svg_patched  verify | tail -1
    @echo ""
    @echo "=== kurbo_bench svg-parse (17-significant-digit input): baseline then patched ==="
    ulimit -c 0 && ./bin_baseline svg-parse 200
    ulimit -c 0 && ./bin_patched  svg-parse 200
    @echo ""
    @echo "=== svgbench, same path at several decimal precisions: baseline then patched ==="
    for s in svg-parse-full svg-parse-1 svg-parse-2 svg-parse-3 svg-parse-6; do \
        ./svg_baseline $s 200; \
        ./svg_patched  $s 200; \
    done
    @echo ""
    @echo "=== paired comparisons (alternating runs; the win count carries the conclusion) ==="
    ulimit -c 0 && TASKSET=2 RUNS=9 bash "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- svg-parse 200
    ulimit -c 0 && RUNS=9 bash "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- svg-parse 200
    ulimit -c 0 && TASKSET=3 RUNS=9 bash "{{justfile_directory()}}/../tools/paired.sh" ./svg_baseline ./svg_patched -- svg-parse-2 200
    ulimit -c 0 && RUNS=9 bash "{{justfile_directory()}}/../tools/paired.sh" ./svg_baseline ./svg_patched -- svg-parse-2 200
    @echo ""
    @echo "NOTE: every CHECK line above is identical between the two builds - this candidate is"
    @echo "      bit-exact. See RESULT.md."

# The rejected variant measured alongside the shipped one: the same scan rewritten with direct
# slice indexing instead of get_byte/unget, WITHOUT the exact fast path. It regressed.
test-variant-a: clone build-baseline
    cd clone && git apply "{{justfile_directory()}}/variant_a_slice_index.diff"
    find clone/kurbo/src -name '*.rs' -exec touch {} +
    cd clone/kurbo_bench && cargo build --release
    cp clone/kurbo_bench/target/release/kurbo_bench ./bin_variant_a
    ulimit -c 0 && TASKSET=2 RUNS=9 bash "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_variant_a -- svg-parse 200

clean:
    rm -rf clone bin_baseline bin_patched bin_variant_a svg_baseline svg_patched
