+/// Bernstein basis weights of a cubic, at the `N_LSE` evenly subdivided t values.
+///
+/// These are the sample points [`CubicOffset::eval_err`] evaluates the candidate approximation
+/// at. They never vary, so only the control points change from call to call.
+const fn mk_pos_weights() -> [[f64; 4]; N_LSE] {
+    let mut result = [[0.0; 4]; N_LSE];
+    let mut i = 0;
+    while i < N_LSE {
+        // Same expression as the t value it replaces, so the sample points are unchanged.
+        let t = (i + 1) as f64 * (1.0 / (N_LSE + 1) as f64);
+        let mt = 1. - t;
+        result[i] = [mt * mt * mt, 3.0 * mt * mt * t, 3.0 * mt * t * t, t * t * t];
+        i += 1;
+    }
+    result
+}
+
+/// Weights giving the *derivative* of a cubic from its own four control points, at the same
+/// sample points as [`mk_pos_weights`].
+///
+/// The factor of 3 from [`ParamCurveDeriv::deriv`](crate::ParamCurveDeriv::deriv) is folded in,
+/// so this consumes the cubic's control points directly and the derivative curve never has to be
+/// constructed.
+const fn mk_tan_weights() -> [[f64; 4]; N_LSE] {
+    let mut result = [[0.0; 4]; N_LSE];
+    let mut i = 0;
+    while i < N_LSE {
+        let t = (i + 1) as f64 * (1.0 / (N_LSE + 1) as f64);
+        let mt = 1. - t;
+        result[i] = [
+            -3.0 * mt * mt,
+            3.0 * (mt * mt - 2.0 * mt * t),
+            3.0 * (2.0 * mt * t - t * t),
+            3.0 * t * t,
+        ];
+        i += 1;
+    }
+    result
+}
+
+const POS_WEIGHTS: [[f64; 4]; N_LSE] = mk_pos_weights();
+const TAN_WEIGHTS: [[f64; 4]; N_LSE] = mk_tan_weights();
