# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate is Not reproducible: `repro/` exercises the arc_angles-consumption logic in
# CubicOffset::find_subdivision_point (kurbo/src/offset.rs) through two escalating approaches -
# an exhaustive adversarial-grid check of the isolated arithmetic (22,736 combinations across
# denormals and near-pi/near-0 boundary doubles) and a 2,000,000-iteration real end-to-end fuzz
# of the public offset_cubic API biased toward inflection-bearing curves and tiny tolerances.
# Neither found the out-of-bounds index the candidate hypothesized. There is no patch.diff -
# only `reproduce-before`, no `apply`/`reproduce-after`.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates that neither the
# isolated arc_angles-consumption arithmetic nor the real offset_cubic API produces the
# out-of-bounds index/panic described by the candidate (exit code 0, "did not reproduce" printed
# = did not reproduce). ITERS overrides the fuzz iteration count (default 2,000,000).
reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
