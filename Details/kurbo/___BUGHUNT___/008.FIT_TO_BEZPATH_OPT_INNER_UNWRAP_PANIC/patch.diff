+        // succeeded). Fall back to a straight line for this piece rather than panicking,
+        // mirroring the equivalent escape hatch in `fit_to_bezpath_rec`.
+        let c = match fit_to_cubic(source, t0..t1, accuracy) {
+            Some((c, _)) => c,
+            None => {
+                let start_p = source.sample_pt_tangent(t0, 1.0).p;
+                let end_p = source.sample_pt_tangent(t1, -1.0).p;
+                let p1 = start_p.lerp(end_p, 1.0 / 3.0);
+                let p2 = end_p.lerp(start_p, 1.0 / 3.0);
+                CubicBez::new(start_p, p1, p2, end_p)
+            }
+        };
         if i == 0 && range.start == 0.0 {
             path.move_to(c.p0);
         }
