@@ -643,7 +643,23 @@ fn fit_to_bezpath_opt_inner(
         } else {
             range.end
         };
-        let (c, _) = fit_to_cubic(source, t0..t1, accuracy).unwrap();
+        // `fit_to_cubic`'s error metric is not monotonic in `accuracy`: a range accepted by
+        // the search pass above at a tightened accuracy `x` is not guaranteed to also fit at
+        // the final `accuracy` (a larger `accuracy` can flip `fit_to_cubic` onto its
+        // short-chord line-fit shortcut, which can fail on a chord that doubles back on
