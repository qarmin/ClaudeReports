# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# NOTE: the fix in patch.diff is documentation-only (it documents the existing NaN/Inf-producing
# behavior on Triangle::inscribed_circle/circumscribed_circle, matching the project's own
# precedent for Affine::inverse, rather than changing the numeric behavior - see RESULT.md for
# why). So `reproduce-after` is EXPECTED to still print the same NaN/Inf output and exit 1, same
# as `reproduce-before` - the patch does not change what the functions return, only what they
# document. Both invocations are included for a complete before/after record.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# `-`: the repro intentionally exits non-zero when it reproduces (see repro/src/main.rs's exit
# code convention), which `just` would otherwise treat as a recipe failure and abort `just test`
# before reaching `apply`/`reproduce-after` - read the printed output rather than the recipe's
# own exit status.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

reproduce-after:
    -cd repro && cargo run --release

clean:
    rm -rf clone repro/target
