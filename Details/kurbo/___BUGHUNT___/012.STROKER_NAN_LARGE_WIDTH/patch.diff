diff --git a/kurbo/src/offset.rs b/kurbo/src/offset.rs
index 48ecfad..0d3de78 100644
--- a/kurbo/src/offset.rs
+++ b/kurbo/src/offset.rs
@@ -212,7 +212,21 @@ impl CubicOffset {
             //
             // If we're even more unlucky, there is a second-order cusp, both zero
             // cusp value and zero derivative.
-            let utan_t = self.q.eval(t).to_vec2().normalize();
+            //
+            // The found root can coincide with (or land extremely close to) an
+            // interval endpoint whose true derivative vanishes (e.g. a cubic with
+            // a repeated final control point). In that case `self.q.eval(t)` is
+            // (near) zero and normalizing it yields NaN; fall back to the nearest
+            // endpoint's already-known-good unit tangent instead.
+            const UTAN_EPSILON: f64 = 1e-12;
+            let q_t = self.q.eval(t).to_vec2();
+            let utan_t = if q_t.hypot2() >= UTAN_EPSILON {
+                q_t.normalize()
+            } else if t - a <= b - t {
+                rec.utan0
+            } else {
+                rec.utan1
+            };
             let cusp_t_minus = CUSP_EPSILON.copysign(rec.cusp0);
             let cusp_t_plus = CUSP_EPSILON.copysign(rec.cusp1);
             self.subdivide(rec, result, t, utan_t, cusp_t_minus, cusp_t_plus);
