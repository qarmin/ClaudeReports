diff --git a/kurbo/src/param_curve.rs b/kurbo/src/param_curve.rs
index 7fff046..9d37f2d 100644
--- a/kurbo/src/param_curve.rs
+++ b/kurbo/src/param_curve.rs
@@ -100,6 +100,13 @@ pub trait ParamCurveArclen: ParamCurve {
             return 0.0;
         }
         let total_arclen = self.arclen(accuracy);
+        // `arclen >= total_arclen` is always false when either side is NaN (e.g. a curve with a
+        // non-finite control point), so without this explicit check a NaN `total_arclen` would
+        // silently flow into `epsilon` below and eventually get absorbed by `f64::max` deep in
+        // `solve_itp`, producing a bogus finite result instead of propagating the NaN.
+        if arclen.is_nan() || total_arclen.is_nan() {
+            return f64::NAN;
+        }
         if arclen >= total_arclen {
             return 1.0;
         }
