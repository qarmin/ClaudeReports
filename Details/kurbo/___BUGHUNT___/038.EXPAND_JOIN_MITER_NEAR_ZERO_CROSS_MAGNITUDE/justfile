# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate is Not reproducible: `repro/` drives the real public `kurbo::expand_path_signed`
# entry point directly through two escalating approaches - a targeted boundary-value sweep of the
# near-parallel-tangent corner angle the candidate hypothesized about (across several anisotropy
# ratios, gaps from 1e-1 rad down to 1e-16 rad), and a 2,000,000-iteration broad randomized sweep
# of corner angle / angle gap / anisotropy. Neither found a non-finite or panicking output. There
# is no patch.diff - only `reproduce-before`, no `apply`/`reproduce-after`.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates that the near-zero-
# cross miter-point blow-up hypothesized by the candidate does not occur in either build profile.
# ITERS overrides the random-sweep iteration count (default 2,000,000).
reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
