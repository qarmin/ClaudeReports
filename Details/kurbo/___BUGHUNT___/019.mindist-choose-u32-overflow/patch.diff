+// Binomial co-efficient, but returning zeros for values outside of domain.
+//
+// Accumulates in `f64` rather than an integer type: `C(n, k)` grows far past any fixed-width
+// integer's range long before `n` reaches this module's own documented degree-255 support (e.g.
+// `C(36, 18)` already exceeds `u32::MAX`), and every call site immediately divides by another
+// `choose(...)` result and multiplies into an `f64`-valued curve point anyway, so there is no
+// exact-integer computation being thrown away by doing the whole thing in `f64` up front. This
+// trades exactness for very large `n` (silently, gracefully lossy, as all `f64` math is) for
+// never overflowing/wrapping/panicking within the documented range.
+fn choose(n: u8, k: u8) -> f64 {
+    let n_int = u32::from(n);
+    let k_int = u32::from(k);
+    if k_int > n_int {
+        return 0.0;
     }
-    let mut p = 1;
-    for i in 1..=(n - k) {
-        p *= n;
-        p /= i;
-        n -= 1;
+    let mut n_rem = f64::from(n);
+    let mut p = 1.0;
+    for i in 1..=(n_int - k_int) {
+        p *= n_rem;
+        p /= f64::from(i);
+        n_rem -= 1.0;
     }
     p
 }
