diff --git a/src/mold.h b/src/mold.h
index a8d3ed1f..358ec4f7 100644
--- a/src/mold.h
+++ b/src/mold.h
@@ -3449,6 +3449,12 @@ InputSection<E>::check_range(Context<E> &ctx, i64 i, i64 val, i64 lo, i64 hi) {
 template <typename E>
 std::pair<SectionFragment<E> *, i64>
 MergeableSection<E>::get_fragment(i64 offset) {
+  // `offset` is ultimately derived from an untrusted symbol value/relocation
+  // addend; a value below the first recorded fragment makes upper_bound
+  // return begin(), so idx would go negative and index fragments/frag_offsets
+  // out of bounds.
+  if (frag_offsets.empty() || offset < frag_offsets[0])
+    return {nullptr, 0};
   auto it = ranges::upper_bound(frag_offsets, offset);
   i64 idx = it - 1 - frag_offsets.begin();
   return {fragments[idx], offset - frag_offsets[idx]};
