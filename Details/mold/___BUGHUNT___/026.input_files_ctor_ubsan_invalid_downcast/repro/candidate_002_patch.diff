diff --git a/src/input-files.cc b/src/input-files.cc
index 2844c98d..1d26ccf5 100644
--- a/src/input-files.cc
+++ b/src/input-files.cc
@@ -86,15 +86,27 @@ InputFile<E>::InputFile(Context<E> &ctx, MappedFile *mf)
   ElfEhdr<E> &ehdr = *(ElfEhdr<E> *)mf->data;
   is_dso = (ehdr.e_type == ET_DYN);
 
-  ElfShdr<E> *sh_begin = (ElfShdr<E> *)(mf->data + ehdr.e_shoff);
+  // e_shoff is an untrusted file offset. Validate it before dereferencing
+  // anything through it: in particular, when e_shnum is 0 (see below) we
+  // need to read sh_begin->sh_size, which requires at least one section
+  // header to actually be present in the file.
+  u64 shoff = ehdr.e_shoff;
+  if (shoff > (u64)mf->size ||
+      (ehdr.e_shnum == 0 && (u64)mf->size - shoff < sizeof(ElfShdr<E>)))
+    Fatal(ctx) << *this << ": e_shoff is out of range";
+
+  ElfShdr<E> *sh_begin = (ElfShdr<E> *)(mf->data + shoff);
 
   // e_shnum contains the total number of sections in an object file.
   // Since it is a 16-bit integer field, it's not large enough to
   // represent >65535 sections. If an object file contains more than 65535
   // sections, the actual number is stored to sh_size field.
-  i64 num_sections = (ehdr.e_shnum == 0) ? sh_begin->sh_size : ehdr.e_shnum;
+  i64 num_sections = (ehdr.e_shnum == 0) ? (i64)(u64)sh_begin->sh_size : (i64)(u16)ehdr.e_shnum;
 
-  if (mf->data + mf->size < (u8 *)(sh_begin + num_sections))
+  // Compare *counts*, not `sh_begin + num_sections` - a huge, attacker-controlled
+  // num_sections could otherwise overflow the pointer arithmetic itself.
+  if (num_sections < 0 ||
+      (u64)num_sections > ((u64)mf->size - shoff) / sizeof(ElfShdr<E>))
     Fatal(ctx) << mf->name << ": e_shoff or e_shnum corrupted: "
                << mf->size << " " << num_sections;
   elf_sections = {sh_begin, sh_begin + num_sections};
