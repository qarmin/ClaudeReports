+/// `UNPREMULTIPLY_RECIP_LUT[a]` is the fixed-point (16.16) reciprocal used by
+/// [`Pixmap::take_unpremultiplied`] to turn the per-pixel unpremultiply division into a
+/// multiply. Entry 0 is unused (alpha == 0 is handled separately).
+const fn build_unpremultiply_recip_lut() -> [u32; 256] {
+    let mut lut = [0u32; 256];
+    let mut a = 1usize;
+    while a < 256 {
+        // round(255 * 65536 / a)
+        lut[a] = ((255 * 65536 * 2 + a as u64) / (2 * a as u64)) as u32;
+        a += 1;
+    }
+    lut
+}
+
+const UNPREMULTIPLY_RECIP_LUT: [u32; 256] = build_unpremultiply_recip_lut();
