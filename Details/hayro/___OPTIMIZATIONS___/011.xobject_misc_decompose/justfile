# Self-contained reproduction for this candidate.
#
# This candidate is a MEASUREMENT/characterization, not a source-code performance fix: the
# patch only adds temporary Instant+AtomicU64 instrumentation (reused from candidate 007's
# ../_reference/ diffs, verbatim) plus one new example (`hayro/examples/bench_ops_reference.rs`)
# that prints the decomposed `xobject_misc` breakdown. No permanent source change is being
# proposed here - see RESULT.md.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

# Full cycle: clone at the pinned commit, apply the instrumentation, build, run the breakdown.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Prints the full operator-bucket time breakdown (see RESULT.md for how to read it) against
# testdata/img.pdf, taskset-pinned for low noise. Override iteration count with `just bench 200`.
bench iterations="80":
    cd clone && cargo build --release --example bench_ops_reference -p hayro
    taskset -c 2 ./clone/target/release/examples/bench_ops_reference "{{justfile_directory()}}/testdata/img.pdf" {{iterations}}

clean:
    rm -rf clone
