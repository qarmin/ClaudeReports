 #[cfg(feature = "images")]
 #[inline(always)]
 pub(crate) fn round_f32(x: f32) -> f32 {
-    #[cfg(feature = "std")]
+    // `f32::round()` lowers to a `roundf` libm call (not a hardware instruction) unless the
