+    // Pre-sized to the number of entries in the page's own `/Font` resource dict so the miss path
+    // below never needs to grow/rehash the map from empty (each distinct name is inserted once).
+    let mut resolved_font_cache = FxHashMap::<Name<'a>, Option<TextStateFont<'a>>>::with_capacity_and_hasher(
+        resources.fonts.len(),
+        Default::default(),
+    );
 
     context.save_state();
 
@@ -564,15 +575,23 @@ pub fn interpret<'a>(
                 // 2) In case it's `None` because we were unable to resolve the font
