+#[cfg(test)]
+mod combine_diff_tests {
+    use super::*;
+
+    // xorshift32, deterministic, no extra dev-dependency needed.
+    struct Rng(u32);
+    impl Rng {
+        fn next(&mut self) -> u32 {
+            let mut x = self.0;
+            x ^= x << 13;
+            x ^= x >> 17;
+            x ^= x << 5;
+            self.0 = x;
+            x
+        }
+        fn range(&mut self, lo: i32, hi: i32) -> i32 {
+            lo + (self.next() % ((hi - lo) as u32)) as i32
+        }
+    }
+
+    fn random_bitmap(rng: &mut Rng, w: u32, h: u32) -> Bitmap {
+        let mut bmp = Bitmap::new(w, h).unwrap();
+        for y in 0..h {
+            for x in 0..w {
+                bmp.set_pixel(x, y, (rng.next() & 1) as u8);
+            }
+        }
+        bmp
+    }
+
+    #[test]
+    fn combine_matches_naive_reference() {
+        let mut rng = Rng(0xC0FFEE ^ 1);
+        let ops = [
+            CombinationOperator::Or,
+            CombinationOperator::And,
+            CombinationOperator::Xor,
+            CombinationOperator::Xnor,
+            CombinationOperator::Replace,
+        ];
+
+        for iter in 0..20_000_u32 {
+            let dest_w = 1 + (rng.next() % 130);
+            let dest_h = 1 + (rng.next() % 20);
+            let src_w = 1 + (rng.next() % 130);
+            let src_h = 1 + (rng.next() % 20);
+
+            let src = random_bitmap(&mut rng, src_w, src_h);
+            let x = rng.range(-140, 140);
+            let y = rng.range(-25, 25);
+            let op = ops[(rng.next() as usize) % ops.len()];
+
+            let mut dest_a = random_bitmap(&mut rng, dest_w, dest_h);
+            let mut dest_b = dest_a.clone();
+
+            dest_a.combine(&src, x, y, op);
+            dest_b.combine_naive(&src, x, y, op);
+
+            assert_eq!(
+                dest_a.data, dest_b.data,
+                "mismatch at iter {iter}: dest {dest_w}x{dest_h}, src {src_w}x{src_h}, x={x}, y={y}, op={op:?}"
+            );
+        }
+    }
