diff --git a/Cargo.toml b/Cargo.toml
index ef83a6a8..796b7b0e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -16,6 +16,10 @@ members = [
     "hayro-postscript",
     "hayro-cmap"
 ]
+# `vello/` is a separate, nested cargo workspace (a local clone of linebender/vello used
+# for the `[patch]` below); excluding it stops cargo from treating it as part of this
+# workspace, which otherwise breaks `workspace = true` dependency inheritance inside it.
+exclude = ["vello"]
 
 [workspace.package]
 authors = ["Laurenz Stampfl <laurenz.stampfl@gmail.com>"]
@@ -112,6 +116,12 @@ clippy.redundant_feature_names = "warn"
 clippy.wildcard_dependencies = "warn"
 # END LINEBENDER LINT SET
 
+# Local vello checkout with the take_unpremultiplied LUT perf fix applied.
+# See ___OPTIMIZATIONS___/03_hayro_vello_unpremultiply_wired_in/RESULT.md.
+[patch."https://github.com/linebender/vello"]
+vello_cpu = { path = "vello/sparse_strips/vello_cpu" }
+vello_common = { path = "vello/sparse_strips/vello_common" }
+
 # Makes it easier to debug with a profiler
 [profile.instrument]
 inherits = "release"
