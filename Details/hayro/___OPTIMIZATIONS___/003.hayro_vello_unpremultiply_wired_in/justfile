# Self-contained reproduction for this candidate.
#
# This one is a two-repo case: patch.diff only changes hayro's own Cargo.toml (excluding
# vello/ from the workspace and adding a [patch] pointing at a local vello checkout), so
# reproducing it for real needs BOTH repos cloned, with the second one nested inside the
# first at the same relative path hayro's Cargo.toml expects ("vello"). vello_pixmap_fix.diff
# (a copy of ../../vello/___OPTIMIZATIONS___/001.take_unpremultiplied_lut/patch.diff, kept
# here too so this folder stays self-contained) supplies the actual LUT fix vello needs.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

hayro_repo_url := "https://github.com/LaurenzV/hayro.git"
hayro_base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"
vello_repo_url := "https://github.com/linebender/vello.git"
vello_base_commit := "af32d531fd805899d9a5c4385ceae81ce8f45b29"

# Full cycle: clone both repos at their pinned commits, apply both patches, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{hayro_repo_url}} clone
    cd clone && git checkout {{hayro_base_commit}}
    git clone {{vello_repo_url}} clone/vello
    cd clone/vello && git checkout {{vello_base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone/vello && git apply "{{justfile_directory()}}/vello_pixmap_fix.diff"

# hayro-bench's own render_bench is the existing project benchmark that reaches this code
# path (parse+interpret+decode+rasterize, no PNG/JPEG encode) - no standalone bench crate
# needed for this candidate.
bench:
    cd clone && cargo run --release --bin render_bench -p hayro-bench -- --iter 30 image_cmyk_icc_jpg.pdf issue391.pdf stream_jpx_1.pdf

clean:
    rm -rf clone
