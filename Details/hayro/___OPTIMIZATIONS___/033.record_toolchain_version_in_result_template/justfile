# Self-contained reproduction for this candidate.
#
# Unlike every other candidate in this workspace, this one is NOT a performance patch to hayro's
# source - it's a documentation/process fix to the perf-optimize skill's own
# templates/RESULT_template.md (outside this repo entirely), so there is no patch.diff, no
# baseline/patched binary, and no timing/call-count comparison to reproduce here.
#
# `just test` instead does the two things that ARE reproducible and verifiable about this
# candidate: (1) clones hayro at the pinned base_commit and confirms the working tree needs zero
# changes (this candidate never touched hayro's own source - see RESULT.md), and (2) prints the
# toolchain-version paragraph this candidate added to RESULT_template.md, sourced from this
# folder's own copy of the template (template.md, a snapshot taken at the time this candidate was
# written - the live skill file may have moved on since).

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

test: clone confirm-no-source-change show-template-change

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

confirm-no-source-change:
    #!/usr/bin/env bash
    set -euo pipefail
    cd clone
    if [ -n "$(git status --porcelain)" ]; then
      echo "UNEXPECTED: clone is not clean at base_commit"
      exit 1
    fi
    echo "confirmed: hayro's own working tree needs no source change for this candidate"

show-template-change:
    @echo "=== paragraph added to templates/RESULT_template.md ==="
    @grep -A 8 "compiled-code artifact" template.md

clean:
    rm -rf clone
