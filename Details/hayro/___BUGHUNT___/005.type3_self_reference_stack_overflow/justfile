# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# repo_url/base_commit read via `git remote get-url origin` / `git rev-parse HEAD` in the main
# project, at the moment patch.diff was captured - patch.diff is a diff against that exact commit
# and may stop applying cleanly once the main branch moves on.

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug (child
# process aborts with a stack overflow, non-zero exit code, REPRODUCED printed). The repro binary
# exits non-zero on a reproduced crash by design (see repro/src/main.rs) - ignore that exit code
# here (`-`) so `just test`'s single-command chain still reaches `apply`/`reproduce-after`
# afterwards instead of stopping on the expected failure.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug (exit
# code 0, "did not reproduce" printed).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
