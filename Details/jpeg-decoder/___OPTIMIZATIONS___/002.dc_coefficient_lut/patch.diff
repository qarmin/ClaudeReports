+    // Analogous to decode_fast_ac: for DC tables, table.dc_lut folds the magnitude-category
+    // decode and its receive_extend into one LUT probe when both fit within LUT_BITS.
+    pub fn decode_dc<R: Read>(&mut self, reader: &mut R, table: &HuffmanTable) -> Result<i16> {
+        if let Some(ref dc_lut) = table.dc_lut {
+            if self.num_bits < LUT_BITS {
+                self.read_bits(reader)?;
+            }
+
+            let (value, size) = dc_lut[self.peek_bits(LUT_BITS) as usize];
+
+            if size != 0 {
+                self.consume_bits(size);
+                return Ok(value);
+            }
+        }
+
+        let category = self.decode(reader, table)?;
+
+        match category {
+            0 => Ok(0),
+            1..=11 => self.receive_extend(reader, category),
+            _ => Err(Error::Format(
+                "invalid DC difference magnitude category".to_owned(),
+            )),
+        }
+    }
+
