+        // Build a lookup table for small DC coefficient differences which both decodes the
+        // magnitude category and does the equivalent of receive_extend, mirroring ac_lut above.
+        let dc_lut = match class {
+            HuffmanTableClass::AC => None,
+            HuffmanTableClass::DC => {
+                let mut table = [(0i16, 0u8); 1 << LUT_BITS];
+
+                for (i, &(magnitude_category, size)) in lut.iter().enumerate() {
+                    if size == 0 {
+                        continue;
+                    }
+
+                    if magnitude_category == 0 {
+                        table[i] = (0, size);
+                    } else if magnitude_category <= 11 && size + magnitude_category <= LUT_BITS {
+                        let unextended_value = (((i << size) & ((1 << LUT_BITS) - 1)) >> (LUT_BITS - magnitude_category)) as u16;
+                        let value = extend(unextended_value, magnitude_category);
+
+                        table[i] = (value, size + magnitude_category);
+                    }
+                }
+
+                Some(table)
+            },
+        };
