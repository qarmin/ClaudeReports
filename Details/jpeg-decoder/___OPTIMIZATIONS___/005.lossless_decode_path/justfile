# Self-contained reproduction for this candidate.
#
# The harness (harness/bench_decode) is untracked in the main jpeg-decoder repo (it's this
# workspace's own scratch crate, see ___OPTIMIZATIONS___/README.md), so a fresh `git clone` of
# repo_url will never contain it - this candidate is self-contained given the whole
# ___OPTIMIZATIONS___ folder (shape 3 from the template comment), not standalone-postable on its
# own.

repo_url := "https://github.com/image-rs/jpeg-decoder.git"
base_commit := "eb2d7c0f6a2d0298aba7a7f8b9ca1440353e8f8c"
harness_dir := "../harness/bench_decode"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/bench_decode
    sed -i 's#path = "\.\./\.\./\.\."#path = ".."#' clone/bench_decode/Cargo.toml

build-baseline:
    cd clone/bench_decode && cargo +stable build --release
    cp clone/bench_decode/target/release/bench_decode ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    find clone/src -name '*.rs' -exec touch {} +
    cd clone/bench_decode && cargo +stable build --release
    cp clone/bench_decode/target/release/bench_decode ./bin_patched

bench:
    @echo "=== baseline (memory re-read for left-neighbour predictor) vs patched (carried-forward local + flat slices), Predictor::Ra branch only ==="
    @echo "--- tests/reftest/images/lossless/1/jpeg_lossless_sel1-rgb.jpg (primary target, predictor selection 1 = Ra) ---"
    ./bin_baseline clone/tests/reftest/images/lossless/1/jpeg_lossless_sel1-rgb.jpg 20
    ./bin_patched  clone/tests/reftest/images/lossless/1/jpeg_lossless_sel1-rgb.jpg 20
    @echo "--- tests/reftest/images/lossless/1/jpeg_lossless_sel2.jpg (generic predictor branch, untouched - expect no consistent change) ---"
    ./bin_baseline clone/tests/reftest/images/lossless/1/jpeg_lossless_sel2.jpg 20
    ./bin_patched  clone/tests/reftest/images/lossless/1/jpeg_lossless_sel2.jpg 20
    @echo "Use ../tools/paired.sh ./bin_baseline ./bin_patched -- <image> [iters] (RUNS=9+) for a properly paired A/B comparison; see RESULT.md for numbers already gathered that way."

clean:
    rm -rf clone bin_baseline bin_patched
