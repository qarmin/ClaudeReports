-                                             row,
-                                             output_width,
-                                             &mut line_buffers[i]);
-        }
-        color_convert(&line_buffers, output);
+        LINE_BUFFERS.with(|line_buffers| {
+            let mut line_buffers = line_buffers.borrow_mut();
+            if line_buffers.len() != component_count
+                || line_buffers.iter().any(|buf| buf.len() != self.line_buffer_size)
+            {
+                *line_buffers = vec![vec![0u8; self.line_buffer_size]; component_count];
+            }
+
+            for (i, component) in self.components.iter().enumerate() {
+                component.upsampler.upsample_row(&component_data[i],
+                                                 component.width,
+                                                 component.height,
+                                                 component.row_stride,
+                                                 row,
+                                                 output_width,
+                                                 &mut line_buffers[i]);
+            }
+            color_convert(&line_buffers, output);
+        });
     }
 }
 
