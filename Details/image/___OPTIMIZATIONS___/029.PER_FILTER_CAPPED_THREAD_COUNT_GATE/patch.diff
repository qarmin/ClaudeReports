@@ -10,6 +10,57 @@ use std::ops::{AddAssign, BitXor};
 use crate::{imageops::FilterType, DynamicImage, ImageBuffer, Pixel};
 use pic_scale_safe::ResamplingFunction;
 
+/// Below this many source pixels, pic-scale-safe's internal `rayon` fan-out
+/// (`par_chunks_exact`/`par_chunks_exact_mut`, gated purely at compile time by its own `rayon`
+/// feature, with no minimum-size gate of its own) costs more in thread-dispatch overhead than it
+/// saves - see `___OPTIMIZATIONS___/021.PIC_SCALE_SAFE_RAYON_SIZE_THRESHOLD_FIX` for the
+/// measurement this threshold is based on.
+#[cfg(feature = "rayon")]
+const SMALL_RESIZE_SOURCE_PIXEL_THRESHOLD: usize = 500_000;
+
+/// Runs `f` on a cached, capped-size rayon pool below the size threshold, instead of letting
+/// pic-scale-safe's internal `par_chunks_exact`/`par_chunks_exact_mut` fan out across the
+/// (possibly large, e.g. 24-thread) global pool - same output, cheaper dispatch for small resizes,
+/// without touching pic-scale-safe's own source. The pool's thread count is chosen per filter
+/// rather than a single constant for all of them: candidate 028 found `num_threads(4)` best for
+/// `Nearest`/`Bilinear`/`Lanczos3`, while candidate 027 found `num_threads(6)` a repeatable win
+/// specifically for `CatmullRom`/`Gaussian` (with `N=6`/`N=8` a wash-or-regression risk for the
+/// first group) - see `___OPTIMIZATIONS___/029.PER_FILTER_CAPPED_THREAD_COUNT_GATE` for the
+/// measurement this is based on.
+#[cfg(feature = "rayon")]
+fn run_resize<T: Send>(source_pixels: usize, alg: ResamplingFunction, f: impl FnOnce() -> T + Send) -> T {
+    use std::sync::OnceLock;
+    static SMALL_RESIZE_POOL_N4: OnceLock<rayon::ThreadPool> = OnceLock::new();
+    static SMALL_RESIZE_POOL_N6: OnceLock<rayon::ThreadPool> = OnceLock::new();
+
+    if source_pixels < SMALL_RESIZE_SOURCE_PIXEL_THRESHOLD {
+        let pool = match alg {
+            ResamplingFunction::CatmullRom | ResamplingFunction::Gaussian => {
+                SMALL_RESIZE_POOL_N6.get_or_init(|| {
+                    rayon::ThreadPoolBuilder::new()
+                        .num_threads(6)
+                        .build()
+                        .expect("failed to build capped-thread pool")
+                })
+            }
+            _ => SMALL_RESIZE_POOL_N4.get_or_init(|| {
+                rayon::ThreadPoolBuilder::new()
+                    .num_threads(4)
+                    .build()
+                    .expect("failed to build capped-thread pool")
+            }),
+        };
+        pool.install(f)
+    } else {
+        f()
+    }
+}
+
+#[cfg(not(feature = "rayon"))]
+fn run_resize<T>(_source_pixels: usize, _alg: ResamplingFunction, f: impl FnOnce() -> T) -> T {
+    f()
+}
