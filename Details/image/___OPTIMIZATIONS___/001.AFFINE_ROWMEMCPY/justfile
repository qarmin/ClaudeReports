# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles a harness-only hunk (a new `rotate180_in_place` criterion case in
# benches/imageops.rs) with the actual fix (src/imageops/affine.rs). apply-harness applies just
# the former so the same benchmark exists in both the baseline and patched build; apply-fix
# applies the latter on top, for the patched build only - so `just test` prints a real
# before/after instead of only building the patched side.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/affine.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/affine.rs' "{{justfile_directory()}}/patch.diff"

# `flip_vertical` was already benched in benches/imageops.rs and exercises flip_vertical_in;
# `rotate180_in_place`'s own case is added by the harness hunk applied above.
bench-baseline:
    @echo "=== baseline (before patch) ==="
    cd clone && cargo bench --bench imageops -- "flip_vertical$|rotate180_in_place"

bench-patched:
    @echo "=== patched (after patch) ==="
    cd clone && cargo test --release --lib imageops::affine
    cd clone && cargo bench --bench imageops -- "flip_vertical$|rotate180_in_place"

clean:
    rm -rf clone
