# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.
#
# This candidate's full RESULT.md sweeps N=2/3/4/6/8; this justfile demonstrates the
# highest-value single comparison (baseline "no gate" vs the N=4 value already shipped in
# production by candidate 029 for Triangle/Lanczos3) rather than rebuilding all 5 binaries -
# see raw/*.log in this folder for the full sweep's numbers.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles the Cargo.toml + benches/imageops.rs harness hunks with the actual fix
# (src/imageops/resize.rs, candidate 023's `run_resize` gate, num_threads(4) - the value this
# candidate's sweep confirms is best/joint-best for Triangle/Lanczos3 across N=2/3/4/6/8).
# apply-harness applies just the former so the same benchmarks exist in both the baseline and
# patched build; apply-fix applies the latter on top, for the patched build only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

# Reuses the repo's own `benches/imageops.rs` (extended by the harness hunk with the
# `bench_resize_dynamic` group, including the Triangle/Lanczos3 cases at 400x300->32x24) rather
# than a standalone bench crate.
# Filters by substring (criterion's default match mode, not regex) - this also runs the
# CatmullRom/Gaussian cases candidate 026 added at the same size, since criterion has no
# built-in "OR" filter; only Triangle/Lanczos3's own lines are relevant to this candidate.
bench-baseline:
    @echo "=== baseline (before patch, i.e. rayon forwarded + bench harness, no capped pool) ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24"

bench-patched:
    @echo "=== patched (after patch, num_threads(4)-capped pool applied) ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24"

clean:
    rm -rf clone
