# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles the same Cargo.toml + benches/imageops.rs harness hunks as candidates
# 021/022/023 (rayon forwarded + bench_resize_dynamic group) with the actual fix
# (src/imageops/resize.rs, candidate 023's num_threads(4)-capped pool combined with candidate
# 022's filter-aware gate). apply-harness applies just the former so the same benchmarks exist in
# both the baseline and patched build; apply-fix applies the latter on top, for the patched build
# only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

bench-baseline:
    @echo "=== baseline (before patch, i.e. rayon forwarded + bench harness, no gate) ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24"

bench-patched:
    @echo "=== patched (after patch, filter-aware num_threads(4)-capped pool applied) ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24"

clean:
    rm -rf clone
