+        // lane at a time to interleave with the next pixel's reduction. Decoupling them lets each
+        // loop vectorize on its own terms.
+        const CHUNK: usize = 256;
+        let mut luma_buf = [0.0f32; CHUNK];
+
+        let input_chunks = input.as_chunks::<3>().0.chunks(CHUNK);
+        let output_chunks = output.chunks_mut(CHUNK);
+
+        for (rgb_chunk, out_chunk) in input_chunks.zip(output_chunks) {
+            let luma = &mut luma_buf[..rgb_chunk.len()];
+
+            for (rgb, luma) in rgb_chunk.iter().zip(luma.iter_mut()) {
+                let mut acc = 0.0;
+                for (&component, coef) in rgb.iter().zip(coef) {
+                    acc = multiply_accumulate(acc, component, coef);
+                }
+                *luma = acc;
             }
 
-            *pix = P::clamp_from_f32(luma);
+            for (&l, pix) in luma.iter().zip(out_chunk) {
+                *pix = P::clamp_from_f32(l);
+            }
         }
     }
 
