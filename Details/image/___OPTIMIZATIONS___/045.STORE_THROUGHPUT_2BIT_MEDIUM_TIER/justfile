# Self-contained reproduction for this candidate.
#
# This candidate is a MEASUREMENT-ONLY investigation - no patch to the `image` crate's own
# source (see RESULT.md's "Does it change behavior/output?" section). There is correctly no
# `patch.diff` in this folder. `repo_url`/`base_commit` are recorded below purely for context
# (the commit this investigation was carried out against) - the synthetic microbenchmark itself
# (`bench/`, candidate 041's harness with a size-matched "medium" ~490,000px tier added) has no
# dependency on the `image` crate at all, so `just test` does not actually need the clone to run,
# but `just clone` is still provided so a reader can check out the same commit if they want to
# re-verify the real `pal2_large.bmp` decode this candidate's "medium" tier is meant to compare
# against (candidates 020/037/041/043).

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# Full cycle: build the standalone synthetic microbenchmark and run it, printing the same
# min/p50/mean/max/GB/s/ns-per-pixel table this candidate's RESULT.md was built from, now with a
# third "medium" (490,000px) size tier alongside candidate 041's original "small"/"large".
test: build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build:
    cd bench && cargo build --release

bench:
    @echo "=== synthetic store-throughput microbenchmark (24 density x variant x size configs, 30 rounds, round-robin) ==="
    @echo "=== no patch to image's own source - see RESULT.md for the medium-vs-small-vs-large scale-invariance comparison ==="
    ./bench/target/release/store_throughput

clean:
    rm -rf clone bench/target
