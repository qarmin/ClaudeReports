+pub fn bench_thumbnail(c: &mut Criterion) {
+    // 4032x3024 (12MP) matches the source size used elsewhere in this repo's
+    // `___OPTIMIZATIONS___` sessions to profile decode/resize, so results are comparable.
+    let src = ImageBuffer::from_fn(4032, 3024, |x, y| {
+        Rgb([x as u8, (y / 8) as u8, ((x * 13 + y) % 256) as u8])
+    });
+
+    c.bench_function("thumbnail 4032x3024 -> 200x150", |b| {
+        b.iter(|| imageops::thumbnail(&src, 200, 150));
+    });
+}
+
+criterion_group!(benches, bench_imageops, bench_resize, bench_thumbnail);
 criterion_main!(benches);
