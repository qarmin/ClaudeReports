# Self-contained reproduction for this candidate.
#
# This candidate is a MEASUREMENT-ONLY investigation - no patch to the `image` crate's own
# source (see RESULT.md's "Does it change behavior/output?" section). There is correctly no
# `patch.diff` in this folder. `repo_url`/`base_commit` are recorded below purely for context
# (the commit this investigation was carried out against, and whose own candidate 037 numbers
# this one's "real decode ns/pixel" comparison table reuses) - the synthetic microbenchmark
# itself (`bench/`) has no dependency on the `image` crate at all, so `just test` does not
# actually need the clone to run, but `just clone` is still provided so a reader can check out
# the same commit if they want to re-verify the candidate-037 numbers this RESULT.md compares
# against.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# Full cycle: build the standalone synthetic microbenchmark (extends candidate 047's harness with
# one new variant, "unpack_volatile_specialized_rowclosure_boundschecked") and run it, printing
# the same min/p50/mean/max/GB/s/ns-per-pixel table this candidate's RESULT.md was built from, for
# all eleven variants x 4 densities x 2 buffer sizes. Two per-pixel correctness checks
# (`verify_unpack_correctness`, `verify_iterator_variants_correctness`) run unconditionally at
# startup and print "... OK" before the timing table - a non-zero exit or a missing OK line means
# an extraction/iterator/bounds-checked variant is wrong, not just slow.
test: build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build:
    cd bench && cargo build --release

bench:
    @echo "=== palette-index bounds-check isolation microbenchmark (extends candidate 047's rowclosure floor with a real, unsized-slice, checked palette index) ==="
    @echo "=== no patch to image's own source - see RESULT.md for the rowclosure-vs-rowclosure_boundschecked comparison ==="
    ./bench/target/release/row_iterator_machinery_throughput

clean:
    rm -rf clone bench/target
