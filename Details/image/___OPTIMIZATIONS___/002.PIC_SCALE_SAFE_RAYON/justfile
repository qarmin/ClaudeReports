# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles a harness-only hunk (a new `dynamic_resize` criterion group in
# benches/imageops.rs, exercising `DynamicImage::resize_exact` - the only resize entry point that
# goes through pic-scale-safe) with the actual fix (Cargo.toml's `rayon` feature-forward).
# apply-harness applies just the former so the same benchmark exists in both the baseline and
# patched build; apply-fix applies the latter on top, for the patched build only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='Cargo.toml' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='Cargo.toml' "{{justfile_directory()}}/patch.diff"

bench-baseline:
    @echo "=== baseline (before patch, pic-scale-safe rayon NOT forwarded) ==="
    cd clone && cargo build --release --bench imageops
    cd clone && cargo bench --bench imageops -- "dynamic_resize"

bench-patched:
    @echo "=== patched (after patch, pic-scale-safe rayon forwarded) ==="
    cd clone && cargo build --release --bench imageops
    cd clone && cargo bench --bench imageops -- "dynamic_resize"

clean:
    rm -rf clone
