 use image::{
     imageops::{self, FilterType},
     math::Rect,
@@ -123,5 +123,33 @@ pub fn bench_resize(c: &mut Criterion) {
     }
 }
 
-criterion_group!(benches, bench_imageops, bench_resize);
+// Unlike `bench_resize` above (which calls the standalone `imageops::resize` free function, a
+// separate, older implementation that never touches pic-scale-safe), this exercises
+// `DynamicImage::resize_exact`, which delegates to the `pic-scale-safe` crate
+// (see `src/imageops/resize.rs`) - the code path affected by the `rayon` feature forwarding.
+pub fn bench_resize_dynamic(c: &mut Criterion) {
+    let src = ImageBuffer::from_fn(4032, 3024, |x, y| {
+        // "random" pixel values
+        Rgb([x as u8, (y / 8) as u8, ((x * 13 + y) % 256) as u8])
+    });
+    let src_dyn = DynamicImage::from(src);
+
+    let mut group = c.benchmark_group("dynamic_resize");
+    let c = group.warm_up_time(Duration::from_secs(1)).sample_size(10);
+
+    for filter in [FilterType::Lanczos3, FilterType::Triangle] {
+        c.bench_function(
+            &format!("DynamicImage::resize_exact 4032x3024->400x300 {filter:?}"),
+            |b| {
+                b.iter_batched(
+                    || src_dyn.clone(),
+                    |mut img| img.resize_exact(400, 300, filter),
+                    BatchSize::LargeInput,
+                );
+            },
+        );
+    }
+}
+
+criterion_group!(benches, bench_imageops, bench_resize, bench_resize_dynamic);
 criterion_main!(benches);
