# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles the harness hunks (Cargo.toml's `benches/imageops.rs` addition) together
# with the actual fix (Cargo.toml's `[patch.crates-io]`/rayon-forward hunks, plus the entire
# vendored+patched `vendor/pic-scale-safe/` tree). apply-harness applies just the bench addition
# so it exists for both the serial baseline and the fixed build; apply-fix applies the
# Cargo.toml + vendor/ hunks on top, for the fixed build only. This reproduces the "S
# (serial/main) vs E (this candidate's vendored+gated fix)" comparison from RESULT.md.
test: clone apply-harness bench-serial apply-fix bench-fixed

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='Cargo.toml' --exclude='vendor/*' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='Cargo.toml' --include='vendor/*' "{{justfile_directory()}}/patch.diff"

# "Serial" here means pic-scale-safe/rayon forwarding has no effect - the registry pic-scale-safe
# is used as-is, with its own `rayon` feature never compiled in. Note this needs
# --no-default-features (not just omitting --features rayon): the image crate's own
# `default = ["rayon", "default-formats"]` enables its own "rayon" feature on a plain
# `cargo bench` with no flags at all, which (once apply-fix runs) would also forward into
# pic-scale-safe.
bench-serial:
    @echo "=== S: true serial (main today, no pic-scale-safe/rayon forward) - Nearest at 400x300->32x24 ==="
    cd clone && cargo bench --bench imageops --no-default-features --features default-formats -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Nearest"

# "Fixed" here means the rayon feature IS enabled, pic-scale-safe/rayon is forwarded, and the
# vendored `[patch.crates-io]` override (with resize_nearest's minimum-row gate) is in effect.
bench-fixed:
    @echo "=== E: this candidate's fix (vendored pic-scale-safe, dst_height>=32 gate) - Nearest at 400x300->32x24 ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Nearest"

clean:
    rm -rf clone
