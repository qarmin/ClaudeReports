-criterion_group!(benches, bench_imageops, bench_resize);
+pub fn bench_thumbnail(c: &mut Criterion) {
+    // 4032x3024 (12MP) matches the source size used elsewhere in this repo's
+    // `___OPTIMIZATIONS___` sessions to profile decode/resize, so results are comparable.
+    let src = ImageBuffer::from_fn(4032, 3024, |x, y| {
+        Rgb([x as u8, (y / 8) as u8, ((x * 13 + y) % 256) as u8])
+    });
+
+    c.bench_function("thumbnail downscale 4032x3024 -> 200x150", |b| {
+        b.iter(|| imageops::thumbnail(&src, 200, 150));
+    });
+
+    // Small source enlarged to a much bigger target: every output pixel's window is fully
+    // inside a fractional (sub-pixel) span in both axes, so this routes essentially every
+    // output pixel through `thumbnail_sample_fraction_both` rather than the block-averaging
+    // path `bench_thumbnail`'s downscale case exercises.
+    let small_src = ImageBuffer::from_fn(200, 150, |x, y| {
+        Rgb([x as u8, (y / 2) as u8, ((x * 13 + y) % 256) as u8])
+    });
+
+    c.bench_function("thumbnail upscale 200x150 -> 4032x3024", |b| {
+        b.iter(|| imageops::thumbnail(&small_src, 4032, 3024));
+    });
+}
+
+criterion_group!(benches, bench_imageops, bench_resize, bench_thumbnail);
 criterion_main!(benches);
