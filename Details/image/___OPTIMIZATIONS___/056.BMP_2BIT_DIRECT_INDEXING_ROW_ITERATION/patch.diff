+// Direct-indexing variants of `set_8bit_pixel_run`/`set_4bit_pixel_run` (and the 1-bit/2-bit
+// paths, which have no other caller) used only by the plain (non-RLE) palettized row path
+// (`read_palettized_pixel_data`). The RLE4/RLE8 paths above still use `ChunksExactMut` because
+// they rely on the iterator's own cursor (`nth`, `for_each`, partial consumption) across several
+// operations within one row - not just a per-pixel `.next()` - so aren't a fair like-for-like
+// swap; see candidate 051's RESULT.md.
+fn set_1bit_pixel_run_direct<'a, T: Iterator<Item = &'a u8>>(
+    row: &mut [u8],
+    num_channels: usize,
+    palette: &[[u8; 3]],
+    indices: T,
+) {
+    let mut offset = 0usize;
+    for idx in indices {
+        let mut bit = 0x80;
+        loop {
+            let Some(pixel) = row.get_mut(offset..offset + 3) else {
+                return;
+            };
+            let rgb = palette[usize::from((idx & bit) != 0)];
+            pixel[0] = rgb[0];
+            pixel[1] = rgb[1];
+            pixel[2] = rgb[2];
+            offset += num_channels;
+
+            bit >>= 1;
+            if bit == 0 {
+                break;
+            }
+        }
+    }
+}
