# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles harness-only additions (a new 700x700 2-bit indexed BMP corpus file
# tests/images/bmp/images/pal2_large.bmp, its reference PNG, and a benches/decode.rs BENCH_DEFS
# entry) with the actual fix (src/codecs/bmp/decoder.rs, candidate 011's fixed-size-array fix
# reapplied so this new file can measure it). apply-harness applies just the former so the same
# benchmark exists in both the baseline and patched build; apply-fix applies the latter on top,
# for the patched build only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/codecs/bmp/decoder.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/codecs/bmp/decoder.rs' "{{justfile_directory()}}/patch.diff"

bench-baseline:
    @echo "=== baseline (before patch) ==="
    cd clone && cargo bench --bench decode -- "load-Bmp/pal2_large.bmp" --exact

bench-patched:
    @echo "=== patched (after patch) ==="
    cd clone && cargo bench --bench decode -- "load-Bmp/pal2_large.bmp" --exact

clean:
    rm -rf clone
