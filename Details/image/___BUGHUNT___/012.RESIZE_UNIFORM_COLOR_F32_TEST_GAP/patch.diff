+    #[test]
+    fn test_resize_uniform_color_f32_preserved() {
+        // Sibling of `test_resize_uniform_color_preserved` for the `f32` pixel type: candidate
+        // 003's `vertical_sample` accumulator-seed bug (`Rgba([1.0; 4])` instead of `[0.0; 4]`)
+        // is unconditional and applies before any clamp, so a mid-range uniform value (not near
+        // either clamp bound) exercises it just as reliably as the `u8` case.
+        use crate::{Pixel, Rgb};
+
+        let filters = [
+            FilterType::Nearest,
+            FilterType::Triangle,
+            FilterType::CatmullRom,
+            FilterType::Gaussian,
+            FilterType::Lanczos3,
+        ];
+        let value = 0.4f32;
+        let src: crate::Rgb32FImage = ImageBuffer::from_pixel(6, 6, Rgb([value, value, value]));
+
+        for filter in filters {
+            let resized = resize(&src, 3, 3, filter);
+            for p in resized.pixels() {
+                for &c in p.channels() {
+                    assert!(
+                        (c - value).abs() < 1e-5,
+                        "resize with {filter:?} did not preserve a uniform source color: got {c} expected {value}"
+                    );
+                }
+            }
+        }
+    }
