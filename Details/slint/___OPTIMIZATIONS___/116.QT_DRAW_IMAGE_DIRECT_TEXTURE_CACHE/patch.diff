+// Single-slot cache for `draw_image_direct`, keyed by source identity (and, for scalable
+// sources, the target size they were rasterized at). `draw_image_direct` has no `ItemRc` to
+// key a per-item cache on (unlike `draw_image`), but in practice it is only ever called for
+// the drag-and-drop image overlay (see `Window::render_drag_image_overlay`), i.e. at most one
+// image in flight at a time, so a single slot gets a full hit rate for that use case without
+// needing a bounded multi-entry cache.
+pub(crate) type DirectImageCacheEntry =
+    (ImageCacheKey, Option<euclid::Size2D<u32, PhysicalPx>>, qttypes::QPixmap);
