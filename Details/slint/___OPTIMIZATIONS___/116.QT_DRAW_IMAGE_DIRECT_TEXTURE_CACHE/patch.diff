+/// Same per-source caching `femtovg`'s `TextureCache`/skia's `cached_image` give their own
+/// `draw_image_direct`: reuse the last rasterized `QPixmap` when both the source's `ImageCacheKey`
+/// and the requested (scalable-source) target size still match, otherwise rasterize and store.
+pub(crate) fn cached_image_to_pixmap(
+    direct_image_cache: &RefCell<Option<DirectImageCacheEntry>>,
+    image: &ImageInner,
+    source_size: Option<euclid::Size2D<u32, PhysicalPx>>,
+) -> Option<qttypes::QPixmap> {
+    ImageCacheKey::new(image)
+        .and_then(|cache_key| {
+            let mut cache = direct_image_cache.borrow_mut();
+            if let Some((cached_key, cached_size, cached_pixmap)) = cache.as_ref() {
+                if *cached_key == cache_key && *cached_size == source_size {
+                    return Some(cached_pixmap.clone());
+                }
+            }
+            let pixmap = image_to_pixmap(image, source_size)?;
+            *cache = Some((cache_key, source_size, pixmap.clone()));
+            Some(pixmap)
+        })
+        .or_else(|| image_to_pixmap(image, source_size))
+}
