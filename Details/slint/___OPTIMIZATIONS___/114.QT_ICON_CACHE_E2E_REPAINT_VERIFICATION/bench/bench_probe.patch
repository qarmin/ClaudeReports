+// TEMPORARY, for candidate 114's end-to-end repaint probe only - reverted before the session
+// ends, never shipped. Split into "real icon set" vs. "no icon set" (`ImageInner::None`)
+// buckets: `NativeButton::actual_icon()`'s call site in qt_widgets/button.rs records a call via
+// `bench_probe_record_call` and, only on an actual cache miss (right before/after calling
+// `image_to_pixmap`), a miss via `bench_probe_record_miss` - so CALLS vs. MISSES per bucket
+// distinguishes "repaint happened but was served from cache" from "repaint re-rasterized".
+#[cfg(feature = "bench-probe")]
+pub static BENCH_PROBE_CALLS_ICON: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "bench-probe")]
+pub static BENCH_PROBE_MISSES_ICON: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "bench-probe")]
+pub static BENCH_PROBE_CALLS_EMPTY: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "bench-probe")]
+pub static BENCH_PROBE_MISSES_EMPTY: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+#[cfg(feature = "bench-probe")]
+pub fn bench_probe_record_call(has_icon: bool) {
+    let counter = if has_icon { &BENCH_PROBE_CALLS_ICON } else { &BENCH_PROBE_CALLS_EMPTY };
+    counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[cfg(feature = "bench-probe")]
+pub fn bench_probe_record_miss(has_icon: bool) {
+    let counter = if has_icon { &BENCH_PROBE_MISSES_ICON } else { &BENCH_PROBE_MISSES_EMPTY };
+    counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Returns `(calls_with_real_icon, misses_with_real_icon, calls_with_no_icon, misses_with_no_icon)`.
+#[cfg(feature = "bench-probe")]
+pub fn bench_probe_counters() -> (u64, u64, u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    (
+        BENCH_PROBE_CALLS_ICON.load(Relaxed),
+        BENCH_PROBE_MISSES_ICON.load(Relaxed),
+        BENCH_PROBE_CALLS_EMPTY.load(Relaxed),
+        BENCH_PROBE_MISSES_EMPTY.load(Relaxed),
+    )
+}
