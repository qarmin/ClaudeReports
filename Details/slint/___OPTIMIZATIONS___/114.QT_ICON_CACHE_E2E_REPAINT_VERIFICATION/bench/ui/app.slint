import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 300px;
    height: 200px;

    icon-button := Button {
        x: 20px;
        y: 20px;
        width: 120px;
        height: 40px;
        icon: @image-url("../../testdata/shapes.svg");
        icon-size: 128px;
    }

    other-button := Button {
        x: 20px;
        y: 120px;
        width: 120px;
        height: 40px;
        text: "other";
    }
}
