# Self-contained reproduction for this candidate.
#
# This candidate is a pure code-reading audit, not a timing measurement: it grepped/read
# internal/backends/qt/qt_widgets/*.rs for candidate 113's "uncached per-paint image_to_pixmap"
# shape and found no additional occurrences (patch.diff is empty - there is nothing to apply or
# bench). `just test` below just re-runs the same greps against a pinned clone so the audit's own
# claims can be checked mechanically rather than only by re-reading RESULT.md.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"

test: clone check

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Re-run the exact greps RESULT.md's "What was tried" section describes, against the pinned clone.
check:
    @echo "--- Image-typed properties/QImage in qt_widgets/*.rs ---"
    grep -rn 'Image\b' clone/internal/backends/qt/qt_widgets/*.rs
    @echo
    @echo "--- image_to_pixmap / QPixmap / QIcon / standardIcon call sites in qt_widgets/*.rs ---"
    grep -rn 'image_to_pixmap\|QPixmap\|QIcon\|standardIcon' clone/internal/backends/qt/qt_widgets/*.rs
    @echo
    @echo "--- All image_to_pixmap call sites in the whole i-slint-backend-qt crate ---"
    grep -rn 'image_to_pixmap' clone/internal/backends/qt/ --include=*.rs

clean:
    rm -rf clone
