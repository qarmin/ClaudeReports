// Standalone bench for the candidate 100 follow-up ("fold is_visible_or_clipped_by_flickable's
// ancestor walk into a single O(k) top-down pass", internal/core/item_tree.rs).
//
// `HiddenChain` nests a `TextInput` 15 levels deep inside `clip: true` Rectangles, with
// `visible: false` on the leaf itself (compiled by the `visible` pass into a synthetic
// visibility-`Clip` ancestor directly wrapping it - internal/compiler/passes/visible.rs) so the
// leaf is always structurally focusable (a TextInput accepts Tab focus) but never visible,
// forcing `is_visible_or_clipped_by_flickable()`'s non-trivial branch on every focus-traversal
// step that reaches it. `count` copies are placed before one always-visible, always-focusable
// `tail` TextInput, so a single Tab press with nothing focused must call
// `is_visible_or_clipped_by_flickable()` on every one of the `count` hidden leaves (each paying
// the 15-level ancestor-chain cost) before landing on `tail`.
component HiddenChain inherits Rectangle {
    Rectangle {
        clip: true;
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        Rectangle {
            clip: true;
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            Rectangle {
                clip: true;
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                Rectangle {
                    clip: true;
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    Rectangle {
                        clip: true;
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        Rectangle {
                            clip: true;
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            Rectangle {
                                clip: true;
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                Rectangle {
                                    clip: true;
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    Rectangle {
                                        clip: true;
                                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                                        Rectangle {
                                            clip: true;
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            Rectangle {
                                                clip: true;
                                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                Rectangle {
                                                    clip: true;
                                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                    Rectangle {
                                                        clip: true;
                                                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                        Rectangle {
                                                            clip: true;
                                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                            Rectangle {
                                                                clip: true;
                                                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                                Rectangle {
                                                                    clip: true;
                                                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                                                    TextInput {
                                                                        visible: false;
                                                                        x: 0px; y: 0px; width: 10px; height: 10px;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <int> count: 500;
    out property <bool> tail-has-focus: tail.has-focus;
    preferred-width: 200px;
    preferred-height: 200px;

    for i in root.count: HiddenChain { }

    tail := TextInput {
        x: 5px; y: 5px; width: 40px; height: 20px;
    }
}
