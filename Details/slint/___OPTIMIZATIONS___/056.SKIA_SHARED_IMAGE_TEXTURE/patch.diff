+/// Upper bound on how many distinct sources' converted textures are kept alive in
+/// [`SkiaItemRenderer::shared_image_texture_cache`] - see its doc comment for why this exists.
+const SHARED_IMAGE_TEXTURE_CACHE_LIMIT: usize = 128;
+
+/// Whether converting `image_inner` to a Skia texture is independent of the requesting item, so
+/// its result can be shared across every item using the same source - unlike SVGs, which
+/// rasterize to a target size chosen by whichever item asks first, or borrowed/imported textures,
+/// which may not have a stable identity to key on at all.
+///
+/// `Image`'s own `PartialEq` already compares raster sources by buffer identity (not content -
+/// see `SharedImageBuffer::eq`), which is exactly "the same source" in the TODO this replaces, so
+/// it's reused directly below instead of inventing a second identity notion.
+fn is_shareable_image_source(image_inner: &i_slint_core::ImageInner) -> bool {
+    match image_inner {
+        i_slint_core::ImageInner::EmbeddedImage { .. } => true,
+        i_slint_core::ImageInner::BackendStorage(..) => true,
+        i_slint_core::ImageInner::NineSlice(nine) => is_shareable_image_source(&nine.0),
+        _ => false,
+    }
+}
