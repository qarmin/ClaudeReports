# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# This is an investigation candidate: patch.diff is empty (no product source changed). What it
# reproduces is a determinism *check* of perf_test's own --bench harness (candidate 102's
# already-permanent BenchPlatform virtual-clock fix, `perf_test/src/bench.rs`), run against
# `list`/`scroll` mode's ScrollBar instead of the `text` mode scenario candidate 102 originally
# verified it on. perf_test/ itself is not part of the tracked slint repo (an untracked harness
# maintained across this ___OPTIMIZATIONS___ workspace's sessions) - clone it from the same origin
# this session used.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

test: clone apply check

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

# patch.diff is empty (no product source changed) - nothing to apply. perf_test/ itself, and its
# candidate-102 BenchPlatform virtual-clock fix, are not part of the cloned repo's tracked history;
# you need your own checkout's perf_test/ (with candidate 102's fix already applied) to reproduce
# this candidate exactly, or re-derive it from `102.BENCHPLATFORM_DETERMINISTIC_CLOCK/benchplatform_clock_fix.diff`
# in this workspace applied to a fresh perf_test/ crate.
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Reproduce the two "content grows every frame" comparisons this candidate's RESULT.md tables:
# list mode (0 differing runs) vs scroll mode (a nonzero, inconsistent rate of differing runs).
# Requires perf_test/ built with candidate 102's BenchPlatform virtual-clock fix (the default,
# current state of perf_test/src/bench.rs at base_commit's matching checkout).
check:
    cd clone/perf_test && cargo build --bin perf_test --profile rdebug --features software
    mkdir -p /tmp/104_check
    for r in $(seq 1 15); do \
        ./clone/target/rdebug/perf_test --bench --mode list --count 500 --mutate 20 --mutate-mode push --scroll-step 0 --frames 60 --snapshot /tmp/104_check/list_$r.ppm >/dev/null; \
        ./clone/target/rdebug/perf_test --bench --mode scroll --count 500 --mutate 20 --mutate-mode push --scroll-step 0 --frames 60 --snapshot /tmp/104_check/scroll_$r.ppm >/dev/null; \
    done
    @echo "Compare /tmp/104_check/list_*.ppm and scroll_*.ppm pairwise (e.g. cmp -l) against run 1 of each mode."

clean:
    rm -rf clone
