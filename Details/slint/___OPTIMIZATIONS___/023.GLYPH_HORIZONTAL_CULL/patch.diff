+/// The horizontal counterpart of [`visible_band`].
+///
+/// Lines are culled vertically but glyph *runs* were never culled horizontally, so a `no-wrap` line
+/// wider than the viewport submitted every glyph on it to the renderer. That is not only wasted
+/// work: the software renderer casts a glyph's device rect to `i16`, and `euclid`'s `cast()`
+/// unwraps, so a run far enough to the right **panics** - reachable with a ~5 000 character line at
+/// a 13 px font. Skipping runs (and glyphs within a run) that cannot reach the clip fixes both.
+pub(super) fn visible_columns(item_renderer: &impl GlyphRenderer) -> Range<PhysicalLength> {
+    let scale_factor = item_renderer.scale_factor();
+    let clip = item_renderer.get_current_clip();
+    let left = clip.origin.x_length() * scale_factor;
+    left..(left + clip.width_length() * scale_factor)
+}
