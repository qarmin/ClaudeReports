+    fn subtree_can_be_skipped(&self, item_rc: &ItemRc) -> bool {
+        let item = item_rc.borrow();
+        let rendering_data = item.cached_rendering_data_offset();
+        let mut cache = self.cache.borrow_mut();
+        let Some(PartialRenderingCachedData { subtree_bounds, .. }) =
+            rendering_data.get_entry(&mut cache)
+        else {
+            // No cache entry yet (item created between compute_dirty_regions and rendering): be
+            // conservative, same as `filter_item` is for the same case.
+            return false;
+        };
+        if subtree_bounds.is_empty() {
+            return true;
+        }
+        let clipped = self.get_current_clip().intersection(subtree_bounds);
+        match clipped {
+            None => true,
+            Some(clipped) => {
+                let screen_geom =
+                    self.current_transform().outer_transformed_rect(&clipped.cast()).cast();
+                !self.dirty_region.draw_intersects(screen_geom)
+            }
+        }
+    }
