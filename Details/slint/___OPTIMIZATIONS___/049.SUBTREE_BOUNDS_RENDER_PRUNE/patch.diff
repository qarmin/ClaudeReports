+    /// Computes, and caches on each item's own cache entry, the union of the bounding rects of
+    /// all of that item's descendants, expressed in the item's own (children) coordinate frame.
+    /// Must run after `compute_dirty_regions` has refreshed every item's `CachedItemBoundingBoxAndTransform`
+    /// for this frame (it reads that data rather than the tracked properties directly, so it adds
+    /// no new dependency registrations).
+    ///
+    /// This lets `filter_item`/`subtree_can_be_skipped` tell whether a culled item's whole subtree
+    /// is still outside the dirty region, so `render_item_children` can skip descending into it
+    /// entirely instead of visiting every descendant just to find nothing to draw.
+    ///
+    /// Returns the computed union for `index` (relative to `index`'s own frame); the caller only
+    /// needs this for the recursive case, the top-level call (`index == -1`) discards it.
+    fn compute_subtree_bounds(&self, component: &ItemTreeRc, index: isize) -> LogicalRect {
+        let acc = RefCell::new(LogicalRect::zero());
+        let mut actual_visitor =
+            |component: &ItemTreeRc, child_index: u32, item: Pin<ItemRef>| -> VisitChildrenResult {
+                let rendering_data = item.cached_rendering_data_offset();
+                let own = {
+                    let mut cache = self.cache.borrow_mut();
+                    rendering_data
+                        .get_entry(&mut cache)
+                        .map(|entry| (*entry.data.bounding_rect(), entry.data.transform()))
+                };
+                // `None` only happens for a descendant of an item whose clip region was empty
+                // this frame (compute_dirty_regions skips refreshing those to save the work) -
+                // its stale bounds from a previous frame, if any, are still in the cache and get
+                // picked up below; if there never was one, contributing nothing here is safe
+                // because that whole branch is never rendered while its clip stays empty.
+                let Some((own_bounding_rect, own_transform)) = own else {
+                    return VisitChildrenResult::CONTINUE;
+                };
+
+                let child_subtree = self.compute_subtree_bounds(component, child_index as isize);
+                let mut merged = own_bounding_rect;
+                if !child_subtree.is_empty() {
+                    let child_subtree_in_our_frame =
+                        own_transform.outer_transformed_rect(&child_subtree.cast()).cast();
+                    merged = merged.union(&child_subtree_in_our_frame);
+                }
+
+                let mut acc = acc.borrow_mut();
+                *acc = acc.union(&merged);
+                VisitChildrenResult::CONTINUE
+            };
+        vtable::new_vref!(let mut actual_visitor : VRefMut<ItemVisitorVTable> for ItemVisitor = &mut actual_visitor);
+        vtable::VRc::borrow_pin(component).as_ref().visit_children_item(
+            index,
+            TraversalOrder::BackToFront,
+            actual_visitor,
+        );
+
+        let result = *acc.borrow();
+        if index >= 0 {
+            let item_rc = ItemRc::new(component.clone(), index as u32);
+            let item = item_rc.borrow();
+            let rendering_data = item.cached_rendering_data_offset();
+            let mut cache = self.cache.borrow_mut();
+            if let Some(entry) = rendering_data.get_entry(&mut cache) {
+                entry.subtree_bounds = result;
+            }
+        }
+        result
     }
 
