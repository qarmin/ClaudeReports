# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Note: fully reproducing the bench additionally needs `perf_test/` copied in manually next
# to `clone/` - it is untracked in the main slint repo's git history, so `just clone` alone
# will not fetch it. This candidate also modified four existing `perf_test` files (adding
# `MainWindow.probe-opacity`/`probe-animate`/`probe-count`, and wiring `--opacity`/`--path` into
# `--skia-bench`, which were previously silent no-ops there) - full copies are in
# `perf_test_fixes/`; drop them into your `perf_test/` (src/ and ui/ as named) before building if
# your copy predates this candidate.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Reproduce the headline numbers from RESULT.md. Needs perf_test/'s source copied into
# ./clone/perf_test (its Cargo.toml uses paths like "../api/rs/slint" relative to its own
# directory, so it must sit inside the checkout it is meant to build against), with
# perf_test_fixes/{backend.rs,bench.rs,skia_headless.rs} overlaid on perf_test/src/ and
# perf_test_fixes/main.slint overlaid on perf_test/ui/main.slint - see the note above.
# `--skia-bench` needs no display/Xvfb/GL context: it renders through Skia's own software
# surface directly.
bench:
    # NOTE: the perf_test_fixes/ overlay below is now redundant - ../harness/perf_test
    # (copied in by clone: above) is the current, cumulative perf_test source, which
    # already includes this candidate's scene/flag additions plus everything added by
    # later candidates. Overlaying an old snapshot on top would silently regress it, so
    # the lines that used to do that were removed.
    cd clone/perf_test && RENDERER=skia cargo build --profile rdebug --bin perf_test --features skia
    @echo "Steady-state frame time + allocations, probe scene, opacity 0 (see RESULT.md):"
    taskset -c 3 ./clone/target/rdebug/perf_test --skia-bench --mode list --count 3 \
        --probe-count 3000 --probe-opacity 0 --probe-animate --frames 20
    @echo "For the paired before/after comparison in RESULT.md: build once per patch.diff"
    @echo "applied/unapplied into two separate clones, then (from the main project's"
    @echo "___OPTIMIZATIONS___/tools/, not this folder):"
    @echo "  RUNS=9 TASKSET=3 paired_skia_headless.sh <base-bin> <patched-bin> \\"
    @echo "      --skia-bench --mode list --count 3 --probe-count 3000 --probe-opacity 0 --probe-animate --frames 20"
    @echo "  RUNS=9 paired_skia_headless.sh <base-bin> <patched-bin> \\"
    @echo "      --skia-bench --mode list --count 3 --probe-count 3000 --probe-opacity 0 --probe-animate --frames 20   # unpinned, multi-core"

clean:
    rm -rf clone
