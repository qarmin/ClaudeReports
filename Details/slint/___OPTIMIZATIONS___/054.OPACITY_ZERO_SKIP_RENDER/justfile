# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.
#
# Note: fully reproducing the bench additionally needs `perf_test/` copied in manually next
# to `clone/` (into `clone/perf_test`) - it is untracked in the main slint repo's git history,
# so `just clone` alone will not fetch it.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Reproduce the headline numbers from RESULT.md. Needs perf_test/'s source copied into
# ./clone/perf_test (its Cargo.toml uses paths like "../api/rs/slint" relative to its own
# directory, so it must sit inside the checkout it is meant to build against) - see the note
# above, it is not part of the main repo checkout `just clone` fetches. `--bench` always uses
# the headless software renderer, regardless of `--renderer`; that flag only matters for the
# real-window `--frames` path used to reach femtovg/skia (see RESULT.md).
bench:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test
    # Geometry-driven animation behind opacity 0 (animated property is `x`, part of the geometry
    # read directly by the traversal this patch shortens):
    ./clone/target/rdebug/perf_test --bench --mode rects --count 50000 \
        --opacity 0 --animate --frames 15
    # Content-only animation behind opacity 0 (animated property is `background`, read only
    # inside the draw call this patch skips entirely - the pattern closest to the reported
    # Spinner/animation-tick() bug, GitHub #6056):
    ./clone/target/rdebug/perf_test --bench --mode rects --count 50000 \
        --opacity 0 --animate --animate-color --frames 15
    @echo "For the paired before/after comparison in RESULT.md: build once per patch.diff"
    @echo "applied/unapplied into two separate clones, then:"
    @echo "  RUNS=9 FRAMES=15 taskset -c N tools/paired.sh <base-bin> <patched-bin> -- --mode rects --count 50000 --opacity 0 --animate"

clean:
    rm -rf clone
