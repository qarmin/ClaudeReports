+/// A weak counterpart to a cached `ImageInner`, kept in a side table alongside `IMAGE_CACHE` so
+/// an `Image` the application still holds can be handed back even after its strong entry was
+/// evicted (or never admitted, if it's heavier than the byte-weight bound above). Only variants
+/// backed by `vtable::VRc` can be represented here: unlike `SharedVector` (used by
+/// `EmbeddedImage`'s pixel buffer), which tracks a single strong refcount only, `VRc` already
+/// keeps a separate weak count (see `helper_crates/vtable/src/vrc.rs`), so downgrading one costs
+/// nothing once the last strong owner drops it. This does not cover `EmbeddedImage` (the common
+/// decoded-raster case): giving `SharedVector` the same strong/weak split would touch its FFI
+/// layout (`slint_shared_vector_allocate`/`_free`, mirrored in the generated C++ headers) and
+/// every unsafe pointer-arithmetic method in that type, which is a much larger and riskier change
+/// than this side table.
+#[derive(Clone)]
+enum WeakImageInner {
+    #[cfg(feature = "svg")]
+    Svg(vtable::VWeak<OpaqueImageVTable, ParsedSVG>),
+}
+
+impl WeakImageInner {
+    fn downgrade(inner: &ImageInner) -> Option<Self> {
+        match inner {
+            #[cfg(feature = "svg")]
+            ImageInner::Svg(svg) => Some(Self::Svg(vtable::VRc::downgrade(svg))),
+            _ => None,
+        }
+    }
+
+    fn upgrade(&self) -> Option<ImageInner> {
+        match self {
+            #[cfg(feature = "svg")]
+            Self::Svg(weak) => weak.upgrade().map(ImageInner::Svg),
+            #[cfg(not(feature = "svg"))]
+            _ => None,
+        }
+    }
+}
