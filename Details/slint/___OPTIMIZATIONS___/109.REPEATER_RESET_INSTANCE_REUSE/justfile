# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# This candidate reuses the project's own `perf_test` harness (a separate Cargo project at
# the repo root, untracked in this snapshot of the repo - see this workspace's README.md
# "Instrumentation added for this workspace" for why it lives outside `clone/`). The harness
# itself is not part of this patch; the two flags below (`--mutate-mode reset`, `--row-style
# bare`) are the extension this candidate added to it (see README.md), so a from-scratch
# `clone/` checkout of the pinned commit will NOT have them unless `perf_test/` is copied in
# separately alongside this candidate folder.
bench:
    cd clone && cargo build --release -p i-slint-core --all-features
    @echo "Run against this workspace's own perf_test/ (see README.md for setup):"
    @echo "  perf_test --bench --mode scroll --count 20000 --mutate 1 --mutate-mode reset --row-style bare --frames 15"

clean:
    rm -rf clone
