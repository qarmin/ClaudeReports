import { CheckBox, Palette, ScrollView } from "std-widgets.slint";
import { AddButtons, BareRecordRow, ClippedRecordRow, FixedLayoutRecordRow, FlatRecordRow, Logic, RecordItem, RecordRow, RowStyle, Settings, TouchRecordRow, VerticalFixedLayoutRecordRow } from "shared.slint";

// Same data and same row as the ListView mode, but every record is a live
// element: no virtualization, so this is the "how bad does it get" mode.
export component ScrollModePage inherits VerticalLayout {
    in property <[RecordItem]> records;
    in-out property <length> scroll-y;

    property <length> row-height: 34px;

    spacing: 6px;

    HorizontalLayout {
        spacing: 12px;

        AddButtons {
            add(count) => {
                Logic.add-records(count);
            }
            clear => {
                Logic.clear-records();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        CheckBox {
            text: "flat rows (no layout inside the row)";
            checked <=> Settings.flat-rows;
            toggled => {
                Settings.row-style = self.checked ? RowStyle.flat : RowStyle.layout;
            }
        }

        Text {
            text: "ScrollView + for (no virtualization) - " + root.records.length + " records";
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    // One view per row style: only the selected one is instantiated, so the comparison stays
    // free of any extra per-row work. `--mode scroll --row-style <layout|flat|clipped|touch|bare>`.

    if Settings.row-style == RowStyle.layout: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: RecordRow {
            variant: index;
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.flat: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: FlatRecordRow {
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.clipped: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: ClippedRecordRow {
            // Must match the `layout` branch exactly apart from `clip: true`, or the comparison
            // measures two changes at once - which it did until this was noticed.
            variant: index;
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.touch: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: TouchRecordRow {
            variant: index;
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.layout-fixed: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: FixedLayoutRecordRow {
            variant: index;
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.vertical-fixed: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: VerticalFixedLayoutRecordRow {
            variant: index;
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }

    if Settings.row-style == RowStyle.bare: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: root.records.length * root.row-height;
        content-y <=> root.scroll-y;

        for record[index] in root.records: BareRecordRow {
            y: index * root.row-height;
            width: 100%;
            height: root.row-height;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }
}
