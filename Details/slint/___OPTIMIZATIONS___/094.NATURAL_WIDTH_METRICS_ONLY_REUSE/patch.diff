+    let new_ranges: alloc::vec::Vec<Range<usize>> = paragraph_ranges(new_text).collect();
+
+    let delta = new_bytes.len() as isize - old_bytes.len() as isize;
+    let shift = |range: Range<usize>| -> Range<usize> {
+        let apply = |x: usize| (x as isize + delta) as usize;
+        apply(range.start)..apply(range.end)
+    };
+
+    // Leading paragraphs entirely within the common prefix: same index, same range, in both old
+    // and new text, so their shaped layout is still exactly right. `range.end <= prefix` alone
+    // isn't enough -- a *shorter* new paragraph at the same index can still end inside the common
+    // prefix while its old counterpart (whose own content actually changed) extended past it, so
+    // the ranges have to agree too, not just the new one's end.
+    let mut lead = 0usize;
+    while lead < old_paragraphs.len()
+        && lead < new_ranges.len()
+        && new_ranges[lead] == old_paragraphs[lead].range
+        && new_ranges[lead].end <= prefix
+    {
