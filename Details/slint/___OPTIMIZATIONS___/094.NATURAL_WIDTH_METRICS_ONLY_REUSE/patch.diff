+            layout_builder,
+            font_context,
+            text_slice,
+            range.clone(),
+            Default::default(),
+            Default::default(),
+            link_color,
+        ));
+    }
+
+    result.extend(old_iter.map(|mut p| {
+        p.range = shift(p.range);
+        p
+    }));
+
+    (result, dirty_range)
+}
