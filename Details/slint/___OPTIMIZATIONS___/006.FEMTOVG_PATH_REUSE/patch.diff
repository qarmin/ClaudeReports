@@ -101,11 +101,59 @@ pub struct GLItemRenderer<'a, R: femtovg::Renderer + TextureImporter> {
     metrics: RenderingMetrics,
 }
 
+std::thread_local! {
+    /// Scratch paths handed out by [`ScratchPath`]. Building a `femtovg::Path` allocates its verb
+    /// and coordinate vectors, and the renderer builds one per rectangle-like primitive per frame,
+    /// so the vectors (and, with femtovg's `PathCache` reuse, the tessellation buffers) are
+    /// recycled instead.
+    static PATH_POOL: RefCell<Vec<femtovg::Path>> = const { RefCell::new(Vec::new()) };
+}
+
+/// A `femtovg::Path` borrowed from a thread-local pool and returned, cleared, on drop.
+/// Deref-coerces to `&femtovg::Path`, so call sites pass `&path` as before.
+struct ScratchPath(Option<femtovg::Path>);
+
+impl ScratchPath {
+    fn new() -> Self {
+        Self(Some(PATH_POOL.with(|pool| pool.borrow_mut().pop()).unwrap_or_else(femtovg::Path::new)))
+    }
+}
+
+impl core::ops::Deref for ScratchPath {
+    type Target = femtovg::Path;
+    fn deref(&self) -> &femtovg::Path {
+        self.0.as_ref().expect("the path is only taken in Drop")
+    }
+}
+
+impl core::ops::DerefMut for ScratchPath {
+    fn deref_mut(&mut self) -> &mut femtovg::Path {
+        self.0.as_mut().expect("the path is only taken in Drop")
+    }
+}
+
+impl Drop for ScratchPath {
+    /// Bounded so that deeply nested clips/shadows/borders cannot make the pool grow without
+    /// limit.
+    fn drop(&mut self) {
+        const POOL_LIMIT: usize = 8;
+        if let Some(mut path) = self.0.take() {
+            path.clear();
+            PATH_POOL.with(|pool| {
+                let mut pool = pool.borrow_mut();
+                if pool.len() < POOL_LIMIT {
+                    pool.push(path);
+                }
+            });
+        }
+    }
+}
