     border_radius: PhysicalBorderRadius,
-) -> femtovg::Path {
-    let mut path = femtovg::Path::new();
+) -> ScratchPath {
+    let mut path = ScratchPath::new();
     let x = rect.origin.x;
     let y = rect.origin.y;
     let width = rect.size.width;
@@ -134,7 +182,7 @@ fn rect_with_radius_to_path(
     path
 }
 
-fn rect_to_path(r: PhysicalRect) -> femtovg::Path {
+fn rect_to_path(r: PhysicalRect) -> ScratchPath {
