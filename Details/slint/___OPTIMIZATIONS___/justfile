# Root justfile for ___OPTIMIZATIONS___/. Run from inside this folder.
#
# The harness lives in ../perf_test (untouched, not duplicated here). This does NOT
# auto-generate SUMMARY.md - table formatting stays manual/agent-driven by design (see
# ~/.claude/skills/perf-optimize/SKILL.md). What this gives you: (1) whether each candidate's
# patch.diff still applies to the CURRENT state of the main project, and (2) raw numbers dumped
# per candidate to compare by eye against what's already written in its RESULT.md.

harness := justfile_directory() + "/../perf_test"
project_path := justfile_directory() + "/.."

build:
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test

# Check every candidate's patch.diff still applies cleanly to the current main tree.
verify-patches:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ justfile_directory() }}"
    for d in */; do
      d="${d%/}"
      [ -f "$d/patch.diff" ] || continue
      if git -C "{{ project_path }}" apply --check "$d/patch.diff" 2>/dev/null; then
        echo "OK      $d"
      else
        echo "STALE   $d  (no longer applies cleanly - project moved on since this candidate was made)"
      fi
    done

# Re-run one candidate against the main project tree (reuses its target/). Always reverts after.
rerun candidate:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'git -C "{{ project_path }}" checkout -- .' EXIT
    git -C "{{ project_path }}" apply "{{ justfile_directory() }}/{{ candidate }}/patch.diff"
    just build
    OUT="{{ justfile_directory() }}/{{ candidate }}/rerun_$(date +%Y%m%d_%H%M%S).txt"
    echo "REPLACE with the actual perf_test invocation and its output for this candidate" | tee "$OUT"
    echo "raw output -> $OUT (compare by hand against RESULT.md, update it if it drifted)"

# Re-run every candidate that has a patch.diff, one at a time.
rerun-all:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ justfile_directory() }}"
    for d in */; do
      d="${d%/}"
      [ -f "$d/patch.diff" ] || continue
      just rerun "$d"
    done
