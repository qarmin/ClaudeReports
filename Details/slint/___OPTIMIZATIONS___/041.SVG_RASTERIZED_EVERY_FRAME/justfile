# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "fb263fd4b78225112c71c374386fd986b9a54e44"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# The original bench used `perf_test`, this repo's own benchmark harness (see
# perf_test/___OPTIMIZATIONS___/41_svg_rasterized_every_frame/RESULT.md). `perf_test/` is
# untracked in the main repo's git history, so a fresh clone here will NOT have it - it
# must be copied in manually (from the original checkout's perf_test/ directory) before
# this recipe can run for real. Once present, the bench that reproduces the -84.9% number is:
#
#   cargo run --profile rdebug --bin make_assets
#   RUNS=5 tools/matrix.sh \
#     "svg|--mode images --count 12 --image-file shapes.svg  --image-cell 200 --repaint-buffer new" \
#     "png|--mode images --count 12 --image-file medium.png  --image-cell 200 --repaint-buffer new"
bench:
    @echo "perf_test/ is untracked in the main repo history - copy it into ./clone manually first."
    @echo "Then, from inside clone/perf_test:"
    @echo "  cargo run --profile rdebug --bin make_assets"
    @echo "  RUNS=5 tools/matrix.sh \\"
    @echo "    \"svg|--mode images --count 12 --image-file shapes.svg  --image-cell 200 --repaint-buffer new\" \\"
    @echo "    \"png|--mode images --count 12 --image-file medium.png  --image-cell 200 --repaint-buffer new\""

clean:
    rm -rf clone
