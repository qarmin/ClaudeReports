import { ListView, Palette } from "std-widgets.slint";
import { AddButtons, Logic, RecordItem, RecordRow } from "shared.slint";

export component ListModePage inherits VerticalLayout {
    in property <[RecordItem]> records;
    in-out property <length> scroll-y <=> list-view.content-y;

    spacing: 6px;

    HorizontalLayout {
        spacing: 12px;

        AddButtons {
            add(count) => {
                Logic.add-records(count);
            }
            clear => {
                Logic.clear-records();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "ListView (virtualized) - " + root.records.length + " records";
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    list-view := ListView {
        vertical-stretch: 1;

        for record[index] in root.records: RecordRow {
            variant: index;
            record: record;
            alternate: mod(index, 2) == 0;
        }
    }
}
