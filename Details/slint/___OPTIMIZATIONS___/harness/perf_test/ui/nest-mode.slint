import { Palette } from "std-widgets.slint";

// Generated: Slint components cannot recurse, so every nesting depth is written out.
// `Layout<N>` wraps the leaf in N VerticalLayouts (each level asks its child for
// layout-info); `Plain<N>` wraps it in N Rectangles with explicit geometry (each level is
// just one more item for the renderer and the hit test to visit).

component Layout0 inherits Rectangle {
    in property <color> tint;
    background: transparent;
    Rectangle {
        background: root.tint;
        border-radius: 2px;
        border-width: 1px;
        border-color: Palette.border;
    }
}

