import { Button, CheckBox, Palette } from "std-widgets.slint";
import { Logic, PerfMode, RecordItem, Settings } from "shared.slint";
import { TextModePage } from "text-mode.slint";
import { ListModePage } from "list-mode.slint";
import { ScrollModePage } from "scroll-mode.slint";
import { RectModePage } from "rect-mode.slint";
import { ImageModePage } from "image-mode.slint";
import { NestModePage } from "nest-mode.slint";
import { LayoutModePage } from "layout-mode.slint";

export { Logic, PerfMode, RecordItem, Settings }

export component MainWindow inherits Window {
    in-out property <PerfMode> mode: PerfMode.text;
    in-out property <string> text-content;
    in property <[RecordItem]> records;
    in-out property <length> scroll-y;
    /// `text` mode: lay the document out with `wrap: word-wrap` instead of `no-wrap`.
    in-out property <bool> word-wrap;
    in property <int> rect-count: 1000;
    in property <bool> rect-gradient;
    in property <image> image-source;
    in property <[image]> image-sources;
    in property <bool> image-distinct;
    in property <length> image-cell: 68px;
    in property <int> layout-children: 4;
    in property <int> layout-kind;
    in property <bool> rect-use-path;
    in property <bool> layout-stretch;
    in property <bool> image-rescale;
    in property <bool> image-tiling;
    in property <ImageFit> image-fit: ImageFit.fill;
    in property <int> nest-depth: 1;
    in property <bool> nest-use-layout: true;
    in property <float> rect-opacity: 1.0;
    in property <length> rect-radius: 3px;
    in property <length> rect-border: 1px;
    in property <bool> rect-show-extra;
    in property <int> rect-extra-count;
    in property <bool> rect-animate;
    in property <bool> rect-animate-color;
    in property <float> rect-item-alpha: -1.0;
    in property <int> rect-animate-count: 1000000;
    in property <bool> rect-shadow;
    in property <string> status;
    in property <string> backend-info;

    title: "Slint perf test - " + root.backend-info;
    preferred-width: 1280px;
    preferred-height: 860px;
    background: Palette.background;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Button {
                text: "1 - TextArea";
                primary: root.mode == PerfMode.text;
                clicked => {
                    root.mode = PerfMode.text;
                }
            }

            Button {
                text: "2 - ListView";
                primary: root.mode == PerfMode.list;
                clicked => {
                    root.mode = PerfMode.list;
                }
            }

            Button {
                text: "4 - Rects";
                primary: root.mode == PerfMode.rects;
                clicked => {
                    root.mode = PerfMode.rects;
                }
            }

            Button {
                text: "3 - ScrollView";
                primary: root.mode == PerfMode.scroll;
                clicked => {
                    root.mode = PerfMode.scroll;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: "renderer: " + root.backend-info;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            repaint-check := CheckBox {
                text: "force repaint";
            }

            // Reading animation-tick() keeps the animation driver alive, so the
            // whole window is re-rendered every frame - that is what makes the
            // renderer show up in a profile instead of an idle event loop.
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Palette.accent-background;
                opacity: repaint-check.checked ? 0.25 + 0.75 * abs(sin(360deg * animation-tick() / 1s)) : 1.0;
            }
        }

        if root.mode == PerfMode.text: TextModePage {
            vertical-stretch: 1;
            text <=> root.text-content;
            scroll-y <=> root.scroll-y;
            word-wrap <=> root.word-wrap;
        }

        if root.mode == PerfMode.list: ListModePage {
            vertical-stretch: 1;
            records: root.records;
            scroll-y <=> root.scroll-y;
        }

        if root.mode == PerfMode.scroll: ScrollModePage {
            vertical-stretch: 1;
            records: root.records;
            scroll-y <=> root.scroll-y;
        }

        if root.mode == PerfMode.nest: NestModePage {
            vertical-stretch: 1;
            count: root.rect-count;
            depth: root.nest-depth;
            use-layout: root.nest-use-layout;
            scroll-y <=> root.scroll-y;
        }

        if root.mode == PerfMode.layouts: LayoutModePage {
            vertical-stretch: 1;
            count: root.rect-count;
            children-count: root.layout-children;
            kind: root.layout-kind;
            stretch: root.layout-stretch;
            scroll-y <=> root.scroll-y;
        }

        if root.mode == PerfMode.images: ImageModePage {
            vertical-stretch: 1;
            count: root.rect-count;
            shared-source: root.image-source;
            sources: root.image-sources;
            distinct: root.image-distinct;
            rescale: root.image-rescale;
            tiling: root.image-tiling;
            cell-width: root.image-cell;
            cell-height: root.image-cell;
            fit: root.image-fit;
            scroll-y <=> root.scroll-y;
        }

        if root.mode == PerfMode.rects: RectModePage {
            vertical-stretch: 1;
            item-opacity: root.rect-opacity;
            item-radius: root.rect-radius;
            item-border: root.rect-border;
            show-extra: root.rect-show-extra;
            extra-count: root.rect-extra-count;
            animate: root.rect-animate;
            animate-color: root.rect-animate-color;
            item-alpha: root.rect-item-alpha;
            use-path: root.rect-use-path;
            animate-count: root.rect-animate-count;
            count: root.rect-count;
            gradient: root.rect-gradient;
            item-shadow: root.rect-shadow;
            scroll-y <=> root.scroll-y;
        }

        Text {
            text: root.status;
            color: Palette.foreground;
        }
    }
}
