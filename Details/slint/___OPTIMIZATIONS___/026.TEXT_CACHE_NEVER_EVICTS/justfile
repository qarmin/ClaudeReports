# Self-contained reproduction for this candidate, given the whole ___OPTIMIZATIONS___ folder is
# kept together - see ../README.md's "Reproducing a candidate standalone" section: `perf_test` is
# untracked in the main repo, so `clone:` copies it in from ../harness/perf_test.
#
# patch.diff here is a fresh re-derivation (2026-08-25) of this candidate's fix, not the original
# session's bytes - see RESULT.md's note on why the original patch was never saved. It bounds
# `TextLayoutCache` at 1024 entries (~4.8 MB) instead of never evicting.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone, build a BASELINE binary (unbounded cache) before touching anything, apply
# the patch, build a PATCHED binary (bounded cache), then run both and print both results.
test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

build-baseline:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test
    cp clone/target/rdebug/perf_test ./perf_test_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test
    cp clone/target/rdebug/perf_test ./perf_test_patched

# RESULT.md/FIX.md's headline: RSS after the last frame, layout rows (3 Text items/row), 60000
# rows - originally 917.4MB unbounded vs 304.5MB bounded (-67%).
bench:
    @echo "=== baseline (TextLayoutCache never evicts) ==="
    ./perf_test_baseline --bench --mode scroll --count 60000 --row-style layout --frames 10
    @echo "=== patched (bounded at 1024 entries) ==="
    ./perf_test_patched --bench --mode scroll --count 60000 --row-style layout --frames 10

clean:
    rm -rf clone perf_test_baseline perf_test_patched
