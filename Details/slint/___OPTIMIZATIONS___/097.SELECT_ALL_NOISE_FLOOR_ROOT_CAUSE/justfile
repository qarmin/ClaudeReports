# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# This is an investigation candidate (root-causing IDEAS.md's "select-all noise floor" entry, not
# a timing candidate) - `bench` here runs the diagnostic trace and the repeat-sampled pixel
# comparison, not a performance benchmark. `patch.diff` against the real Slint source is empty -
# this candidate found no product-source bug at all; the finding is entirely about `perf_test`'s
# own status label, and the fix (`bench_status_blank.diff`) is applied directly to `perf_test/`
# (a plain patch, not `git apply` against this clone's tracked source, since `perf_test/` is
# untracked in the main repo).
#
# repo_url/base_commit read via `git remote get-url origin` / `git rev-parse HEAD` in the main
# project, at the moment this candidate was written (same commit as candidate 095/096, no commits
# landed in between).

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit (patch.diff is empty - nothing to apply to tracked
# source), copy perf_test's own harness fix in, build, run the repeat-sampled pixel comparison.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

# patch.diff is empty (no tracked-source change). Kept as a step for consistency with every other
# candidate's justfile shape.
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff" || true

# Applies the harness-only status-label fix directly to perf_test/src/bench.rs (a plain unified
# diff against a file `git apply` against the clone's own tracked history won't touch, since
# perf_test/ is untracked in the main repo - this candidate's diff was captured against the
# checked-out file's own content, not via `git diff`).
apply-harness-fix:
    cd clone/perf_test && patch -p1 < "{{justfile_directory()}}/bench_status_blank.diff"

# Reproduces the noise floor (unpatched) and confirms the fix removes it (patched), 20 repeats
# each, on the harness default scene/frame count.
bench:
    cd clone/perf_test && cargo build --bin perf_test --profile rdebug --features software
    mkdir -p /tmp/097_repro/unpatched
    for r in $(seq 1 20); do \
        ./clone/target/rdebug/perf_test --bench --mode text --count 10000 --type-text \
            --scroll-step 0 --frames 6 --snapshot /tmp/097_repro/unpatched/r$r.ppm >/dev/null; \
    done
    just apply-harness-fix
    cd clone/perf_test && cargo build --bin perf_test --profile rdebug --features software
    mkdir -p /tmp/097_repro/patched
    for r in $(seq 1 20); do \
        ./clone/target/rdebug/perf_test --bench --mode text --count 10000 --type-text \
            --scroll-step 0 --frames 6 --snapshot /tmp/097_repro/patched/r$r.ppm >/dev/null; \
    done
    @echo "Compare /tmp/097_repro/unpatched/*.ppm pairwise (expect ~3700 differing px, rows"
    @echo "839-851) against /tmp/097_repro/patched/*.ppm (expect 0) - see RESULT.md for the"
    @echo "exact comparison approach used."

clean:
    rm -rf clone
