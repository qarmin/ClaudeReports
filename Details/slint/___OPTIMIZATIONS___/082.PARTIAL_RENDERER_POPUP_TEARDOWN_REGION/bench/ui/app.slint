// Standalone bench for candidate 082: does closing a `ChildWindow` popup over a screen full of
// small items force a full-screen redraw (unpatched) or only redraw the popup's own small region
// (patched)?
export component AppWindow inherits Window {
    width: 800px;
    height: 600px;

    in property <int> row-count: 10000;
    property <int> columns: 100;
    property <length> cell-width: root.width / root.columns;
    property <length> cell-height: 6px;

    callback open-popup();
    callback close-popup();

    // A grid of small, always-visible rectangles tiling the whole window - the shape a real UI
    // is mostly made of, and enough of them that redrawing all of them (a forced full-screen
    // refresh) costs measurably more than redrawing only the popup's own small rect.
    for index in root.row-count: Rectangle {
        x: mod(index, root.columns) * root.cell-width;
        y: floor(index / root.columns) * root.cell-height;
        width: root.cell-width - 1px;
        height: root.cell-height - 1px;
        background: mod(index, 2) == 0 ? #3050a0 : #40a050;
    }

    popup := PopupWindow {
        x: 350px;
        y: 250px;
        width: 100px;
        height: 100px;
        close-policy: no-auto-close;
        Rectangle {
            background: #d02020;
        }
    }

    open-popup => {
        popup.show();
    }
    close-popup => {
        popup.close();
    }
}
