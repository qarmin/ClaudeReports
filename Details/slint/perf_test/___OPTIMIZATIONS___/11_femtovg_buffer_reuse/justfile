harness := justfile_directory() + "/../.."
bin := justfile_directory() + "/../../../target/rdebug/perf_test"

# Allocations per frame with the buffer reuse in place (this is the metric; times need a GPU)
run: build
    {{ bin }} --mode rects --count 3000 --frames 8
    {{ bin }} --mode rects --count 3000 --gradient --frames 8
    {{ bin }} --mode list --count 100000 --frames 8

run-xvfb: build
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode rects --count 3000 --frames 8
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode list --count 100000 --frames 8

# Revert the whole femtovg-side experiment (candidates 06 + 11) and rebuild, to compare
revert:
    cd {{ harness }}/.. && git checkout internal/renderers/femtovg/itemrenderer.rs Cargo.toml \
        examples/Cargo.toml demos/Cargo.toml tests/Cargo.toml
    cd {{ harness }}/../femtovg && git checkout src/path.rs src/path/cache.rs
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test

build:
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test
