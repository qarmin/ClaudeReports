harness := justfile_directory() + "/../.."
bin := justfile_directory() + "/../../../target/rdebug/perf_test"

build:
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test

# The four row variants, software renderer (no display needed)
run: build
    #!/usr/bin/env bash
    for style in layout flat clipped bare; do
        printf "%-8s " $style
        {{ bin }} --bench --mode scroll --count 100000 --row-style $style --frames 5 |
            awk '/^first frame/{f=$3} /^later frames/{printf "first=%-9s later=%-9s allocs=%s\n", f, $3, $7}'
    done

# Same on the real display
run-gpu: build
    #!/usr/bin/env bash
    for style in layout flat clipped bare; do
        printf "%-8s " $style
        {{ bin }} --mode scroll --count 100000 --row-style $style --frames 20 |
            awk '/^later frames/{printf "later=%-9s allocs=%s\n", $3, $7}'
    done
