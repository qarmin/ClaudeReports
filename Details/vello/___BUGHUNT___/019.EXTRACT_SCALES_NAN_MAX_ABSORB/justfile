# Self-contained reproduction for candidate 019 (vello_common::util::extract_scales silently
# absorbing a NaN scale_y into the arbitrary 1e-6 floor for near-singular affine transforms).
#
# `repo_url`/`base_commit` were read via `git remote get-url origin` / `git rev-parse HEAD` in the
# main project at investigation time.
#
# Note: this environment's git-lfs binary may be missing from PATH in some shells, which makes a
# plain `git clone`/`git checkout` of this repo fail on its LFS-tracked PNG test snapshots. The
# repro below never touches those files, so the clone step disables the LFS filter outright
# (`-c filter.lfs.*`) to stay robust regardless of whether git-lfs is installed/on PATH on the
# machine running this.

# https (not the ssh form `git remote get-url origin` actually returns) so `just clone` works
# without an ssh key/agent configured.
repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists (exit 1), apply the fix, prove it's gone (exit 0).
# `reproduce-before` deliberately exits 1 to signal "bug present" - prefixed with `-` so this
# recipe keeps going into `apply`/`reproduce-after` instead of stopping there.
test:
    just clone
    -just reproduce-before
    just apply
    just reproduce-after

clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - exits 1, printing which near-singular
# transforms collapsed scale_y to the arbitrary 1e-6 floor instead of their true small value.
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - exits 0, scale_y now matches the
# transform-specific value instead of the floor.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
