# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# What this demonstrates: `vello_shaders::cpu::clip_leaf` (the CPU-shader shim used whenever
# `RendererOptions::use_cpu` is `true`) does `stack.pop().unwrap()` for every `EndClip` entry in
# `clip_inp`, with no check that a matching `BeginClip` was ever pushed. `Encoding`'s own public
# API (`encode_begin_clip`/`encode_end_clip`) always keeps `BeginClip`/`EndClip` balanced, but
# `vello::Scene::encoding_mut()` - a real, documented public escape hatch ("this can be used to
# more easily create invalid scenes") - lets a caller append a raw `EndClip` draw tag with no
# matching `BeginClip`, which then panics deep in the CPU-shim pipeline instead of being rejected
# up front or degrading gracefully the way the real GPU/WGSL shader does for the same condition
# (out-of-range storage-buffer reads are silently clamped by wgpu/naga on GPU, not UB).
#
# This machine has no real GPU: point VK_ICD_FILENAMES at a software Vulkan ICD (e.g. Google's
# SwiftShader) to get a real wgpu::Device without real GPU hardware. Any real GPU backend
# (Vulkan/Metal/DX12/GL) exercises the exact same GPU/CPU-shim dispatch code in vello_shaders; on
# a machine with a real GPU, VK_ICD_FILENAMES can simply be dropped (or WGPU_BACKEND unset to let
# wgpu pick the first working backend).

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

export WGPU_BACKEND := "vulkan"

# Full cycle: clone pristine, prove the bug exists (both repro shapes), apply the fix, prove it's
# gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run both standalone repro binaries against the pristine clone (expected: both panic at
# vello_shaders/src/cpu/clip_leaf.rs:59, "called `Option::unwrap()` on a `None` value").
# Requires VK_ICD_FILENAMES to point at a working Vulkan ICD if there's no real GPU (see header
# comment above) - e.g.:
#   VK_ICD_FILENAMES=/path/to/vk_swiftshader_icd.json just test
reproduce-before:
    cd repro && cargo run --release --bin clip_underflow
    cd repro && cargo run --release --bin clip_underflow_variant2

apply:
    cd clone && git apply ../patch.diff

# Re-run both repro binaries against the patched clone. Expected: neither panics any more
# ("rendered OK, no panic" for both).
reproduce-after:
    cd repro && cargo run --release --bin clip_underflow
    cd repro && cargo run --release --bin clip_underflow_variant2

clean:
    rm -rf clone repro/target repro/Cargo.lock
