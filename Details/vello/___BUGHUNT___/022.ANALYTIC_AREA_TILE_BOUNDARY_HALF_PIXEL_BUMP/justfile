# Self-contained reproduction for candidate 022.
#
# Status is "Not reproducible" (as the specific hypothesis stated: a per-tile-boundary
# discontinuity in the analytic coverage computation reused across adjacent tiles). There is no
# patch.diff - see RESULT.md. `just test` clones the repo at base_commit and runs `repro/`, which
# demonstrates that the real, visually-observable artifact (referenced in
# https://github.com/linebender/vello/issues/1556) is present, but that its magnitude is
# completely independent of alignment to the 4px tile grid - directly refuting the "reused across
# adjacent tiles" mechanism this candidate set out to check, and consistent with it instead being
# an ordinary "conflation artifact" from compositing two independently-antialiased shapes at a
# concave junction (as vello's own maintainers already concluded on that issue).

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone. Prints two tests: (1) sweeps a
# concave wall-junction's position across sub-pixel offsets AND across every offset relative to
# the 4px tile grid, comparing a single-path "ground truth" render against the same shape built
# from two independently-composited rects; (2) checks a single path's own coverage is
# byte-identical across many tile-row boundaries. Ends by printing an explicit RESULT line.
reproduce:
    cd repro && cargo run --release

clean:
    rm -rf clone
