# Self-contained reproduction for this candidate.
#
# Status: Not reproducible - no patch.diff, so this justfile only has a reproduce step (no
# apply/reproduce-after). See RESULT.md for the full analysis.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

test: clone reproduce

# git-lfs filters are disabled below (-c filter.lfs.*) so this clone works even when the
# `git-lfs` binary isn't installed - none of the LFS-tracked assets in the main repo are needed
# to build/run this repro, which only depends on glifo/vello_cpu/vello_common's Rust source.
clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.clean=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.clean=cat -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone at base_commit - demonstrates that
# rendering glyph 8 of the malformed (zero-stop ColorLine) test font does NOT panic.
reproduce:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
