# Self-contained reproduction for candidate 062
# (GLIFO_UNWRAP_EXPECT_SWEEP_CONTINUATION).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# NOTE: unlike most candidates in this workspace, this bug is gated
# `#[cfg(all(debug_assertions, feature = "std"))]` - it only exists (and only panics) in a
# *debug* build, so `reproduce-before`/`reproduce-after` intentionally use plain `cargo run`
# (debug profile), not `cargo run --release`.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro (debug build) against the pristine clone - should panic.
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again (debug build), now against the patched clone - should no longer panic.
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
