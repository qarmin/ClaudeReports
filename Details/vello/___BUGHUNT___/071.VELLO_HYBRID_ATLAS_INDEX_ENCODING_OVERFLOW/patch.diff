             .initial_atlas_count
@@ -643,6 +646,15 @@ pub(crate) fn pack_image_offset(x: u16, y: u16) -> u32 {
     ((x as u32) << 16) | (y as u32)
 }
 
+/// Maximum number of atlases addressable by [`pack_image_params`]'s 8-bit `atlas_index` field.
+///
+/// [`MemorySettings::normalize`] must clamp `max_atlases` to this value in addition to whatever
+/// the device itself reports, since a real device's `max_texture_array_layers` commonly exceeds
+/// this (e.g. wgpu's own conservative default is exactly 256, but many real adapters report much
+/// more - 2048 is common) - so relying on the device limit alone is not sufficient to keep
+/// `atlas_index` within its 8-bit encoding.
+pub(crate) const MAX_ATLASES_SUPPORTED_BY_ENCODING: usize = 256;
+
 /// Pack image `quality`, extend modes, `atlas_index`, and source type into a single u32.
 /// `is_external`: stored in bit 14
 /// `atlas_index`: stored in bits 6-13 (8 bits, supports up to 256 atlases)
@@ -660,7 +672,10 @@ pub(crate) fn pack_image_params(
     debug_assert!(extend_x <= 3, "extend_x must be 0-3 (2 bits)");
     debug_assert!(extend_y <= 3, "extend_y must be 0-3 (2 bits)");
     debug_assert!(quality <= 3, "quality must be 0-3 (2 bits)");
-    debug_assert!(atlas_index <= 255, "atlas_index must be 0-255 (8 bits)");
+    debug_assert!(
+        atlas_index < MAX_ATLASES_SUPPORTED_BY_ENCODING as u32,
+        "atlas_index must be 0-255 (8 bits)"
+    );
     (u32::from(is_external) << 14)
         | (atlas_index << 6)
         | (extend_y << 4)
