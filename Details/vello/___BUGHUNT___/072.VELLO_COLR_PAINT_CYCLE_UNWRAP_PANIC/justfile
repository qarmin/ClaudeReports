# Self-contained reproduction for candidate 072 (VELLO_COLR_PAINT_CYCLE_UNWRAP_PANIC).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
# `reproduce-before` is prefixed with `-` because the repro intentionally exits non-zero when the
# bug is present (see repro/src/main.rs's exit code convention) - without it, `just`'s
# fail-fast default would stop the chain right after demonstrating the bug and never reach
# `apply`/`reproduce-after`.
#
# NOTE: this repo has `vello_tests/snapshots/*.png` and
# `sparse_strips/vello_sparse_tests/snapshots/*.png` marked `filter=lfs required=true`, but
# `git-lfs` is not assumed to be installed - `clone` disables the LFS filter so a plain clone
# still succeeds (this candidate's repro never touches those paths anyway).
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git config filter.lfs.smudge cat && git config filter.lfs.process "" && git config filter.lfs.required false
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug (classic
# vello's real Scene::draw_glyphs(..).draw(..) panics on a real COLRv1 font's deliberately
# cyclic PaintColrGlyph glyph).
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic for any glyph.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
