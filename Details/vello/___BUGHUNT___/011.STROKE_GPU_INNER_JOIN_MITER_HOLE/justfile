# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This machine has no real GPU: the repro uses wgpu's GL backend with Mesa's llvmpipe software
# rasterizer (WGPU_BACKEND=gl, LIBGL_ALWAYS_SOFTWARE=1). Any real GPU backend (Vulkan/Metal/DX12)
# exercises the exact same compute-shader stroke-expansion code path in vello_shaders, so on a
# machine with a real GPU these two env vars can simply be dropped.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

export WGPU_BACKEND := "gl"
export LIBGL_ALWAYS_SOFTWARE := "1"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

# The `-c filter.lfs.*` overrides make this work even when `git-lfs` isn't installed on the
# machine running `just test` - the repo declares LFS filters for its test-snapshot PNGs (see
# .gitattributes), which this candidate's repro never touches, so it's safe to just let those
# come through as inert pointer text instead of requiring a git-lfs install.
clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false \
        clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false \
        checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (nonzero exit code, "REPRODUCED" printed). The leading `-` tells `just` not to abort the `test`
# chain on this recipe's expected-nonzero exit code (see repro/src/main.rs's own exit code
# convention: 0 = did not reproduce, non-zero = reproduced).
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug
# (exit code 0, "did not reproduce" printed).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
