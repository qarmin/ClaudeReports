+// Draws the "inner" (concave) side of a join.
+//
+// A plain straight connector between `inner0` and `inner1` can self-intersect with the offset
+// curves of the two adjoining segments (this is the "weak correctness" stroke model - see
+// https://github.com/linebender/vello/issues/1063 and the never-merged "Add inner joins" commits
+// on the `paper-revisions` branch, which this is adapted from). Filling that self-intersecting
+// outline with the nonzero winding rule can then locally cancel out to zero exactly where the
+// inner join's own geometry overlaps the interior of an adjoining segment, punching an
+// unintended hole in the stroke. Drawing the two straight edges *twice* contributes zero net
+// winding on their own (each edge's contribution cancels against its own duplicate), and the
+// additional arc wound in the opposite direction exactly cancels whatever spurious coverage the
+// straight connector would otherwise have produced, without needing to compute the actual
+// self-intersection point.
+fn draw_inner_join(
+    path_ix: u32, p0: vec2f, inner0: vec2f, inner1: vec2f, cr: f32, d: f32, transform: Transform,
+) {
+    if abs(cr) < TANGENT_THRESH {
+        // Smooth (near-collinear) join: the inner offset lines already meet almost exactly.
+        if any(inner0 != inner1) {
+            output_line_with_transform(path_ix, inner0, inner1, transform);
+        }
+    } else {
+        let line_ix = atomicAdd(&bump.lines, 4u);
+        write_line_with_transform(line_ix, path_ix, inner0, p0, transform);
+        write_line_with_transform(line_ix + 1u, path_ix, p0, inner1, transform);
+        write_line_with_transform(line_ix + 2u, path_ix, inner0, p0, transform);
+        write_line_with_transform(line_ix + 3u, path_ix, p0, inner1, transform);
+        flatten_arc(path_ix, inner1, inner0, p0, -abs(atan2(cr, d)), transform);
+    }
+}
