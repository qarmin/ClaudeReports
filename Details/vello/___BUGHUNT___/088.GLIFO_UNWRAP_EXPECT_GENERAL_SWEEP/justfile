# Self-contained verification for candidate 088 (GLIFO_UNWRAP_EXPECT_GENERAL_SWEEP).
# Status: Not reproducible (no new bug - this bug class was already exhaustively swept by
# candidates 062/070/080, see RESULT.md). No patch.diff exists for this candidate, so this
# justfile only has a `reproduce-before` step (per the template's own instructions for that case).
#
# repo_url/base_commit were read via `git remote get-url origin` / `git rev-parse HEAD` in the
# main project at investigation time.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Re-runs the exact static sweep (grep + pedantic clippy pass) this candidate performed against
# a pristine clone. Prints the same 5 unwrap/expect call sites and same clippy warning set
# recorded in output.txt - demonstrates there is no new, unaccounted-for site to find.
reproduce-before:
    #!/usr/bin/env bash
    set -euo pipefail
    cd clone
    echo "=== unwrap/expect ==="
    grep -rn '\.unwrap()\|\.expect(' glifo/src
    echo "=== clippy pedantic pass ==="
    cargo clippy -p glifo --no-deps --all-targets --all-features -- \
        -W clippy::unwrap_used -W clippy::expect_used -W clippy::indexing_slicing \
        -W clippy::panic -W clippy::unreachable -W clippy::todo

clean:
    rm -rf clone
