# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Status for this candidate is "Not reproducible" (see RESULT.md) - there is no patch.diff, so
# this only proves the repro's own claim: on this machine/toolchain, the reporter's exact scene
# renders correctly (no stray pixels outside the stroked rect's outline) through vello's real
# public rendering API. It does NOT prove the bug doesn't exist on the reporter's own hardware/
# driver - see RESULT.md's "What was tried" for why a real GPU/Vulkan backend wasn't available
# to test against in this session.
#
# Note: if this environment's git-lfs binary is missing, a plain `git clone`/`git checkout` of
# this repo fails on its LFS-tracked PNG test snapshots. The repro below never touches those
# files, so the clone step disables the LFS filter outright (`-c filter.lfs.*`) to stay robust
# regardless of whether git-lfs is installed on the machine running this.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Build+run the standalone repro against a pristine clone at base_commit.
test: clone reproduce-before

clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
