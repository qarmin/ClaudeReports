+    // `robust: false` to avoid also capturing the larger `debug_layers`-only buffers, which
+    // nothing here consumes via `take_captured_buffers` (leaving them uncollected would panic
+    // `Render`'s own `Drop` impl when the `debug_layers` feature is enabled).
+    let mut recording = render.render_encoding_coarse(
+        encoding,
+        resolver,
+        shaders,
+        image_atlas,
+        params,
+        download_bump,
+        false,
+    );
     let out_image = render.out_image();
+    let bump_buf = download_bump.then(|| render.bump_buf());
     render.record_fine(shaders, &mut recording);
-    (recording, out_image.into())
+    (recording, out_image.into(), bump_buf)
 }
 
