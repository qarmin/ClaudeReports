 /// Create a single recording with both coarse and fine render stages.
 ///
 /// This function is not recommended when the scene can be complex, as it does not
-/// implement robust dynamic memory.
+/// implement robust dynamic memory (i.e. it cannot grow buffers and re-render if a coarse
+/// stage overflows a fixed-size intermediate buffer).
+///
+/// If `download_bump` is set, the small `BumpAllocators` summary buffer is also marked for CPU
+/// readback (see the returned `BufferProxy`), so a caller can at least detect that an overflow
+/// happened and some or all of the scene was not drawn, rather than silently observing an
+/// incomplete image with `Ok(())`. See <https://github.com/linebender/vello/issues/720>.
+///
+/// `download_bump` must be `false` when this render uses the CPU-shader dispatch path
+/// (`RendererOptions::use_cpu`): CPU-dispatched shaders' buffers are never materialized as a
+/// real `wgpu::Buffer` in the engine's bind map (they're resolved directly to host memory
+/// instead), so marking one for a GPU-side download command fails outright.
 pub(crate) fn render_encoding_full(
     encoding: &Encoding,
     resolver: &mut Resolver,
     shaders: &FullShaders,
     image_atlas: &mut Option<ImageProxy>,
     params: &RenderParams,
