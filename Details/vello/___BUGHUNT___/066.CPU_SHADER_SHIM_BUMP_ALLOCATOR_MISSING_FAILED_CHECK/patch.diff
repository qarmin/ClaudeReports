diff --git a/vello_shaders/src/cpu/util.rs b/vello_shaders/src/cpu/util.rs
index ec801ebe..f008a571 100644
--- a/vello_shaders/src/cpu/util.rs
+++ b/vello_shaders/src/cpu/util.rs
@@ -226,3 +226,15 @@ pub(crate) const ONE_MINUS_ULP: f32 = 0.99999994;
 /// direction. The theory is that a is not off by more than a few ulp, and it's
 /// always in the range of 0..1.
 pub(crate) const ROBUST_EPSILON: f32 = 2e-7;
+
+/// Bitflags for each stage that can fail bump allocation.
+///
+/// Mirrors the `STAGE_*` constants in `shader/shared/bump.wgsl`. On the GPU path, a shader that
+/// would overflow one of the fixed-capacity bump-allocated buffers (`vello_encoding`'s
+/// `BufferSizes::new`) instead resets its own claimed offset to 0 and ORs its stage's bit into
+/// `BumpAllocators::failed`, relying on wgpu/naga's storage-buffer bounds checks to make the
+/// resulting writes a silent (wrong-but-safe) clamp rather than a crash. The CPU shader shim has
+/// no such implicit bounds check, so it must reset the offset *and* explicitly guard the
+/// resulting writes itself.
+pub(crate) const STAGE_BINNING: u32 = 0x1;
+pub(crate) const STAGE_TILE_ALLOC: u32 = 0x2;
