# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Needs a real (possibly software) Vulkan adapter reachable by wgpu. Set VK_ICD_FILENAMES to a
# usable Vulkan ICD if there is no real GPU available (e.g. Google's SwiftShader CPU
# implementation - see this workspace's own README.md for how this session obtained one).
#
# NOTE: this repo's `.gitattributes` marks the snapshot-test reference PNGs as `git-lfs`-tracked;
# a `git-lfs`-less environment will still `clone` fine (git-lfs pointer stubs are plain text
# files, not real images) but cannot use those particular snapshot tests - irrelevant here, this
# candidate's own repro never touches them.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    # The `-c filter.lfs.*` overrides let this clone/checkout succeed without a working
    # `git-lfs` install (this candidate never touches the LFS-tracked snapshot PNGs, so a
    # no-op smudge filter is fine).
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false \
        clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false \
        checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates the panic.
# `before.rs` is written against the PRE-fix `upload_image` signature (bare `ImageId`, panics
# internally on atlas exhaustion) and only compiles against a pristine `./clone`.
reproduce-before:
    cd repro && cargo run --release --bin before

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same scenario again, now against the patched clone - `after.rs` is written against the
# POST-fix signature (`Result<ImageId, RenderError>`) and only compiles against a patched
# `./clone`, so it must be run separately from `before.rs`.
reproduce-after:
    cd repro && cargo run --release --bin after

clean:
    rm -rf clone
