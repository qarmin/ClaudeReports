@@ -131,6 +131,17 @@ pub enum RenderError {
     /// An intermediate texture allocation failed.
     #[error(transparent)]
     IntermediateTexture(#[from] IntermediateTextureError),
+    /// The scene's layer graph could not be scheduled within a bounded number of rendering
+    /// rounds.
+    ///
+    /// This indicates an extremely large or deeply/widely nested layer graph combined with a
+    /// small intermediate texture size, such that the scheduler could not find a compatible
+    /// round for some operation within `max_rounds` attempts.
+    #[error("scene requires more than {max_rounds} scheduling rounds")]
+    SchedulingLimitExceeded {
+        /// The maximum number of scheduling rounds the scheduler is willing to consider.
+        max_rounds: usize,
+    },
     // TODO: Consider expanding `RenderError` to replace some `.unwrap` and `.expect`.
 }
 
