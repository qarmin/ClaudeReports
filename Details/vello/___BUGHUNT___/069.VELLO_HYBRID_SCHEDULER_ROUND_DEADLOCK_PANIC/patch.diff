diff --git a/sparse_strips/vello_hybrid/src/schedule/schedule_tests.rs b/sparse_strips/vello_hybrid/src/schedule/schedule_tests.rs
index bbae1a2d..5d7d154b 100644
--- a/sparse_strips/vello_hybrid/src/schedule/schedule_tests.rs
+++ b/sparse_strips/vello_hybrid/src/schedule/schedule_tests.rs
@@ -916,3 +916,16 @@ fn blend_is_constrained_to_parent_clip_bbox() {
     // This must not panic.
     let _ = crate::blend::GpuBlendInstance::new(blend, None, SizeU16::new(64));
 }
+
+#[test]
+fn deadlock_probe() {
+    const CHILDREN: usize = 3;
+    let depth = 11_usize;
+    let mut case = SceneCase::new(8, 8);
+    add_tree(&mut case, depth, CHILDREN);
+    let result = case.schedule(RootTarget::UserSurface, SizeU16::new(8), 1000, true);
+    assert!(matches!(
+        result,
+        Err(RenderError::SchedulingLimitExceeded { max_rounds: 40_000 })
+    ));
+}
