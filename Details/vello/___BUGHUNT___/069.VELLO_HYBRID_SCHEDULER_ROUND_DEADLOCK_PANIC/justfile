# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Needs a real (possibly software) Vulkan adapter reachable by wgpu. Set VK_ICD_FILENAMES to a
# usable Vulkan ICD if there is no real GPU available (e.g. Google's SwiftShader CPU
# implementation - see this workspace's own README.md for how this session obtained one).

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - a real (software) wgpu Vulkan
# device, driven through vello_hybrid's real public `Renderer::render` entry point with a real
# `Scene` (built via the crate's own public push_layer/pop_layer/fill_rect API) - should panic
# with "possible deadlock in scheduler detected".
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic; `render()` instead
# returns `Err(RenderError::SchedulingLimitExceeded)`.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
