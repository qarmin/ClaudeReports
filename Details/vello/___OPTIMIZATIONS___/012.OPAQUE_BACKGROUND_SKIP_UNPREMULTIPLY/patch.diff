+/// Opaque-background rendering benchmark (candidate 012, PR #1850).
+///
+/// Draws a viewport-covering, fully opaque `fill_rect` first (the pattern the PR detects as a
+/// "root background"), followed by a grid of smaller, semi-transparent rects on top - a scene
+/// shape close to a typical UI screenshot (opaque page background + some translucent overlay
+/// content), so the background is eligible for detection but doesn't cover 100% of the render
+/// commands afterward. Measures both the full `render()` call (which the PR's `RootBackground`
+/// detection also speeds up, by skipping the background's own `fill_rect` command entirely and
+/// filling now-uncovered fine-buffer regions directly with the solid background color instead of
+/// unpacking/zeroing them) and, isolated from `render()`, `take_unpremultiplied()` on the
+/// resulting pixmap (the specific mechanism this candidate targets: skipping per-pixel
+/// unpremultiplication once the whole pixmap is known to be opaque).
+pub fn background(c: &mut Criterion) {
+    if !crate::EXTENDED {
+        return;
+    }
+
+    const VIEWPORT_WIDTH: u16 = 1920;
+    const VIEWPORT_HEIGHT: u16 = 1080;
+
+    fn build_scene(renderer: &mut RenderContext) {
+        renderer.reset();
+        renderer.set_paint(Color::from_rgba8(255, 255, 255, 255));
+        renderer.fill_rect(&Rect::new(
+            0.0,
+            0.0,
+            f64::from(VIEWPORT_WIDTH),
+            f64::from(VIEWPORT_HEIGHT),
+        ));
+
+        for i in 0..40_u32 {
+            let x = f64::from((i * 47) % 1800);
+            let y = f64::from((i * 91) % 1000);
+            renderer.set_paint(Color::from_rgba8(
+                (i * 5 % 255) as u8,
+                (i * 11 % 255) as u8,
+                (i * 17 % 255) as u8,
+                200,
+            ));
+            renderer.fill_rect(&Rect::new(x, y, x + 120.0, y + 120.0));
+        }
+
+        renderer.flush();
+    }
+
+    let mut g = c.benchmark_group("integration/background");
+
+    g.bench_function("render", |b| {
+        let mut renderer = RenderContext::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+        let mut resources = Resources::default();
+        let mut pixmap = Pixmap::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+
+        b.iter(|| {
+            build_scene(&mut renderer);
+            renderer.render(&mut pixmap, &mut resources);
+            std::hint::black_box(&pixmap);
+        });
+    });
+
+    g.bench_function("render_and_take_unpremultiplied", |b| {
+        let mut renderer = RenderContext::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+        let mut resources = Resources::default();
+
+        b.iter(|| {
+            build_scene(&mut renderer);
+            let mut pixmap = Pixmap::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+            renderer.render(&mut pixmap, &mut resources);
+            std::hint::black_box(pixmap.take_unpremultiplied());
+        });
+    });
+
+    // Isolate just the unpremultiply step given an already-rendered pixmap - this reflects
+    // exactly the mechanism this candidate changes (`Pixmap::may_have_transparency`), without
+    // the render-side changes from the same PR mixed in.
+    let mut prebuilt_renderer = RenderContext::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+    let mut prebuilt_resources = Resources::default();
+    build_scene(&mut prebuilt_renderer);
+    let mut prebuilt_pixmap = Pixmap::new(VIEWPORT_WIDTH, VIEWPORT_HEIGHT);
+    prebuilt_renderer.render(&mut prebuilt_pixmap, &mut prebuilt_resources);
+
+    g.bench_function("take_unpremultiplied_only", |b| {
+        b.iter_batched(
+            || prebuilt_pixmap.clone(),
+            |pixmap| std::hint::black_box(pixmap.take_unpremultiplied()),
+            BatchSize::LargeInput,
+        );
+    });
+
+    g.finish();
+}
