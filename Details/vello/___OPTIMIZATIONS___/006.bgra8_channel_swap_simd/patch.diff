+/// Swaps the red and blue channels of each RGBA8 pixel in `data`, converting BGRA8 to RGBA8
+/// (and vice versa, since the swap is its own inverse).
+fn bgra_to_rgba(data: &mut [u8]) {
+    // Unfortunately we need to construct a custom level here and cannot use the one
+    // from the Vello CPU / Vello Hybrid context. This does mean we are not testing
+    // all possible combinations in CI, but the used intrinsics are very simple and
+    // also used in other parts of the pipeline, so risk is very low.
+    let level = Level::try_detect().unwrap_or(Level::baseline());
+
+    dispatch!(level, simd => bgra_to_rgba_impl(simd, data));
+}
+
+#[inline(always)]
+fn bgra_to_rgba_impl<S: Simd>(simd: S, data: &mut [u8]) {
+    let (body, tail) = data.as_chunks_mut::<64>();
+
+    for chunk in body {
+        let bgra = simd.load_interleaved_128_u8x64(chunk);
+        let (bg, ra) = simd.split_u8x64(bgra);
+        let (b, g) = simd.split_u8x32(bg);
+        let (r, a) = simd.split_u8x32(ra);
+
+        let rgba = simd.combine_u8x32(simd.combine_u8x16(r, g), simd.combine_u8x16(b, a));
+        simd.store_interleaved_128_u8x64(rgba, chunk);
+    }
+
+    for pixel in tail.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
+    }
+}
