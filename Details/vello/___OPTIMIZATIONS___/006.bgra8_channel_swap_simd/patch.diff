+/// Benches [`ImageSource::from_peniko_image_data`]'s BGRA8 -> RGBA8 channel swap, which
+/// runs once per loaded/decoded image (e.g. every `image::open` result fed into a scene).
+pub fn bgra_to_rgba(c: &mut Criterion) {
+    let pixel_count = usize::from(WIDTH) * usize::from(HEIGHT);
+    let bgra = OPAQUE_BLUE.repeat(pixel_count);
+
+    let mut group = c.benchmark_group("pixmap/bgra_to_rgba");
+    group.bench_function("swap", |b| {
+        b.iter_batched(
+            || ImageData {
+                data: Blob::from(bgra.clone()),
+                format: ImageFormat::Bgra8,
+                alpha_type: ImageAlphaType::Alpha,
+                width: u32::from(WIDTH),
+                height: u32::from(HEIGHT),
+            },
+            |image_data| black_box(ImageSource::from_peniko_image_data(&image_data)),
+            BatchSize::LargeInput,
+        );
+    });
+    group.finish();
+}
