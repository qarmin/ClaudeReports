diff --git a/sparse_strips/vello_bench/src/hybrid_color_matrix.rs b/sparse_strips/vello_bench/src/hybrid_color_matrix.rs
new file mode 100644
index 00000000..0f74aa87
--- /dev/null
+++ b/sparse_strips/vello_bench/src/hybrid_color_matrix.rs
@@ -0,0 +1,284 @@
+// Copyright 2026 the Vello Authors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Benchmarks for `vello_hybrid`'s GPU `ColorMatrix` filter shader path.
+//!
+//! Requires a real (or software-fallback, e.g. llvmpipe/EGL) `wgpu` adapter; gated behind the
+//! `hybrid` feature since it pulls in `vello_hybrid` + `wgpu` + `pollster`.
+
+use criterion::Criterion;
+use pollster::block_on;
+use vello_common::filter_effects::{Filter, FilterPrimitive, matrices};
+use vello_common::kurbo::Rect;
+use vello_common::peniko::color::{AlphaColor, Srgb};
+use vello_hybrid::{RenderSize, RenderTargetConfig, Renderer, Resources, Scene, TextureBindings};
+
+const WIDTH: u16 = 2048;
+const HEIGHT: u16 = 2048;
+
+struct GpuContext {
+    device: wgpu::Device,
+    queue: wgpu::Queue,
+    texture: wgpu::Texture,
+    texture_view: wgpu::TextureView,
+    depth_view: wgpu::TextureView,
+    renderer: Renderer,
+    resources: Resources,
+}
+
+fn init_gpu() -> Option<GpuContext> {
+    let instance = wgpu::Instance::default();
+    let adapter = block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
+        power_preference: wgpu::PowerPreference::default(),
+        force_fallback_adapter: false,
+        compatible_surface: None,
+    }))
+    .ok()?;
+    let (device, queue) = block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+        label: Some("vello_bench hybrid device"),
+        required_features: wgpu::Features::empty(),
+        ..Default::default()
+    }))
+    .ok()?;
+
+    let texture = device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("vello_bench render target"),
+        size: wgpu::Extent3d {
+            width: WIDTH.into(),
+            height: HEIGHT.into(),
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba8Unorm,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+        view_formats: &[],
+    });
+    let texture_view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+
+    let (renderer, resources) = Renderer::new(
+        &device,
+        &RenderTargetConfig {
+            format: texture.format(),
+            width: WIDTH.into(),
+            height: HEIGHT.into(),
+        },
+    );
+    let render_size = RenderSize {
+        width: WIDTH.into(),
+        height: HEIGHT.into(),
+    };
+    let depth_view = Renderer::create_depth_texture_view(&device, &render_size);
+
+    Some(GpuContext {
+        device,
+        queue,
+        texture,
+        texture_view,
+        depth_view,
+        renderer,
+        resources,
+    })
+}
+
+/// Build a scene containing a `ColorMatrix` filter layer applied to a varied-color fill,
+/// covering most of the viewport so the fragment shader's per-pixel matrix application
+/// dominates over fixed per-draw overhead.
+fn build_scene(matrix: [f32; 20]) -> Scene {
+    let mut scene = Scene::new(WIDTH, HEIGHT);
+
+    let filter = Filter::from_primitive(FilterPrimitive::ColorMatrix { matrix });
+    scene.push_filter_layer(filter);
+
+    // A handful of overlapping, differently colored rects so the filtered region has real
+    // RGB variance (grayscale/sepia are otherwise indistinguishable from a no-op on a solid fill).
+    let colors = [
+        AlphaColor::<Srgb>::new([0.8, 0.1, 0.1, 1.0]),
+        AlphaColor::<Srgb>::new([0.1, 0.8, 0.1, 1.0]),
+        AlphaColor::<Srgb>::new([0.1, 0.1, 0.8, 1.0]),
+        AlphaColor::<Srgb>::new([0.8, 0.8, 0.1, 1.0]),
+    ];
+    for (i, color) in colors.iter().enumerate() {
+        let offset = f64::from(u16::try_from(i).unwrap()) * 40.0;
+        scene.set_paint(*color);
+        scene.fill_rect(&Rect::new(
+            offset,
+            offset,
+            f64::from(WIDTH) - offset,
+            f64::from(HEIGHT) - offset,
+        ));
+    }
+
+    scene.pop_layer();
+    scene
+}
+
+fn render_once(ctx: &mut GpuContext, scene: &Scene) {
+    let render_size = RenderSize {
+        width: WIDTH.into(),
+        height: HEIGHT.into(),
+    };
+    let mut encoder = ctx
+        .device
+        .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+            label: Some("vello_bench hybrid encoder"),
+        });
+    ctx.renderer
+        .render(
+            scene,
+            &mut ctx.resources,
+            &ctx.device,
+            &ctx.queue,
+            &mut encoder,
+            &render_size,
+            &ctx.texture_view,
+            Some(&ctx.depth_view),
+            &TextureBindings::new(),
+        )
+        .unwrap();
+
+    let bytes_per_row = (u32::from(WIDTH) * 4).next_multiple_of(256);
+    let copy_buffer = ctx.device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("vello_bench hybrid readback"),
+        size: u64::from(bytes_per_row) * u64::from(HEIGHT),
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    encoder.copy_texture_to_buffer(
+        wgpu::TexelCopyTextureInfo {
+            texture: &ctx.texture,
+            mip_level: 0,
+            origin: wgpu::Origin3d::ZERO,
+            aspect: wgpu::TextureAspect::All,
+        },
+        wgpu::TexelCopyBufferInfo {
+            buffer: &copy_buffer,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(bytes_per_row),
+                rows_per_image: None,
+            },
+        },
+        wgpu::Extent3d {
+            width: WIDTH.into(),
+            height: HEIGHT.into(),
+            depth_or_array_layers: 1,
+        },
+    );
+    ctx.queue.submit([encoder.finish()]);
+
+    copy_buffer
+        .slice(..)
+        .map_async(wgpu::MapMode::Read, |result| {
+            result.expect("failed to map readback buffer");
+        });
+    ctx.device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+    drop(copy_buffer.slice(..).get_mapped_range());
+    copy_buffer.unmap();
+}
+
+/// Read back the rendered texture as straight RGBA8, for a correctness/hash check outside the
+/// timed loop (not used by the criterion benches themselves).
+pub fn render_and_read_back(matrix: [f32; 20]) -> (u16, u16, Vec<u8>) {
+    let mut ctx = init_gpu().expect("no wgpu adapter available");
+    let scene = build_scene(matrix);
+    let render_size = RenderSize {
+        width: WIDTH.into(),
+        height: HEIGHT.into(),
+    };
+    let mut encoder = ctx
+        .device
+        .create_command_encoder(&wgpu::CommandEncoderDescriptor { label: None });
+    ctx.renderer
+        .render(
+            &scene,
+            &mut ctx.resources,
+            &ctx.device,
+            &ctx.queue,
+            &mut encoder,
+            &render_size,
+            &ctx.texture_view,
+            Some(&ctx.depth_view),
+            &TextureBindings::new(),
+        )
+        .unwrap();
+
+    let bytes_per_row = (u32::from(WIDTH) * 4).next_multiple_of(256);
+    let copy_buffer = ctx.device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: u64::from(bytes_per_row) * u64::from(HEIGHT),
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    encoder.copy_texture_to_buffer(
+        wgpu::TexelCopyTextureInfo {
+            texture: &ctx.texture,
+            mip_level: 0,
+            origin: wgpu::Origin3d::ZERO,
+            aspect: wgpu::TextureAspect::All,
+        },
+        wgpu::TexelCopyBufferInfo {
+            buffer: &copy_buffer,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(bytes_per_row),
+                rows_per_image: None,
+            },
+        },
+        wgpu::Extent3d {
+            width: WIDTH.into(),
+            height: HEIGHT.into(),
+            depth_or_array_layers: 1,
+        },
+    );
+    ctx.queue.submit([encoder.finish()]);
+    copy_buffer
+        .slice(..)
+        .map_async(wgpu::MapMode::Read, |result| {
+            result.expect("failed to map readback buffer");
+        });
+    ctx.device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+
+    let mut img_data = Vec::with_capacity(usize::from(WIDTH) * usize::from(HEIGHT) * 4);
+    for row in copy_buffer
+        .slice(..)
+        .get_mapped_range()
+        .chunks_exact(bytes_per_row as usize)
+    {
+        img_data.extend_from_slice(&row[0..usize::from(WIDTH) * 4]);
+    }
+    copy_buffer.unmap();
+
+    (WIDTH, HEIGHT, img_data)
+}
+
+/// `ColorMatrix` filter benchmark, comparing a premultiplied-compatible matrix (grayscale,
+/// eligible for the premul fast path) against a matrix that needs the general (unpremultiply
+/// -> apply -> premultiply) path (alpha-to-black, reads the alpha channel into RGB).
+pub fn color_matrix(c: &mut Criterion) {
+    if !crate::EXTENDED {
+        return;
+    }
+
+    let Some(mut ctx) = init_gpu() else {
+        return;
+    };
+
+    let mut g = c.benchmark_group("hybrid_color_matrix");
+
+    let grayscale_scene = build_scene(matrices::GRAYSCALE);
+    g.bench_function("premul_compatible_grayscale", |b| {
+        b.iter(|| render_once(&mut ctx, &grayscale_scene));
+    });
+
+    let sepia_scene = build_scene(matrices::SEPIA);
+    g.bench_function("premul_compatible_sepia", |b| {
+        b.iter(|| render_once(&mut ctx, &sepia_scene));
+    });
+
+    let general_scene = build_scene(matrices::ALPHA_TO_BLACK);
+    g.bench_function("general_alpha_to_black", |b| {
+        b.iter(|| render_once(&mut ctx, &general_scene));
+    });
+}
