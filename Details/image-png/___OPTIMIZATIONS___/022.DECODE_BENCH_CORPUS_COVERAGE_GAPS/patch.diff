+/// This benchmarks decoding every frame of an APNG via repeated `Reader::next_frame` calls - the
+/// animation decode path, which `bench_file` (a single `next_frame` call) does not cover.
+fn bench_apng_file(g: &mut BenchmarkGroup<WallTime>, data: Vec<u8>, name: String) {
+    let mut reader = create_reader(data.as_slice());
+    let num_frames = reader
+        .info()
+        .animation_control()
+        .map(|a| a.num_frames)
+        .unwrap_or(1);
+    let mut image = vec![0; reader.output_buffer_size().unwrap()];
+
+    let mut total_bytes = 0u64;
+    for _ in 0..num_frames {
+        let info = reader.next_frame(&mut image).unwrap();
+        total_bytes += info.buffer_size() as u64;
+    }
+
+    g.throughput(Throughput::Bytes(total_bytes));
+    g.bench_with_input(name, &data, |b, data| {
+        b.iter(|| {
+            let mut reader = create_reader(data.as_slice());
+            for _ in 0..num_frames {
+                reader.next_frame(&mut image).unwrap();
+            }
+        })
+    });
+}
