+/// Generates a synthetic, store-only-compressed grayscale image at `bit_depth` (1, 2, 4, 8 or 16)
+/// - covers the sub-byte and 16-bit decode paths that the 8-bit-only real-file corpus in
+/// `tests/benches/` does not exercise.
+pub fn write_gray_noncompressed_png(w: &mut impl Write, width: u32, height: u32, bit_depth: u8) {
+    write_png_sig(w);
+    write_ihdr(w, width, height, bit_depth, /* color_type = grayscale */ 0, false);
+
+    let max_sample: u32 = (1u32 << bit_depth) - 1;
+    let mut raw = Vec::new();
+    for y in 0..height {
+        raw.push(0u8); // filter = none
+        let row: Vec<u32> = (0..width).map(|x| (x + y) & max_sample).collect();
+        match bit_depth {
+            16 => {
+                for sample in row {
+                    raw.write_u16::<byteorder::BigEndian>(sample as u16)
+                        .unwrap();
+                }
+            }
+            8 => raw.extend(row.iter().map(|&s| s as u8)),
+            _ => {
+                let samples: Vec<u8> = row.iter().map(|&s| s as u8).collect();
+                raw.extend(pack_samples_msb_first(&samples, bit_depth));
+            }
+        }
+    }
+    write_idats_from_raw(w, &raw, usize::MAX);
+    write_iend(w);
+}
+
+/// Generates a synthetic, store-only-compressed palette (indexed-color) image at `bit_depth`
+/// (1, 2, 4 or 8) - covers the sub-byte palette-expansion decode path.
+pub fn write_palette_noncompressed_png(w: &mut impl Write, width: u32, height: u32, bit_depth: u8) {
+    write_png_sig(w);
+    write_ihdr(w, width, height, bit_depth, /* color_type = palette */ 3, false);
+
+    let palette_len = 1usize << bit_depth;
+    let mut palette = Vec::with_capacity(palette_len * 3);
+    for i in 0..palette_len {
+        let v = (i * 255 / (palette_len - 1).max(1)) as u8;
+        palette.extend_from_slice(&[v, 255 - v, v / 2]);
+    }
+    write_chunk(w, b"PLTE", &palette);
+
+    let mut raw = Vec::new();
+    for y in 0..height {
+        raw.push(0u8); // filter = none
+        let samples: Vec<u8> = (0..width)
+            .map(|x| ((x + y) % palette_len as u32) as u8)
+            .collect();
+        raw.extend(pack_samples_msb_first(&samples, bit_depth));
+    }
+    write_idats_from_raw(w, &raw, usize::MAX);
+    write_iend(w);
+}
+
+/// Generates a synthetic, store-only-compressed 16-bit RGB image - covers the 16-bit-per-channel
+/// decode path (byte-swap/sample-widening) that the 8-bit-only real-file corpus does not exercise.
+pub fn write_rgb16_noncompressed_png(w: &mut impl Write, width: u32, height: u32) {
+    write_png_sig(w);
+    write_ihdr(w, width, height, 16, /* color_type = RGB */ 2, false);
+
+    let mut raw = Vec::new();
+    for y in 0..height {
+        raw.push(0u8); // filter = none
+        for x in 0..width {
+            let r = (x * 65535 / width.max(1)) as u16;
+            let g = (y * 65535 / height.max(1)) as u16;
+            let b: u16 = 32768;
+            raw.write_u16::<byteorder::BigEndian>(r).unwrap();
+            raw.write_u16::<byteorder::BigEndian>(g).unwrap();
+            raw.write_u16::<byteorder::BigEndian>(b).unwrap();
+        }
+    }
+    write_idats_from_raw(w, &raw, usize::MAX);
+    write_iend(w);
+}
+
+/// The 7 Adam7 passes as `(x_start, y_start, x_step, y_step)`.
+/// See http://www.libpng.org/pub/png/spec/1.2/PNG-DataRep.html#DR.Interlaced-data-order
+const ADAM7_PASSES: [(u32, u32, u32, u32); 7] = [
+    (0, 0, 8, 8),
+    (4, 0, 8, 8),
+    (0, 4, 4, 8),
+    (2, 0, 4, 4),
+    (0, 2, 2, 4),
+    (1, 0, 2, 2),
+    (0, 1, 1, 2),
+];
+
+/// Generates a synthetic, store-only-compressed Adam7-interlaced RGBA8 image. The `png` crate's
+/// own [`crate::Encoder`] does not support writing interlaced images (see
+/// `FormatErrorKind::InterlacedEncodingUnsupported` in `src/encoder.rs`), so this hand-rolls the
+/// 7-pass sub-image layout instead - this is the only way to get an Adam7 test image other than
+/// lifting one of the tiny (32x32) `basi*.png` files from `tests/pngsuite/`.
+pub fn write_adam7_rgba8_noncompressed_png(w: &mut impl Write, width: u32, height: u32) {
+    write_png_sig(w);
+    write_ihdr(w, width, height, 8, /* color_type = RGBA */ 6, true);
+
+    let mut raw = Vec::new();
+    for (x0, y0, xs, ys) in ADAM7_PASSES {
+        let pass_width = if width > x0 { (width - x0 - 1) / xs + 1 } else { 0 };
+        let pass_height = if height > y0 { (height - y0 - 1) / ys + 1 } else { 0 };
+        for y in 0..pass_height {
+            raw.push(0u8); // filter = none
+            for x in 0..pass_width {
+                let color = ((x0 + x * xs + y0 + y * ys) % 256) as u8;
+                raw.extend_from_slice(&[color, 255 - color, color / 2, 0xff]);
+            }
+        }
+    }
+    write_idats_from_raw(w, &raw, usize::MAX);
+    write_iend(w);
+}
