+/// Writes an acTL chunk (APNG animation control).
+/// See https://wiki.mozilla.org/APNG_Specification#.60acTL.60:_The_Animation_Control_Chunk
+pub fn write_actl(w: &mut impl Write, num_frames: u32, num_plays: u32) {
+    let mut data = Vec::new();
+    data.write_u32::<byteorder::BigEndian>(num_frames).unwrap();
+    data.write_u32::<byteorder::BigEndian>(num_plays).unwrap();
+    write_chunk(w, b"acTL", &data);
+}
+
+/// Writes an fcTL chunk (APNG frame control).
+/// See https://wiki.mozilla.org/APNG_Specification#.60fcTL.60:_The_Frame_Control_Chunk
+#[allow(clippy::too_many_arguments)]
+pub fn write_fctl(
+    w: &mut impl Write,
+    sequence_number: u32,
+    width: u32,
+    height: u32,
+    x_offset: u32,
+    y_offset: u32,
+    delay_num: u16,
+    delay_den: u16,
+    dispose_op: u8,
+    blend_op: u8,
+) {
+    let mut data = Vec::new();
+    data.write_u32::<byteorder::BigEndian>(sequence_number)
+        .unwrap();
+    data.write_u32::<byteorder::BigEndian>(width).unwrap();
+    data.write_u32::<byteorder::BigEndian>(height).unwrap();
+    data.write_u32::<byteorder::BigEndian>(x_offset).unwrap();
+    data.write_u32::<byteorder::BigEndian>(y_offset).unwrap();
+    data.write_u16::<byteorder::BigEndian>(delay_num).unwrap();
+    data.write_u16::<byteorder::BigEndian>(delay_den).unwrap();
+    data.write_u8(dispose_op).unwrap();
+    data.write_u8(blend_op).unwrap();
+    write_chunk(w, b"fcTL", &data);
+}
+
+/// Writes an fdAT chunk (APNG frame data), prefixed with `sequence_number`.
+/// See https://wiki.mozilla.org/APNG_Specification#.60fdAT.60:_The_Frame_Data_Chunk
+pub fn write_fdat(w: &mut impl Write, sequence_number: u32, frame_data: &[u8]) {
+    let mut data = Vec::new();
+    data.write_u32::<byteorder::BigEndian>(sequence_number)
+        .unwrap();
+    data.write_all(frame_data).unwrap();
+    write_chunk(w, b"fdAT", &data);
+}
+
+/// Generates a synthetic APNG with `num_frames` RGBA8 frames of size `width` x `height` - covers
+/// the animation decode path (repeated `next_frame` calls across `IDAT`/`fdAT`), which the
+/// single-frame-only real-file corpus does not exercise at all. The default image doubles as
+/// frame 0 (i.e. `sep_def_img = false`), the common case.
+pub fn write_apng(w: &mut impl Write, width: u32, height: u32, num_frames: u32) {
+    assert!(num_frames >= 1);
+    write_png_sig(w);
+    write_ihdr(w, width, height, 8, /* color_type = RGBA */ 6, false);
+    write_actl(w, num_frames, /* num_plays = */ 0);
+
+    let mut seq = 0u32;
+    write_fctl(w, seq, width, height, 0, 0, 1, 30, 0, 0);
+    seq += 1;
+    write_chunk(
+        w,
+        b"IDAT",
+        &generate_rgba8_with_width_and_height(width, height),
+    );
+
+    for _ in 1..num_frames {
+        write_fctl(w, seq, width, height, 0, 0, 1, 30, 0, 0);
+        seq += 1;
+        write_fdat(
+            w,
+            seq,
+            &generate_rgba8_with_width_and_height(width, height),
+        );
+        seq += 1;
+    }
+
+    write_iend(w);
+}
