+
+/// Writes an IHDR chunk with fully explicit parameters (unlike
+/// [`write_rgba8_ihdr_with_width`], which is fixed to 8-bit RGBA, non-interlaced).
+/// See http://www.libpng.org/pub/png/spec/1.2/PNG-Chunks.html#C.IHDR
+pub fn write_ihdr(
+    w: &mut impl Write,
+    width: u32,
+    height: u32,
+    bit_depth: u8,
+    color_type: u8,
+    interlaced: bool,
+) {
+    let mut data = Vec::new();
+    data.write_u32::<byteorder::BigEndian>(width).unwrap();
+    data.write_u32::<byteorder::BigEndian>(height).unwrap();
+    data.write_u8(bit_depth).unwrap();
+    data.write_u8(color_type).unwrap();
+    data.write_u8(0).unwrap(); // compression method (0 is the only allowed value)
+    data.write_u8(0).unwrap(); // filter method (0 is the only allowed value)
+    data.write_u8(interlaced as u8).unwrap();
+    write_chunk(w, b"IHDR", &data);
+}
+
+/// Wraps `raw_scanlines` (rows already prefixed with their per-row filter-type byte) in a
+/// store-only zlib stream and writes it as one or more IDAT chunks of at most `idat_bytes` each.
+pub fn write_idats_from_raw(w: &mut impl Write, raw_scanlines: &[u8], idat_bytes: usize) {
+    let mut zlib_data = Vec::new();
+    let mut store_only_compressor =
+        fdeflate::StoredOnlyCompressor::new(std::io::Cursor::new(&mut zlib_data)).unwrap();
+    store_only_compressor.write_data(raw_scanlines).unwrap();
+    store_only_compressor.finish().unwrap();
+
+    for chunk in zlib_data.chunks(idat_bytes) {
+        write_chunk(w, b"IDAT", chunk);
+    }
+}
+
+/// Packs one-byte-per-sample values (each expected to fit in `bit_depth` bits) MSB-first into a
+/// PNG sub-byte scanline, as used by grayscale/palette rows at `bit_depth` 1, 2 or 4. A no-op copy
+/// when `bit_depth == 8`.
+fn pack_samples_msb_first(samples: &[u8], bit_depth: u8) -> Vec<u8> {
+    if bit_depth == 8 {
+        return samples.to_vec();
+    }
+    assert!(matches!(bit_depth, 1 | 2 | 4), "unsupported bit depth");
+    let samples_per_byte = 8 / bit_depth as usize;
+    let mut out = vec![0u8; samples.len().div_ceil(samples_per_byte)];
+    for (i, &sample) in samples.iter().enumerate() {
+        let shift = 8 - bit_depth as usize * (i % samples_per_byte + 1);
+        out[i / samples_per_byte] |= (sample & ((1 << bit_depth) - 1)) << shift;
+    }
+    out
+}
