# Self-contained reproduction for this candidate.
#
# Shape 3 (see templates/candidate_justfile): reuses the shared ___OPTIMIZATIONS___/harness/encoder_bench/
# (no encoder benchmark ships with the repo itself) - self-contained given the whole
# ___OPTIMIZATIONS___ folder kept together, not as a fully isolated single subfolder.
#
# This candidate's own headline number needs the harness's `memory` mode + `--skip-verify` flag,
# added to encoder_bench specifically for this candidate (see RESULT.md "Why `--mode memory
# --skip-verify`" and the harness's own README.md) - a plain `compress`/`apng` run's
# `peak_rss_MiB` cannot see this change at all, because the harness's own output sink for those
# modes is a `Vec<u8>` (needed for hashing/roundtrip verification), which itself ends up holding
# the whole encoded PNG in memory regardless of whether the library streamed internally.

repo_url := "https://github.com/image-rs/image-png.git"
base_commit := "05ccdb9c8ae7fc50f4787ba2888a1c515adad944"
harness_dir := "../harness/encoder_bench"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/encoder_bench
    sed -i 's|path = "../../.."|path = ".."|' clone/encoder_bench/Cargo.toml

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd clone/encoder_bench && cargo build --release
    cp clone/encoder_bench/target/release/encoder_bench ./bin_baseline

build-patched:
    cd clone/encoder_bench && cargo build --release
    cp clone/encoder_bench/target/release/encoder_bench ./bin_patched

# `--only Level6` isolates the default compression setting (Compression::Balanced) in its own
# process, since peak_rss_MiB is a process-wide high-water mark (see harness README.md).
# `--skip-verify` is mandatory here, not optional - see the header comment above.
bench:
    @echo "=== baseline (before patch), 4096x4096 RGBA, Level6, single-core ==="
    ulimit -c 0 && taskset -c 0 ./bin_baseline --mode memory --only Level6 --size 4096 --iters 5 --skip-verify
    @echo "=== patched (after patch), 4096x4096 RGBA, Level6, single-core ==="
    ulimit -c 0 && taskset -c 0 ./bin_patched --mode memory --only Level6 --size 4096 --iters 5 --skip-verify
    @echo "=== baseline, unpinned multi-core ==="
    ulimit -c 0 && ./bin_baseline --mode memory --only Level6 --size 4096 --iters 5 --skip-verify
    @echo "=== patched, unpinned multi-core ==="
    ulimit -c 0 && ./bin_patched --mode memory --only Level6 --size 4096 --iters 5 --skip-verify
    @echo "=== correctness: verified separately, in a normal (Vec-sink) run, all DeflateCompression settings ==="
    ulimit -c 0 && ./bin_baseline --mode compress --size 4096 --iters 3
    ulimit -c 0 && ./bin_patched --mode compress --size 4096 --iters 3

clean:
    rm -rf clone bin_baseline bin_patched
