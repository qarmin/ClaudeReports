# Self-contained reproduction for this candidate.
#
# Pure measurement/characterization - no patch.diff (see RESULT.md's "What happens next": this is
# a vendoring candidate for fdeflate itself, not attempted here). `just test` clones the repo at
# base_commit, builds the standalone bench (./bench/, depending on `{ path = "../clone" }`
# rewritten below, plus `fdeflate` directly), and runs it.

repo_url := "https://github.com/image-rs/image-png.git"
base_commit := "05ccdb9c8ae7fc50f4787ba2888a1c515adad944"

test: clone build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/bench" clone/bench
    sed -i 's|path = "../../.."|path = ".."|' clone/bench/Cargo.toml

build:
    cd clone/bench && cargo build --release

bench:
    @echo "=== Decompressor::new() cost + APNG decode allocation scaling ==="
    ulimit -c 0 && ./clone/bench/target/release/fdeflate_reset_bench

clean:
    rm -rf clone
