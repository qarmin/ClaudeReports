# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# NOTE: unlike the generic template, both reproduce steps intentionally use a *debug* build
# (no --release). The bug is a usize subtraction underflow gated by Rust's overflow checks,
# which dnglab's own [profile.release] disables - see RESULT.md's Root cause for why the
# release build's silent wraparound is a latent out-of-bounds read, not "no bug".

repo_url := "https://github.com/dnglab/dnglab.git"
base_commit := "ac975f5d1b3362feb3974811db6cc5a37a77b02b"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic (debug build).
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic.
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
