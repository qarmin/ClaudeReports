# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# The repro itself is bounded (a background thread + watchdog, see repro/src/main.rs) so both
# steps below terminate on their own within ~10s either way - no need for an external timeout.

repo_url := "https://github.com/dnglab/dnglab.git"
base_commit := "ac975f5d1b3362feb3974811db6cc5a37a77b02b"

# Full cycle: clone pristine, prove the bug exists (hang detected), apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - watchdog should report HANG DETECTED.
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should report COMPLETED (no hang) instead
# (it will still panic from the separate, already-documented candidate 001 bug - see RESULT.md).
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
