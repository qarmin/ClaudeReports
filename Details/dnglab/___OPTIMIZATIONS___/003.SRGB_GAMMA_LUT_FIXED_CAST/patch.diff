 pub fn srgb_apply_gamma(v: f32) -> f32 {
   if v <= SRGB_CROSSOVER_POINT {
     v * LINEAR_GAIN
   } else {
-    v.powf(1.0 / SRGB_GAMMA) * SRGB_GAIN - SRGB_OFFSET
+    fast_pow_gamma(v) * SRGB_GAIN - SRGB_OFFSET
   }
 }
 
