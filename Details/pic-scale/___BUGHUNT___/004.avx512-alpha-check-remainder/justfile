# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# repo_url/base_commit read via `git remote get-url origin` / `git rev-parse HEAD` in the main
# project, at the moment patch.diff was captured.

repo_url := "https://github.com/awxkee/pic-scale.git"
base_commit := "7eec7cfde2aed58a1606a48b5c7bd084536f9624"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should REPRODUCE (exit 1,
# "premultiply_alpha=true produced byte-identical output to premultiply_alpha=false").
# Requires an AVX-512BW-capable x86_64 host (the bug lives in the AVX-512 dispatch path only).
# `|| true` because a non-zero exit here is the *expected* outcome (bug present) - `just test`
# should keep going into `apply`/`reproduce-after`, not abort the chain.
reproduce-before:
    cd repro && cargo run --release || true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should NOT reproduce (exit 0), and the
# premultiply_alpha=true output should now match the always-correct AVX2/scalar reference values.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
