diff --git a/src/avx2/alpha_u16.rs b/src/avx2/alpha_u16.rs
index d159f66..60e6302 100644
--- a/src/avx2/alpha_u16.rs
+++ b/src/avx2/alpha_u16.rs
@@ -359,6 +359,16 @@ fn avx_unpremultiply_alpha_rgba_u16_row_avx(in_place: &mut [u16], bit_depth: usi
             _mm256_shuffle_ps::<{ shuffle(3, 3, 3, 3) }>(alphas_f32, alphas_f32),
         );
 
+        // Clamp before the f32 -> i32 cast: an unclamped product can exceed i32::MAX for a
+        // small-but-nonzero alpha, which makes `_mm256_cvtps_epi32` produce the "integer
+        // indefinite" value (0x80000000). `_mm256_packus_epi32`'s unsigned saturation then
+        // collapses that to 0 instead of max_colors, and the later `_mm256_min_epu16` clamp
+        // (which only clamps from above) can't rescue it once it's already 0.
+        lo0 = _mm256_min_ps(lo0, v_scale_colors);
+        hi0 = _mm256_min_ps(hi0, v_scale_colors);
+        lo1 = _mm256_min_ps(lo1, v_scale_colors);
+        hi1 = _mm256_min_ps(hi1, v_scale_colors);
+
         let lo_u0 = _mm256_cvtps_epi32(lo0);
         let hi_u0 = _mm256_cvtps_epi32(hi0);
 
@@ -408,6 +418,10 @@ fn avx_unpremultiply_alpha_rgba_u16_row_avx(in_place: &mut [u16], bit_depth: usi
             _mm256_shuffle_ps::<{ shuffle(1, 1, 1, 1) }>(alphas_f32, alphas_f32),
         );
 
+        // See the identical clamp in the 32-wide loop above for why this is needed.
+        lo = _mm256_min_ps(lo, v_scale_colors);
+        hi = _mm256_min_ps(hi, v_scale_colors);
+
         let lo_u = _mm256_cvtps_epi32(lo);
         let hi_u = _mm256_cvtps_epi32(hi);
 
@@ -451,6 +465,10 @@ fn avx_unpremultiply_alpha_rgba_u16_row_avx(in_place: &mut [u16], bit_depth: usi
             _mm256_shuffle_ps::<{ shuffle(1, 1, 1, 1) }>(alphas_f32, alphas_f32),
         );
 
+        // See the identical clamp in the 32-wide loop above for why this is needed.
+        lo = _mm256_min_ps(lo, v_scale_colors);
+        hi = _mm256_min_ps(hi, v_scale_colors);
+
         let lo_u = _mm256_cvtps_epi32(lo);
         let hi_u = _mm256_cvtps_epi32(hi);
 
