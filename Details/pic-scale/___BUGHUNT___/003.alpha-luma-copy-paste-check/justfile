# Self-contained reproduction for this candidate.
#
# This candidate found no source bug (Status: Not reproducible), so there is no patch.diff and no
# repro/ crate. What this justfile reproduces instead is the actual evidence behind that result:
# this session's own differential tests (gray-alpha vs. RGBA-reference, per bit depth) both pass
# against a pristine clone, before and after applying them, with no source change involved.

repo_url := "https://github.com/awxkee/pic-scale.git"
base_commit := "7eec7cfde2aed58a1606a48b5c7bd084536f9624"

test: clone baseline apply-verification-tests new-differential-tests full-suite

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# The project's own test suite before this candidate's tests are added, for a before/after count.
baseline:
    cd clone && cargo test --lib

# Not a fix - adds this session's own temporary differential tests (see verification_tests.diff)
# comparing the gray-alpha (LA, 2-channel) premultiply/unpremultiply row functions against the
# RGBA reference path on a pixel with R=G=B=luma and the same alpha.
apply-verification-tests:
    cd clone && git apply "{{justfile_directory()}}/verification_tests.diff"

new-differential-tests:
    cd clone && cargo test --lib bughunt_diff_tests
    cd clone && cargo test --lib bughunt_diff_tests --no-default-features

# Confirms the temporary test-only additions don't disturb the rest of the suite.
full-suite:
    cd clone && cargo test --lib

clean:
    rm -rf clone
