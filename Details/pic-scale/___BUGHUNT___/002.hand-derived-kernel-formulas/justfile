# Self-contained reproduction for this candidate.
#
# This candidate found no source bug (Status: Not reproducible), so there is no patch.diff and no
# repro/ crate. What this justfile reproduces instead is the actual evidence behind that result:
# the pre-existing regression suite (guarding formula bugs already fixed before this session) and
# this session's own differential tests (for the previously-untested kernel files) both pass
# against a pristine clone - see RESULT.md/output.txt.

repo_url := "https://github.com/awxkee/pic-scale.git"
base_commit := "7eec7cfde2aed58a1606a48b5c7bd084536f9624"

test: clone pre-existing-suite apply-verification-tests new-differential-tests full-suite

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# The regression suite already present at base_commit, guarding the formula bugs the backlog
# entry was worried about (already found and fixed in two prior "Bugfixes" commits).
pre-existing-suite:
    cd clone && cargo test --lib math::

# Not a fix - adds this session's own temporary differential tests (see verification_tests.diff)
# for the kernel files that had no prior coverage (hann/hamming/hanning, kaiser, welch, quadric,
# cubic/bicubic, lagrange).
apply-verification-tests:
    cd clone && git apply "{{justfile_directory()}}/verification_tests.diff"

new-differential-tests:
    cd clone && cargo test --lib tmp_verify

# Confirms the temporary test-only additions don't disturb the rest of the suite.
full-suite:
    cd clone && cargo test --lib

clean:
    rm -rf clone
