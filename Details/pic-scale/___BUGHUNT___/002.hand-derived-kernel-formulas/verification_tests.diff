diff --git a/src/math/welch.rs b/src/math/welch.rs
index 288b033..17c84bd 100644
--- a/src/math/welch.rs
+++ b/src/math/welch.rs
@@ -54,3 +54,37 @@ where
         mla(-x, x, 1f32.as_())
     }
 }
+
+#[cfg(test)]
+mod tmp_verify_tests {
+    use super::*;
+
+    fn ref_welch(x: f64) -> f64 {
+        let x = x.abs();
+        if x >= 1.0 { 0.0 } else { 1.0 - x * x }
+    }
+
+    #[test]
+    fn tmp_welch_matches_reference_nonnegative_domain() {
+        // weights.rs always calls this with `dx.abs()`, so only x >= 0 is
+        // ever reached in practice - verify that domain explicitly.
+        for i in 0..=200 {
+            let x = i as f64 / 100.0;
+            let (got, want) = (welch(x), ref_welch(x));
+            assert!((got - want).abs() < 1e-9, "x={x}: got {got}, want {want}");
+        }
+    }
+
+    /// The function itself has no `x <= -1` branch (relies on callers passing
+    /// `dx.abs()`), so a negative x outside [-1, 0] does NOT vanish here -
+    /// documenting this latent, currently-unreachable gap rather than
+    /// asserting it is safe.
+    #[test]
+    fn tmp_welch_negative_x_is_not_clamped_by_the_function_itself() {
+        let w = welch(-2.0f64);
+        assert!(
+            w != 0.0,
+            "expected the still-unguarded negative branch to be nonzero (documents the gap)"
+        );
+    }
+}
