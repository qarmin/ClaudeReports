         rem.copy_from_slice(&dst_buffer[..rem.len()]);
     }
 }
+
+#[cfg(test)]
+mod bughunt_remainder_tests {
+    use super::{avx_premultiply_alpha_rgba_u16, avx_unpremultiply_alpha_rgba_u16};
+    use crate::alpha_handle_u16::{premultiply_alpha_rgba_row, unpremultiply_alpha_rgba_row};
+
+    fn lcg(state: &mut u64) -> u64 {
+        *state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+        *state
+    }
+
+    // Tolerance-based, not exact-match: the AVX2 "any bit depth" executor uses an f32
+    // reciprocal-multiply approximation while the scalar reference uses exact integer division
+    // for bit_depth 16, so a +/-1 LSB drift is expected and unrelated to remainder handling (see
+    // RESULT.md). A dropped/never-written remainder element would show as a *much* larger
+    // deviation (the buffer's leftover zero-init, or the untouched source value), not +/-1.
+    const TOLERANCE: i64 = 20;
+
+    #[test]
+    fn avx2_u16_remainder_matches_scalar_within_tolerance() {
+        if !std::arch::is_x86_feature_detected!("avx2") {
+            return;
+        }
+        for bit_depth in [10usize, 12, 16] {
+            let max_colors = (1u64 << bit_depth) - 1;
+            for width in 1..200usize {
+                let mut state = 0x9E3779B97F4A7C15u64 ^ (width as u64) ^ ((bit_depth as u64) << 40);
+                let len = width * 4;
+                let mut src = vec![0u16; len];
+                for px in src.chunks_mut(4) {
+                    px[0] = (lcg(&mut state) % (max_colors + 1)) as u16;
+                    px[1] = (lcg(&mut state) % (max_colors + 1)) as u16;
+                    px[2] = (lcg(&mut state) % (max_colors + 1)) as u16;
+                    px[3] = (lcg(&mut state) % (max_colors + 1)) as u16;
+                }
+                let mut expected = vec![0u16; len];
+                premultiply_alpha_rgba_row(&mut expected, &src, bit_depth);
+                let mut actual = vec![0u16; len];
+                avx_premultiply_alpha_rgba_u16(&mut actual, &src, bit_depth);
+                for (i, (a, e)) in actual.iter().zip(expected.iter()).enumerate() {
+                    let diff = (*a as i64 - *e as i64).abs();
+                    assert!(
+                        diff <= TOLERANCE,
+                        "premultiply width={width} bit_depth={bit_depth} idx={i} actual={a} expected={e}"
+                    );
+                }
+
+                let mut expected_un = expected.clone();
+                unpremultiply_alpha_rgba_row(&mut expected_un, bit_depth);
+                let mut actual_un = actual.clone();
+                avx_unpremultiply_alpha_rgba_u16(&mut actual_un, bit_depth);
+                for (i, (a, e)) in actual_un.iter().zip(expected_un.iter()).enumerate() {
+                    let diff = (*a as i64 - *e as i64).abs();
+                    assert!(
+                        diff <= TOLERANCE,
+                        "unpremultiply width={width} bit_depth={bit_depth} idx={i} actual={a} expected={e}"
+                    );
+                }
+            }
+        }
+    }
+}
