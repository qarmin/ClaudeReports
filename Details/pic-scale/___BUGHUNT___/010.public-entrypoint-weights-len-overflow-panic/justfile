# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# The bug is reachable through the crate's real public API (`Scaler::plan_rgba_resampling`), so
# `repro/` depends on the cloned crate directly - no visibility shim needed.

repo_url := "https://github.com/awxkee/pic-scale.git"
base_commit := "7eec7cfde2aed58a1606a48b5c7bd084536f9624"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone
    -just reproduce-before
    just apply
    just reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic (nonzero exit,
# "REPRODUCED - panicked" printed) because `overflow-checks = true` is set in repro/Cargo.toml so
# the bug is visible the same way it is under Cargo's default `dev` profile.
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic (exit 0,
# "did not reproduce - suspect code path correctly returned Err(...)" printed).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
