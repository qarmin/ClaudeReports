+#[cfg(test)]
+mod bughunt_diff_tests {
+    use super::unpremultiply_alpha_sse_rgba_u16;
+    use crate::alpha_handle_u16::unpremultiply_alpha_rgba_row;
+
+    fn next(state: &mut u32) -> u32 {
+        *state ^= *state << 13;
+        *state ^= *state >> 17;
+        *state ^= *state << 5;
+        *state
+    }
+
+    /// candidate 007: audits `unpremultiply_alpha_sse_rgba_u16` against the scalar reference
+    /// across the full u16 domain at bit_depth=16, including alpha == 0 pixels with nonzero
+    /// color - unlike the AVX2 counterpart (candidate 007's confirmed bug), SSE already handles
+    /// this correctly via `_mm_select_si128`. This test documents that it stays correct.
+    #[test]
+    fn sse_unpremultiply_u16_bit_depth_16_matches_scalar_reference_across_full_range() {
+        if !std::arch::is_x86_feature_detected!("sse4.1") {
+            return;
+        }
+
+        let mut src: Vec<u16> = Vec::new();
+
+        let boundary = [0u16, 1, 32766, 32767, 32768, 32769, 65534, 65535];
+        for &c in &boundary {
+            src.extend_from_slice(&[c, c, c, 0]);
+        }
+
+        // See the AVX2 sibling test for why color is kept <= alpha here (avoids the separate,
+        // not-fixed-in-this-patch overflow issue - see IDEAS.md).
+        let mut state = 0x8765_4321u32;
+        for _ in 0..50_000 {
+            let a = (next(&mut state) & 0xFFFF) as u16;
+            let c = if a == 0 {
+                0
+            } else {
+                (next(&mut state) % (a as u32 + 1)) as u16
+            };
+            src.extend_from_slice(&[c, c, c, a]);
+        }
+
+        let mut expected = src.clone();
+        unpremultiply_alpha_rgba_row(&mut expected, 16);
+
+        let mut actual = src.clone();
+        unpremultiply_alpha_sse_rgba_u16(&mut actual, 16);
+
+        assert_eq!(
+            actual, expected,
+            "SSE unpremultiply diverged from the scalar reference at bit_depth=16"
+        );
+    }
+}
