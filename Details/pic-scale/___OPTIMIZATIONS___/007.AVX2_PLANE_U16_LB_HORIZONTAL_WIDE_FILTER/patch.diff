+fn acc_16_dot<const D: bool>(
+    start_x: usize,
+    src: &[u16],
+    w0: __m256i,
+    store: __m256i,
+) -> __m256i {
+    unsafe {
+        const CN: usize = 1;
+        let src_ptr = src.get_unchecked((start_x * CN)..);
+        let px = _mm256_loadu_si256(src_ptr.as_ptr().cast());
+
+        _mm256_dot16_avx_epi32::<D>(store, px, w0)
+    }
+}
+
+#[inline(always)]
+fn fold_store_256(store256: __m256i) -> __m128i {
+    unsafe {
+        _mm_add_epi32(
+            _mm256_castsi256_si128(store256),
+            _mm256_extracti128_si256::<1>(store256),
+        )
+    }
+}
