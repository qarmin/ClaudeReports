+#[cfg(feature = "avx512")]
+#[inline(always)]
+fn acc_8_dot_rgb_512(
+    start_x: usize,
+    src: &[u16],
+    w0: __m256i,
+    w1: __m256i,
+    store: __m256i,
+    shuffle: __m256i,
+) -> __m256i {
+    let store = acc_4_dot_rgb_512(start_x, src, w0, store, shuffle);
+    acc_4_dot_rgb_512(start_x + 4, src, w1, store, shuffle)
+}
