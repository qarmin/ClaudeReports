# Self-contained reproduction for candidate 019.
#
# This is a tooling/environment finding (refuting "seed the corpus with one file" as a reliable
# workaround for the default-ASAN cargo-fuzz hang), not a bug in lofty's own source - there is no
# patch.diff to apply, so this justfile only has a reproduce-before step.

repo_url := "https://github.com/Serial-ATA/lofty-rs.git"
base_commit := "5c6565e36d35b9ea7de049daa67acc0be0fd3b01"

# No patch.diff for this candidate - see RESULT.md ("The fix").
test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Runs the real `cargo +nightly fuzz run` command against the pristine clone's own existing
# fuzz/ targets: seeds mp4file_read_from's corpus with one real file, then shows the ASAN run
# still hangs despite the seed. Requires: nightly toolchain + cargo-fuzz installed (same as
# required for candidates 009/018).
reproduce-before:
    ./repro/run.sh clone mp4file_read_from

clean:
    rm -rf clone
