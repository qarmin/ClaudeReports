# Self-contained reproduction for candidate 033 (sse4a_extrq_insertq_zero_length_immediate_bug).
#
# Not reproducible - no patch.diff, so only `reproduce-before` exists (per candidate_justfile's
# own template note). This still builds and runs the real end-to-end path (a real rustc
# compilation through the real codegen backend, on real SSE4a hardware), it just demonstrates the
# suspected bug does NOT occur - see RESULT.md.

repo_url := "https://github.com/rust-lang/rustc_codegen_gcc.git"
base_commit := "4cd7da5f9a5d9509b34ac0a766424ccdae706d33"

test: clone build reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r repro clone/repro

# One-time setup: downloads a prebuilt libgccjit.so and builds the sysroot (core/alloc/std).
# ~2-3 minutes on a modern multi-core machine, per this workspace's own README.md.
build:
    echo 'download-gccjit = true' > clone/config.toml
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build --sysroot --release

# Compile+run the repro against the real backend, and against plain rustc (LLVM) as the oracle -
# both are expected to print "total=4128 failures=0" / "ALL OK" and exit 0 (that's the point: the
# hypothesized LEN=0 truncation bug does not reproduce). Requires a host CPU with SSE4a.
reproduce-before:
    rustc --edition 2021 -O clone/repro/zero_len.rs -o /tmp/cand033_zero_len_llvm
    /tmp/cand033_zero_len_llvm
    cd clone && CHANNEL=release ./y.sh rustc repro/zero_len.rs -o /tmp/cand033_zero_len_gcc
    /tmp/cand033_zero_len_gcc

clean:
    rm -rf clone
