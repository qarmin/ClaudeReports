+/// Cranelift only has lowering rules for 128bit atomics on x86_64 with `cmpxchg16b`. Without it
+/// `define_function` fails with `Unsupported`, which cg_clif turns into an ICE, so every atomic
+/// intrinsic has to check this before handing an `I128` to `atomic_load`/`atomic_store`/
+/// `atomic_cas`/`atomic_rmw`.
+fn has_128bit_atomics(fx: &FunctionCx<'_, '_, '_>) -> bool {
+    fx.module
+        .isa()
+        .isa_flags()
+        .iter()
+        .any(|flag| flag.name == "has_cmpxchg16b" && flag.as_bool() == Some(true))
+}
+
+/// Reports that 128bit atomics can't be codegened for the current target. Returns `true` if the
+/// caller must stop codegening this intrinsic (`false` means it may proceed).
+fn reject_unsupported_128bit_atomic<'tcx>(
+    fx: &mut FunctionCx<'_, '_, 'tcx>,
+    ty: Ty<'tcx>,
+    span: Span,
+) -> bool {
+    if !matches!(ty.kind(), ty::Uint(UintTy::U128) | ty::Int(IntTy::I128)) {
+        return false;
+    }
+    if has_128bit_atomics(fx) {
+        return false;
+    }
+
+    let msg = if fx.module.isa().triple().architecture == target_lexicon::Architecture::X86_64 {
+        "128bit atomics require the cmpxchg16b target feature; \
+         try `-Ctarget-feature=+cmpxchg16b` or a `-Ctarget-cpu` that implies it"
+    } else {
+        "128bit atomics not yet supported"
+    };
+
+    if fx.tcx.is_compiler_builtins(LOCAL_CRATE) {
+        // special case for compiler-builtins to avoid having to patch it
+        crate::base::codegen_panic_nounwind(fx, msg, span);
+    } else {
+        fx.tcx.dcx().span_fatal(span, msg);
+    }
+    true
+}
