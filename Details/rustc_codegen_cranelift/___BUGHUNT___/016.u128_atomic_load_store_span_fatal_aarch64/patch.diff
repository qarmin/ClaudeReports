+/// Cranelift only has lowerings for 128bit atomics in its x64 backend, and every one of them is
+/// gated on the `cmpxchg16b` ISA flag. Everywhere else (aarch64, s390x, ...) there is no lowering
+/// at all and the operation has to be rejected.
+fn isa_supports_128bit_atomics(fx: &FunctionCx<'_, '_, '_>) -> bool {
+    let isa = fx.module.isa();
+    isa.triple().architecture == target_lexicon::Architecture::X86_64
+        && isa
+            .isa_flags()
+            .iter()
+            .any(|flag| flag.name == "has_cmpxchg16b" && flag.as_bool() == Some(true))
+}
+
+/// Emit a runtime abort for a 128bit atomic operation the target ISA can't lower.
+///
+/// This can't be a hard error: `core` itself instantiates the 128bit atomic intrinsics on every
+/// target where `target_has_atomic = "128"` holds (all of aarch64, s390x and x86_64 macOS), so
+/// erroring out makes those targets impossible to compile at all rather than just making the
+/// unsupported operation fail. Warn + trap is what the backend already does for unsupported
+/// `llvm.*` intrinsics.
+fn codegen_unsupported_128bit_atomic<'tcx>(
+    fx: &mut FunctionCx<'_, '_, 'tcx>,
+    intrinsic: Symbol,
+    span: Span,
+) {
+    if !fx.tcx.is_compiler_builtins(LOCAL_CRATE) {
+        fx.tcx.dcx().span_warn(
+            span,
+            format!("`{intrinsic}` on a 128bit integer is not yet supported; replacing with trap"),
+        );
+    }
+    crate::base::codegen_panic_nounwind(fx, "128bit atomics not yet supported", span);
+}
