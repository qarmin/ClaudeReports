+/// Cranelift has no `sdiv`/`udiv`/`srem`/`urem` lowering for `I128` on any backend, so 128-bit
+/// division and remainder always have to go through compiler-builtins. Callers that build the
+/// `I128` values themselves (e.g. the per-lane SIMD path) must use this rather than emitting the
+/// Cranelift instruction directly.
+pub(crate) fn codegen_div_rem(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    is_div: bool,
+    is_signed: bool,
+    lhs: Value,
+    rhs: Value,
+) -> Value {
+    let name = match (is_div, is_signed) {
+        (true, false) => "__udivti3",
+        (true, true) => "__divti3",
+        (false, false) => "__umodti3",
+        (false, true) => "__modti3",
+    };
+    fx.lib_call(
+        name,
+        vec![AbiParam::new(types::I128), AbiParam::new(types::I128)],
+        vec![AbiParam::new(types::I128)],
+        &[lhs, rhs],
+    )[0]
+}
