+fn print_target_cpus(sess: &Session, out: &mut String) {
+    use std::fmt::Write;
+
+    // `-Ctarget-cpu=<name>` is forwarded to Cranelift as a settings preset, so the presets of the
+    // target's ISA are exactly the accepted values.
+    let mut presets = isa_settings(sess)
+        .into_iter()
+        .filter(|setting| setting.kind == settings::SettingKind::Preset)
+        .map(|setting| setting.name)
+        .collect::<Vec<_>>();
+    presets.sort_unstable();
+
+    writeln!(out, "Available CPUs for this target:").unwrap();
+    if sess.host.arch == sess.target.arch && !sess.target.requires_consistent_cpu {
+        writeln!(out, "    {NATIVE_CPU} - Select the CPU of the current host.").unwrap();
+    }
+    for name in presets {
+        writeln!(out, "    {name}").unwrap();
+    }
+    writeln!(out).unwrap();
+}
+
+fn print_target_features(sess: &Session, out: &mut String) {
+    use std::fmt::Write;
+
+    let mut rust_features = sess
+        .target
+        .rust_target_features()
+        .iter()
+        // Only list (experimentally) supported features.
+        .filter(|(_feature, gate, _implied)| gate.in_cfg())
+        .map(|(feature, _gate, _implied)| *feature)
+        .collect::<Vec<_>>();
+    rust_features.push("crt-static");
+    rust_features.sort_unstable();
+
+    // Cranelift's own codegen features are its ISA-specific `has_*` boolean settings. They are not
+    // the same namespace as the rustc feature names above and cannot be used in `cfg` or
+    // `#[target_feature]`.
+    let mut cranelift_features = isa_settings(sess)
+        .into_iter()
+        .filter(|setting| {
+            setting.kind == settings::SettingKind::Bool && setting.name.starts_with("has_")
+        })
+        .map(|setting| (setting.name, setting.description))
+        .collect::<Vec<_>>();
+    cranelift_features.sort_unstable();
+
+    let max_feature_len = rust_features
+        .iter()
+        .copied()
+        .chain(cranelift_features.iter().map(|(feature, _desc)| *feature))
+        .map(str::len)
+        .max()
+        .unwrap_or(0);
+
+    writeln!(out, "Features supported by rustc for this target:").unwrap();
+    for feature in &rust_features {
+        writeln!(out, "    {feature}").unwrap();
+    }
+    writeln!(out, "\nCode-generation features supported by Cranelift for this target:").unwrap();
+    for (feature, desc) in &cranelift_features {
+        writeln!(out, "    {feature:max_feature_len$} - {desc}").unwrap();
+    }
+    if cranelift_features.is_empty() {
+        writeln!(out, "    No code-generation features are known for this target.").unwrap();
+    }
+    writeln!(out, "\nUse +feature to enable a feature, or -feature to disable it.").unwrap();
+    writeln!(out, "For example, rustc -C target-cpu=mycpu -C target-feature=+feature1,-feature2\n")
+        .unwrap();
+    writeln!(out, "Code-generation features cannot be used in cfg or #[target_feature],").unwrap();
+    writeln!(out, "and may be renamed or removed in a future version of Cranelift or rustc.\n")
+        .unwrap();
+}
