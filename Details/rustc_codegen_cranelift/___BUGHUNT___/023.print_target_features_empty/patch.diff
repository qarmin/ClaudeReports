+/// The ISA-specific Cranelift settings available for `sess`'s target, or an empty list when
+/// Cranelift has no backend for it at all.
+///
+/// Deliberately infallible: this only feeds `--print` output, which must not hard-error on a
+/// target cg_clif cannot codegen for. So it neither goes through `target_tuple` (which calls
+/// `fatal` on an unparsable tuple) nor hands `isa::lookup` an architecture whose per-ISA
+/// `isa_builder` would `assert!` instead of returning `Err` (big-endian AArch64).
+fn isa_settings(sess: &Session) -> Vec<settings::Setting> {
+    use target_lexicon::{Aarch64Architecture, Architecture, Triple};
+
+    let Ok(triple) = back::versioned_llvm_target(sess).parse::<Triple>() else {
+        return Vec::new();
+    };
+    if !matches!(
+        triple.architecture,
+        Architecture::X86_64
+            | Architecture::Aarch64(Aarch64Architecture::Aarch64)
+            | Architecture::S390x
+            | Architecture::Riscv64(_)
+    ) {
+        return Vec::new();
+    }
+    match cranelift_codegen::isa::lookup(triple) {
+        Ok(isa_builder) => isa_builder.iter().collect(),
+        Err(_) => Vec::new(),
+    }
+}
