+
+/// Return type of the `__{eq,ne,lt,le,gt,ge}tf2` soft-float comparison libcalls.
+///
+/// Needs to stay in sync with compiler-builtins' `CmpResult`
+/// (`library/compiler-builtins/compiler-builtins/src/float/cmp.rs`), which in turn follows LLVM's
+/// `getCmpLibcallReturnType`. It depends on the target being compiled for, not on the host.
+pub(crate) fn cmp_result_ty(sess: &Session) -> Type {
+    match sess.target.arch {
+        // Aarch64 uses `int` rather than a pointer-sized value. LLVM's
+        // `getCmpLibcallReturnType` is i32 for wasm too.
+        Arch::AArch64 | Arch::Arm64EC | Arch::Wasm32 | Arch::Wasm64 => types::I32,
+        // AVR uses a single byte.
+        Arch::Avr => types::I8,
+        // In compiler-rt, LLP64 ABIs use `long long` and everything else uses `long`. In effect,
+        // this means the return value is always pointer-sized.
+        _ => match sess.target.pointer_width {
+            16 => types::I16,
+            32 => types::I32,
+            64 => types::I64,
+            pointer_width => {
+                sess.dcx().fatal(format!("unsupported pointer width {pointer_width}"))
+            }
+        },
+    }
+}
 
