# Self-contained reproduction for candidate 028 (linker_script_parser_token_indexing).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# mold is C++20/CMake (not Rust/cargo). A plain Debug build is used for consistency with the
# rest of this project's candidates, but this bug is a stack overflow, so it reproduces in a
# Release build too - a Release build just needs deeper nesting to hit it (smaller frames),
# and the two self/mutually-including-script cases (which recurse without bound rather than
# to a finite input-controlled depth) crash in any build.
#
# repro/run.sh needs a working `cc` to produce the trivial .o it links against.

repo_url := "https://github.com/rui314/mold.git"
base_commit := "c340272e6376f9a8e5b5cd6f6634f925f6d54e5c"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone build-before reproduce-before apply build-after reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build-before:
    cmake -S clone -B clone/build-plain -DCMAKE_BUILD_TYPE=Debug
    cmake --build clone/build-plain -j4

# Should demonstrate the bug: five malformed/self-referential linker scripts each kill mold
# with SIGSEGV (exit 139) from stack exhaustion. `ulimit -c 0` stops the core dumps.
# Expected to exit non-zero here.
reproduce-before:
    ulimit -c 0 && bash repro/run.sh clone/build-plain/mold

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-after:
    cmake --build clone/build-plain -j4

# Same repro again against the patched clone: no crashes, each malformed script is rejected
# with `mold: fatal: <file>: ... is nested too deeply`, and every valid script still links.
# Expected to exit 0 here.
reproduce-after:
    ulimit -c 0 && bash repro/run.sh clone/build-plain/mold

clean:
    rm -rf clone
