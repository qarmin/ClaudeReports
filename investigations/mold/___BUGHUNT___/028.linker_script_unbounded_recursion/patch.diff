 namespace mold {
 
+// Our linker script parser is recursive descent, and both the script
+// language and the file inclusion it performs allow unbounded nesting,
+// so we cap the nesting depth to keep a malformed script from
+// exhausting the stack. Real scripts nest only a few levels deep.
+static constexpr i64 MAX_SCRIPT_DEPTH = 1000;
+
+namespace {
+class ScopedDepth {
+public:
+  ScopedDepth(i64 &depth) : depth(depth) { depth++; }
+  ~ScopedDepth() { depth--; }
+
+private:
+  i64 &depth;
+};
+}
