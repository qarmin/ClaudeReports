 }
 
+// Bounds-checked variant, see the read_uleb(u8 **, u8 *) overload above.
+inline i64 read_sleb(u8 **buf, u8 *end) {
+  u64 val = 0;
+  u8 shift = 0;
+  u8 byte = 0;
+  while (*buf < end) {
+    byte = *(*buf)++;
+    if (shift < 64) {
+      val |= (u64)(byte & 0x7f) << shift;
+      shift += 7;
+    }
+    if (!(byte & 0x80))
+      break;
+  }
+  return sign_extend(val, shift);
+}
