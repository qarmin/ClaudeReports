 }
 
+// Bounds-checked variant for untrusted input (e.g. DWARF from object files).
+// A crafted LEB128 run whose continuation bit never clears must not walk past
+// the end of its buffer, so stop at `end`; also cap `shift` below 64 so an
+// overlong encoding can't shift by an out-of-range amount (which is UB).
+inline u64 read_uleb(u8 **buf, u8 *end) {
+  u64 val = 0;
+  u8 shift = 0;
+  u8 byte = 0;
+  while (*buf < end) {
+    byte = *(*buf)++;
+    if (shift < 64) {
+      val |= (u64)(byte & 0x7f) << shift;
+      shift += 7;
+    }
+    if (!(byte & 0x80))
+      break;
+  }
+  return val;
+}
