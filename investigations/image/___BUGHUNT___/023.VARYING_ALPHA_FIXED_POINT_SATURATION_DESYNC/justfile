# Self-contained reproduction for this candidate.
#
# Spatially-varying-alpha resize through `DynamicImage::resize_exact`'s pic-scale-safe-backed
# fixed-point (u8/u16) path can produce colors far outside the true source color range, even at
# fully-opaque output alpha, for filters with negative lobes (CatmullRom/Gaussian/Lanczos3). The
# bug's mechanism lives in the `pic-scale-safe` dependency's fixed-point convolution (it
# saturates each channel - including the premultiplied-alpha channel - independently between
# passes), but the trigger path exercised here is `image`'s own public API
# (`DynamicImage::resize_exact`), which is what a real caller would use.
#
# No patch.diff is included - an attempted fix (routing the affected pixel types through
# pic-scale-safe's f32 functions instead) was tried, verified to eliminate this repro's
# deviation, but rejected after it was found to regress this repo's own pre-existing
# `tests/regression.rs::resizing_with_catmul` reference-image test far more severely (13/8580
# differing channels, max off-by-1 -> 2081/8580, max off-by-255) on a real photographic image
# with near-zero (not exactly zero) alpha regions. See RESULT.md "The fix" for detail.
#
# repo_url/base_commit: `image-rs/image`, read via `git remote get-url origin` /
# `git rev-parse HEAD` in the main project at the moment this candidate was investigated.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should show a large color
# deviation (>21% of the u16 range) at a fully-opaque output pixel, while the same repro's f32
# oracle path on the identical geometry/filter stays within ~1e-6.
reproduce-before:
    cd repro && cargo run --release || true

clean:
    rm -rf clone
