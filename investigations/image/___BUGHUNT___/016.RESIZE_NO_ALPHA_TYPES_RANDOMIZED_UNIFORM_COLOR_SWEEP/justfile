# Self-contained reproduction attempt for this candidate. This candidate was Not reproducible -
# `reproduce-before` demonstrates that against a pristine clone at base_commit; there is no
# patch.diff, so there is no `apply`/`reproduce-after` step.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone. Exits 0 with "Not reproduced"
# because no uniform-color-violating bug was found in DynamicImage::resize_exact for the no-alpha
# color types (Luma8/Luma16/Rgb16/Luma32F/Rgb32F) or in a 500-iteration randomized
# size/filter/color sweep of Rgba8.
reproduce-before:
    cd repro && cargo run --release

clean:
