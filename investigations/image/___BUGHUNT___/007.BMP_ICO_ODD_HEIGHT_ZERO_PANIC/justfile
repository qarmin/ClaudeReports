# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic (bug present).
# `|| true`: the repro's own non-zero exit *is* the expected signal here, not a justfile failure -
# without it, `just test`'s recipe chain would stop right here and never reach reproduce-after.
reproduce-before:
    cd repro && cargo run --release || true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic (bug fixed, returns a
# clean decode error instead).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
