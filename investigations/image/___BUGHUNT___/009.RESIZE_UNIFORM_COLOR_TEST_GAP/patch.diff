+    #[test]
+    fn test_resize_uniform_color_preserved() {
+        // A resize of a uniform-color image must reproduce that exact color: any
+        // accumulator/seed bug in the resampling math shows up as a flat per-channel bias here.
+        use crate::Rgb;
+
+        let filters = [
+            FilterType::Nearest,
+            FilterType::Triangle,
+            FilterType::CatmullRom,
+            FilterType::Gaussian,
+            FilterType::Lanczos3,
+        ];
+        let value = 100u8;
+        let src: RgbImage = ImageBuffer::from_pixel(6, 6, Rgb([value, value, value]));
+
+        for filter in filters {
+            let resized = resize(&src, 3, 3, filter);
+            for p in resized.pixels() {
+                assert_eq!(
+                    *p,
+                    Rgb([value, value, value]),
+                    "resize with {filter:?} did not preserve a uniform source color"
+                );
+            }
+        }
+    }
