diff --git a/src/codecs/bmp/decoder.rs b/src/codecs/bmp/decoder.rs
index cba61aed..e3799214 100644
--- a/src/codecs/bmp/decoder.rs
+++ b/src/codecs/bmp/decoder.rs
@@ -727,10 +727,16 @@ fn read_scanline(
             return Ok(());
         };
 
-        if Ok(head.len()) == usize::try_from(end_pos - current_pos) {
-            reader.read_exact(head)?;
-            *last = b'\0';
-            return Ok(());
+        // `current_pos` can exceed `end_pos` for a malformed file whose declared pixel-data
+        // offset points past the actual end of the file - use `checked_sub` rather than `-` so
+        // that case falls through to the ordinary `read_exact` below (which reports a clean EOF
+        // error) instead of underflowing.
+        if let Some(remaining) = end_pos.checked_sub(current_pos) {
+            if Ok(head.len()) == usize::try_from(remaining) {
+                reader.read_exact(head)?;
+                *last = b'\0';
+                return Ok(());
+            }
         }
     }
 
