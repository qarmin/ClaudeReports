# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles the Cargo.toml + benches/imageops.rs harness hunks (rayon forwarded +
# bench_resize_dynamic group, extended in this candidate with a FilterType::Nearest case at
# 400x300->32x24) with candidate 029's exact, unmodified per-filter gate (src/imageops/resize.rs -
# num_threads(4) for Nearest/Bilinear/Lanczos3, num_threads(6) for CatmullRom/Gaussian, keyed on
# ResamplingFunction). apply-harness applies just the former so the bench exists in both the
# serial baseline and the gated build; apply-fix applies the gate on top, for the gated build
# only. This reproduces the "S (serial/main) vs E (gated, N=4)" comparison from RESULT.md - the
# comparison that showed the existing gate does NOT recover Nearest's serial performance (still
# ~20-30x slower than S even when gated).
test: clone apply-harness bench-serial apply-fix bench-gated

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

# Reuses the repo's own `benches/imageops.rs` (extended by the harness hunk with the
# bench_resize_dynamic group's Nearest case) rather than a standalone bench crate.
# "Serial" here means Cargo.toml's rayon forward IS present (needed for the bench harness to be
# meaningful at all) but resize.rs has no gate yet - pic-scale-safe's own rayon dispatch is what's
# ungated in this step, not "no rayon feature". See RESULT.md's "S vs A" rows for the true serial
# (main, no rayon forward at all) comparison, which needs a separate un-forwarded Cargo.toml build
# not captured by this two-step justfile (kept to the same two-binary shape as candidate 029's
# justfile for consistency across this workspace's candidate line).
bench-serial:
    @echo "=== ungated (rayon forwarded, no capped-thread gate) - Nearest at 400x300->32x24 ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Nearest"

bench-gated:
    @echo "=== gated (per-filter capped-thread pool, Nearest routed to N=4) - Nearest at 400x300->32x24 ==="
    cd clone && cargo bench --bench imageops --features rayon -- "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Nearest"

clean:
    rm -rf clone
