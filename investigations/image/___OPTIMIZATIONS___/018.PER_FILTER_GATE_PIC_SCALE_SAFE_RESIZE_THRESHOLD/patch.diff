+    let resized_typed: Vec<<I::Pixel as Pixel>::Subpixel> = unsafe {
+        let mut resized = std::mem::ManuallyDrop::new(resized);
+        Vec::from_raw_parts(
+            resized
+                .as_mut_ptr()
+                .cast::<<I::Pixel as Pixel>::Subpixel>(),
+            resized.len(),
+            resized.capacity(),
+        )
+    };
+
+    ImageBuffer::from_raw(nwidth, nheight, resized_typed)
+}
