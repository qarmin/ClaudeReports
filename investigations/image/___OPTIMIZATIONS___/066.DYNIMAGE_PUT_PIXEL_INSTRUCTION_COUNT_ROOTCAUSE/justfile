# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# This candidate is a root-cause investigation (via `objdump`/`perf stat`/LLVM IR) of candidate
# 065's already-known "#[inline] increases instructions ~16.2%" side observation - `patch.diff`
# here is byte-identical to candidate 064/065's, kept purely as the before/after toggle (same
# convention candidate 037/065 used for their own measurement-only investigations).
#
# The temporary example driver this needs (_perf_check_066.rs) is NOT part of patch.diff (see
# RESULT.md's "Does it change behavior/output?" - it's measurement tooling, not the fix) - this
# justfile writes it into the clone directly instead of assuming a reader already has it.
#
# Needs `objdump`/`nm` (binutils) on PATH (always available in this workspace's experience) and
# `perf` for the instruction-count confirmation step (falls back to a loud message and skips that
# one step if `perf` is unavailable - the objdump/disassembly comparison, which is this
# candidate's actual point, does not need `perf` at all).

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

test: clone add-driver build-baseline build-patched build-putpixel-only-control instructions-compare disasm-compare

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Adds the temporary example driver + its [[example]] Cargo.toml entry to the clone. Kept out of
# patch.diff on purpose (measurement tooling, not the fix) - see justfile header.
add-driver:
    #!/usr/bin/env bash
    set -euo pipefail
    cat > clone/examples/_perf_check_066.rs <<'RUST'
    use std::hint::black_box;

    use image::{imageops, DynamicImage, Rgba, RgbaImage};

    fn main() {
        let mut args = std::env::args().skip(1);
        let mode = args.next().expect("mode: vertical|horizontal");
        let iters: u32 = args.next().expect("iters").parse().expect("iters as u32");

        let mut img = DynamicImage::ImageRgba8(RgbaImage::new(1920, 1080));
        let start = Rgba([0u8, 128, 0, 0]);
        let stop = Rgba([255u8, 255, 255, 255]);

        for _ in 0..iters {
            let img_ref = black_box(&mut img);
            match mode.as_str() {
                "vertical" => imageops::vertical_gradient(img_ref, &start, &stop),
                "horizontal" => imageops::horizontal_gradient(img_ref, &start, &stop),
                other => panic!("unknown mode {other}"),
            }
            black_box(&img);
        }
    }
    RUST
    python3 - <<'PY'
    content = open("clone/Cargo.toml").read()
    marker = '[[example]]\nname = "bmp_1bit_encoding"\nrequired-features = ["bmp"]\n'
    addition = marker + '\n[[example]]\nname = "_perf_check_066"\nrequired-features = ["bmp"]\n'
    assert marker in content, "bmp_1bit_encoding [[example]] block not found - Cargo.toml layout changed since base_commit"
    open("clone/Cargo.toml", "w").write(content.replace(marker, addition))
    PY

build-baseline:
    cd clone && cargo build --release --example _perf_check_066
    mkdir -p bin
    cp clone/target/release/examples/_perf_check_066 bin/baseline

build-patched: apply
    cd clone && cargo build --release --example _perf_check_066
    mkdir -p bin
    cp clone/target/release/examples/_perf_check_066 bin/patched

# Isolates the effect to `#[inline]` on `put_pixel` alone (not `get_pixel`'s `#[inline(always)]`,
# which this workload never exercises) - see RESULT.md step 2. Reverts the full patch first, then
# applies just the one-line `put_pixel` attribute.
build-putpixel-only-control:
    #!/usr/bin/env bash
    set -euo pipefail
    cd clone
    git checkout -- src/images/dynimage.rs
    python3 - <<'PY'
    path = "src/images/dynimage.rs"
    content = open(path).read()
    needle = "impl GenericImage for DynamicImage {\n    fn put_pixel("
    replacement = "impl GenericImage for DynamicImage {\n    #[inline]\n    fn put_pixel("
    assert needle in content, "put_pixel signature not found - source layout changed since base_commit"
    open(path, "w").write(content.replace(needle, replacement))
    PY
    cargo build --release --example _perf_check_066
    mkdir -p ../bin
    cp target/release/examples/_perf_check_066 ../bin/patched_putpixel_only
    git checkout -- src/images/dynimage.rs

# Confirms candidate 065's own ~16.2% instructions delta reproduces on this harness, and that the
# put_pixel-only control matches the full patch (RESULT.md step 2/5).
instructions-compare:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v perf >/dev/null; then
        echo "perf not installed/usable - skipping instructions-compare step (see RESULT.md for this session's already-captured numbers)"
        exit 0
    fi
    for variant in baseline patched patched_putpixel_only; do
        for mode in vertical horizontal; do
            echo "=== ${variant} ${mode} ==="
            taskset -c 0 perf stat -e instructions -- "bin/${variant}" "${mode}" 200 2>&1 | grep instructions
        done
    done

# The actual root-cause step: disassembles <DynamicImage as GenericImage>::put_pixel out of both
# binaries and diffs the ImageRgba8 match arm (the one this harness exercises) - see RESULT.md
# steps 3-4 for how to read this output, and disasm_baseline_rgba8_arm.asm/
# disasm_patched_rgba8_arm.asm in this folder for the exact excerpt this candidate's finding is
# built on.
disasm-compare:
    #!/usr/bin/env bash
    set -eu
    for variant in baseline patched; do
        # objdump's output is written to a real file (not piped) before awk reads it, so awk's
        # early `exit` never sends SIGPIPE back to objdump - piping the two directly under
        # `pipefail` makes this recipe fail with exit 141 even though the output is correct.
        objdump -d -C -M intel --no-show-raw-insn "bin/${variant}" > "bin/${variant}_full.asm"
        awk '/<.*DynamicImage as .*GenericImage>::put_pixel>:/{flag=1} flag{print} flag && /^$/{exit}' \
            "bin/${variant}_full.asm" > "bin/${variant}_put_pixel.asm"
        echo "=== ${variant}: $(wc -l < bin/${variant}_put_pixel.asm) lines ==="
    done
    echo "Full diff (line numbers/labels will differ - see RESULT.md for the specific ImageRgba8 arm excerpt):"
    diff "bin/baseline_put_pixel.asm" "bin/patched_put_pixel.asm" || true

clean:
    rm -rf clone bin
