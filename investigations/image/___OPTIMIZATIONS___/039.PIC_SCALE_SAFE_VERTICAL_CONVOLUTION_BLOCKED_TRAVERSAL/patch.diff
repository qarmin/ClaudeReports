+        } else if CHANNELS == 3 || CHANNELS == 4 {
+            dst[0] = trc.linearize(dst[0]);
+            dst[1] = trc.linearize(dst[1]);
+            dst[2] = trc.linearize(dst[2]);
+        }
+    });
+}
