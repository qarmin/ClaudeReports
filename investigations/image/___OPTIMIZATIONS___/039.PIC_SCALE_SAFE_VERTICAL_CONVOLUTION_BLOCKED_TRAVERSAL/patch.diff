+/// # Generics
+/// `T` - template buffer type
+/// `J` - accumulator type
+pub(crate) fn column_handler_fixed_point<
+    T: Copy + 'static + AsPrimitive<J> + Default,
+    J: Copy + 'static + AsPrimitive<T> + Mul<Output = J> + AddAssign + SaturateNarrow<T> + Default,
+>(
+    bounds: &FilterBounds,
+    src: &[T],
+    dst: &mut [T],
+    src_stride: usize,
+    weight: &[i16],
+    bit_depth: u32,
+) where
+    i32: AsPrimitive<J>,
+    i16: AsPrimitive<J>,
+{
+    let mut cx = 0usize;
+
+    let total_width = dst.len();
+
+    // Candidate 039 (___OPTIMIZATIONS___): a wide column block, processed tap-by-tap with the
+    // same accumulate-then-narrow shape as the smaller tiers below, but far fewer times per row.
+    // Each destination row jumps between `bounds.size` source rows spaced `src_stride` bytes
+    // apart (often >>L2 line count for a downscale's full source width); with only a 16-64
+    // element block, that spaced-row-hop repeats total_width/BUFFER_SIZE times per destination
+    // row, discarding cache locality between visits to the same row. A wider block amortizes
+    // each row-hop over more contiguous, prefetch-friendly bytes per visit.
+    while cx + 512 <= total_width {
+        convolve_column_handler_fixed_point_direct_buffer::<T, J, 512>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 512;
+    }
+
+    #[cfg(target_arch = "aarch64")]
+    while cx + 64 <= total_width {
+        convolve_column_handler_fixed_point_direct_buffer_four::<T, J, 16>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 64;
+    }
+
+    while cx + 32 <= total_width {
+        convolve_column_handler_fixed_point_direct_buffer_double::<T, J, 16>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 32;
+    }
+
+    while cx + 16 <= total_width {
+        convolve_column_handler_fixed_point_direct_buffer16::<T, J, 16>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 16;
+    }
+
+    while cx + 8 <= total_width {
+        convolve_column_handler_fixed_point_direct_buffer::<T, J, 8>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 8;
+    }
+
+    while cx < total_width {
+        convolve_column_handler_fixed_point_direct_buffer::<T, J, 1>(
+            src, src_stride, dst, weight, bounds, bit_depth, cx,
+        );
+
+        cx += 1;
+    }
+}
