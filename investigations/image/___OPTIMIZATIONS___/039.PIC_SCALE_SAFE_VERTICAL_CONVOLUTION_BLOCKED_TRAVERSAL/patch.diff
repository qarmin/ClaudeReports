+        + Div<Output = V>,
+>(
+    x: V,
+) -> V
+where
+    f64: AsPrimitive<V>,
+    f32: AsPrimitive<V>,
+{
+    if x < 1.0.as_() {
+        ((13.0.as_() / 11.0.as_() * x - 453.0.as_() / 209.0.as_()) * x - 3.0.as_() / 209.0.as_())
+            * x
+            + 1.0.as_()
+    } else if x < 2.0.as_() {
+        (((-6.0).as_() / 11.0.as_() * (x - 1f32.as_()) + 270.0.as_() / 209.0.as_())
+            * (x - 1f32.as_())
+            - 156.0.as_() / 209.0.as_())
+            * (x - 1f32.as_())
+    } else {
+        ((1.0.as_() / 11.0.as_() * (x - 2f32.as_()) - 45.0.as_() / 209.0.as_()) * (x - 2f32.as_())
+            + 26.0.as_() / 209.0.as_())
+            * (x - 2f32.as_())
+    }
+}
