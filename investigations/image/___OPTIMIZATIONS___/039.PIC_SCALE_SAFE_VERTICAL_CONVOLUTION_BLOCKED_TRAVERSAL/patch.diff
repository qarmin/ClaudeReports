+[package]
+name = "pic-scale-safe"
+version = "0.1.11"
+edition = "2021"
+description = "Fast and safe performance image scaling (vendored + locally patched, see ___OPTIMIZATIONS___/039.PIC_SCALE_SAFE_VERTICAL_CONVOLUTION_BLOCKED_TRAVERSAL)"
+readme = "README.md"
+license = "BSD-3-Clause OR Apache-2.0"
+authors = ["Radzivon Bartoshyk"]
+documentation = "https://github.com/awxkee/pic-scale-safe"
+homepage = "https://github.com/awxkee/pic-scale-safe"
+repository = "https://github.com/awxkee/pic-scale-safe"
+
+[lib]
+name = "pic_scale_safe"
+path = "src/lib.rs"
+
+[dependencies]
+num-traits = "0.2.19"
+rayon = { version = "1.10.0", optional = true }
+
+[features]
+default = []
+rayon = ["dep:rayon"]
+
+[workspace]
