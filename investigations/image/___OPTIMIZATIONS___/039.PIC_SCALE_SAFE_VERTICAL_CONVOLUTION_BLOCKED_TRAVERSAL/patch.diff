+
+#[inline(always)]
+pub(crate) fn gaussian<
+    V: ConstPI + Copy + Neg<Output = V> + Mul<Output = V> + MulAssign + 'static + Float,
+>(
+    x: V,
+) -> V
+where
+    f32: AsPrimitive<V>,
+{
+    let sigma: V = 0.35f32.as_();
+    let pi = V::const_pi();
+    let mut den = 2f32.as_() * sigma * sigma;
+    den *= den;
+    (1f32.as_() / ((2f32.as_() * pi).sqrt() * sigma)) * (-x / den).exp()
+}
