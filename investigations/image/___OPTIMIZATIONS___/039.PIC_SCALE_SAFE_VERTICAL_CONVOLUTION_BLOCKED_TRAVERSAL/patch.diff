+
+use num_traits::AsPrimitive;
+use std::ops::{Mul, Sub};
+
+#[inline(always)]
+pub(crate) fn welch<V: Copy + PartialOrd + Mul<Output = V> + Sub<Output = V> + 'static>(x: V) -> V
+where
+    f32: AsPrimitive<V>,
+{
+    if x == 0f32.as_() {
+        1f32.as_()
+    } else if x >= 1f32.as_() {
+        0.0f32.as_()
+    } else {
+        1f32.as_() - x * x
+    }
+}
