diff --git a/benches/imageops.rs b/benches/imageops.rs
index d1b33ebe..9f75921e 100644
--- a/benches/imageops.rs
+++ b/benches/imageops.rs
@@ -1,6 +1,6 @@
 use std::{hint::black_box, time::Duration};
 
-use criterion::{criterion_group, criterion_main, Criterion};
+use criterion::{criterion_group, criterion_main, BatchSize, Criterion};
 use image::{
     imageops::{self, FilterType},
     math::Rect,
@@ -123,5 +123,60 @@ pub fn bench_resize(c: &mut Criterion) {
     }
 }
 
-criterion_group!(benches, bench_imageops, bench_resize);
+// Exercises `DynamicImage::resize_exact`, which delegates to the `pic-scale-safe` crate
+// (see `src/imageops/resize.rs`) - the code path affected by this candidate's vertical
+// convolution block-size change. `Nearest` is included alongside
+// `Lanczos3`/`Triangle`/`CatmullRom`/`Gaussian` as a control (it never routes through
+// `column_handler_fixed_point`, see `resize_nearest.rs`). Reused verbatim from candidates
+// 002/031-038.
+pub fn bench_resize_dynamic(c: &mut Criterion) {
+    let src = ImageBuffer::from_fn(4032, 3024, |x, y| {
+        // "random" pixel values
+        Rgb([x as u8, (y / 8) as u8, ((x * 13 + y) % 256) as u8])
+    });
+    let src_dyn = DynamicImage::from(src);
+
+    let mut group = c.benchmark_group("dynamic_resize");
+    let c = group.warm_up_time(Duration::from_secs(1)).sample_size(10);
+
+    for (w, h) in [(400u32, 300u32), (64, 48)] {
+        for filter in [FilterType::Lanczos3, FilterType::Triangle] {
+            c.bench_function(
+                &format!("DynamicImage::resize_exact 4032x3024->{w}x{h} {filter:?}"),
+                |b| {
+                    b.iter_batched(
+                        || src_dyn.clone(),
+                        |mut img| img.resize_exact(w, h, filter),
+                        BatchSize::LargeInput,
+                    );
+                },
+            );
+        }
+    }
+
+    let small_src = ImageBuffer::from_fn(400, 300, |x, y| {
+        Rgb([x as u8, (y / 8) as u8, ((x * 13 + y) % 256) as u8])
+    });
+    let small_src_dyn = DynamicImage::from(small_src);
+    for filter in [
+        FilterType::Lanczos3,
+        FilterType::Triangle,
+        FilterType::CatmullRom,
+        FilterType::Gaussian,
+        FilterType::Nearest,
+    ] {
+        c.bench_function(
+            &format!("DynamicImage::resize_exact 400x300->32x24 {filter:?}"),
+            |b| {
+                b.iter_batched(
+                    || small_src_dyn.clone(),
+                    |mut img| img.resize_exact(32, 24, filter),
+                    BatchSize::LargeInput,
+                );
+            },
+        );
+    }
+}
+
+criterion_group!(benches, bench_imageops, bench_resize, bench_resize_dynamic);
 criterion_main!(benches);
