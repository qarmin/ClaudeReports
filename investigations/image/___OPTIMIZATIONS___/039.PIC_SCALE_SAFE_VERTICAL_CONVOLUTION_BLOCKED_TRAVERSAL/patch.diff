+use num_traits::{AsPrimitive, Signed};
+use std::ops::{Mul, Sub};
+
+#[inline(always)]
+pub(crate) fn quadric<V: Copy + Mul<Output = V> + Signed + Sub<Output = V> + 'static + PartialOrd>(
+    x: V,
+) -> V
+where
+    f32: AsPrimitive<V>,
+{
+    let x = x.abs();
+    if x < 0.5f32.as_() {
+        return 0.75f32.as_() - x * x;
+    } else if x < 1.5f32.as_() {
+        let t = x - 1.5f32.as_();
+        return 0.5f32.as_() * t * t;
+    }
+    0f32.as_()
+}
