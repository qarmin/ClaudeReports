+    resampling_function: ResamplingFunction,
+) -> Result<Vec<f32>, String> {
+    resize_floating_point::<f32, f32, f32, 4>(
+        source,
+        source_size,
+        destination_size,
+        8,
+        resampling_function,
+    )
+}
