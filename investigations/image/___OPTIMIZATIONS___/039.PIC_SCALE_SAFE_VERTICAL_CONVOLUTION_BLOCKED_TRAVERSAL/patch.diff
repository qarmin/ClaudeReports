+#[inline(always)]
+pub(crate) fn lanczos2<V: Copy + PartialEq + Div<Output = V> + 'static + Float + ConstPI>(x: V) -> V
+where
+    f32: AsPrimitive<V>,
+{
+    lanczos_sinc(x, 2f32.as_())
+}
