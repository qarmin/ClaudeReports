+
+#[inline(always)]
+pub(crate) fn spline16<
+    V: Copy
+        + Div<Output = V>
+        + Add<Output = V>
+        + Sub<Output = V>
+        + Mul<Output = V>
+        + 'static
+        + PartialOrd
+        + Div<Output = V>,
+>(
+    x: V,
+) -> V
+where
+    f64: AsPrimitive<V>,
+    f32: AsPrimitive<V>,
+{
+    if x < 1.0.as_() {
+        ((x - 9.0.as_() / 5.0.as_()) * x - 1.0.as_() / 5.0.as_()) * x + 1.0.as_()
+    } else {
+        (((-1.0).as_() / 3.0.as_() * (x - 1f32.as_()) + 4.0.as_() / 5.0.as_()) * (x - 1f32.as_())
+            - 7.0.as_() / 15.0.as_())
+            * (x - 1f32.as_())
+    }
+}
+
+#[inline(always)]
+pub(crate) fn spline36<
+    V: Copy
