# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# patch.diff bundles a harness-only hunk (new brighten_in_place/contrast_in_place criterion
# cases in benches/imageops.rs) with the actual fix (src/imageops/colorops.rs: fast path +
# #[inline(always)] on brighten_in_place only - contrast_in_place is left untouched, see
# RESULT.md). apply-harness applies just the former so the same benchmark exists in both the
# baseline and patched build; apply-fix applies the latter on top, for the patched build only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/colorops.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/colorops.rs' "{{justfile_directory()}}/patch.diff"

bench-baseline:
    @echo "=== baseline (before patch) ==="
    cd clone && cargo bench --bench imageops -- "^brighten_in_place$"

bench-patched:
    @echo "=== patched (after patch) ==="
    cd clone && cargo test --release --lib imageops::colorops
    cd clone && cargo bench --bench imageops -- "^brighten_in_place$"

clean:
    rm -rf clone
