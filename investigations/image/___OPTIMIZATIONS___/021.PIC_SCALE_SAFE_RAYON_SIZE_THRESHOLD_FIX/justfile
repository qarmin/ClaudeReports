# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# patch.diff is a diff against base_commit below and includes THREE bundled changes (not just
# this candidate's own fix), because the fix is only meaningful on top of them:
#   1. Candidate 002's `pic-scale-safe/rayon` Cargo.toml feature-forward (without it,
#      pic-scale-safe's internal rayon dispatch never compiles in at all, so there is no
#      regression to fix).
#   2. Candidate 019's `bench_resize_dynamic` criterion group in benches/imageops.rs (needed to
#      reach/measure the affected `DynamicImage::resize_exact` code path at these sizes).
#   3. This candidate's own change: a `SMALL_RESIZE_SOURCE_PIXEL_THRESHOLD`-gated single-thread
#      rayon pool wrapping the pic-scale-safe call in src/imageops/resize.rs.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/image-rs/image.git"
base_commit := "44ce9226c541dd2b11897b9ef07156a28871cdb7"

# apply-harness applies the bundled Cargo.toml + benches/imageops.rs hunks (1 and 2 above, i.e.
# the "A" baseline in RESULT.md) so the same benchmarks exist in both the baseline and patched
# build; apply-fix applies the remaining src/imageops/resize.rs hunk (3 above, this candidate's
# own size-threshold gate) on top, for the patched build only.
test: clone apply-harness bench-baseline apply-fix bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-harness:
    cd clone && git apply --exclude='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

apply-fix:
    cd clone && git apply --include='src/imageops/resize.rs' "{{justfile_directory()}}/patch.diff"

# Runs the same benchmark IDs measured in RESULT.md. Requires the `rayon` feature (default-on).
bench-baseline:
    @echo "=== baseline (before patch, i.e. rayon forwarded + bench harness, no size-threshold gate) ==="
    cd clone && cargo build --release --bench imageops
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Triangle" --exact
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Lanczos3" --exact
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 4032x3024->400x300 Lanczos3" --exact

bench-patched:
    @echo "=== patched (after patch, size-threshold gate applied) ==="
    cd clone && cargo build --release --bench imageops
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Triangle" --exact
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 400x300->32x24 Lanczos3" --exact
    cd clone && ./target/release/deps/imageops-* --bench "dynamic_resize/DynamicImage::resize_exact 4032x3024->400x300 Lanczos3" --exact

test-suite:
    cd clone && cargo test --release

clean:
    rm -rf clone
