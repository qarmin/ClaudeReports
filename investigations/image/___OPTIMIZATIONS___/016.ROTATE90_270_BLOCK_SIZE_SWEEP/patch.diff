+    // cache line's worth of rows. Process the image in small square tiles instead: within one
+    // tile the write side only touches `BLOCK` destination rows spanning `BLOCK` pixels each,
+    // which stays cache-resident, while still avoiding per-pixel get_pixel/put_pixel dispatch.
+    let pix_stride = usize::from(<I::Pixel as Pixel>::CHANNEL_COUNT);
