#
# Requires this project's own toolchain to already be buildable in the environment running this
# (see the upstream project's Readme.md "Quick start" - `./y.sh prepare` needs network access to
# download a prebuilt libgccjit.so and to fetch rustc-dev components). Not fast: a fresh clone's
# first `./y.sh prepare && ./y.sh build --sysroot --release` takes a few minutes.

repo_url := "https://github.com/rust-lang/rustc_codegen_gcc.git"
base_commit := "4cd7da5f9a5d9509b34ac0a766424ccdae706d33"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && cp config.example.toml config.toml
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build --sysroot --release

# Runs the dev-vs-release comparison inside the fresh clone and prints a MATCH/MISMATCH verdict -
# see repro/run.sh for what each step does.
reproduce-before:
    bash repro/run.sh clone

clean:
    rm -rf clone
