# Self-contained reproduction for candidate 032 (cmpxchg16b_atomic_u128_missing_latomic_link).
#
# Unlike a typical `cargo run` repro, the thing under test is a compiler backend, not a library -
# so "run the repro" means "compile a small Rust source file through the real backend
# (`y.sh rustc`, wrapping `rustc -Zcodegen-backend=...`) and run the resulting binary", following
# the same pattern as candidates 004/027 in this workspace.
#
# `repro/atomic128.rs` uses `core::intrinsics::atomic_cxchg`/`atomic_xadd::<u128, ...>` directly
# rather than `std::sync::atomic::AtomicU128` - see `repro/README.md`/`RESULT.md` for why
# (`AtomicU128` doesn't exist on x86_64-unknown-linux-gnu at all, on any backend).

repo_url := "https://github.com/rust-lang/rustc_codegen_gcc.git"
base_commit := "4cd7da5f9a5d9509b34ac0a766424ccdae706d33"

test: clone build reproduce-before apply rebuild reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r repro clone/repro

# One-time setup: downloads a prebuilt libgccjit.so and builds the sysroot (core/alloc/std).
# ~2-3 minutes on a modern multi-core machine, per this workspace's own README.md.
build:
    echo 'download-gccjit = true' > clone/config.toml
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build --sysroot --release

# Compile+run the repro against the pristine (unpatched) backend, WITH the feature that's supposed
# to make 128-bit atomics native - this should fail to link with `undefined reference to
# \`__atomic_compare_exchange_16'`/`__atomic_fetch_add_16'`.
reproduce-before:
    ulimit -c 0
    cd clone && CHANNEL=release ./y.sh rustc repro/atomic128.rs -o /tmp/atomic128_before -C target-feature=+cmpxchg16b

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

rebuild:
    cd clone && CHANNEL=release ./y.sh build --release

# Same repro again, now against the patched backend - should link and print
# `cmpxchg: old=1 ok=true x=2`, `fetch_add: prev=10 y=15`, `OK`.
reproduce-after:
    ulimit -c 0
    cd clone && CHANNEL=release ./y.sh rustc repro/atomic128.rs -o /tmp/atomic128_after -C target-feature=+cmpxchg16b
    /tmp/atomic128_after

clean:
    rm -rf clone
