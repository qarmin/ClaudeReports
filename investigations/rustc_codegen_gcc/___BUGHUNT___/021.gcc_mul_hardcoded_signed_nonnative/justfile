# Self-contained reproduction for candidate 021 (gcc_mul_hardcoded_signed_nonnative).
#
# Status: Not reproducible - there is no patch.diff (no bug, no fix). `just test` clones a
# pristine checkout and re-runs the same investigation this candidate's RESULT.md describes:
# compile-and-run a boundary-value i128/u128 multiplication program three ways (plain rustc/LLVM
# reference, this backend's native-128-bit-int path, and this backend with the array-based
# non-native path forced via a transient diagnostic patch that is applied and reverted inside the
# clone only), disassemble to confirm __multi3 (not __umulti3) was actually called, and diff the
# outputs.
#
# Requires this project's own toolchain to already be buildable in the environment running this
# (see the upstream project's Readme.md "Quick start" - `./y.sh prepare` needs network access to
# download a prebuilt libgccjit.so and to fetch rustc-dev components). Not fast: a fresh clone's
# first `./y.sh prepare && ./y.sh build --sysroot --release` takes a few minutes.

repo_url := "https://github.com/rust-lang/rustc_codegen_gcc.git"
base_commit := "4cd7da5f9a5d9509b34ac0a766424ccdae706d33"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && cp config.example.toml config.toml
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build --sysroot --release

# Runs the full three-way comparison (rustc/LLVM reference, native-128-bit-int backend path,
# forced array-based non-native backend path) inside the fresh clone and prints a MATCH/MISMATCH
# verdict - see repro/run.sh for what each step does.
reproduce-before:
    bash repro/run.sh clone

clean:
    rm -rf clone
