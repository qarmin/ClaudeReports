# Self-contained reproduction for candidate 027 (atomic_load_ignored_ty_plain_loads).
#
# Not reproducible - no patch.diff, so only `reproduce-before` exists (per candidate_justfile's
# own template note). This still builds and runs the real end-to-end path (a real rustc
# compilation through the real codegen backend), it just demonstrates the suspected bug does NOT
# occur - see RESULT.md.

repo_url := "https://github.com/rust-lang/rustc_codegen_gcc.git"
base_commit := "4cd7da5f9a5d9509b34ac0a766424ccdae706d33"

test: clone build reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r repro clone/repro

# One-time setup: downloads a prebuilt libgccjit.so and builds the sysroot (core/alloc/std).
# ~2-3 minutes on a modern multi-core machine, per this workspace's own README.md.
build:
    echo 'download-gccjit = true' > clone/config.toml
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build --sysroot --release

# Compile+run all three repro files against the real backend - all are expected to print
# TOTAL_FAILURES=0 (that's the point: the hypothesized sign bug does not reproduce).
reproduce-before:
    cd clone && CHANNEL=release ./y.sh rustc repro/widen_and_compare.rs -o /tmp/atomic_load_widen_and_compare
    /tmp/atomic_load_widen_and_compare
    cd clone && CHANNEL=release ./y.sh rustc repro/div_and_pointer_width.rs -o /tmp/atomic_load_div_and_pointer_width
    /tmp/atomic_load_div_and_pointer_width
    cd clone && CHANNEL=release ./y.sh rustc repro/match_and_minmax.rs -o /tmp/atomic_load_match_and_minmax
    /tmp/atomic_load_match_and_minmax

clean:
    rm -rf clone
