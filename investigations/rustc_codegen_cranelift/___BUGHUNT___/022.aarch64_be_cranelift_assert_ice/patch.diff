diff --git a/src/lib.rs b/src/lib.rs
index 6d2a3537..d383ecaf 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -272,6 +272,19 @@ fn build_isa(sess: &Session, jit: bool) -> Arc<dyn TargetIsa + 'static> {
 
     let target_tuple = crate::target_tuple(sess);
 
+    // `cranelift_codegen::isa::lookup` dispatches on the architecture *family* and then the
+    // backend's own `isa_builder` asserts the exact variant, so an unsupported variant panics
+    // instead of returning `Err(LookupError::Unsupported)`. Big-endian AArch64 is the only such
+    // variant among the architectures Cranelift knows about; reject it with a diagnostic.
+    if let target_lexicon::Architecture::Aarch64(aarch64_arch) = target_tuple.architecture {
+        if aarch64_arch != target_lexicon::Aarch64Architecture::Aarch64 {
+            sess.dcx().fatal(format!(
+                "can't compile for {}: big-endian AArch64 is not supported by Cranelift",
+                target_tuple
+            ));
+        }
+    }
+
     let mut flags_builder = settings::builder();
     flags_builder.set("is_pic", if jit { "false" } else { "true" }).unwrap();
     let enable_verifier = if enable_verifier(sess) { "true" } else { "false" };
