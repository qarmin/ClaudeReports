# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Extra host requirements beyond a Rust nightly toolchain:
#   * qemu-aarch64_be   - user-mode BIG-ENDIAN aarch64 emulation, so the LLVM-produced
#                         bare-metal binary is actually RUN and its output compared
#                         (Debian/Ubuntu: qemu-user)
#   * the rust-src component of the pinned nightly (rust-toolchain.toml asks for it), because
#     there is no rustup rust-std for any aarch64_be target - `core` is built from source
#
# `just build-clif` takes a few minutes the first time (it builds cg_clif and its sysroot).

# Swap to https://github.com/rust-lang/rustc_codegen_cranelift.git if you have no SSH key set up.
repo_url := "git@github.com:rust-lang/rustc_codegen_cranelift.git"
base_commit := "2bc05d45078dbee6495c008cbd5d1dc24edff53f"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone build-clif reproduce-before apply build-clif reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build-clif:
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build

# Expected: LLVM builds/links/RUNS the big-endian aarch64 binary (prints 7890598189674834828),
# while the pristine cg_clif ICEs with
#   assertion failed: triple.architecture == Architecture::Aarch64(Aarch64Architecture::Aarch64)
# on all six aarch64_be-* targets -> exit 1.
reproduce-before:
    -ulimit -c 0 && CLIF_ROOT="{{justfile_directory()}}/clone" bash repro/run.sh

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro against the patched clone. Cranelift has no big-endian aarch64 backend at all, so
# the expected post-fix behaviour is a clean
#   error: can't compile for aarch64_be-...: big-endian AArch64 is not supported by Cranelift
# instead of an ICE, and no change for any other target -> exit 0.
reproduce-after:
    ulimit -c 0 && CLIF_ROOT="{{justfile_directory()}}/clone" bash repro/run.sh

# Optional: the whole-target-list blast-radius sweep whose captured outputs are in
# repro/target_sweep_{before,after}.txt (~331 targets, a couple of minutes).
sweep:
    ulimit -c 0 && CLIF_ROOT="{{justfile_directory()}}/clone" bash repro/sweep_targets.sh

clean:
    rm -rf clone repro/work
