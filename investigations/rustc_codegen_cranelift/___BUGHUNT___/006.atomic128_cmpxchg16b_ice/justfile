# Self-contained reproduction for candidate 006 (128-bit atomics ICE in cg_clif).
#
# Nothing here reaches outside this folder: `just clone` fetches cg_clif into ./clone (gitignored)
# and builds it, then the repro is compiled twice from the same source - once with plain rustc
# (LLVM = the oracle) and once with the clone's dist/cargo-clif - and the run-time output compared.
#
# `just test` is the full cycle: clone, build cg_clif, show the ICE, apply patch.diff, rebuild,
# show the ICE is gone and the program now prints LLVM's answer.
#
# To point the reproduce recipes at an existing cg_clif checkout instead of ./clone:
#   CLIF_ROOT=/path/to/rustc_codegen_cranelift just llvm clif

repo_url := "git@github.com:rust-lang/rustc_codegen_cranelift.git"
base_commit := "2bc05d45078dbee6495c008cbd5d1dc24edff53f"

clif := env_var_or_default("CLIF_ROOT", justfile_directory() / "clone")

# cg_clif never forwards `-C target-feature` to Cranelift, so this flag is what makes LLVM able to
# compile the program at opt-level 0 (without it LLVM emits an __atomic_compare_exchange_16 libcall
# that doesn't link) while cg_clif still believes the ISA has no cmpxchg16b.
export RUSTFLAGS := "-Ctarget-feature=+cmpxchg16b"

test:
    @test -z "${CLIF_ROOT:-}" || { echo "run 'just test' without CLIF_ROOT set - it builds ./clone"; exit 2; }
    just clone
    just build-clif
    just llvm
    @echo "=== cg_clif BEFORE the patch (expected: ICE) ==="
    -just clif
    just apply
    just build-clif
    @echo "=== cg_clif AFTER the patch (expected: same output as LLVM) ==="
    just clif

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build-clif:
    cd {{clif}} && ./y.sh prepare
    cd {{clif}} && ./y.sh build

# The oracle: plain rustc/LLVM on the same source.
llvm:
    ulimit -c 0 && cd repro && CARGO_TARGET_DIR=target-llvm cargo run --bin atomic128_cmpxchg16b_ice

# The same source through cg_clif.
clif:
    ulimit -c 0 && cd repro && CARGO_TARGET_DIR=target-clif {{clif}}/dist/cargo-clif run --bin atomic128_cmpxchg16b_ice

# The wider bug class: every 128-bit atomic intrinsic (load/store/cxchg/cxchgweak/xchg/xadd/xsub/
# and/or/xor/nand/umax/umin/max/min) over four boundary values, single-file, no cargo.
family:
    ulimit -c 0 && cd repro && rustc $RUSTFLAGS -o /tmp/a128_llvm atomic128_family.rs && /tmp/a128_llvm > /tmp/a128_llvm.out
    ulimit -c 0 && cd repro && {{clif}}/dist/rustc-clif $RUSTFLAGS -o /tmp/a128_clif atomic128_family.rs && /tmp/a128_clif > /tmp/a128_clif.out
    diff /tmp/a128_llvm.out /tmp/a128_clif.out && echo "family sweep: LLVM and cg_clif agree"

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

clean:
    rm -rf clone repro/target-llvm repro/target-clif
