# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Extra host requirements beyond a Rust nightly toolchain:
#   * qemu-aarch64      - user-mode aarch64 emulation, so the produced bare-metal binary is
#                         actually RUN and its output compared (Debian/Ubuntu: qemu-user)
#   * the rust-src component of the pinned nightly (rust-toolchain.toml asks for it), because
#     there is no rustup rust-std for aarch64-unknown-none - `core` is built from source
#
# `just build-clif` takes a few minutes the first time (it builds cg_clif and its sysroot).

# Swap to https://github.com/rust-lang/rustc_codegen_cranelift.git if you have no SSH key set up
# (that is the URL the in-session check of `just clone` + `just apply` actually used).
repo_url := "git@github.com:rust-lang/rustc_codegen_cranelift.git"
base_commit := "2bc05d45078dbee6495c008cbd5d1dc24edff53f"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone build-clif reproduce-before apply build-clif reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

build-clif:
    cd clone && ./y.sh prepare
    cd clone && ./y.sh build

# Build+link+RUN the bare-metal aarch64 program with rustc (LLVM) and with the pristine cg_clif.
# Expected: LLVM prints 7890598189674834828, cg_clif ICEs in src/driver/aot.rs -> exit 1.
reproduce-before:
    -ulimit -c 0 && CLIF_ROOT="{{justfile_directory()}}/clone" bash repro/run.sh

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro against the patched clone: both sides must now print 7890598189674834828 -> exit 0.
reproduce-after:
    ulimit -c 0 && CLIF_ROOT="{{justfile_directory()}}/clone" bash repro/run.sh

clean:
    rm -rf clone repro/work
