+/// The value of an `in`/`inout` inline asm operand. Cranelift has no SSA type wider than 128 bits,
+/// so an operand in a `ymm_reg`/`zmm_reg`-style register class can only be handed to the asm
+/// wrapper through memory, never through an SSA value.
+#[derive(Copy, Clone, Debug)]
+pub(crate) enum AsmValue {
+    Val(Value),
+    ByRef(Pointer, Size),
+}
+
+impl From<Value> for AsmValue {
+    fn from(value: Value) -> Self {
+        AsmValue::Val(value)
+    }
+}
