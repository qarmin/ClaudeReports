 }
 
+/// Widest value Cranelift has an SSA type for (`i128`/`i8x16`); anything above this can only be
+/// moved through memory.
+const MAX_ASM_SSA_VALUE_SIZE: u64 = 16;
+
+fn asm_input_value<'tcx>(fx: &mut FunctionCx<'_, '_, 'tcx>, value: CValue<'tcx>) -> AsmValue {
+    let size = value.layout().size;
+    if size.bytes() > MAX_ASM_SSA_VALUE_SIZE {
+        let (ptr, meta) = value.force_stack(fx);
+        assert!(meta.is_none());
+        AsmValue::ByRef(ptr, size)
+    } else {
+        AsmValue::Val(value.load_scalar(fx))
+    }
+}
+
+fn copy_asm_operand(fx: &mut FunctionCx<'_, '_, '_>, dst: Pointer, src: Pointer, size: Size) {
+    let dst_addr = dst.get_addr(fx);
+    let src_addr = src.get_addr(fx);
+    // The asm wrapper's stack slot is only 16-byte aligned, and nothing is known about the
+    // alignment of the operand's own storage either, so claim the minimum for both.
+    fx.bcx.emit_small_memory_copy(
+        fx.target_config,
+        dst_addr,
+        src_addr,
+        size.bytes(),
+        1,
+        1,
+        true,
+        MemFlagsData::new().with_notrap(),
+    );
+}
