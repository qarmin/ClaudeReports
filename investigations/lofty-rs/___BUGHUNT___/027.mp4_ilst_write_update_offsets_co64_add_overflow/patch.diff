+// `read_offset` comes straight from file data and can be any `u64`, including values well
+// outside the range a bare `read_offset as i64 + difference` can represent without overflowing.
+fn apply_offset_difference(
+	ident: &AtomIdent<'static>,
+	read_offset: u64,
+	difference: i64,
+) -> Result<u64, FileEncodingError> {
+	i64::try_from(read_offset)
+		.ok()
+		.and_then(|offset| offset.checked_add(difference))
+		.and_then(|offset| u64::try_from(offset).ok())
+		.ok_or_else(|| {
+			FileParseError::from(AtomParseError::message(
+				Some(ident.clone()),
+				"offset update would overflow",
+			))
+			.into()
+		})
+}
