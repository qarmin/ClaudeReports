# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.

repo_url := "https://github.com/Serial-ATA/lofty-rs.git"
base_commit := "5c6565e36d35b9ea7de049daa67acc0be0fd3b01"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
# `reproduce-before` intentionally exits non-zero when the bug reproduces (see repro/src/main.rs),
# so it's run with `-just` continue-on-error rather than a plain dependency chain that would
# otherwise abort right after successfully demonstrating the bug.
test:
    just clone
    -just reproduce-before
    just apply
    just reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug (a
# silently wrapped/corrupted `stco` chunk offset written to disk, no panic, no error).
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - `save_to` should now return a graceful
# `FileEncodingError` instead of silently writing a wrapped offset.
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
