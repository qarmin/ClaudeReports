# Self-contained reproduction for candidate 028: characterizing the corpus-size/composition
# threshold that lets `--sanitizer address` reliably avoid the ASAN symbolizer hang (candidates
# 009/018/019/024).
#
# This is a tooling/environment finding, not a bug in lofty's own source - there is no patch.diff
# to apply, so this justfile only has a reproduce-before step. The corpus this candidate uses is
# built for real, from scratch, inside repro/run.sh (no committed fuzz/corpus/ exists in the repo
# - see README.md).

repo_url := "https://github.com/Serial-ATA/lofty-rs.git"
base_commit := "5c6565e36d35b9ea7de049daa67acc0be0fd3b01"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Runs the real `cargo +nightly fuzz run` command against the pristine clone's own existing fuzz/
# targets (mp4file_read_from and speexfile_read_from by default): builds a real corpus from
# scratch via several independent --sanitizer none bursts, then shows the same ASAN command
# hanging from an empty corpus and completing cleanly once that real corpus exists. Requires:
# nightly toolchain + cargo-fuzz installed (same as required for candidates 009/018/019/024).
# Takes several minutes (builds two targets in two sanitizer modes, plus corpus-building bursts).
reproduce-before:
    ./repro/run.sh clone mp4file_read_from speexfile_read_from

clean:
    rm -rf clone
