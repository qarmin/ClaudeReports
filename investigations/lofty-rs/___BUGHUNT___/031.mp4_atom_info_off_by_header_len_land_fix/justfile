# Self-contained reproduction for candidate 031: landing candidate 026's already-verified
# `atom_info.rs` fix for real.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/Serial-ATA/lofty-rs.git"
base_commit := "5c6565e36d35b9ea7de049daa67acc0be0fd3b01"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (non-zero exit, "REPRODUCED" on stderr). The repro's own exit code encodes reproduced/not, so
# this recipe doesn't propagate it as a `just` failure - `test`'s later steps must still run.
reproduce-before:
    cd repro && cargo run --release --bin repro031; true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug
# (exit 0, "did not reproduce").
reproduce-after:
    cd repro && cargo run --release --bin repro031

# Supplementary, non-gating: demonstrates this fix's documented scope limit (candidate 030's
# separate, still-unpatched moov.rs bug independently still causes the "+8" case even after this
# candidate's fix - see RESULT.md). Always exits 0 by design; read the printed lines.
scope-check:
    cd repro && cargo run --release --bin mdia_slack_scope

clean:
    rm -rf clone repro/target
