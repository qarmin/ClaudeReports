+fn __bucket_for(op: &TypedInstruction<'_, '_>) -> crate::__OpBucket {
+    use crate::__OpBucket::*;
+    match op {
+        TypedInstruction::SaveState(_) | TypedInstruction::RestoreState(_) => StateStack,
+        TypedInstruction::Transform(_) => Transform,
+        TypedInstruction::RectPath(_)
