+        | TypedInstruction::LineTo(_)
+        | TypedInstruction::CubicTo(_)
+        | TypedInstruction::CubicStartTo(_)
+        | TypedInstruction::CubicEndTo(_)
+        | TypedInstruction::ClosePath(_)
+        | TypedInstruction::EndPath(_)
+        | TypedInstruction::ClipNonZero(_)
+        | TypedInstruction::ClipEvenOdd(_) => PathBuild,
+        TypedInstruction::FillPathEvenOdd(_)
+        | TypedInstruction::FillPathNonZero(_)
+        | TypedInstruction::FillPathNonZeroCompatibility(_)
+        | TypedInstruction::FillAndStrokeEvenOdd(_)
+        | TypedInstruction::FillAndStrokeNonZero(_)
+        | TypedInstruction::CloseAndStrokePath(_)
+        | TypedInstruction::CloseFillAndStrokeEvenOdd(_)
+        | TypedInstruction::CloseFillAndStrokeNonZero(_)
+        | TypedInstruction::StrokePath(_) => PathDraw,
+        TypedInstruction::LineWidth(_)
+        | TypedInstruction::LineCap(_)
+        | TypedInstruction::LineJoin(_)
+        | TypedInstruction::MiterLimit(_)
+        | TypedInstruction::DashPattern(_)
+        | TypedInstruction::RenderingIntent(_)
+        | TypedInstruction::FlatnessTolerance(_)
+        | TypedInstruction::SetGraphicsState(_)
+        | TypedInstruction::ColorSpaceStroke(_)
+        | TypedInstruction::ColorSpaceNonStroke(_)
+        | TypedInstruction::StrokeColor(_)
+        | TypedInstruction::StrokeColorNamed(_)
+        | TypedInstruction::NonStrokeColor(_)
+        | TypedInstruction::NonStrokeColorNamed(_)
+        | TypedInstruction::StrokeColorDeviceGray(_)
+        | TypedInstruction::NonStrokeColorDeviceGray(_)
+        | TypedInstruction::StrokeColorDeviceRgb(_)
+        | TypedInstruction::NonStrokeColorDeviceRgb(_)
+        | TypedInstruction::StrokeColorCmyk(_)
+        | TypedInstruction::NonStrokeColorCmyk(_) => Color,
+        TypedInstruction::TextFont(_) => TextFontOp,
+        TypedInstruction::CharacterSpacing(_)
+        | TypedInstruction::WordSpacing(_)
+        | TypedInstruction::HorizontalScaling(_)
+        | TypedInstruction::TextLeading(_)
+        | TypedInstruction::TextRenderingMode(_)
+        | TypedInstruction::TextRise(_)
+        | TypedInstruction::BeginText(_)
+        | TypedInstruction::EndText(_)
+        | TypedInstruction::NextLine(_)
+        | TypedInstruction::NextLineAndSetLeading(_)
+        | TypedInstruction::SetTextMatrix(_)
+        | TypedInstruction::NextLineUsingLeading(_) => TextState,
+        TypedInstruction::ShowText(_)
+        | TypedInstruction::NextLineAndShowText(_)
+        | TypedInstruction::ShowTextWithParameters(_)
+        | TypedInstruction::ShowTexts(_) => TextShow,
+        TypedInstruction::Shading(_)
+        | TypedInstruction::XObject(_)
+        | TypedInstruction::InlineImage(_)
+        | TypedInstruction::ColorGlyph(_)
+        | TypedInstruction::ShapeGlyph(_)
+        | TypedInstruction::MarkedContentPoint(_)
+        | TypedInstruction::MarkedContentPointWithProperties(_)
+        | TypedInstruction::BeginMarkedContent(_)
+        | TypedInstruction::BeginMarkedContentWithProperties(_)
+        | TypedInstruction::EndMarkedContent(_)
+        | TypedInstruction::BeginCompatibility(_)
+        | TypedInstruction::EndCompatibility(_) => XObjectMisc,
+        _ => Other,
+    }
+}
