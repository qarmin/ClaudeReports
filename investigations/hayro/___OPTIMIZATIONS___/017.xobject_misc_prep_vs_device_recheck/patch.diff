+
+// Finer-grained buckets for the "dispatch overhead not explained by tokenizing or
+// font/glyph resolution" remainder (candidate 007). Each bucket's time is the whole
+// match-arm body, INCLUDING nested calls into fill_path/stroke_path/show_text_string/
+// x_object.draw - for PathDraw and TextShow this overlaps with hayro's own
+// draw_path/draw_glyph_run/draw_image timers, subtract those (via
+// hayro::__debug_op_timings_ns) to get the "prep work before reaching the device call"
+// portion specifically.
+#[derive(Clone, Copy)]
+pub(crate) enum __OpBucket {
+    StateStack,
+    Transform,
+    PathBuild,
+    PathDraw,
+    Color,
+    TextState,
+    TextFontOp,
+    TextShow,
+    XObjectMisc,
+    Other,
+}
+pub(crate) static __PHASE_STATE_STACK_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_TRANSFORM_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_PATH_BUILD_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_PATH_DRAW_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_COLOR_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_TEXT_STATE_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_TEXT_FONT_OP_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_TEXT_SHOW_WHOLE_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_XOBJECT_MISC_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+pub(crate) static __PHASE_OTHER_BUCKET_NS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+pub(crate) fn __record_bucket(bucket: __OpBucket, ns: u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let counter = match bucket {
+        __OpBucket::StateStack => &__PHASE_STATE_STACK_NS,
+        __OpBucket::Transform => &__PHASE_TRANSFORM_NS,
+        __OpBucket::PathBuild => &__PHASE_PATH_BUILD_NS,
+        __OpBucket::PathDraw => &__PHASE_PATH_DRAW_NS,
+        __OpBucket::Color => &__PHASE_COLOR_NS,
+        __OpBucket::TextState => &__PHASE_TEXT_STATE_NS,
+        __OpBucket::TextFontOp => &__PHASE_TEXT_FONT_OP_NS,
+        __OpBucket::TextShow => &__PHASE_TEXT_SHOW_WHOLE_NS,
+        __OpBucket::XObjectMisc => &__PHASE_XOBJECT_MISC_NS,
+        __OpBucket::Other => &__PHASE_OTHER_BUCKET_NS,
+    };
+    counter.fetch_add(ns, Relaxed);
+}
+
+/// TEMPORARY profiling hook, not part of the public API.
+#[doc(hidden)]
+pub fn __debug_op_buckets_ns() -> [(&'static str, u64); 9] {
+    use std::sync::atomic::Ordering::Relaxed;
+    [
+        ("state_stack", __PHASE_STATE_STACK_NS.load(Relaxed)),
+        ("transform", __PHASE_TRANSFORM_NS.load(Relaxed)),
+        ("path_build", __PHASE_PATH_BUILD_NS.load(Relaxed)),
+        ("path_draw_whole", __PHASE_PATH_DRAW_NS.load(Relaxed)),
+        ("color", __PHASE_COLOR_NS.load(Relaxed)),
+        ("text_state", __PHASE_TEXT_STATE_NS.load(Relaxed)),
+        ("text_font_op", __PHASE_TEXT_FONT_OP_NS.load(Relaxed)),
+        ("text_show_whole", __PHASE_TEXT_SHOW_WHOLE_NS.load(Relaxed)),
+        ("xobject_misc", __PHASE_XOBJECT_MISC_NS.load(Relaxed)),
+    ]
+}
