+        (0..width)
+            .map(|_| {
+                state = state.wrapping_mul(1664525).wrapping_add(1013904223);
+                // Values roughly in wavelet-coefficient range, including negatives.
+                (state as i32 as f32) / (i32::MAX as f32) * 2048.0
+            })
+            .collect()
+    }
+
+    // `reference` uses true FMA (`f32::mul_add`) throughout, matching what the
+    // SIMD bulk path always uses (fearless_simd dispatches to real hardware FMA
+    // at runtime, independent of this crate's compile-time `target-feature`
+    // flags). The new code's *scalar* remainder/boundary positions still use
+    // `crate::math::mul_add`, which on this build falls back to unfused `a*b+c`
+    // (see `math.rs`'s doc comment: "very imprecise, but hopefully good enough")
+    // whenever `target-feature=fma` wasn't set at compile time - exactly the
+    // same tradeoff the existing, shipped `filter_step_vertical` already makes
+    // between its SIMD bulk and scalar remainder. So this test allows a small
+    // tolerance rather than requiring bit-exact equality, and its real purpose
+    // is to catch *index/logic* bugs (which show up as wildly wrong values,
+    // wrong lengths, or panics), not to police FMA rounding policy.
+    fn approx_eq(a: f32, b: f32) -> bool {
+        let diff = (a - b).abs();
+        let scale = a.abs().max(b.abs()).max(1.0);
+        diff <= (scale * 1e-4).max(5e-4)
+    }
+
+    #[test]
+    fn new_simd_path_matches_reference_within_fp_tolerance_exhaustively() {
+        let mut mismatches = Vec::new();
+        let mut max_relative_diff = 0.0f32;
+
+        for &transform in &[WaveletTransform::Reversible53, WaveletTransform::Irreversible97] {
+            for width in 1..=80usize {
+                for x0 in 0..2usize {
+                    for seed in 0..4u32 {
+                        let original = synthetic_row(width, seed + width as u32 * 7);
+
+                        let mut expected = original.clone();
+                        reference::filter_row(&mut expected, width, x0, transform);
+
+                        let mut actual = original.clone();
+                        let rect = IntRect::from_ltrb(x0 as u32, 0, (x0 + width) as u32, 1);
+                        filter_horizontal(&mut actual, rect, transform);
+
+                        for (&e, &a) in expected.iter().zip(&actual) {
+                            let scale = e.abs().max(a.abs()).max(1.0);
+                            max_relative_diff = max_relative_diff.max((e - a).abs() / scale);
+                        }
+
+                        if !expected.iter().zip(&actual).all(|(&e, &a)| approx_eq(e, a)) {
+                            mismatches.push((transform, width, x0, seed, expected, actual));
+                        }
+                    }
+                }
+            }
+        }
+
+        eprintln!("max relative diff observed: {max_relative_diff:e}");
+        assert!(
+            mismatches.is_empty(),
+            "{} mismatches (beyond FP tolerance) between reference and new SIMD horizontal filter; first: {:?}",
+            mismatches.len(),
+            mismatches.first()
+        );
+    }
+}
