# Self-contained reproduction for this candidate.
#
# This candidate is a decision/investigation, not a hot-path speed patch: it checks whether
# adding a rust-toolchain.toml (pinning the currently-installed `stable` version) changes
# anything observable today. `just test` builds hayro-bench's own `render_bench` (already in
# the repo, no standalone bench crate needed) before and after the patch, renders the same
# PDF with both, and diffs the produced PNG bytes - see RESULT.md for the full methodology
# (raw-binary diff vs. output diff, and why they differ).
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

# Full cycle: clone at the pinned commit, build a BASELINE binary before touching anything,
# apply the patch, build a PATCHED binary, then render the same PDF with both and compare.
test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/bench_input
    cp "{{justfile_directory()}}/testdata/img.pdf" clone/bench_input/img.pdf

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd clone && rm -rf target && cargo build --release -p hayro-bench
    cp clone/target/release/render_bench ./bin_baseline

build-patched:
    cd clone && rm -rf target && cargo build --release -p hayro-bench
    cp clone/target/release/render_bench ./bin_patched

# Renders bench_input/img.pdf with both binaries (--save-bitmaps), then compares the produced
# PNG bytes - the actual correctness question this candidate answers. Also prints render_bench's
# own timing line for both, for reference (see RESULT.md: expect these to be noise-level close,
# not a real speed difference either way).
bench:
    @echo "=== baseline (unpinned toolchain) ==="
    cd clone && rm -rf bench_input-hayro && ../bin_baseline bench_input --backend hayro --iter 20 --save-bitmaps
    cp clone/bench_input-hayro/img/page_0001_*.png ./out_baseline.png
    @echo "=== patched (pinned rust-toolchain.toml) ==="
    cd clone && rm -rf bench_input-hayro && ../bin_patched bench_input --backend hayro --iter 20 --save-bitmaps
    cp clone/bench_input-hayro/img/page_0001_*.png ./out_patched.png
    @echo "=== output comparison ==="
    @sha256sum out_baseline.png out_patched.png
    @cmp out_baseline.png out_patched.png && echo "Rendered output is bit-identical." || echo "Rendered output DIFFERS - see above."

clean:
    rm -rf clone bin_baseline bin_patched out_baseline.png out_patched.png
