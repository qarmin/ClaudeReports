# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.
#
# Fill in repo_url/base_commit when this candidate is created (read them once with
# `git remote get-url origin` / `git rev-parse HEAD` in the main project, at the moment
# patch.diff is captured) - patch.diff is a diff against that exact commit and may stop
# applying cleanly once the main branch moves on.

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Adapt this recipe. Two options, in order of preference:
#   1) The project already ships a benchmark/example that reaches the patched code -
#      just invoke it against ./clone, no extra crate needed.
#   2) No suitable existing benchmark - a standalone bench crate lives in ./bench/ next to
#      this justfile, with its Cargo.toml depending on `{ path = "../clone/<crate_dir>" }`
#      (the clone/ directory `just clone` just created). Build and run that instead.
bench:
    cd bench && cargo run --release -- 30

clean:
    rm -rf clone
