+            #[inline(always)]
+            |s, left, right| (left + right).mul_add(neg_delta, s),
+            #[inline(always)]
+            |s, left, right| math::mul_add(left + right, NEG_DELTA, s),
+        );
+    }
+
+    // Suspect #3: many small (~row-sized) calls vs one big call doing the same
+    // total amount of arithmetic. If per-call/loop-setup overhead is the
+    // dominant cost, the many-small-calls variant should be markedly slower
+    // per element than the one-big-call variant.
+    #[test]
+    #[ignore]
+    fn print_detected_level() {
+        println!("Level::new() = {:?}", Level::new());
+    }
+
+    #[test]
+    #[ignore]
+    fn suspect_3_amortization() {
+        const ROW_WIDTH: usize = 620; // ~ real per-row evens/odds buffer width for a 1241px-wide image
+        const N_ROWS: usize = 1752 * 4; // ~ rows x lifting-steps in one real decode of that image
+        const ROUNDS: usize = 5;
+        let total = ROW_WIDTH * N_ROWS;
+
+        dispatch!(Level::new(), simd => {
+            let mut small_times = Vec::with_capacity(ROUNDS);
+            let mut big_times = Vec::with_capacity(ROUNDS);
+
+            // Alternate small/big across rounds (paired comparison, avoids attributing
+            // a thermal/frequency drift over the run to one variant only).
+            for round in 0..ROUNDS {
+                let run_small = || {
+                    let mut target_small = vec![1.0f32; ROW_WIDTH];
+                    let neighbor_small = vec![2.0f32; ROW_WIDTH];
+                    let start = Instant::now();
+                    for _ in 0..N_ROWS {
+                        for x in target_small.iter_mut() {
+                            *x = 1.0;
+                        }
+                        run_step(simd, ROW_WIDTH, 0, &mut target_small, &neighbor_small);
+                        std::hint::black_box(&target_small);
+                    }
+                    start.elapsed()
+                };
+                let run_big = || {
+                    let mut target_big = vec![1.0f32; total];
+                    let neighbor_big = vec![2.0f32; total];
+                    let start = Instant::now();
+                    run_step(simd, total, 0, &mut target_big, &neighbor_big);
+                    std::hint::black_box(&target_big);
+                    start.elapsed()
+                };
+
+                if round % 2 == 0 {
+                    small_times.push(run_small());
+                    big_times.push(run_big());
+                } else {
+                    big_times.push(run_big());
+                    small_times.push(run_small());
+                }
+            }
+
+            println!(
+                "suspect#3 amortization ({N_ROWS} calls x {ROW_WIDTH} width vs 1 call x {total} width), {ROUNDS} paired rounds:"
+            );
+            println!("  many-small-calls: {small_times:?}");
+            println!("  one-big-call:     {big_times:?}");
+            let small_median = {
+                let mut v: Vec<_> = small_times.iter().map(|d| d.as_secs_f64()).collect();
+                v.sort_by(f64::total_cmp);
+                v[v.len() / 2]
+            };
+            let big_median = {
+                let mut v: Vec<_> = big_times.iter().map(|d| d.as_secs_f64()).collect();
+                v.sort_by(f64::total_cmp);
+                v[v.len() / 2]
+            };
+            println!(
+                "  median: small={small_median:.6}s big={big_median:.6}s ratio(small/big)={:.2}x",
+                small_median / big_median
+            );
+        });
+    }
+
+    // Suspect #2: does a plain +4-byte (one f32) base-address shift of the
+    // exact same computation cost anything extra on this SIMD dispatch level?
+    // This isolates pure load-alignment cost from the algorithm's own
+    // inherent even/odd overlap (which is present in both arms below - both
+    // pass `first = 0`, only the underlying slice's start address differs).
+    #[test]
+    #[ignore]
+    fn suspect_2_alignment() {
+        const WIDTH: usize = 4_000_000;
+        const ROUNDS: usize = 5;
+
+        dispatch!(Level::new(), simd => {
+            let mut offset0_times = Vec::with_capacity(ROUNDS);
+            let mut offset1_times = Vec::with_capacity(ROUNDS);
+
+            for round in 0..ROUNDS {
+                let run_offset0 = || {
+                    let mut target = vec![1.0f32; WIDTH + 8];
+                    let neighbor = vec![2.0f32; WIDTH + 8];
+                    let start = Instant::now();
+                    run_step(simd, WIDTH, 0, &mut target[0..WIDTH], &neighbor[0..WIDTH]);
+                    std::hint::black_box(&target);
+                    start.elapsed()
+                };
+                let run_offset1 = || {
+                    let mut target = vec![1.0f32; WIDTH + 8];
+                    let neighbor = vec![2.0f32; WIDTH + 8];
+                    let start = Instant::now();
+                    run_step(simd, WIDTH, 0, &mut target[1..WIDTH + 1], &neighbor[1..WIDTH + 1]);
+                    std::hint::black_box(&target);
+                    start.elapsed()
+                };
+
+                if round % 2 == 0 {
+                    offset0_times.push(run_offset0());
+                    offset1_times.push(run_offset1());
+                } else {
+                    offset1_times.push(run_offset1());
+                    offset0_times.push(run_offset0());
+                }
+            }
+
+            println!("suspect#2 alignment ({WIDTH} elements, single call), {ROUNDS} paired rounds:");
+            println!("  offset+0: {offset0_times:?}");
+            println!("  offset+1elem: {offset1_times:?}");
+            let median = |times: &[std::time::Duration]| {
+                let mut v: Vec<_> = times.iter().map(|d| d.as_secs_f64()).collect();
+                v.sort_by(f64::total_cmp);
+                v[v.len() / 2]
+            };
+            let m0 = median(&offset0_times);
+            let m1 = median(&offset1_times);
+            println!("  median: offset+0={m0:.6}s offset+1elem={m1:.6}s ratio={:.3}x", m1 / m0);
+        });
+    }
+
+    // Neither #2 nor #3 explained the regression's magnitude - this checks
+    // whether the SIMD kernel itself (one big call, so amortization-neutral)
+    // simply costs more per element than the equivalent plain scalar loop,
+    // independent of any shape/alignment concern.
+    #[test]
+    #[ignore]
+    fn suspect_4_simd_kernel_vs_naive_scalar() {
+        const WIDTH: usize = 4_000_000;
+        const ROUNDS: usize = 5;
+
+        fn scalar_step(width: usize, first: usize, target: &mut [f32], neighbor: &[f32]) {
+            const NEG_DELTA: f32 = -0.443_506_87;
+            if first == 0 {
+                let left = periodic_symmetric_extension_left(0, 1);
+                let right = periodic_symmetric_extension_right(0, 1, width);
+                target[0] = math::mul_add(
+                    neighbor[(left - 1) / 2] + neighbor[(right - 1) / 2],
+                    NEG_DELTA,
+                    target[0],
+                );
+            }
+            let middle_start = if first == 0 { 2 } else { 1 };
+            let num_terms = if width - 1 > middle_start {
+                (width - 1 - middle_start).div_ceil(2)
+            } else {
+                0
+            };
+            let k_start = (middle_start - first) / 2;
+            let (nl_start, nh_start) = if first == 0 {
+                (k_start - 1, k_start)
+            } else {
+                (k_start, k_start + 1)
+            };
+            for term in 0..num_terms {
+                let k = k_start + term;
+                let nl = nl_start + term;
+                let nh = nh_start + term;
+                target[k] = math::mul_add(neighbor[nl] + neighbor[nh], NEG_DELTA, target[k]);
+            }
+        }
+
+        dispatch!(Level::new(), simd => {
+            let mut simd_times = Vec::with_capacity(ROUNDS);
+            let mut scalar_times = Vec::with_capacity(ROUNDS);
+
+            for round in 0..ROUNDS {
+                let run_simd = || {
+                    let mut target = vec![1.0f32; WIDTH];
+                    let neighbor = vec![2.0f32; WIDTH];
+                    let start = Instant::now();
+                    run_step(simd, WIDTH, 0, &mut target, &neighbor);
+                    std::hint::black_box(&target);
+                    start.elapsed()
+                };
+                let run_scalar = || {
+                    let mut target = vec![1.0f32; WIDTH];
+                    let neighbor = vec![2.0f32; WIDTH];
+                    let start = Instant::now();
+                    scalar_step(WIDTH, 0, &mut target, &neighbor);
+                    std::hint::black_box(&target);
+                    start.elapsed()
+                };
+
+                if round % 2 == 0 {
+                    simd_times.push(run_simd());
+                    scalar_times.push(run_scalar());
+                } else {
+                    scalar_times.push(run_scalar());
+                    simd_times.push(run_simd());
+                }
+            }
+
+            println!("suspect#4 SIMD kernel vs naive scalar loop ({WIDTH} elements, single call), {ROUNDS} paired rounds:");
+            println!("  simd:   {simd_times:?}");
+            println!("  scalar: {scalar_times:?}");
+            let median = |times: &[std::time::Duration]| {
+                let mut v: Vec<_> = times.iter().map(|d| d.as_secs_f64()).collect();
+                v.sort_by(f64::total_cmp);
+                v[v.len() / 2]
+            };
+            let ms = median(&simd_times);
+            let mc = median(&scalar_times);
+            println!("  median: simd={ms:.6}s scalar={mc:.6}s ratio(simd/scalar)={:.3}x", ms / mc);
+        });
+    }
+}
