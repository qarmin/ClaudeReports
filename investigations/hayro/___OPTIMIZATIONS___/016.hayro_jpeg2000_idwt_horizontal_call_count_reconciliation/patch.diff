+    // `reference` uses true FMA (`f32::mul_add`) throughout, matching what the
+    // SIMD bulk path always uses (fearless_simd dispatches to real hardware FMA
+    // at runtime, independent of this crate's compile-time `target-feature`
+    // flags). The new code's *scalar* remainder/boundary positions still use
+    // `crate::math::mul_add`, which on this build falls back to unfused `a*b+c`
+    // (see `math.rs`'s doc comment: "very imprecise, but hopefully good enough")
+    // whenever `target-feature=fma` wasn't set at compile time - exactly the
+    // same tradeoff the existing, shipped `filter_step_vertical` already makes
+    // between its SIMD bulk and scalar remainder. So this test allows a small
+    // tolerance rather than requiring bit-exact equality, and its real purpose
+    // is to catch *index/logic* bugs (which show up as wildly wrong values,
+    // wrong lengths, or panics), not to police FMA rounding policy.
+    fn approx_eq(a: f32, b: f32) -> bool {
+        let diff = (a - b).abs();
+        let scale = a.abs().max(b.abs()).max(1.0);
+        diff <= (scale * 1e-4).max(5e-4)
+    }
