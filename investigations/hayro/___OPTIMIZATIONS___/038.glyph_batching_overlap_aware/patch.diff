+    /// Fills a batch of glyphs previously accumulated by `fill_outline_run` because their
+    /// (conservative, bbox-based) transformed extents were proven not to overlap each other.
+    /// A single glyph is filled the same way as the pre-batching code (no extra path
+    /// allocation); two or more are combined into one `BezPath` and filled with a single
+    /// `fill_path` call, which is only sound for `NonZero` fill when the glyphs don't overlap.
+    fn flush_glyph_batch(&mut self, run_transform: Affine, pending: &[(Rc<BezPath>, Affine)]) {
+        match pending {
+            [] => {}
+            [(outline, glyph_transform)] => {
+                self.ctx.set_transform(run_transform * *glyph_transform);
+                self.ctx.fill_path(outline.as_ref());
+                self.ctx.set_transform(run_transform);
+            }
+            _ => {
+                let mut combined = BezPath::new();
+                for (outline, glyph_transform) in pending {
+                    combined.extend(*glyph_transform * outline.as_ref());
+                }
+                self.ctx.fill_path(&combined);
+            }
+        }
+    }
