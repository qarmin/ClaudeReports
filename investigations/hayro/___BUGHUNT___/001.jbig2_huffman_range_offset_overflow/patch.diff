+#[cfg(test)]
+mod overflow_boundary_tests {
+    use super::*;
+
+    fn single_leaf_decode(
+        range_low: i32,
+        range_length: u8,
+        is_lower: bool,
+        offset_bytes: &[u8],
+    ) -> Result<Option<i32>> {
+        let nodes = [HuffmanNode::Leaf(LeafData {
+            range_low,
+            range_length,
+            is_lower,
+            is_out_of_band: false,
+        })];
+        let mut reader = Reader::new(offset_bytes);
+        HuffmanNode::decode_from(&nodes, 0, &mut reader)
+    }
+
+    // Same shape as the 17 stale fuzz crashes: an "upper" leaf line (`is_lower: false`,
+    // `range_length: 32`, as every standard table's final line is) with HTOFFSET near i32::MAX.
+    #[test]
+    fn add_overflow_is_a_decode_error_not_a_panic() {
+        let result = single_leaf_decode(65808, 32, false, &[0x7F, 0xFF, 0xFF, 0xFF]);
+        assert_eq!(
+            result,
+            Err(crate::error::DecodeError::Huffman(
+                HuffmanError::InvalidCode
+            ))
+        );
+    }
+
+    // Same class, other branch: an `is_lower: true` leaf line with HTOFFSET near i32::MAX so
+    // `range_low - range_offset` underflows below i32::MIN.
+    #[test]
+    fn sub_overflow_is_a_decode_error_not_a_panic() {
+        let result = single_leaf_decode(-257, 32, true, &[0x7F, 0xFF, 0xFF, 0xFF]);
+        assert_eq!(
+            result,
+            Err(crate::error::DecodeError::Huffman(
+                HuffmanError::InvalidCode
+            ))
+        );
+    }
+
+    // Sanity: an in-range offset on the same leaf shapes still decodes normally.
+    #[test]
+    fn small_offset_still_decodes_normally() {
+        assert_eq!(
+            single_leaf_decode(65808, 32, false, &[0x00, 0x00, 0x00, 0x05]),
+            Ok(Some(65813))
+        );
+        assert_eq!(
+            single_leaf_decode(-257, 32, true, &[0x00, 0x00, 0x00, 0x05]),
+            Ok(Some(-262))
+        );
+    }
+}
