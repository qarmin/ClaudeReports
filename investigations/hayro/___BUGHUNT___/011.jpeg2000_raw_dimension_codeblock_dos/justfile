repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should be slow (~1-1.5s) and use
# ~2.7GB of peak RSS to render a 20x20-on-page thumbnail placement.
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should complete in well under a millisecond
# and use only a few MB of peak RSS.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
