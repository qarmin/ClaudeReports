# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate is Not reproducible: it re-checks an open question left by candidates
# 008/009 (does driving 008's 100000x100000 malformed-JPEG2000 PoC PDF through the real
# top-level `hayro::render()` still hang/thrash for CPU-bound work distinct from the
# already-fixed eager-allocation issue, once BOTH candidate 008's and candidate 009's real
# fixes are applied together). There is no bug of this candidate's own to fix, so there is no
# `patch.diff` here - `prerequisite_fixes.diff` (a concatenation of candidate 008's and
# candidate 009's own already-verified `patch.diff` files) is applied instead, to reproduce the
# exact combined state this candidate investigated.

repo_url := "https://github.com/LaurenzV/hayro.git"
base_commit := "5a5f0e247c970df948505ee0bb36e2df2504bf86"

# Full cycle: clone pristine, apply candidates 008+009's own already-verified fixes together,
# then run the repro and confirm it completes quickly (no separate hang) via the real, public,
# top-level `hayro::render()` entry point.
test: clone apply-prerequisites reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-prerequisites:
    cd clone && git apply "{{justfile_directory()}}/prerequisite_fixes.diff"

# Should print `render()` completing in well under a second (see output.txt for a real captured
# run) - not hanging/thrashing past any multi-second timeout.
reproduce:
    cd repro && cargo run --release

clean:
    rm -rf clone
