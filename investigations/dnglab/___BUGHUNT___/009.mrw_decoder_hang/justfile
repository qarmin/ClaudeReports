# exists for this candidate - nothing to apply/fix.

repo_url := "https://github.com/dnglab/dnglab.git"
base_commit := "ac975f5d1b3362feb3974811db6cc5a37a77b02b"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone. Build and run are separate steps
# (not `cargo run`) since the first build alone can take well over 8s - only the run itself is
# timed/asserted against the 8s window the original fuzzer report used.
reproduce:
    cd repro && cargo build --release
    cd repro && timeout 8 ./target/release/repro

clean:
    rm -rf clone
