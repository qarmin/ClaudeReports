# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder (including the real, unmodified crash
# file from GitHub issue #573, embedded at repro/testdata/issue573_real_crash_file.dng), or
# fetched by `just clone` into ./clone (gitignored) - nothing in this justfile reaches outside the
# folder it lives in.

repo_url := "https://github.com/dnglab/dnglab.git"
base_commit := "ac975f5d1b3362feb3974811db6cc5a37a77b02b"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic on
# "assertion failed: p1.y <= p2.y" (or the x-axis sibling) for both input variants.
reproduce-before:
    cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - the assert! panic should no longer occur for
# either variant (the real crash-file variant will still panic on a SEPARATE, already-tracked,
# still-unfixed bug - candidate 007's `as_ltrb_offsets` underflow, debug build only - once this
# candidate's own assert! stops blocking it; see RESULT.md/output.txt for why that's expected and
# does not indicate this candidate's own fix failed).
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
