# Self-contained reproduction for candidate 017 (Not reproducible - see RESULT.md).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# repo_url/base_commit were read at the moment this candidate was investigated
# (`git remote get-url origin` / `git rev-parse HEAD` in the main project).

repo_url := "https://github.com/dnglab/dnglab.git"
base_commit := "ac975f5d1b3362feb3974811db6cc5a37a77b02b"

# No patch.diff exists for this candidate (Not reproducible) - `test` just clones and runs the
# repro, which demonstrates that GitHub issue #488's "hangs indefinitely" claim does not occur
# (it either instantly crashes or instantly returns garbage, depending on the exact scenario -
# see RESULT.md and output.txt).
test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Runs all three scenarios (each as its own process, since 'literal' and 'far' crash the
# process - that's expected and is the point being demonstrated: a crash, not a hang).
reproduce:
    cd repro && cargo build --release
    -timeout 15 repro/target/release/repro017 literal; echo "literal exit: $?"
    timeout 15 repro/target/release/repro017 modest; echo "modest exit: $?"
    -timeout 15 repro/target/release/repro017 far; echo "far exit: $?"

clean:
    rm -rf clone repro/target
