# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# patch.diff touches crates/zune-jpeg/src/{bitstream.rs,bitstream_arith.rs,decoder.rs,mcu.rs,
# mcu_prog.rs} - a re-derivation of upstream PR #438 (197g/zune-image, "Rewrite progressive AC
# refinement") rebased onto this workspace's base_commit. The standalone bench driver it's
# measured with (bench/bench_decode.rs, copied to clone/crates/zune-jpeg/examples/bench_decode.rs)
# is harness, not fix, so it's copied in by `clone:` below and present identically for both the
# baseline and patched builds.
#
# Measured result for this candidate: NO measurable full-decode wall-clock change on
# test-images/jpeg/benchmarks/speed_bench_prog.jpg (see RESULT.md) even though `perf` shows the
# patched decode_mcu_ac_refine's own self-time share drop from ~11.2% to ~9.8% of total cycles -
# `just test` still reproduces a real, fair baseline-vs-patched comparison, it just doesn't show a
# whole-decode win for this input.

repo_url := "https://github.com/etemesi254/zune-image.git"
base_commit := "533296caf9a6783691d42b2dfbc623029216cbaf"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/crates/zune-jpeg/examples
    cp "{{justfile_directory()}}/bench/bench_decode.rs" clone/crates/zune-jpeg/examples/bench_decode.rs

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Baseline build happens BEFORE `apply`, patched build happens AFTER - `test`'s recipe order
# (clone build-baseline apply build-patched bench) guarantees this.
build-baseline:
    cd clone && cargo build --release -p zune-jpeg --example bench_decode 2>&1 | tail -5
    mkdir -p ../bin
    cp clone/target/release/examples/bench_decode ./bin_baseline

build-patched:
    cd clone && cargo build --release -p zune-jpeg --example bench_decode 2>&1 | tail -5
    cp clone/target/release/examples/bench_decode ./bin_patched

# expected_hash_hex pins the known-correct decode of
# test-images/jpeg/benchmarks/speed_bench_prog.jpg at base_commit - both binaries must reproduce
# it bit-exact (this candidate is a bit-exact patch, not a characterized-difference one, see
# RESULT.md).
bench_args := "clone/test-images/jpeg/benchmarks/speed_bench_prog.jpg 20 569766d874657049"

bench:
    @echo "=== baseline (before patch) ==="
    ulimit -c 0 && ./bin_baseline {{bench_args}}
    @echo "=== patched (after patch) ==="
    ulimit -c 0 && ./bin_patched {{bench_args}}

clean:
    rm -rf clone bin_baseline bin_patched
