# Self-contained reproduction for candidate 006 (JPEG AVX2 YCbCr->RGB baseline).
#
# This candidate is a measurement/investigation only - no patch.diff exists (see RESULT.md:
# reading the source showed `ycbcr_to_rgb_avx2_1::<false>` (RGB) already IS the same kernel as
# `ycbcr_to_rgb_avx2_1::<true>` (BGR), so there was nothing to patch). `just test` therefore just
# clones the pinned commit, builds this folder's own `bench/bench_decode.rs` harness, and runs it
# once against `speed_bench.jpg` to reproduce the RGB decode timing referenced in RESULT.md - there
# is no baseline-vs-patched comparison to print because nothing was changed.

repo_url := "https://github.com/etemesi254/zune-image.git"
base_commit := "533296caf9a6783691d42b2dfbc623029216cbaf"

test: clone build run

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/crates/zune-jpeg/examples
    cp "{{justfile_directory()}}/bench/bench_decode.rs" clone/crates/zune-jpeg/examples/bench_decode.rs

build:
    cd clone && cargo build --release -p zune-jpeg --example bench_decode

run:
    @echo "=== RGB decode timing (default DecoderOptions, out_colorspace = RGB) ==="
    @echo "No patch was applied for this candidate - see RESULT.md. This just reproduces the"
    @echo "baseline timing/hash that the investigation's profiling was based on."
    ulimit -c 0 && ./clone/target/release/examples/bench_decode clone/test-images/jpeg/benchmarks/speed_bench.jpg 30

clean:
    rm -rf clone
