+/// Convert a batch of 16 YCbCr pixels to RGB, dispatching to an AVX2 kernel at runtime when
+/// available (x86_64 only) and falling back to the scalar implementation otherwise.
+///
+/// Same parameters/panics as [`ycbcr_to_rgb_inner_16_scalar`].
+pub fn ycbcr_to_rgb_inner_16<const BGRA: bool>(
+    y: &[i16; 16], cb: &[i16; 16], cr: &[i16; 16], output: &mut [u8], pos: &mut usize
+) {
+    #[cfg(target_arch = "x86_64")]
+    {
+        if std::is_x86_feature_detected!("avx2") {
+            // SAFETY: AVX2 support was just checked above.
+            unsafe {
+                avx2::ycbcr_to_rgb_inner_16_avx2::<BGRA>(y, cb, cr, output, pos);
+            }
+            return;
+        }
+    }
+    ycbcr_to_rgb_inner_16_scalar::<BGRA>(y, cb, cr, output, pos);
+}
