+// This loop is a tight, branch-free multiply-add-shift with no loop-carried dependency between
+// elements, so LLVM's auto-vectorizer already turns it into SSE2 code identical to a hand-written
+// SIMD version at the default (SSE2-only) compile target (verified by objdump - both produce the
+// same punpcklbw/pmullw/paddw/psrlw/packuswb sequence). Wrapping it with `simd_fn!` (this crate's
+// existing AVX2/NEON runtime-dispatch macro, used by sobel.rs/bilateral_filter.rs/rotate.rs)
+// instead lets the *same* source recompile under `#[target_feature(enable = "avx2")]`, so the
+// auto-vectorizer picks 32-byte-wide registers instead of 16-byte ones on machines that support
+// it - the actual point of this candidate, since the crate's own default feature set already
+// includes `avx2`.
+simd_fn!(
+    #[allow(clippy::cast_possible_truncation)]
+    fn premultiply_u8_simd(input: &mut [u8], alpha: &[u8]) {
+        input.iter_mut().zip(alpha).for_each(|(color, al)| {
+            let temp = (u16::from(*al) * u16::from(*color)) + 0x80;
+
+            *color = ((temp + (temp >> 8)) >> 8) as u8;
+        });
+    }
+);
