+#[cfg(test)]
+mod tests {
+    use super::{premultiply_u16, premultiply_u8};
+
+    fn premultiply_u8_reference(color: u8, al: u8) -> u8 {
+        let temp = (u16::from(al) * u16::from(color)) + 0x80;
+        ((temp + (temp >> 8)) >> 8) as u8
+    }
+
+    fn premultiply_u16_reference(color: u16, al: u16) -> u16 {
+        const MAX_VALUE: u32 = 65535;
+        let temp = (u32::from(al) * u32::from(color)) + MAX_VALUE.div_ceil(2);
+        ((temp + (temp >> 16)) >> 16) as u16
+    }
+
+    #[test]
+    fn premultiply_u8_matches_reference_exhaustive() {
+        // exhaustive over the full u8 x u8 (color, alpha) domain, with a length (65536) that is
+        // a multiple of the AVX2 lane width (32) - also check a trimmed, non-multiple length
+        // below to exercise the scalar remainder path of the dispatched implementation.
+        let colors: Vec<u8> = (0..=255u16).flat_map(|c| std::iter::repeat(c as u8).take(256)).collect();
+        let alphas: Vec<u8> = (0..=255u16).cycle().take(colors.len()).map(|a| a as u8).collect();
+
+        let expected: Vec<u8> = colors
+            .iter()
+            .zip(&alphas)
+            .map(|(&c, &a)| premultiply_u8_reference(c, a))
+            .collect();
+
+        let mut actual = colors.clone();
+        premultiply_u8(&mut actual, &alphas);
+        assert_eq!(actual, expected);
+
+        // non-multiple-of-32 length remainder check
+        let mut actual = colors[..12345].to_vec();
+        premultiply_u8(&mut actual, &alphas[..12345]);
+        assert_eq!(actual, expected[..12345]);
+    }
+
+    #[test]
+    fn premultiply_u16_matches_reference() {
+        use nanorand::Rng;
+
+        // not a multiple of the AVX2 lane width (16) - exercises the remainder path too.
+        let mut colors = [0u16; 2003];
+        nanorand::WyRand::new().fill(&mut colors);
+        let mut alphas = [0u16; 2003];
+        nanorand::WyRand::new().fill(&mut alphas);
+
+        let expected: Vec<u16> = colors
+            .iter()
+            .zip(&alphas)
+            .map(|(&c, &a)| premultiply_u16_reference(c, a))
+            .collect();
+
+        let mut actual = colors;
+        premultiply_u16(&mut actual, &alphas);
+        assert_eq!(actual.as_slice(), expected.as_slice());
+    }
+}
