# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Only gst-plugins-bad's "hls" plugin (openssl crypto backend) and gst-plugins-good's "soup" HTTP
# source are built, plus their hard prerequisites - the bug lives entirely in
# ext/hls/gsthlsdemux.c's gst_hls_demux_finish_fragment(). The repro drives the real, unmodified
# `hlsdemux`/`souphttpsrc` elements (via the project's own public `gst-launch-1.0` tool) against a
# real local HTTP server (repro/serve.py) serving a crafted AES-128 HLS playlist/key/segment - a
# genuine second participant, not a hand-authored stand-in for what an HLS origin server would
# send (see CONFIRMATION.md section 11).

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    export PATH="$HOME/.local/bin:$PATH" && cd clone && meson setup \
        --buildtype=debugoptimized \
        -Dglib:tests=false \
        -Ddoc=disabled \
        -Dexamples=disabled \
        -Dintrospection=disabled \
        -Dgood=enabled \
        -Dgst-plugins-good:auto_features=disabled \
        -Dgst-plugins-good:soup=enabled \
        -Dbad=enabled \
        -Dgst-plugins-bad:auto_features=disabled \
        -Dgst-plugins-bad:hls=enabled \
        -Dgst-plugins-bad:hls-crypto=openssl \
        -Dugly=disabled \
        -Dlibav=disabled \
        -Dges=disabled \
        -Dsharp=disabled \
        -Drs=disabled \
        -Dpython=disabled \
        -Dlibnice=disabled \
        -Ddevtools=disabled \
        -Drtsp_server=disabled \
        -Dgst-examples=disabled \
        -Dqt5=disabled \
        -Dorc=disabled \
        -Dgstreamer:tracer_hooks=false \
        -Dgst-plugins-base:pango=disabled \
        build-hls
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-hls

# Build+run the standalone repro against the pristine clone - should demonstrate the bug: a real
# local HTTP server serves a crafted AES-128 HLS media playlist/key/segment, a real
# `souphttpsrc ! hlsdemux ! fakesink` pipeline (run via the real gst-launch-1.0 tool) fetches and
# decrypts it, and the manual PKCS7-unpadding code in gst_hls_demux_finish_fragment() computes a
# negative `unpadded_size` and passes it straight to gst_buffer_resize(), which aborts the process
# under G_DEBUG=fatal-warnings. Runs both the primary (last decrypted byte 0xFF) and a second,
# different boundary value (0x80) in the same bug class.
reproduce-before:
    #!/usr/bin/env bash
    set -o pipefail
    FAIL=0
    for mode in primary boundary; do
        echo "=== mode=$mode ==="
        OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-hls" \
            SRC_DIR="{{justfile_directory()}}/clone" \
            bash repro/run.sh "$mode" 2>&1)"
        RC=$?
        echo "$OUT"
        if [ "$RC" != 134 ] || ! grep -q "assertion 'size >= -1' failed" <<< "$OUT"; then
            echo "expected exit 134 (SIGABRT) and the gst_buffer_resize_range assertion for mode=$mode, did not see it (exit=$RC)" >&2
            FAIL=1
        fi
    done
    exit $FAIL

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-hls

# Same repro again, now against the patched clone - should no longer abort the process for either
# boundary value; hlsdemux should instead post a clean GST_STREAM_ERROR_DECODE and the pipeline
# should fail to preroll gracefully (exit 1, no assertion).
reproduce-after:
    #!/usr/bin/env bash
    set -o pipefail
    FAIL=0
    for mode in primary boundary; do
        echo "=== mode=$mode ==="
        OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-hls" \
            SRC_DIR="{{justfile_directory()}}/clone" \
            bash repro/run.sh "$mode" 2>&1)"
        RC=$?
        echo "$OUT"
        if [ "$RC" = 134 ] || grep -q "assertion" <<< "$OUT"; then
            echo "still saw an assertion/abort after applying the patch for mode=$mode" >&2
            FAIL=1
        fi
        if ! grep -q "Invalid PKCS7 padding in decrypted fragment" <<< "$OUT"; then
            echo "expected the new clean GST_ELEMENT_ERROR for mode=$mode, did not see it" >&2
            FAIL=1
        fi
    done
    exit $FAIL

clean:
    rm -rf clone
