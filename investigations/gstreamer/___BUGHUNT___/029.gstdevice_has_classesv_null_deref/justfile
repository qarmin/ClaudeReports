# Self-contained reproduction for candidate 029 (gst_device_has_classesv NULL deref).
#
# Everything needed is either in this folder or fetched by `just clone` into ./clone (gitignored).
# `meson`/`ninja` must be on PATH (e.g. `uv tool install meson && uv tool install ninja`), and
# `clang` with ASAN/UBSAN runtimes must be available.
#
# The build is scoped to just the gstreamer core subproject (gstdevice.c is core-lib, no plugin
# needed) - base/good/bad/ugly/libav/ges/rs/python/etc all disabled to keep the build fast.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply rebuild reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && \
    PATH="$HOME/.local/bin:$PATH" CC=clang meson setup build-029 \
        --buildtype=debugoptimized \
        -Db_sanitize=address,undefined \
        -Db_lundef=false \
        -Dc_args=-fno-sanitize=function \
        --wrap-mode=nodownload \
        -Dbase=disabled \
        -Dgood=disabled \
        -Dbad=disabled \
        -Dugly=disabled \
        -Dlibav=disabled \
        -Dges=disabled \
        -Dsharp=disabled \
        -Drs=disabled \
        -Dpython=disabled \
        -Dlibnice=disabled \
        -Ddevtools=disabled \
        -Drtsp_server=disabled \
        -Dgst-examples=disabled \
        -Dqt5=disabled \
        -Dorc=disabled \
        -Ddoc=disabled \
        -Dexamples=disabled \
        -Dintrospection=disabled \
        -Dgstreamer:tracer_hooks=false
    cd clone && PATH="$HOME/.local/bin:$PATH" ninja -C build-029 subprojects/gstreamer/gst/libgstreamer-1.0.so.0.2902.0

# Build+run the standalone repro against the pristine clone - should SEGV/UBSan-abort inside
# gst_device_has_classesv() at gstdevice.c:372 (strstr on a NULL device_class).
reproduce-before:
    ulimit -c 0 && BUILD_DIR="{{justfile_directory()}}/clone/build-029" bash "{{justfile_directory()}}/repro/run.sh"

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

rebuild:
    cd clone && PATH="$HOME/.local/bin:$PATH" ninja -C build-029 subprojects/gstreamer/gst/libgstreamer-1.0.so.0.2902.0

# Same repro again, now against the patched+rebuilt clone - should print "result = 0 (no crash)".
reproduce-after:
    ulimit -c 0 && BUILD_DIR="{{justfile_directory()}}/clone/build-029" bash "{{justfile_directory()}}/repro/run.sh"

clean:
    rm -rf clone repro/bin
