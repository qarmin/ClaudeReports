diff --git a/subprojects/gstreamer/gst/gstevent.c b/subprojects/gstreamer/gst/gstevent.c
index c9f001fceb..2f5224dc30 100644
--- a/subprojects/gstreamer/gst/gstevent.c
+++ b/subprojects/gstreamer/gst/gstevent.c
@@ -1682,8 +1682,13 @@ gst_event_new_sink_message (const gchar * name, GstMessage * msg)
 
   GST_CAT_INFO (GST_CAT_EVENT, "creating sink-message event");
 
+  /* @name is a plain caller-supplied string, not guaranteed to be static/
+   * long-lived (see gst_ipc_pipeline_comm_read_bus_message() for a real caller
+   * that passes a pointer into a transient buffer) - it must be duplicated,
+   * not stored as-is like gst_structure_new_static_str() does for names longer
+   * than 15 bytes. */
   structure =
-      gst_structure_new_static_str (name, "message", GST_TYPE_MESSAGE, msg,
+      gst_structure_new (name, "message", GST_TYPE_MESSAGE, msg,
       NULL);
   event = gst_event_new_custom (GST_EVENT_SINK_MESSAGE, structure);
 
