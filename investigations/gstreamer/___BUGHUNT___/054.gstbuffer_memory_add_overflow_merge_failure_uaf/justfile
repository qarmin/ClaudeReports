# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Only core gstreamer is built (no plugins needed - the bug is entirely in
# subprojects/gstreamer/gst/gstbuffer.c, reachable through gst_buffer_append_memory()'s public
# API). Requires valgrind on PATH.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Builds repro.c against a fresh core-only build and runs it under valgrind - should report
# invalid reads/frees (use-after-free) in gst_buffer_get_size()/gst_buffer_unref() after the
# GST_BUFFER_MEM_MAX overflow path hits a simulated merge failure.
reproduce-before:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 99 ] || ! grep -q "Invalid read" <<< "$OUT"; then
        echo "expected valgrind to report invalid reads (exit 99), got exit=$RC" >&2
        exit 1
    fi

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-core-repro

# Same repro again, now against the patched clone - valgrind should report 0 errors, and the
# buffer should keep its original 16 memories (the 17th is safely refused, not silently corrupted).
reproduce-after:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 0 ]; then
        echo "expected valgrind to report 0 errors (exit 0) after the fix, got exit=$RC" >&2
        exit 1
    fi
    if ! grep -q "memory count after overflow: 16" <<< "$OUT"; then
        echo "expected the buffer to keep its 16 original memories after the fix" >&2
        exit 1
    fi

clean:
    rm -rf clone
