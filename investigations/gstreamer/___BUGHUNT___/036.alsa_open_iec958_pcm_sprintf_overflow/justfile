# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Only gst-plugins-base (with the alsa plugin explicitly enabled) is built, under clang
# ASAN+UBSAN - the bug lives entirely in ext/alsa/gstalsa.c, no other plugin scope is needed.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && export PATH="$HOME/.local/bin:$PATH" && CC=clang CXX=clang++ meson setup \
        --buildtype=debugoptimized \
        -Db_sanitize=address,undefined \
        -Db_lundef=false \
        -Dc_args=-fno-sanitize=function \
        -Dcpp_args=-fno-sanitize=function \
        -Dglib:tests=false \
        -Ddoc=disabled \
        -Dexamples=disabled \
        -Dintrospection=disabled \
        -Dgood=disabled \
        -Dbad=disabled \
        -Dugly=disabled \
        -Dlibav=disabled \
        -Dges=disabled \
        -Dsharp=disabled \
        -Drs=disabled \
        -Dpython=disabled \
        -Dlibnice=disabled \
        -Ddevtools=disabled \
        -Drtsp_server=disabled \
        -Dgst-examples=disabled \
        -Dqt5=disabled \
        -Dorc=disabled \
        -Dgstreamer:tracer_hooks=false \
        -Dgst-plugins-base:auto_features=disabled \
        -Dgst-plugins-base:alsa=enabled \
        build-asan-alsa
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-asan-alsa subprojects/gst-plugins-base/ext/alsa/libgstalsa.so subprojects/gstreamer/gst/libgstreamer-1.0.so.0.2902.0

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (AddressSanitizer: stack-buffer-overflow in gst_alsa_open_iec958_pcm's sprintf). ASAN aborts
# with a non-zero exit on a genuine finding, so this step is EXPECTED to "fail" - `|| true` keeps
# the `test` chain going into `apply`/`reproduce-after`, which check the real outcome by reading
# the output, not the exit code.
reproduce-before:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-alsa" bash repro/run.sh || true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-asan-alsa subprojects/gst-plugins-base/ext/alsa/libgstalsa.so

# Same repro again, now against the patched clone - should no longer demonstrate the bug (clean
# exit, no ASAN report; gst_alsa_open_iec958_pcm returns NULL for an over-long device name).
reproduce-after:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-alsa" bash repro/run.sh

clean:
    rm -rf clone repro/repro
