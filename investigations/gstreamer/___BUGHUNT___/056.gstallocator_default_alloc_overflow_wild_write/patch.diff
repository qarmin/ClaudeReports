diff --git a/subprojects/gstreamer/gst/gstallocator.c b/subprojects/gstreamer/gst/gstallocator.c
index 605d026db4..7553bc5dea 100644
--- a/subprojects/gstreamer/gst/gstallocator.c
+++ b/subprojects/gstreamer/gst/gstallocator.c
@@ -542,7 +542,18 @@ static GstMemory *
 default_alloc (GstAllocator * allocator, gsize size,
     GstAllocationParams * params)
 {
-  gsize maxsize = size + params->prefix + params->padding;
+  gsize maxsize;
+
+  if (params->prefix > G_MAXSIZE - params->padding ||
+      size > G_MAXSIZE - params->prefix - params->padding) {
+    GST_CAT_WARNING (GST_CAT_MEMORY,
+        "Allocating %" G_GSIZE_FORMAT " bytes with prefix %" G_GSIZE_FORMAT
+        " and padding %" G_GSIZE_FORMAT " overflows", size, params->prefix,
+        params->padding);
+    return NULL;
+  }
+
+  maxsize = size + params->prefix + params->padding;
 
   return (GstMemory *) _sysmem_new_block (params->flags,
       maxsize, params->align, params->prefix, size);
