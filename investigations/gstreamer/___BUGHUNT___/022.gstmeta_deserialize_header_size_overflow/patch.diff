diff --git a/subprojects/gstreamer/gst/gstmeta.c b/subprojects/gstreamer/gst/gstmeta.c
index 6ab508115b..b578e66254 100644
--- a/subprojects/gstreamer/gst/gstmeta.c
+++ b/subprojects/gstreamer/gst/gstmeta.c
@@ -866,7 +866,11 @@ gst_meta_deserialize (GstBuffer * buffer, const guint8 * data, gsize size,
 
   guint32 total_size = GST_READ_UINT32_LE (data + 0);
   guint32 name_len = GST_READ_UINT32_LE (data + 4);
-  guint32 header_size = 2 * sizeof (guint32) + name_len + 2;
+  /* Compute in 64-bit: name_len is attacker-controlled and can be up to
+   * G_MAXUINT32, which would silently wrap a guint32 header_size (e.g.
+   * name_len == G_MAXUINT32 wraps to 9), defeating the bounds checks below
+   * and leading to an out-of-bounds read/write further down. */
+  guint64 header_size = 2 * sizeof (guint32) + (guint64) name_len + 2;
   if (size < total_size || total_size < header_size)
     goto bad_header;
 
