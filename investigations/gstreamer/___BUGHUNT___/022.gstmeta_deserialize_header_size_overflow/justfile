# Self-contained reproduction for this candidate. Everything needed is either in this folder or
# fetched by `just clone` into ./clone (gitignored). The bug is in GStreamer core
# (subprojects/gstreamer/gst/gstmeta.c) so only the core "gstreamer" meson subproject is built
# (base/good/ugly/bad plugin sets all disabled) - much faster than the project's full ASAN scope
# and sufficient, since gst_meta_deserialize() has no plugin dependency.
#
# Needs: meson, ninja, clang (with libclang-rt for ASAN/UBSAN), pkg-config on PATH.

repo_url := "git@github.com:GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && export PATH="$HOME/.local/bin:$PATH" && CC=clang CXX=clang++ meson setup build-asan \
        --buildtype=debugoptimized \
        -Db_sanitize=address,undefined \
        -Db_lundef=false \
        -Dc_args=-fno-sanitize=function \
        -Dcpp_args=-fno-sanitize=function \
        -Dbase=disabled -Dgood=disabled -Dugly=disabled -Dbad=disabled \
        -Dlibav=disabled -Ddevtools=disabled -Dges=disabled -Drtsp_server=disabled \
        -Dgst-examples=disabled -Dpython=disabled -Dtls=disabled -Dlibnice=disabled
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-asan subprojects/gstreamer/gst/libgstreamer-1.0.so.0.2902.0

# Should crash (ASAN SEGV inside gst_meta_deserialize) - a nonzero exit here is the expected,
# desired outcome (that's the bug), so it's prefixed with `-` to let `test`'s recipe chain
# continue on to apply/reproduce-after instead of stopping here.
reproduce-before:
    -BUILD_DIR="{{justfile_directory()}}/clone/build-asan" bash repro/run.sh

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-asan subprojects/gstreamer/gst/libgstreamer-1.0.so.0.2902.0

# Should no longer crash - gst_meta_deserialize() returns NULL, consumed=0.
reproduce-after:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan" bash repro/run.sh

clean:
    rm -rf clone
