# Self-contained reproduction for this candidate.
#
# Only core gstreamer is built - the bug is entirely in subprojects/gstreamer/gst/gstelement.c,
# reachable through the public gst_element_request_pad_simple() API against a custom request-pad
# element (no plugin needed). Requires valgrind on PATH.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Builds+runs repro.c under valgrind - should report an "Invalid read" inside
# gst_element_is_valid_request_template_name() (gstelement.c:1060, strncmp).
reproduce-before:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 99 ] || ! grep -q "Invalid read" <<< "$OUT"; then
        echo "expected valgrind to report an invalid read (exit 99), got exit=$RC" >&2
        exit 1
    fi

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-core-repro

# Same repro again, now against the patched clone - valgrind should report 0 errors, and the
# pad request should still correctly fail (return NULL) since "src_5" doesn't match the template.
reproduce-after:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 0 ]; then
        echo "expected valgrind to report 0 errors (exit 0) after the fix, got exit=$RC" >&2
        exit 1
    fi

clean:
    rm -rf clone
