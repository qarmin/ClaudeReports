# Self-contained reproduction for this candidate.
#
# gst_analytics_modelinfo_find_tensor_name() is real public API (libgstanalytics-1.0) - no
# visibility workaround needed. Only core+base+bad are built.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Builds+runs repro.c - loads a crafted .modelinfo file whose [modelinfo] header section
# stray-sets matching type/dims keys, and asks for a tensor that doesn't exist. Should print
# "returned: modelinfo" (the header's own group name, a false match) and the BUG line.
reproduce-before:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    echo "$OUT"
    if ! grep -q "BUG: the format-version HEADER section" <<< "$OUT"; then
        echo "expected the header section to be returned as a false tensor-name match" >&2
        exit 1
    fi

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-analytics-repro

# Same repro again, now against the patched clone - should return (NULL), no false match.
reproduce-after:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(SRC_DIR="{{justfile_directory()}}/clone" bash repro/build_and_run.sh 2>&1)"
    echo "$OUT"
    if ! grep -q "returned: (NULL)" <<< "$OUT"; then
        echo "expected a clean (NULL) result after the fix" >&2
        exit 1
    fi

clean:
    rm -rf clone build-analytics-repro
