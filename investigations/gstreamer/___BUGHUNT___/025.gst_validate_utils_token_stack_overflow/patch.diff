+/* Appends @c (already consumed via _next()) to @token at *@pos, bailing out
+ * via longjmp if @token (a fixed PARSER_MAX_TOKEN_SIZE stack buffer) would
+ * overflow - callers only ever grow tokens one gchar at a time via _next(),
+ * so this is the single choke point that needs the bounds check. */
+static void
+_token_push (MathParser * parser, gchar * token, gint * pos, gchar c)
+{
+  if (*pos >= PARSER_MAX_TOKEN_SIZE - 1)
+    _error (parser, "Token is too long!");
+
+  token[(*pos)++] = c;
+}
