# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Only gst-plugins-bad's "aes" plugin (and its own hard prerequisites: gstreamer core,
# gst-plugins-base for gstpbutils/gstvideo, openssl) is built, under clang ASAN+UBSAN - this bug
# lives entirely in ext/aes/gstaeshelper.c + its two callers gstaesenc.c/gstaesdec.c.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && export PATH="$HOME/.local/bin:$PATH" && CC=clang CXX=clang++ meson setup \
        --buildtype=debugoptimized \
        -Db_sanitize=address,undefined \
        -Db_lundef=false \
        -Dc_args=-fno-sanitize=function \
        -Dcpp_args=-fno-sanitize=function \
        -Dglib:tests=false \
        -Ddoc=disabled \
        -Dexamples=disabled \
        -Dintrospection=disabled \
        -Dgood=disabled \
        -Dbad=enabled \
        -Dgst-plugins-bad:auto_features=disabled \
        -Dgst-plugins-bad:aes=enabled \
        -Dgst-plugins-bad:aja=disabled \
        -Dgst-plugins-bad:openh264=disabled \
        -Dgst-plugins-bad:vmaf=disabled \
        -Dgst-plugins-bad:webrtcdsp=disabled \
        -Dgst-plugins-bad:fdkaac=disabled \
        -Dgst-plugins-bad:srtp=disabled \
        -Dgst-plugins-bad:sctp=disabled \
        -Dugly=disabled \
        -Dlibav=disabled \
        -Dges=disabled \
        -Dsharp=disabled \
        -Drs=disabled \
        -Dpython=disabled \
        -Dlibnice=disabled \
        -Ddevtools=disabled \
        -Drtsp_server=disabled \
        -Dgst-examples=disabled \
        -Dqt5=disabled \
        -Dorc=disabled \
        -Dgstreamer:tracer_hooks=false \
        -Dgst-plugins-base:pango=disabled \
        build-aes-only
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-aes-only \
        subprojects/gst-plugins-bad/ext/aes/libgstaes.so

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (AddressSanitizer: heap-buffer-overflow in gst_aes_hexstring2bytearray). ASAN aborts the
# process (exit != 0) on a real finding, so a non-zero exit here is success, not failure -
# check the output instead of the exit code.
reproduce-before:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-aes-only" \
        SRC_DIR="{{justfile_directory()}}/clone" \
        bash repro/run.sh aesenc key 400 2>&1)" || true
    echo "$OUT"
    if ! grep -q "heap-buffer-overflow.*gst_aes_hexstring2bytearray" <<< "$OUT"; then
        echo "expected an AddressSanitizer heap-buffer-overflow in gst_aes_hexstring2bytearray, did not see one" >&2
        exit 1
    fi

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-aes-only \
        subprojects/gst-plugins-bad/ext/aes/libgstaes.so

# Same repro again, now against the patched clone - should no longer demonstrate the bug (a
# logged "invalid key" GST_ERROR and a clean exit, no ASAN report).
reproduce-after:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-aes-only" \
        SRC_DIR="{{justfile_directory()}}/clone" \
        bash repro/run.sh aesenc key 400 2>&1)"
    echo "$OUT"
    if grep -q "AddressSanitizer" <<< "$OUT"; then
        echo "still saw an AddressSanitizer report after applying the patch" >&2
        exit 1
    fi
    if ! grep -q "g_object_set returned without crashing" <<< "$OUT"; then
        echo "expected a clean exit after applying the patch, did not see one" >&2
        exit 1
    fi

clean:
    rm -rf clone repro/repro
