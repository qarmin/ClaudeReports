# Self-contained reproduction. See ../005.../justfile for the identical pattern/rationale
# (build scope, why clang) - not repeated here.

repo_url := "git@github.com:GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && bash ../../tools/build_asan_fuzz.sh build-asan-fuzz

reproduce-before:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-fuzz" bash repro/run.sh

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && export PATH="$HOME/.local/bin:$PATH" && ninja -C build-asan-fuzz subprojects/gst-plugins-good/gst/avi/libgstavi.so

reproduce-after:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-fuzz" bash repro/run.sh

clean:
    rm -rf clone
