# Self-contained reproduction. Same pattern as ../021.gstmeta_serialize_header_size_truncation/justfile
# (build scope, why clang) - not repeated here. m3u8.c needs only gstreamer-1.0 core to compile
# (it's #include-d directly, same trick the project's own hlsdemux_m3u8.c unit test uses), so the
# much cheaper core-only build (tools/build_asan_core.sh) is enough even though the bug lives in
# the gst-plugins-bad ext/hls source tree - no plugin needs to actually be built.

repo_url := "git@github.com:GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cd clone && bash ../../tools/build_asan_core.sh build-asan-core

reproduce-before:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-core" M3U8_SRC_DIR="{{justfile_directory()}}/clone/subprojects/gst-plugins-bad/ext/hls" bash repro/run.sh

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

reproduce-after:
    BUILD_DIR="{{justfile_directory()}}/clone/build-asan-core" M3U8_SRC_DIR="{{justfile_directory()}}/clone/subprojects/gst-plugins-bad/ext/hls" bash repro/run.sh

clean:
    rm -rf clone repro/repro_bin
