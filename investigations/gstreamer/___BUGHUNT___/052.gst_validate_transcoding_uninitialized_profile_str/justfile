# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Only core+base+bad+devtools are built (bad is needed for the gst-transcoder library that
# gst-validate-transcoding.c links against) - good/ugly/libav/ges/rs/python/etc are all disabled
# to keep the build fast. Requires valgrind on PATH.

repo_url := "https://github.com/GStreamer/gstreamer.git"
base_commit := "65b9547519cdafce691e65777d4178280bf10808"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    export PATH="$HOME/.local/bin:$PATH" && cd clone && meson setup \
        --buildtype=debug \
        -Dglib:tests=false \
        -Ddoc=disabled \
        -Dexamples=disabled \
        -Dintrospection=disabled \
        -Dgood=disabled \
        -Dugly=disabled \
        -Dlibav=disabled \
        -Dges=disabled \
        -Dsharp=disabled \
        -Drs=disabled \
        -Dpython=disabled \
        -Dlibnice=disabled \
        -Drtsp_server=disabled \
        -Dgst-examples=disabled \
        -Dqt5=disabled \
        -Dbase=enabled \
        -Dbad=enabled \
        -Ddevtools=enabled \
        build-bad-devtools
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-bad-devtools

# Runs the real gst-validate-transcoding-1.0 binary with no -o flag under valgrind
# --track-origins=yes - should report an uninitialised-value read at gst-validate-transcoding.c:354.
reproduce-before:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-bad-devtools" \
        SRC_DIR="{{justfile_directory()}}/clone" \
        bash repro/run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 42 ]; then
        echo "expected repro/run.sh to exit 42 (uninitialised-value read confirmed), got $RC" >&2
        exit 1
    fi

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    export PATH="$HOME/.local/bin:$PATH" && cd clone && ninja -C build-bad-devtools

# Same repro again, now against the patched clone - valgrind should report 0 errors.
reproduce-after:
    #!/usr/bin/env bash
    set -eo pipefail
    OUT="$(BUILD_DIR="{{justfile_directory()}}/clone/build-bad-devtools" \
        SRC_DIR="{{justfile_directory()}}/clone" \
        bash repro/run.sh 2>&1)"
    RC=$?
    echo "$OUT"
    if [ "$RC" != 0 ]; then
        echo "expected repro/run.sh to exit 0 (no uninitialised-value read) after the fix, got $RC" >&2
        exit 1
    fi

clean:
    rm -rf clone
