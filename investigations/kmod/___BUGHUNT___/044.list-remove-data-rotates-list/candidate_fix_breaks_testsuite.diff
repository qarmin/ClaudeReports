diff --git a/libkmod/libkmod-list.c b/libkmod/libkmod-list.c
index e3f2fa1..cb4c1c0 100644
--- a/libkmod/libkmod-list.c
+++ b/libkmod/libkmod-list.c
@@ -190,10 +190,15 @@ struct kmod_list *kmod_list_remove_data(struct kmod_list *list, const void *data
 		return list;
 
 	node = list_node_remove(&itr->node);
-	free(itr);
-
-	if (node == NULL)
+	if (node == NULL) {
+		free(itr);
 		return NULL;
