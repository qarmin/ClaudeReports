diff --git a/tools/modprobe.c b/tools/modprobe.c
index b807529..36dfc20 100644
--- a/tools/modprobe.c
+++ b/tools/modprobe.c
@@ -526,8 +526,20 @@ static int rmmod_do_module(struct kmod_module *mod, int flags)
 		deps = kmod_module_get_dependencies(mod);
 		kmod_list_foreach(itr, deps) {
 			struct kmod_module *dep = kmod_module_get_module(itr);
-			if (kmod_module_get_refcnt(dep) == 0)
-				rmmod_do_remove_module(dep);
+
+			if (kmod_module_get_refcnt(dep) == 0) {
+				const char *dep_cmd = kmod_module_get_remove_commands(dep);
+
+				if (dep_cmd != NULL) {
+					int saved_priority = log_priority;
+
+					log_priority = LOG_WARNING;
+					command_do(dep, "remove", dep_cmd, NULL);
+					log_priority = saved_priority;
+				} else {
+					rmmod_do_remove_module(dep);
+				}
+			}
 			kmod_module_unref(dep);
 		}
 		kmod_module_unref_list(deps);
