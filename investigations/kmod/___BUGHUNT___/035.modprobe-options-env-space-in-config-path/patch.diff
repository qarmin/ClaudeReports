+static void env_modprobe_options_append_quoted(const char *value)
+{
+	char *quoted;
+	char q = strchr(value, '"') == NULL ? '"' : '\'';
+
+	if (strchr(value, ' ') == NULL || strchr(value, q) != NULL ||
+	    asprintf(&quoted, "%c%s%c", q, value, q) < 0) {
+		env_modprobe_options_append(value);
+		return;
+	}
+
+	env_modprobe_options_append(quoted);
+	free(quoted);
+}
