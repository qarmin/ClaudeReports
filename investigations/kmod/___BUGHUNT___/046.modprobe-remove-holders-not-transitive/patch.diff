diff --git a/tools/modprobe.c b/tools/modprobe.c
index b807529..def9a39 100644
--- a/tools/modprobe.c
+++ b/tools/modprobe.c
@@ -425,13 +425,13 @@ static int rmmod_do_remove_module(struct kmod_module *mod)
 static int rmmod_do_module(struct kmod_module *mod, int flags);
 
 /* Remove modules in reverse order */
-static int rmmod_do_modlist(struct kmod_list *list, bool stop_on_errors)
+static int rmmod_do_modlist(struct kmod_list *list, bool stop_on_errors, int flags)
 {
 	struct kmod_list *l;
 
 	kmod_list_foreach_reverse(l, list) {
 		struct kmod_module *m = kmod_module_get_module(l);
-		int r = rmmod_do_module(m, RMMOD_FLAG_IGNORE_BUILTIN);
+		int r = rmmod_do_module(m, RMMOD_FLAG_IGNORE_BUILTIN | flags);
 		kmod_module_unref(m);
 
 		if (r < 0 && stop_on_errors)
@@ -483,13 +483,13 @@ static int rmmod_do_module(struct kmod_module *mod, int flags)
 	}
 
 	/* 1. @mod's post-softdeps in reverse order */
-	rmmod_do_modlist(post, false);
+	rmmod_do_modlist(post, false, 0);
 
 	/* 2. Other modules holding @mod */
 	if (flags & RMMOD_FLAG_REMOVE_HOLDERS) {
 		struct kmod_list *holders = kmod_module_get_holders(mod);
 
-		err = rmmod_do_modlist(holders, true);
+		err = rmmod_do_modlist(holders, true, RMMOD_FLAG_REMOVE_HOLDERS);
 		kmod_module_unref_list(holders);
 		if (err < 0)
 			goto error;
@@ -534,7 +534,7 @@ static int rmmod_do_module(struct kmod_module *mod, int flags)
 	}
 
 	/* 5. @mod's pre-softdeps in reverse order: errors are non-fatal */
-	rmmod_do_modlist(pre, false);
+	rmmod_do_modlist(pre, false, 0);
 
 error:
 	kmod_module_unref_list(pre);
