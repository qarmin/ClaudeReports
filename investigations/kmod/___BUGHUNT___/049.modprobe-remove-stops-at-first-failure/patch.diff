diff --git a/tools/modprobe.c b/tools/modprobe.c
index b807529..f8a4ebf 100644
--- a/tools/modprobe.c
+++ b/tools/modprobe.c
@@ -574,6 +574,11 @@ static int rmmod(struct kmod_ctx *ctx, const char *alias)
 static int rmmod_all(struct kmod_ctx *ctx, char **args, int nargs)
 {
 	int i, err = 0;
+	int saved_priority = log_priority;
+
+	/* LOG() is fatal at the default priority: keep going with the other modules, like insmod_all() with -a */
+	if (nargs > 1)
+		log_priority = LOG_WARNING;
 
 	for (i = 0; i < nargs; i++) {
 		int r = rmmod(ctx, args[i]);
@@ -581,6 +586,7 @@ static int rmmod_all(struct kmod_ctx *ctx, char **args, int nargs)
 			err = r;
 	}
 
+	log_priority = saved_priority;
 	return err;
 }
 
