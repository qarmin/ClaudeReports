 fn color_no_convert(data: &[Vec<u8>], output: &mut [u8]) {
+    if data.is_empty() {
+        return;
+    }
+
+    // Each per-component line buffer is padded to a shared scratch capacity that can exceed the
+    // number of actually-valid (upsampled) samples per component; only the first `width` samples
+    // of each are meaningful, mirroring how the other color_convert_line_* functions are
+    // implicitly bounded by zipping against `output.chunks_exact_mut(component_count)`.
+    let width = output.len() / data.len();
     let mut output_iter = output.iter_mut();
 
-    for pixel in data {
-        for d in pixel {
-            *(output_iter.next().unwrap()) = *d;
+    for component in data {
+        for d in component.iter().take(width) {
+            match output_iter.next() {
+                Some(o) => *o = *d,
+                None => return,
+            }
         }
     }
 }
