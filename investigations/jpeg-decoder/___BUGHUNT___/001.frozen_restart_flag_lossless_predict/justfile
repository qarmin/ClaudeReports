repo_url := "https://github.com/image-rs/jpeg-decoder.git"
base_commit := "eb2d7c0f6a2d0298aba7a7f8b9ca1440353e8f8c"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug.
# (The repro binary always exits 0; it reports mismatches on stdout rather than via exit code -
# so this recipe asserts on the printed marker string instead.)
reproduce-before:
    cd repro && cargo run --release | tee /tmp/repro_before.out
    grep -q "BUG REPRODUCED" /tmp/repro_before.out

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug.
reproduce-after:
    cd repro && cargo run --release | tee /tmp/repro_after.out
    grep -q "image decoded correctly" /tmp/repro_after.out

clean:
    rm -rf clone
