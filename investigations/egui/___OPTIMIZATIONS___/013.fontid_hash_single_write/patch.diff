diff --git a/crates/epaint/src/text/font_id.rs b/crates/epaint/src/text/font_id.rs
index 2e04ea2b6..87677380f 100644
--- a/crates/epaint/src/text/font_id.rs
+++ b/crates/epaint/src/text/font_id.rs
@@ -43,8 +43,21 @@ impl core::hash::Hash for FontId {
     #[inline(always)]
     fn hash<H: core::hash::Hasher>(&self, state: &mut H) {
         let Self { size, family } = self;
-        emath::OrderedFloat(*size).hash(state);
-        family.hash(state);
+        // Size and family kind in one write: hashed once per text section of every layout.
+        let size_bits = if size.is_nan() {
+            0x7fc0_0000
+        } else {
+            (size + 0.0).to_bits() // same equivalence classes as `OrderedFloat`
+        };
+        let family_kind: u64 = match family {
+            FontFamily::Proportional => 0,
+            FontFamily::Monospace => 1,
+            FontFamily::Name(_) => 2,
+        };
+        state.write_u64(u64::from(size_bits) | family_kind << 32);
+        if let FontFamily::Name(name) = family {
+            name.hash(state);
+        }
     }
 }
 
