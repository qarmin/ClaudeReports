+/// Outline normals of a rounded rectangle whose four corners have the same radius, by number of points.
+///
+/// The normals only depend on the corner shape (not on the radius or position), so they are computed
+/// once with [`Path::add_line_loop`] from a canonical rectangle, instead of for every rectangle.
+/// `None` if there is no precomputed shape with this many points (e.g. corners were merged).
+fn rounded_rect_normals(num_points: usize) -> Option<&'static [Vec2]> {
+    static NORMALS: std::sync::OnceLock<[Vec<Vec2>; 5]> = std::sync::OnceLock::new();
+
+    let index = match num_points {
+        12 => 0,
+        20 => 1,
+        36 => 2,
+        68 => 3,
+        132 => 4,
+        _ => return None,
+    };
+    let normals = NORMALS.get_or_init(|| {
+        // One radius for each of the corner resolutions (see `path::add_circle_quadrant`):
+        [1.0_f32, 3.0, 10.0, 30.0, 60.0].map(|radius| {
+            let rect = Rect::from_min_size(Pos2::ZERO, Vec2::splat(4.0 * radius));
+            let mut points = Vec::new();
+            path::rounded_rectangle(&mut points, RoundedRect::new(rect, radius));
+            let mut path = Path::default();
+            path.add_line_loop(&points);
+            path.0.iter().map(|point| point.normal).collect()
+        })
+    });
+    Some(&normals[index])
+}
