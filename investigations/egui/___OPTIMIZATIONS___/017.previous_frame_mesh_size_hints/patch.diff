+/// The `(vertices, indices)` of every primitive, for [`Tessellator::with_mesh_size_hints`].
+pub fn mesh_sizes(primitives: &[ClippedPrimitive], out: &mut Vec<(usize, usize)>) {
+    out.clear();
+    out.extend(
+        primitives
+            .iter()
+            .map(|primitive| match &primitive.primitive {
+                Primitive::Mesh(mesh) => (mesh.vertices.len(), mesh.indices.len()),
+                Primitive::Callback(_) => (0, 0),
+            }),
+    );
+}
