+/// The three quads (six triangles) between two consecutive 4-vertex cross-sections of a stroke.
+#[inline(always)]
+fn push_strip_quads(out: &mut Mesh, a: u32, b: u32) {
+    out.indices.extend_from_slice(&[
+        a,
+        a + 1,
+        b,
+        a + 1,
+        b,
+        b + 1,
+        a + 1,
+        a + 2,
+        b + 1,
+        a + 2,
+        b + 1,
+        b + 2,
+        a + 2,
+        a + 3,
+        b + 2,
+        a + 3,
+        b + 2,
+        b + 3,
+    ]);
+}
