+impl core::hash::Hash for Color32 {
+    // A single `u32` write instead of the length prefix + byte slice that `[u8; 4]` hashes as.
+    #[inline(always)]
+    fn hash<H: core::hash::Hasher>(&self, state: &mut H) {
+        state.write_u32(u32::from_ne_bytes(self.0));
+    }
