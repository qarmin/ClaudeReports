 // ----------------------------------------------------------------------------
 
+/// Vertices and indices that text and mesh shapes will add (other shapes are not counted).
+fn shape_mesh_size(shape: &Shape) -> (usize, usize) {
+    match shape {
+        Shape::Text(text) => (text.galley.num_vertices, text.galley.num_indices),
+        Shape::Mesh(mesh) => (mesh.vertices.len(), mesh.indices.len()),
+        Shape::Vec(shapes) => shapes.iter().fold((0, 0), |(v, i), shape| {
+            let (sv, si) = shape_mesh_size(shape);
+            (v + sv, i + si)
+        }),
+        _ => (0, 0),
+    }
+}
+
+/// For each shape that starts a run of shapes with the same clip rect, the expected size of
+/// the mesh that run is tessellated into; `(0, 0)` for the other shapes.
+fn mesh_size_hints(shapes: &[ClippedShape]) -> Vec<(usize, usize)> {
+    let mut hints = vec![(0, 0); shapes.len()];
+    let mut run_start = 0;
+    let mut total = (0, 0);
+    for (i, clipped) in shapes.iter().enumerate() {
+        if clipped.clip_rect != shapes[run_start].clip_rect {
+            hints[run_start] = total;
+            run_start = i;
+            total = (0, 0);
+        }
+        let (v, idx) = shape_mesh_size(&clipped.shape);
+        total = (total.0 + v, total.1 + idx);
+    }
+    if let Some(hint) = hints.get_mut(run_start) {
+        *hint = total;
+    }
+    hints
+}
+
 /// Converts [`Shape`]s into triangles ([`Mesh`]).
 ///
 /// For performance reasons it is smart to reuse the same [`Tessellator`].
