+
+/// Same equivalence classes as [`emath::OrderedFloat`]'s hash (all NaNs equal, `-0.0 == 0.0`).
+#[inline(always)]
+fn float_bits(value: f32) -> u32 {
+    if value.is_nan() {
+        0x7fc0_0000
+    } else {
+        (value + 0.0).to_bits()
     }
 }
 
