@@ -91,8 +91,15 @@ impl core::hash::Hash for Stroke {
     #[inline(always)]
     fn hash<H: core::hash::Hasher>(&self, state: &mut H) {
         let Self { width, color } = *self;
-        emath::OrderedFloat(width).hash(state);
-        color.hash(state);
+        // Same equivalence classes as `OrderedFloat`; one write instead of three.
+        let width_bits = if width.is_nan() {
+            0x7fc0_0000
