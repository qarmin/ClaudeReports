+        // Packed into one write: this runs for every label layout, cached or not.
+        let flags = u32::from(*break_on_newline)
+            | u32::from(*justify) << 1
+            | u32::from(*round_output_to_gui) << 2
+            | u32::from(*keep_trailing_whitespace) << 3
