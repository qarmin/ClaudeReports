# Self-contained reproduction for this candidate.
#
# repro/repro.cpp and repro/repro_fixed.cpp reuse Godot's REAL
# core/templates/hash_map.h and core/os/memory.cpp verbatim (compiled directly
# from a fresh clone, no reimplementation) plus a minimal mirror function
# (mini_find_named_color) copying the exact body of Color::find_named_color
# (core/math/color.cpp:412-431) - same static-container shape, same lazy-init
# check, same (missing, in repro.cpp) lock. One deliberate simplification: the
# key type is CharString, not String - String::to_upper()/ustring.cpp's real
# implementation pulls in Object/OS/Variant/TranslationServer to link
# standalone, which is irrelevant to this bug (a concurrent-mutation race on
# HashMap's internal resize/rehash, identical for either CowData-backed string
# type). See gdscript_repro/ for an end-to-end repro using the real String type
# through the real engine binary instead.
#
# patch.diff is the real fix applied to the actual core/math/color.cpp - but
# the mirror here does NOT link against the real Color class (would require
# pulling in Object/ClassDB/the whole engine). `apply` is kept for the record;
# the "fix verified" claim rests on repro.cpp vs. repro_fixed.cpp.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "ebf68e6f024eda115c301595d9296f23f2a254eb"

inc_flags := "-I./clone -I./clone/platform/linuxbsd -DASAN_ENABLED -DTHREADS_ENABLED"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    touch clone/core/profiling/profiling.gen.h

# Expected (confirming) result: ASan aborts with a heap-buffer-overflow in
# HashMap internals well before the 18s timeout - `|| true` keeps this from
# failing the `test` chain.
reproduce-before:
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c clone/core/os/memory.cpp -o memory.o
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c repro/err_stub.cpp -o err_stub.o
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c repro/repro.cpp -o repro.o
    g++ -std=c++17 -fsanitize=address -g -O1 repro.o err_stub.o memory.o -o repro_before -lpthread
    ulimit -c 0 && (timeout 18 ./repro_before || true)

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Expected result: runs the full 18s and prints "No crash within the time
# limit" - no ASan abort.
reproduce-after:
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c clone/core/os/memory.cpp -o memory.o
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c repro/err_stub.cpp -o err_stub.o
    g++ -std=c++17 -fsanitize=address -g -O1 {{inc_flags}} -c repro/repro_fixed.cpp -o repro_fixed.o
    g++ -std=c++17 -fsanitize=address -g -O1 repro_fixed.o err_stub.o memory.o -o repro_after -lpthread
    ulimit -c 0 && timeout 18 ./repro_after

clean:
    rm -rf clone *.o repro_before repro_after
