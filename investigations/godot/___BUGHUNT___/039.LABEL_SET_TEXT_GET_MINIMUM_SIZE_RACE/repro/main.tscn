[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var lbl := Label.new()
	add_child(lbl)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_set_spam.bind(lbl))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_get_spam.bind(lbl))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _set_spam(lbl: Label) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(lbl):
			break
		lbl.text = \"Hello, world! This is a longer string to force reallocation.\" if flag else \"Short\"
		flag = not flag


func _get_spam(lbl: Label) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(lbl):
			break
		var s: Vector2 = lbl.get_minimum_size()
		var t: String = lbl.text
		var l := t.length()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
