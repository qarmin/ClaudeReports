[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var img := Image.create(1000, 1000, false, Image.FORMAT_RGBA8)

	var threads: Array[Thread] = []
	for i in range(2):
		var t := Thread.new()
		t.start(_resize.bind(img))
		threads.append(t)
	for i in range(4):
		var t := Thread.new()
		t.start(_touch.bind(img))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _resize(img: Image) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(img):
			break
		img.resize(1000, 1000) if flag else img.resize(2, 2)
		flag = not flag


func _touch(img: Image) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(img):
			break
		img.set_pixel(500, 500, Color(1, 0, 0))
		img.get_pixel(500, 500)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
