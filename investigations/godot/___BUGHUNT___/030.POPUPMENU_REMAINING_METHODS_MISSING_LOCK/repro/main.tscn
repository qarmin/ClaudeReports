[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var popup := PopupMenu.new()
	add_child(popup)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(popup))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


# Deliberately avoids set_item_count()/get_item_count() (candidate 018's own
# already-confirmed-and-fixed scope) - every call below is one of the ~100
# OTHER PopupMenu item accessors/mutators that candidate 018 flagged as still
# unguarded.
func _spam(popup: PopupMenu) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(popup):
			break
		match rng.randi() % 10:
			0:
				popup.add_item(\"x\")
			1:
				popup.add_icon_item(null, \"y\")
			2:
				popup.clear()
			3:
				popup.remove_item(0)
			4:
				popup.set_item_text(0, \"z\")
			5:
				popup.get_item_text(0)
			6:
				popup.set_item_checked(0, true)
			7:
				popup.is_item_checked(0)
			8:
				popup.scroll_to_item(0)
			9:
				popup.set_item_disabled(0, true)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
