[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var region := NavigationRegion2D.new()
	add_child(region)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(region))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(region: NavigationRegion2D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(region):
			break
		match rng.randi() % 8:
			0:
				region.set_enabled(rng.randi() % 2 == 0)
			1:
				region.set_use_edge_connections(rng.randi() % 2 == 0)
			2:
				region.set_navigation_layers(rng.randi())
			3:
				region.set_enter_cost(rng.randf())
			4:
				region.set_travel_cost(rng.randf())
			5:
				region.get_navigation_map()
			6:
				region.is_enabled()
			7:
				region.get_navigation_layers()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
