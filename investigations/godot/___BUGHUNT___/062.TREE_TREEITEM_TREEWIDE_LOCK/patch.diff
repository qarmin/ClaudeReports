diff --git a/scene/gui/tree.h b/scene/gui/tree.h
index b335aa8ab3..ffb4b09188 100644
--- a/scene/gui/tree.h
+++ b/scene/gui/tree.h
@@ -60,6 +60,11 @@ public:
 private:
 	friend class Tree;
 
+	// Used instead of `tree->_thread_safe_` only when this item has no `tree` (a standalone
+	// TreeItem not yet part of any Tree widget) - see Tree::_thread_safe_'s own comment for why
+	// the structural lock lives on Tree, not here.
+	mutable Mutex _fallback_mutex;
+
 	struct Cell {
 		mutable RID accessibility_cell_element;
 		TreeCellMode mode = TreeItem::CELL_MODE_STRING;
@@ -494,6 +499,14 @@ public:
 private:
 	friend class TreeItem;
 
+	// Guards the parent/child/sibling structure of every TreeItem in this tree (first_child/
+	// last_child/next/prev/parent, and TreeItem's children_cache). This is deliberately a single
+	// tree-wide lock, not a per-TreeItem one: a child's next/prev fields are written by its
+	// *parent's* create_child()/remove_child(), so a per-instance mutex on the child can never
+	// provide mutual exclusion against the parent's concurrent write - see candidate 042's own
+	// "what's not done" note. TreeItem reaches this via its `tree` back-pointer (friend access).
+	_THREAD_SAFE_CLASS_
+
 	TreeItem *root = nullptr;
 	TreeItem *popup_edited_item = nullptr;
 	TreeItem *selected_item = nullptr;
