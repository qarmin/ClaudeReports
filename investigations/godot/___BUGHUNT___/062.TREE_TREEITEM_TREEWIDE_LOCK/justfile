# Self-contained reproduction for this candidate.
#
# Per this project's repro policy (2026-10-05), this candidate has ONLY a
# GDScript-level repro (repro/) - no standalone C++ mirror.
#
# This candidate's patch is a complete replacement for candidate 042's own
# design (which only ever existed as its own patch.diff, never merged) - it
# does NOT reuse 042's per-instance-mutex approach. See RESULT.md for why a
# tree-wide lock (stored on Tree itself) is necessary instead of a lock per
# TreeItem.
#
# Build parallelism is deliberately capped (-j12, not -j$(nproc)) - a full
# -j$(nproc) use_asan=yes build on a 24-core/29GB box was observed to risk
# OOM when stacked with other concurrent work in this workspace. Editing
# tree.h triggers a wide recompile (the editor's scene tree dock, inspector,
# etc. all use Tree) - budget ~4 minutes for this specific rebuild.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "b8420aa3a60689572a745c0f8a85c9df62d4cbfb"

test: clone verify-patch

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

verify-patch:
    cd clone && git apply --check "{{justfile_directory()}}/patch.diff"
    @echo "patch.diff applies cleanly."

# The real thing: builds a fresh ASan editor binary from the clone, runs
# repro/ against it unpatched (expect a crash - a heap-use-after-free inside
# LocalVector::remove_at() or Span::find(), reached through concurrent
# create_child()/remove_child() calls on a Tree's root item racing
# get_next()/get_prev() calls on one of its stable children - NOTE: this
# needs enough contention to trigger reliably; a smaller-scale attempt (3+3
# threads/4s) saw 0/3 crashes, the shipped repro (6+6 threads/8s) saw 5/6),
# applies the fix, rebuilds, and runs it again (expect a clean "survived"
# exit).
build-and-run: clone
    cd clone && python3 -m venv .venv 2>/dev/null; . .venv/bin/activate 2>/dev/null; pip install scons -q 2>/dev/null || true
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== unfixed: running repro/ a few times, expect at least one crash ==="
    (cd clone && for i in 1 2 3; do ASAN_OPTIONS=detect_leaks=0 timeout -k 5 20 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro" || true; done)
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== fixed: running repro/, expect clean every time ==="
    cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 20 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro"

clean:
    rm -rf clone
