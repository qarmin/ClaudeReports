[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node3D


func _ready() -> void:
	var area := Area3D.new()
	add_child(area)
	area.process_mode = Node.PROCESS_MODE_DISABLED

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(area))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(area: Area3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(area):
			break
		if rng.randi() % 2 == 0:
			area.set_disable_mode(CollisionObject3D.DISABLE_MODE_MAKE_STATIC)
		else:
			area.set_disable_mode(CollisionObject3D.DISABLE_MODE_KEEP_ACTIVE)
"

[node name="Main" type="Node3D"]
script = SubResource("GDScript_1")
