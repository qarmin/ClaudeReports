[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var host := ENetConnection.new()
	host.create_host(64)

	var threads: Array[Thread] = []
	for i in range(4):
		var t := Thread.new()
		t.start(_connect_spam.bind(host))
		threads.append(t)
	for i in range(2):
		var t := Thread.new()
		t.start(_read_spam.bind(host))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _connect_spam(host: ENetConnection) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(host):
			break
		host.connect_to_host(\"127.0.0.1\", 34567, 0, 0)


func _read_spam(host: ENetConnection) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(host):
			break
		var peers: Array = host.get_peers()
		host.service(0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
