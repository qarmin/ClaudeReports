; Minimal project for candidate 028 - the debuggee. Started with
; `--remote-debug tcp://127.0.0.1:<PORT>`, which makes the engine construct a real
; `RemoteDebuggerPeerTCP` and spawn its real background `_poll()` thread
; (core/debugger/remote_debugger_peer.cpp). No special script logic is needed on this side:
; every engine frame already calls `RemoteDebugger::poll_events()` -> `flush_output()` /
; `_poll_messages()`, which read `peer->is_peer_connected()` / `peer->has_message()` with no
; lock, from the main thread, while the background `_poll()` thread concurrently writes
; `connected` and pushes into `in_queue` under its own mutex.

config_version=5

[application]

config/name="remote_debugger_race_client"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
