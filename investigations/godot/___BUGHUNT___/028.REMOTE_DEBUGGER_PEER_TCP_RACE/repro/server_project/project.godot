; Minimal project acting as the real second participant: a genuine TCP debug-server peer.
; Listens on a loopback TCP port and, once the debuggee (started separately with
; `--remote-debug tcp://127.0.0.1:<port>`) connects, floods it with real,
; protocol-correct `var_to_bytes()`-encoded messages over the real socket - the exact
; wire format `RemoteDebuggerPeerTCP::_read_in()` decodes on the other end.

config_version=5

[application]

config/name="remote_debugger_race_server"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
