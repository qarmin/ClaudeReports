; Minimal project to reproduce the missing lock in Input::action_press()/
; action_release() (core/input/input.cpp:1515-1543), which mutate the
; HashMap<StringName, ActionState> action_states with NO lock at all, via
; the public GDScript API Input.action_press()/Input.action_release()
; called concurrently from many Threads.

config_version=5

[application]

config/name="input_action_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
