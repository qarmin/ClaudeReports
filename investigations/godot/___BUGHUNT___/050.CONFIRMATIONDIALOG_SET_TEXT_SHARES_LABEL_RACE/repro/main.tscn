[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var dlg := ConfirmationDialog.new()
	add_child(dlg)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_set_spam.bind(dlg))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read_spam.bind(dlg))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _set_spam(dlg: ConfirmationDialog) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(dlg):
			break
		dlg.dialog_text = \"This is a longer confirmation message to force reallocation.\" if flag else \"Short\"
		flag = not flag


func _read_spam(dlg: ConfirmationDialog) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(dlg):
			break
		var t: String = dlg.dialog_text
		var l := t.length()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
