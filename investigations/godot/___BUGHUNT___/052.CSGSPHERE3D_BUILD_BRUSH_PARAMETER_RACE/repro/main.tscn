[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var sph := CSGSphere3D.new()
	add_child(sph)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(sph))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(sph: CSGSphere3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(sph):
			break
		match rng.randi() % 4:
			0:
				sph.radius = rng.randf_range(0.1, 5.0)
			1:
				sph.rings = rng.randi_range(2, 16)
			2:
				sph.bake_collision_shape()
			3:
				sph.get_meshes()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
