diff --git a/modules/csg/csg_shape.h b/modules/csg/csg_shape.h
index 85c05008c6..4ff7ea3319 100644
--- a/modules/csg/csg_shape.h
+++ b/modules/csg/csg_shape.h
@@ -32,6 +32,8 @@
 
 #include "csg.h"
 
+#include "core/os/mutex.h"
+
 #include "scene/3d/path_3d.h"
 #include "scene/3d/visual_instance_3d.h"
 
@@ -58,6 +60,22 @@ private:
 	Operation operation = OPERATION_UNION;
 	CSGShape3D *parent_shape = nullptr;
 
+protected:
+	// Guards dirty/brush/node_aabb against concurrent _get_brush() calls (e.g. two threads both
+	// calling bake_collision_shape()/get_meshes(), or a worker thread racing the main thread's own
+	// _make_dirty()-deferred update_shape()). Per-instance, not shared with any other CSGShape3D -
+	// _get_brush() holds it across a recursive child->_get_brush() call, which is safe because
+	// each child locks its own, different mutex instance; _make_dirty() releases it before
+	// propagating to parent_shape->_make_dirty() so it never holds a child's lock while asking for
+	// a parent's (see candidate 012/013's identical lesson on cross-object lock ordering).
+	// Protected (not private): CSGPrimitive3D subclasses' own shape-parameter setters
+	// (radius/rings/sides/height/etc.) must also take this lock around their field writes, not
+	// just call _make_dirty() - _build_brush() reads those same fields while holding this mutex
+	// (via _get_brush()), so an unlocked concurrent setter write is a TOCTOU race on the fields
+	// an override's _build_brush() uses to size its output arrays (candidate 052).
+	mutable Mutex brush_mutex;
+
+private:
 	CSGBrush *brush = nullptr;
 
 	AABB node_aabb;
