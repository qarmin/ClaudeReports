[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var bm := BitMap.new()
	bm.create(Vector2i(1000, 1000))

	var threads: Array[Thread] = []
	for i in range(2):
		var t := Thread.new()
		t.start(_resize.bind(bm))
		threads.append(t)
	for i in range(4):
		var t := Thread.new()
		t.start(_touch.bind(bm))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _resize(bm: BitMap) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(bm):
			break
		bm.create(Vector2i(1000, 1000) if flag else Vector2i(2, 2))
		flag = not flag


func _touch(bm: BitMap) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(bm):
			break
		bm.set_bit(500, 500, true)
		bm.get_bit(500, 500)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
