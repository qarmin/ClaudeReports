[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node3D


func _ready() -> void:
	var agent := NavigationAgent3D.new()
	add_child(agent)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(agent))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(agent: NavigationAgent3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(agent):
			break
		match rng.randi() % 8:
			0:
				agent.set_avoidance_enabled(rng.randi() % 2 == 0)
			1:
				agent.set_radius(rng.randf())
			2:
				agent.set_max_speed(rng.randf())
			3:
				agent.set_path_desired_distance(rng.randf())
			4:
				agent.set_target_position(Vector3(rng.randf(), rng.randf(), rng.randf()))
			5:
				agent.get_navigation_map()
			6:
				agent.get_avoidance_enabled()
			7:
				agent.get_radius()
"

[node name="Main" type="Node3D"]
script = SubResource("GDScript_1")
