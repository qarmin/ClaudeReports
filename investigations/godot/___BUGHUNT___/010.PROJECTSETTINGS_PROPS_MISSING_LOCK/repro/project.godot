; Minimal project to reproduce the missing lock on ProjectSettings' `props` RBMap
; (core/config/project_settings.h:101). set_setting() (-> _set(), locked) races against
; clear()/get_order()/is_builtin_setting() (all unlocked) via the public GDScript
; ProjectSettings singleton, called concurrently from many Threads.

config_version=5

