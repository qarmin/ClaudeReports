script/source = "extends Node


func _ready() -> void:
	var tree := Tree.new()
	add_child(tree)
	var root: TreeItem = tree.create_item()

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_mutate_spam.bind(tree, root))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read_spam.bind(root))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _mutate_spam(tree: Tree, root: TreeItem) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tree) or not is_instance_valid(root):
			break
		var child: TreeItem = tree.create_item(root)
		if root.get_child_count() > 1:
			var first := root.get_first_child()
			if first != null and is_instance_valid(first):
				root.remove_child(first)


func _read_spam(root: TreeItem) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(root):
			break
		var c: int = root.get_child_count()
		var first := root.get_first_child()
		if first != null and is_instance_valid(first):
			var n := first.get_next()
