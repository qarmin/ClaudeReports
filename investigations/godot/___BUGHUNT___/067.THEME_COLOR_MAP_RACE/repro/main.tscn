[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var th: Theme


func _ready() -> void:
	th = Theme.new()
	th.set_color(\"stable_name\", \"StableType\", Color(1, 0, 0))

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		var type_name := \"Type_%d\" % rng.randi()
		th.set_color(\"name\", type_name, Color(1, 1, 1))
		th.clear_color(\"name\", type_name)


func _reader_thread() -> void:
	while running:
		var _c: Color = th.get_color(\"stable_name\", \"StableType\")
		var _h: bool = th.has_color(\"stable_name\", \"StableType\")
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
