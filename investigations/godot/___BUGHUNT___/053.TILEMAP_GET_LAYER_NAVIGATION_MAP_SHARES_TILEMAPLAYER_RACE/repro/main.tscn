[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var tm := TileMap.new()
	add_child(tm)

	var threads: Array[Thread] = []
	for i in range(4):
		var t := Thread.new()
		t.start(_spam.bind(tm))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(tm: TileMap) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tm):
			break
		match rng.randi() % 3:
			0:
				tm.get_layer_navigation_map(0)
			1:
				tm.is_layer_navigation_enabled(0)
			2:
				tm.is_layer_enabled(0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
