[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var doc := GLTFDocument.new()
	var json_text := \"{\\\"asset\\\":{\\\"version\\\":\\\"2.0\\\"}}\"
	var bytes: PackedByteArray = json_text.to_utf8_buffer()

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(doc, bytes))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(doc: GLTFDocument, bytes: PackedByteArray) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(doc):
			break
		var state := GLTFState.new()
		doc.append_from_buffer(bytes, \"\", state, 0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
