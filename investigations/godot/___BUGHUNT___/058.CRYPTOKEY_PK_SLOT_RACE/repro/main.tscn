[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var key: CryptoKey
var pem: String


func _ready() -> void:
	var crypto := Crypto.new()
	key = crypto.generate_rsa(2048)
	pem = key.save_to_string(false)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(6):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(8.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		key.load_from_string(pem, false)


func _reader_thread() -> void:
	while running:
		var _s := key.save_to_string(false)
		var _b := key.is_public_only()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
