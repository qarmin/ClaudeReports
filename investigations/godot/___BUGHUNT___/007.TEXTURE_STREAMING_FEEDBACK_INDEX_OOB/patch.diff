@@ -463,6 +463,12 @@ uint32_t TextureStreaming::feedback_buffer_material_index(RID p_material) {
 	if (_buffer) {
 		// material_info_owner.get_index() is thread-safe (only reads from RID_Owner which is thread-safe)
 		uint32_t index = material_info_owner.get_index(p_material);
+		// get_index() returns UINT32_MAX (RID_IndexedOwner::INVALID_INDEX) for a material
