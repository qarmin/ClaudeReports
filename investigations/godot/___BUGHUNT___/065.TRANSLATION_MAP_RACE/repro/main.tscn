[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var tr: Translation


func _ready() -> void:
	tr = Translation.new()
	tr.add_message(\"stable_key\", \"stable_value\")

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		var key := \"key_%d\" % rng.randi()
		tr.add_message(key, \"value\")
		tr.erase_message(key)


func _reader_thread() -> void:
	while running:
		var _s: String = tr.get_message(\"stable_key\")
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
