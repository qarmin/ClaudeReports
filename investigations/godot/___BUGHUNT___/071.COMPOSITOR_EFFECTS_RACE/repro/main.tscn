[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var comp: Compositor
var pool: Array[CompositorEffect] = []


func _ready() -> void:
	comp = Compositor.new()
	for i in range(5):
		pool.append(CompositorEffect.new())

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		var arr: Array[CompositorEffect] = []
		for e in pool:
			arr.append(e)
		comp.compositor_effects = arr


func _reader_thread() -> void:
	while running:
		var arr = comp.compositor_effects
		for e in arr:
			if e != null:
				e.enabled = true
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
