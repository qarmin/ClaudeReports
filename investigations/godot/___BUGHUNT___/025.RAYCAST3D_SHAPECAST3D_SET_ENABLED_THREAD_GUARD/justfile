# Self-contained reproduction for this candidate.
#
# Per this project's repro policy (2026-10-05), this candidate has ONLY a GDScript-level repro
# (repro/ for RayCast3D, repro_shapecast/ for ShapeCast3D) - no standalone C++ mirror. Re-running
# it from scratch means building a real Godot editor binary with ASan (~15-30 min from a clean
# clone, much less if an object-code cache from a previous build of the same commit is reused), so
# this justfile splits into a cheap default check (`test`: does the patch still apply to a fresh
# clone?) and a separate, expensive recipe (`build-and-run`) that does the real thing.
#
# Build parallelism is deliberately capped (-j12, not -j$(nproc)) - a full -j$(nproc)
# use_asan=yes build on a 24-core/29GB box was observed to risk OOM when stacked with other
# concurrent work in this workspace.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "b8420aa3a60689572a745c0f8a85c9df62d4cbfb"

test: clone verify-patch

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Cheap sanity check: does patch.diff still apply cleanly to the commit this
# candidate was recorded against? Does NOT build or run anything.
verify-patch:
    cd clone && git apply --check "{{justfile_directory()}}/patch.diff"
    @echo "patch.diff applies cleanly."

# The real thing: builds a fresh ASan editor binary from the clone, runs both repros against it
# unpatched (expect a crash in each - a deterministic null-pointer dereference, reproduces every
# time, not timing-dependent), applies the fix, rebuilds, and runs both again (expect clean
# "survived" exits).
build-and-run: clone
    cd clone && python3 -m venv .venv 2>/dev/null; . .venv/bin/activate 2>/dev/null; pip install scons -q 2>/dev/null || true
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== unfixed: running repro/ (RayCast3D), expect a crash ==="
    (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro" || true)
    @echo "=== unfixed: running repro_shapecast/ (ShapeCast3D), expect a crash ==="
    (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro_shapecast" || true)
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== fixed: running repro/, expect clean ==="
    cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro"
    @echo "=== fixed: running repro_shapecast/, expect clean ==="
    cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro_shapecast"

clean:
    rm -rf clone
