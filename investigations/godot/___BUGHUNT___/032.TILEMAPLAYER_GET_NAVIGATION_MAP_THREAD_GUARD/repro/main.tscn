[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var tml := TileMapLayer.new()
	add_child(tml)

	var threads: Array[Thread] = []
	for i in range(4):
		var t := Thread.new()
		t.start(_spam.bind(tml))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(tml: TileMapLayer) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tml):
			break
		match rng.randi() % 3:
			0:
				tml.get_navigation_map()
			1:
				tml.is_navigation_enabled()
			2:
				tml.is_enabled()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
