[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var tp := TextParagraph.new()

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_set_spam.bind(tp))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_get_spam.bind(tp))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _set_spam(tp: TextParagraph) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tp):
			break
		tp.set_ellipsis_char(\"…\" if flag else \".\")
		flag = not flag


func _get_spam(tp: TextParagraph) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tp):
			break
		var s: String = tp.get_ellipsis_char()
		var l := s.length()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
