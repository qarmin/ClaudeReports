[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var tb := TabBar.new()
	add_child(tb)
	for i in range(10):
		tb.add_tab(\"tab %d\" % i)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_mutate_spam.bind(tb))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read_spam.bind(tb))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _mutate_spam(tb: TabBar) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tb):
			break
		tb.add_tab(\"new tab\")
		if tb.tab_count > 1:
			tb.remove_tab(0)


func _read_spam(tb: TabBar) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(tb):
			break
		var c: int = tb.tab_count
		if c > 0:
			var t: String = tb.get_tab_title(0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
