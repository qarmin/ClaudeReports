[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var tp: TextParagraph


func _ready() -> void:
	tp = TextParagraph.new()
	tp.set_ellipsis_char(\".\")

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var toggle := true
	while running:
		if toggle:
			tp.set_ellipsis_char(\".\")
		else:
			tp.set_ellipsis_char(\"-\")
		toggle = !toggle


func _reader_thread() -> void:
	while running:
		var copy := tp.duplicate()
		var _s := copy.get_ellipsis_char()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
