[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var sp := StreamPeerGZIP.new()
	sp.start_compression(false, 65535)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(sp, i))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(sp: StreamPeerGZIP, idx: int) -> void:
	var small := PackedByteArray()
	small.resize(16)
	var big := PackedByteArray()
	big.resize(4096)
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(sp):
			break
		sp.put_partial_data(big if flag else small)
		if sp.get_available_bytes() > 0:
			sp.get_partial_data(sp.get_available_bytes())
		flag = not flag
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
