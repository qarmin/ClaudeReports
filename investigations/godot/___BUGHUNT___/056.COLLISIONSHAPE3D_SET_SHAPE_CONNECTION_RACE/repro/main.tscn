[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var cs: CollisionShape3D
var box: BoxShape3D
var sphere: SphereShape3D


func _ready() -> void:
	cs = CollisionShape3D.new()
	add_child(cs)
	box = BoxShape3D.new()
	sphere = SphereShape3D.new()

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var toggle := true
	while running:
		if toggle:
			cs.shape = box
		else:
			cs.shape = sphere
		toggle = !toggle


func _reader_thread() -> void:
	while running:
		var s: Shape3D = cs.shape
		if s != null:
			var _c = s.get_class()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
