[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var il := ItemList.new()
	add_child(il)
	for i in range(10):
		il.add_item(\"item %d\" % i)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_mutate_spam.bind(il))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read_spam.bind(il))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _mutate_spam(il: ItemList) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(il):
			break
		il.add_item(\"new item\")
		if il.item_count > 1:
			il.remove_item(0)


func _read_spam(il: ItemList) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(il):
			break
		var c: int = il.item_count
		if c > 0:
			var t: String = il.get_item_text(0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
