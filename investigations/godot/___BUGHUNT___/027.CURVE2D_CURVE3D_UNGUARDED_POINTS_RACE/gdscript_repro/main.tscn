[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var curve2d := Curve2D.new()
	curve2d.add_point(Vector2(0.0, 0.0))
	curve2d.add_point(Vector2(1.0, 1.0))

	var curve3d := Curve3D.new()
	curve3d.add_point(Vector3(0.0, 0.0, 0.0))
	curve3d.add_point(Vector3(1.0, 1.0, 1.0))

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_spam2d.bind(curve2d))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_spam3d.bind(curve3d))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam2d(curve: Curve2D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		match rng.randi() % 5:
			0:
				curve.add_point(Vector2(rng.randf(), rng.randf()))
			1:
				if curve.get_point_count() > 0:
					curve.remove_point(rng.randi() % curve.get_point_count())
			2:
				curve.samplef(rng.randf() * curve.get_point_count())
			3:
				curve.sample_baked(rng.randf() * curve.get_baked_length())
			4:
				if curve.get_point_count() > 0:
					curve.get_point_position(rng.randi() % curve.get_point_count())


func _spam3d(curve: Curve3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		match rng.randi() % 5:
			0:
				curve.add_point(Vector3(rng.randf(), rng.randf(), rng.randf()))
			1:
				if curve.get_point_count() > 0:
					curve.remove_point(rng.randi() % curve.get_point_count())
			2:
				curve.samplef(rng.randf() * curve.get_point_count())
			3:
				curve.sample_baked(rng.randf() * curve.get_baked_length())
			4:
				if curve.get_point_count() > 0:
					curve.get_point_position(rng.randi() % curve.get_point_count())
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
