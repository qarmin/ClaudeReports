[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var ce: CodeEdit


func _ready() -> void:
	ce = CodeEdit.new()
	add_child(ce)
	var lines := PackedStringArray()
	for i in range(100):
		lines.append(\"line %d\" % i)
	ce.text = \"\\n\".join(lines)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		var line := rng.randi_range(0, 99)
		ce.set_line_as_breakpoint(line, true)
		ce.set_line_as_breakpoint(line, false)


func _reader_thread() -> void:
	while running:
		ce.get_breakpointed_lines()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
