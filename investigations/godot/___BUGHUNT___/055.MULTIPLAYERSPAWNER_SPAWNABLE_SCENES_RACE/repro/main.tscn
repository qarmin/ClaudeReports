[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var sp: MultiplayerSpawner


func _ready() -> void:
	sp = MultiplayerSpawner.new()
	add_child(sp)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		sp.add_spawnable_scene(\"res://fake_%d.tscn\" % randi())
		if sp.get_spawnable_scene_count() > 50:
			sp.clear_spawnable_scenes()


func _reader_thread() -> void:
	while running:
		var c := sp.get_spawnable_scene_count()
		for i in range(c):
			sp.get_spawnable_scene(i)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
