[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var obstacle := NavigationObstacle3D.new()
	add_child(obstacle)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(obstacle))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(obstacle: NavigationObstacle3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(obstacle):
			break
		match rng.randi() % 8:
			0:
				obstacle.set_avoidance_enabled(rng.randi() % 2 == 0)
			1:
				obstacle.set_radius(rng.randf())
			2:
				obstacle.set_height(rng.randf())
			3:
				obstacle.set_avoidance_layers(rng.randi())
			4:
				obstacle.set_use_3d_avoidance(rng.randi() % 2 == 0)
			5:
				obstacle.get_navigation_map()
			6:
				obstacle.get_avoidance_enabled()
			7:
				obstacle.get_radius()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
