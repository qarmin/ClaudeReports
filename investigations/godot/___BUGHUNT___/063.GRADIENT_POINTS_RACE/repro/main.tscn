[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var g: Gradient


func _ready() -> void:
	g = Gradient.new()
	g.add_point(0.5, Color(1, 0, 0))

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		g.add_point(rng.randf(), Color(rng.randf(), rng.randf(), rng.randf()))
		if g.get_point_count() > 20:
			g.remove_point(0)


func _reader_thread() -> void:
	while running:
		var c: int = g.get_point_count()
		for i in range(c):
			g.get_color(i)
			g.get_offset(i)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
