[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var sc := SplitContainer.new()
	add_child(sc)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_set_spam.bind(sc))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_get_spam.bind(sc))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _set_spam(sc: SplitContainer) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(sc):
			break
		var big := PackedInt32Array()
		big.resize(200)
		var small := PackedInt32Array([1])
		sc.split_offsets = big if flag else small
		flag = not flag


func _get_spam(sc: SplitContainer) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(sc):
			break
		var o: PackedInt32Array = sc.split_offsets
		var l := o.size()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
