[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true


func _ready() -> void:
	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		AudioServer.add_bus(1)
		if AudioServer.get_bus_count() > 10:
			AudioServer.remove_bus(AudioServer.get_bus_count() - 1)


func _reader_thread() -> void:
	while running:
		var c := AudioServer.get_bus_count()
		for i in range(c):
			AudioServer.set_bus_volume_db(i, -1.0)
			AudioServer.get_bus_volume_db(i)
			AudioServer.set_bus_mute(i, false)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
