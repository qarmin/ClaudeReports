[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var te := TextEdit.new()
	add_child(te)

	var big_lines := PackedStringArray()
	for i in range(100):
		big_lines.append(\"line %d\" % i)
	var big_text: String = \"\\n\".join(big_lines)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_set_spam.bind(te, big_text))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_get_spam.bind(te))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _set_spam(te: TextEdit, big_text: String) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(te):
			break
		te.text = big_text if flag else \"short\"
		flag = not flag


func _get_spam(te: TextEdit) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(te):
			break
		var c: int = te.get_line_count()
		if c > 0:
			var l: String = te.get_line(c - 1)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
