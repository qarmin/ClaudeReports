[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var cyl := CSGCylinder3D.new()
	add_child(cyl)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(cyl))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(cyl: CSGCylinder3D) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(cyl):
			break
		match rng.randi() % 4:
			0:
				cyl.radius = rng.randf_range(0.1, 5.0)
			1:
				cyl.height = rng.randf_range(0.1, 5.0)
			2:
				cyl.bake_collision_shape()
			3:
				cyl.get_meshes()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
