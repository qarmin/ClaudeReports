[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var mb := MenuButton.new()
	add_child(mb)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_spam.bind(mb))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(mb: MenuButton) -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 15000:
		if not is_instance_valid(mb):
			break
		match rng.randi() % 3:
			0:
				mb.get_popup()
			1:
				mb.set_item_count(rng.randi() % 5)
			2:
				mb.get_item_count()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
