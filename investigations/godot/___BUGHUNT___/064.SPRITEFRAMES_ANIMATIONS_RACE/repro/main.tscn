[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var sf: SpriteFrames


func _ready() -> void:
	sf = SpriteFrames.new()
	sf.add_animation(\"anim\")
	sf.add_frame(\"anim\", null)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		sf.add_frame(\"anim\", null)
		if sf.get_frame_count(\"anim\") > 20:
			sf.remove_frame(\"anim\", 0)


func _reader_thread() -> void:
	while running:
		var c: int = sf.get_frame_count(\"anim\")
		for i in range(c):
			sf.get_frame_texture(\"anim\", i)
			sf.get_frame_duration(\"anim\", i)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
