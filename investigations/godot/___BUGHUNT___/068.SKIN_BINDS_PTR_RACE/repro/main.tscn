[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var sk: Skin


func _ready() -> void:
	sk = Skin.new()
	sk.add_bind(0, Transform3D())

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		sk.add_bind(rng.randi_range(0, 10), Transform3D())
		if sk.get_bind_count() > 30:
			sk.set_bind_count(1)


func _reader_thread() -> void:
	while running:
		var c: int = sk.get_bind_count()
		for i in range(c):
			sk.get_bind_bone(i)
			sk.get_bind_pose(i)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
