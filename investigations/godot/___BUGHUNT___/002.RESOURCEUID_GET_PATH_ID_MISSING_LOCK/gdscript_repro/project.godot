; Engine configuration file.
; This minimal project exists only to reproduce one bug:
; ResourceUID.get_path_id() (reached via ResourceLoader.get_resource_uid()) races
; with ResourceUID.add_id()/remove_id() because the former takes no lock.
; See README.md in this folder.

config_version=5

[application]

config/name="resourceuid_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
