[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var ge := GraphEdit.new()
	add_child(ge)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_mutate_spam.bind(ge))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read_spam.bind(ge))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _mutate_spam(ge: GraphEdit) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(ge):
			break
		ge.connect_node(\"A\", 0, \"B\", 0)
		ge.disconnect_node(\"A\", 0, \"B\", 0)


func _read_spam(ge: GraphEdit) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(ge):
			break
		var l: Array = ge.get_connection_list()
		var c: bool = ge.is_node_connected(\"A\", 0, \"B\", 0)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
