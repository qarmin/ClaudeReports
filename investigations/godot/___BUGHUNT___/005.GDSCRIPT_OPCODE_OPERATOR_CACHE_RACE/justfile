# Self-contained reproduction for this candidate.
#
# Per this project's repro policy (2026-10-05), this candidate has ONLY a
# GDScript-level repro (gdscript_repro/) - no standalone C++ mirror. Unlike a
# mirror repro, actually re-running it from scratch means building a real
# Godot editor binary with ASan (~1-15 min depending on how much is cached),
# so this justfile splits into a cheap default check (`test`: does the patch
# still apply to a fresh clone?) and a separate, expensive recipe
# (`build-and-run`) that does the real thing.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "b8420aa3a60689572a745c0f8a85c9df62d4cbfb"

test: clone verify-patch

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Cheap sanity check: does patch.diff still apply cleanly to the commit this
# candidate was recorded against? Does NOT build or run anything.
verify-patch:
    cd clone && git apply --check "{{justfile_directory()}}/patch.diff"
    @echo "patch.diff applies cleanly."

# The real thing: builds a fresh ASan editor binary from the clone, runs
# gdscript_repro/ against it unpatched (expect a SIGSEGV within a handful of
# runs - this is a narrow race, not 100% per-run), applies the fix, rebuilds
# (much faster, only gdscript_vm.cpp changed), and runs it again (expect
# clean every time). Takes several minutes even on a warm SCons cache.
build-and-run: clone
    cd clone && python3 -m venv .venv 2>/dev/null; . .venv/bin/activate 2>/dev/null; pip install scons -q 2>/dev/null || true
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j"$(nproc)"
    @echo "=== unfixed: running gdscript_repro/ 5 times, expect at least one SIGSEGV ==="
    for i in 1 2 3 4 5; do \
        (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/gdscript_repro" || true); \
    done
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j"$(nproc)"
    @echo "=== fixed: running gdscript_repro/ 5 times, expect all clean ==="
    for i in 1 2 3 4 5; do \
        (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout 30 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/gdscript_repro"); \
    done

clean:
    rm -rf clone
