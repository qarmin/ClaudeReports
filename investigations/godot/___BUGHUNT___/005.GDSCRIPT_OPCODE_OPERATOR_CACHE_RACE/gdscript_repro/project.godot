; Minimal project to reproduce the OPCODE_OPERATOR first-run cache race
; (modules/gdscript/gdscript_vm.cpp:779-810) via plain GDScript `a + b` expressions,
; called concurrently from many Threads for the first time.

config_version=5

[application]

config/name="opcode_operator_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
