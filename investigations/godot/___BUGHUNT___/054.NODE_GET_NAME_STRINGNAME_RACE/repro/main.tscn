[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var n: Node


func _ready() -> void:
	n = Node.new()
	add_child(n)

	var threads: Array[Thread] = []
	for i in range(6):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	# Main-thread writer loop - this is the documented-supported shape (main
	# thread renames, worker threads read), satisfying set_name()'s own
	# existing is-main-thread guard.
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 6000:
		n.name = \"name_%d\" % rng.randi()

	running = false
	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _reader_thread() -> void:
	while running:
		var s: String = n.name
		var _l = s.length()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
