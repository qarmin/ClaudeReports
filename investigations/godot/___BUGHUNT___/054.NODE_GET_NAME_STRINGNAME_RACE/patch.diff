 StringName Node::get_name() const {
+	// Not ERR_READ_THREAD_GUARD_V: that macro's error message calls get_description(), which (when
+	// inside the tree) calls get_path(), which calls get_name() on every ancestor - recursing right
+	// back into this same guard on the same (disallowed) thread and stack-overflowing. get_class()
+	// doesn't touch data.name, so it can't recurse the same way.
+	if (unlikely(!is_readable_from_caller_thread())) {
+		ERR_FAIL_V_MSG(StringName(), vformat("%s: The function `get_name()` on this node can only be accessed from either the main thread or a thread group. Use `call_deferred()` instead.", get_class()));
+	}
 	return data.name;
 }
 
