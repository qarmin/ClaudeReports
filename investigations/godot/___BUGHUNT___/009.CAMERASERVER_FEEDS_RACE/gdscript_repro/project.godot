; Minimal project to reproduce the fully-unlocked CameraServer::feeds Vector
; (servers/camera/camera_server.cpp) - add_feed()/remove_feed()/get_feed()/
; get_feeds()/get_feed_count() all touch `feeds` with zero locking, despite
; CameraServer declaring (but never using) a _THREAD_SAFE_CLASS_ mutex.

config_version=5

[application]

config/name="camera_server_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
