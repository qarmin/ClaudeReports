# Self-contained reproduction for this candidate.
#
# Per this project's repro policy (2026-10-05), this candidate has ONLY a
# GDScript-level repro (repro/) - no standalone C++ mirror.
#
# NOTE: unlike most candidates this session, the unfixed symptom is NOT a
# crash - it's a deterministic HANG (the process never prints "survived" and
# must be killed by `timeout`). This is the same StringName-corruption-driven
# engine-wide freeze shape documented in candidate 054 (Node::get_name) -
# "fixed" means the process exits cleanly and prints "survived", not that a
# segfault stops happening.
#
# Build parallelism is deliberately capped (-j12, not -j$(nproc)) - a full
# -j$(nproc) use_asan=yes build on a 24-core/29GB box was observed to risk
# OOM when stacked with other concurrent work in this workspace.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "b8420aa3a60689572a745c0f8a85c9df62d4cbfb"

test: clone verify-patch

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

verify-patch:
    cd clone && git apply --check "{{justfile_directory()}}/patch.diff"
    @echo "patch.diff applies cleanly."

# The real thing: builds a fresh ASan editor binary from the clone, runs
# repro/ against it unpatched under `timeout` (expect it to be KILLED by the
# timeout - the process hangs and never prints "survived"), applies the fix,
# rebuilds, and runs it again (expect a clean "survived" exit well within
# the timeout).
build-and-run: clone
    cd clone && python3 -m venv .venv 2>/dev/null; . .venv/bin/activate 2>/dev/null; pip install scons -q 2>/dev/null || true
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== unfixed: running repro/, expect it to hang and get killed by timeout ==="
    (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 10 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro" || true)
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== fixed: running repro/, expect clean ==="
    cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 15 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro"

clean:
    rm -rf clone
