[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var bm: BoneMap


func _ready() -> void:
	var prof := SkeletonProfile.new()
	prof.set_bone_size(1)
	prof.set_bone_name(0, &\"root\")

	bm = BoneMap.new()
	bm.set_profile(prof)
	print(\"setup done, has root: \", bm.get_skeleton_bone_name(&\"root\") == &\"\")

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)
	print(\"threads started\")

	await get_tree().create_timer(3.0).timeout
	print(\"timer done\")
	running = false

	for t in threads:
		t.wait_to_finish()
	print(\"threads joined\")

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	while running:
		bm.set_skeleton_bone_name(&\"root\", \"bone_%d\" % rng.randi())


func _reader_thread() -> void:
	while running:
		var _s: StringName = bm.get_skeleton_bone_name(&\"root\")
		var _f: StringName = bm.find_profile_bone_name(&\"root\")
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
