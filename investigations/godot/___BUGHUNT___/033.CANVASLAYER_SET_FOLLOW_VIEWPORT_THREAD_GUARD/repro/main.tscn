[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var cl := CanvasLayer.new()
	add_child(cl)

	var threads: Array[Thread] = []
	for i in range(4):
		var t := Thread.new()
		t.start(_spam.bind(cl))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _spam(cl: CanvasLayer) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 3000:
		if not is_instance_valid(cl):
			break
		cl.set_follow_viewport(flag)
		flag = not flag
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
