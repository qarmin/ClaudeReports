# Self-contained reproduction for this candidate.
#
# Per this project's repro policy (2026-10-05), this candidate has ONLY a
# GDScript-level repro (repro/) - no standalone C++ mirror.
#
# patch.diff is a SUPERSET of candidate 036's own patch.diff (same
# resize()/set_data()/_copy_internals_from()/get_pixel()/set_pixel() locks),
# PLUS this candidate's own addition: _THREAD_SAFE_METHOD_ on ~69 other
# ClassDB-bound methods, generated via lock_image_methods.py (kept here for
# reference/reuse - a small regex-based script that finds `Image::method(`
# definitions and inserts the lock macro right after the opening brace, same
# approach candidate 030 used for PopupMenu's ~80 remaining methods).
#
# NOTE: get_data() is deliberately NOT locked - it returns `const Vector<uint8_t>&`,
# a reference into Image's own data, so locking just the accessor doesn't
# protect a caller that keeps using the reference after the function returns
# (the same "caller outlives the lock" shape as candidate 015's CSGShape3D).
#
# Build parallelism is deliberately capped (-j12, not -j$(nproc)) - a full
# -j$(nproc) use_asan=yes build on a 24-core/29GB box was observed to risk
# OOM when stacked with other concurrent work in this workspace. Editing
# image.h triggers a VERY wide recompile (Image is used almost everywhere) -
# budget 10-15 minutes for this specific rebuild, not the usual ~1-2 min.

repo_url := "https://github.com/qarmin/godot.git"
base_commit := "b8420aa3a60689572a745c0f8a85c9df62d4cbfb"

test: clone verify-patch

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

verify-patch:
    cd clone && git apply --check "{{justfile_directory()}}/patch.diff"
    @echo "patch.diff applies cleanly."

# The real thing: builds a fresh ASan editor binary from the clone, runs
# repro/ against it unpatched (expect a crash - various heap-use-after-free/
# FATAL bounds-check signatures depending on interleaving, reached through
# crop()/flip_x()/convert() racing get_size()/is_empty()/get_used_rect() -
# reproduces reliably), applies the fix, rebuilds (budget 10-15 min, not the
# usual best case), and runs it again (expect a clean "survived" exit).
build-and-run: clone
    cd clone && python3 -m venv .venv 2>/dev/null; . .venv/bin/activate 2>/dev/null; pip install scons -q 2>/dev/null || true
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== unfixed: running repro/, expect a crash ==="
    (cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 15 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro" || true)
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && scons platform=linuxbsd target=editor use_asan=yes tests=yes debug_symbols=yes -j12
    @echo "=== fixed: running repro/, expect clean ==="
    cd clone && ASAN_OPTIONS=detect_leaks=0 timeout -k 5 15 ./bin/godot.linuxbsd.editor.x86_64.san --headless --path "{{justfile_directory()}}/repro"

clean:
    rm -rf clone
