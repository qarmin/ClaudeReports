[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


func _ready() -> void:
	var img := Image.create(256, 256, false, Image.FORMAT_RGBA8)

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_mutate.bind(img))
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_read.bind(img))
		threads.append(t)
	for t in threads:
		t.wait_to_finish()
	print(\"survived\")
	get_tree().quit()


func _mutate(img: Image) -> void:
	var start: int = Time.get_ticks_msec()
	var flag := true
	while Time.get_ticks_msec() - start < 4000:
		if not is_instance_valid(img):
			break
		if flag:
			img.crop(256, 256)
			img.flip_x()
		else:
			img.crop(64, 64)
			img.convert(Image.FORMAT_RGB8)
			img.convert(Image.FORMAT_RGBA8)
		flag = not flag


func _read(img: Image) -> void:
	var start: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - start < 4000:
		if not is_instance_valid(img):
			break
		var _s := img.get_size()
		var _e := img.is_empty()
		var _u := img.get_used_rect()
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
