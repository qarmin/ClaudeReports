; Minimal project to reproduce the missing lock in
; CallQueue::get_max_buffer_usage() (core/object/message_queue.cpp:456-458)
; via the public GDScript API: Performance.get_monitor(Performance.MEMORY_MESSAGE_BUFFER_MAX)
; reads the same global MessageQueue::get_singleton() that call_deferred() mutates.

config_version=5

[application]

config/name="callqueue_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[memory]

limits/message_queue/max_size_mb=256

