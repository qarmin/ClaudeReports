; Minimal project to reproduce the missing lock on ProjectSettings' `custom_prop_info` HashMap
; (core/config/project_settings.h:103). ProjectSettings.add_property_info() (-> set_custom_property_info(),
; fully UNLOCKED write into custom_prop_info) races against ProjectSettings.get_property_list()
; (-> _get_property_list(), _THREAD_SAFE_METHOD_-guarded, but reads the SAME custom_prop_info
; HashMap) via the public GDScript ProjectSettings/Object singleton API, called concurrently
; from many Threads.

config_version=5

[application]

config/name="project_settings_custom_prop_info_race_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
