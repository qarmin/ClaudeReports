; Minimal project to reproduce heap corruption in CallQueue::push_callablep()'s
; out-of-memory branch (core/object/message_queue.cpp:94-99), which calls
; statistics() (:347-440) - statistics() destructs every pending Message/Variant
; in place but never resets pages_used/page_bytes, so the queue is left
; believing it still holds pages_used valid pages of already-destructed messages.

config_version=5

[application]

config/name="callqueue_oom_corruption_repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[memory]

limits/message_queue/max_size_mb=1
