[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node


var running := true
var ls: LabelSettings


func _ready() -> void:
	ls = LabelSettings.new()
	for i in range(5):
		ls.add_stacked_outline()
		ls.add_stacked_shadow()

	var threads: Array[Thread] = []
	for i in range(3):
		var t := Thread.new()
		t.start(_writer_thread)
		threads.append(t)
	for i in range(3):
		var t := Thread.new()
		t.start(_reader_thread)
		threads.append(t)

	await get_tree().create_timer(3.0).timeout
	running = false

	for t in threads:
		t.wait_to_finish()

	print(\"survived\")
	get_tree().quit()


func _writer_thread() -> void:
	while running:
		ls.add_stacked_outline()
		ls.remove_stacked_outline(0)
		ls.add_stacked_shadow()
		ls.remove_stacked_shadow(0)


func _reader_thread() -> void:
	while running:
		var c := ls.get_stacked_outline_count()
		for i in range(c):
			ls.set_stacked_outline_size(i, 3)
			ls.get_stacked_outline_color(i)
		var cs := ls.get_stacked_shadow_count()
		for i in range(cs):
			ls.set_stacked_shadow_color(i, Color(1, 0, 0))
			ls.get_stacked_shadow_offset(i)
"

[node name="Main" type="Node"]
script = SubResource("GDScript_1")
