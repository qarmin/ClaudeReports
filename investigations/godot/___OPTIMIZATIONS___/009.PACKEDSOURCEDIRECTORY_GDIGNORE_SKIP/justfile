# Self-contained reproduction for this candidate.
#
# Everything needed is either in this folder or fetched by `just clone` into ./clone (gitignored).
# `bench/generate_repro_project.py` builds the synthetic repro project (a `.gdignore`-marked
# directory with 15,000 files, matching the shape of godotengine/godot#122438's own report) fresh
# each time - no fixture files need to be shipped in this folder.
#
# This is a from-scratch Godot build (SCons) - expect ~15-25 min per build on a modern multi-core
# machine, not a Rust/cargo build. scons isn't preinstalled everywhere - `pip3 install scons
# --break-system-packages` if `command -v scons` fails.

repo_url := "https://github.com/godotengine/godot.git"
base_commit := "9552dfb6859a1aaba1e570b8e0ef5c599b830f19"

test: clone gen-repro build-baseline bench-baseline apply build-patched bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

gen-repro:
    rm -rf repro_project
    python3 "{{justfile_directory()}}/bench/generate_repro_project.py" repro_project
    cp "{{justfile_directory()}}/bench/bench_pck.gd" repro_project/

build-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v scons >/dev/null 2>&1 || pip3 install scons --break-system-packages
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_baseline"

apply:
    git -C clone apply "{{justfile_directory()}}/patch.diff"

build-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_patched"

bench-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== baseline (before patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_baseline" --headless --path "{{justfile_directory()}}/repro_project" --script bench_pck.gd 2>&1 | grep load_resource_pack_us
    done

bench-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== patched (after patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_patched" --headless --path "{{justfile_directory()}}/repro_project" --script bench_pck.gd 2>&1 | grep load_resource_pack_us
    done

clean:
    rm -rf clone bin_baseline bin_patched xdg_data repro_project
