+// These two EditorFileDialogs cost ~1.45MB each (see ___OPTIMIZATIONS___/021) and are only used
+// by the Autoload tab's browse/create-scene actions, so they are built on first use.
+FileDialog *EditorAutoloadSettings::_get_autoload_file_dialog() {
+	if (!autoload_file_dialog) {
+		autoload_file_dialog = memnew(EditorFileDialog);
+		autoload_file_dialog->set_file_mode(FileDialog::FILE_MODE_OPEN_FILE);
+		add_child(autoload_file_dialog);
+		autoload_file_dialog->connect("file_selected", callable_mp(this, &EditorAutoloadSettings::_autoload_file_selected));
+
+		List<String> afn;
+		ResourceLoader::get_recognized_extensions_for_type("Script", &afn);
+		for (const String &E : afn) {
+			autoload_file_dialog->add_filter("*." + E);
+		}
+	}
+	return autoload_file_dialog;
+}
+
+FileDialog *EditorAutoloadSettings::_get_scene_file_dialog() {
+	if (!scene_file_dialog) {
+		scene_file_dialog = memnew(EditorFileDialog);
+		scene_file_dialog->set_file_mode(FileDialog::FILE_MODE_SAVE_FILE);
+		add_child(scene_file_dialog);
+		scene_file_dialog->connect("file_selected", callable_mp(this, &EditorAutoloadSettings::_scene_file_selected));
+
+		List<String> afn;
+		ResourceLoader::get_recognized_extensions_for_type("PackedScene", &afn);
+		for (const String &E : afn) {
+			scene_file_dialog->add_filter("*." + E);
+		}
+	}
+	return scene_file_dialog;
+}
+
+void EditorAutoloadSettings::_browse_pressed() {
+	_get_autoload_file_dialog()->popup_file_dialog();
+}
