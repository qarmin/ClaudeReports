+// The right-click context menu is only ever built and shown from _popup_menu(), which rebuilds its
+// contents from scratch every time, so there is no state to preserve by creating it up front.
+// LineEdit/TextEdit already defer their own context menus the same way.
+void FileDialog::_ensure_item_menu() {
+	if (item_menu) {
+		return;
+	}
+
+	item_menu = memnew(PopupMenu);
+	item_menu->connect(SceneStringName(id_pressed), callable_mp(this, &FileDialog::_item_menu_id_pressed));
+	add_child(item_menu, false, INTERNAL_MODE_FRONT);
+}
+
