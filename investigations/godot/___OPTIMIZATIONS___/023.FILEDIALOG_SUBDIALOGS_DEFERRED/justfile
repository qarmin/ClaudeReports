# Self-contained reproduction for this candidate.
#
# Adds a `verify` recipe on top of the usual shape: it copies bench/scratch_verification_test.cpp
# into the clone's tests/ and runs it, so the deferral can be checked structurally (5 sub-dialogs
# on a fresh FileDialog before the patch, 0 after) as well as measured.
#
# Everything needed is either in this folder or fetched by `just clone` into ./clone (gitignored),
# except the shared empty-project harness at ___OPTIMIZATIONS___/harness/empty_project (untracked
# in the main repo, shared with candidates 006/007/010/011/012/013/015/016/017 - see SKILL.md's
# "Bench harnesses" section). This candidate's self-containment is relaxed to "given the whole
# ___OPTIMIZATIONS___ folder kept together", not a fully isolated single subfolder.
#
# This is a from-scratch Godot build (SCons) - expect ~15-25 min per build on a modern multi-core
# machine, not a Rust/cargo build. scons isn't preinstalled everywhere - `pip3 install scons
# --break-system-packages` if `command -v scons` fails.

repo_url := "https://github.com/godotengine/godot.git"
base_commit := "9552dfb6859a1aaba1e570b8e0ef5c599b830f19"
harness_dir := "../harness/empty_project"

test: clone build-baseline bench-baseline verify-baseline apply build-patched bench-patched verify-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/_empty_project

build-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v scons >/dev/null 2>&1 || pip3 install scons --break-system-packages
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_baseline"

apply:
    git -C clone apply "{{justfile_directory()}}/patch.diff"

build-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_patched"

# Peak RSS via /proc/<pid>/status's VmHWM (no /usr/bin/time in this project's own dev container -
# adapt to `/usr/bin/time -v` if available on the machine running this).
bench-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    export XDG_DATA_HOME="{{justfile_directory()}}/clone/_xdg_data"
    export XDG_CONFIG_HOME="{{justfile_directory()}}/clone/_xdg_config"
    mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
    cd clone
    echo "=== baseline (before patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_baseline" --headless --editor --path _empty_project --quit-after 1 > /tmp/_rss_run.log 2>&1 &
      PID=$!
      PEAK=""
      while kill -0 $PID 2>/dev/null; do
        V=$(grep VmHWM /proc/$PID/status 2>/dev/null || true)
        if [ -n "$V" ]; then PEAK="$V"; fi
        sleep 0.02
      done
      wait $PID
      echo "peak RSS run $i: $PEAK"
    done

bench-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export XDG_DATA_HOME="{{justfile_directory()}}/clone/_xdg_data"
    export XDG_CONFIG_HOME="{{justfile_directory()}}/clone/_xdg_config"
    mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
    cd clone
    echo "=== patched (after patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_patched" --headless --editor --path _empty_project --quit-after 1 > /tmp/_rss_run.log 2>&1 &
      PID=$!
      PEAK=""
      while kill -0 $PID 2>/dev/null; do
        V=$(grep VmHWM /proc/$PID/status 2>/dev/null || true)
        if [ -n "$V" ]; then PEAK="$V"; fi
        sleep 0.02
      done
      wait $PID
      echo "peak RSS run $i: $PEAK"
    done

clean:
    rm -rf clone bin_baseline bin_patched

# Structural verification: count AcceptDialog-derived children of a fresh FileDialog.
# Expect 5 on the baseline build, 0 on the patched build.
verify-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    cp "{{justfile_directory()}}/bench/scratch_verification_test.cpp" clone/tests/scene/test_file_dialog_scratch.cpp
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    echo "=== baseline control (expect 5 sub-dialogs on a fresh FileDialog) ==="
    ./bin/godot.linuxbsd.editor.x86_64 --headless --test --test-case="*SCRATCH*FileDialog*,*FileDialog*SCRATCH*" 2>&1 | grep SCRATCH_FD || true

verify-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    echo "=== patched (expect 0 initially, then 0 -> 1 visible per flow) ==="
    ./bin/godot.linuxbsd.editor.x86_64 --headless --test --test-case="*SCRATCH*FileDialog*,*FileDialog*SCRATCH*" 2>&1 | grep SCRATCH_FD || true
