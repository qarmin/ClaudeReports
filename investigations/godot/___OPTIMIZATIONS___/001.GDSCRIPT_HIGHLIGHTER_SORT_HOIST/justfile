# Self-contained reproduction for this candidate.
#
# Everything needed is either in this folder or fetched by `just clone` into ./clone (gitignored).
# `bench/scratch_benchmark.patch` adds a temporary doctest TEST_CASE (never part of patch.diff -
# it's harness, not a fix) that times GDScriptSyntaxHighlighter::get_line_syntax_highlighting()
# on a long synthetic line; `patch.diff` is the one-line-moved real engine fix. Baseline = bench
# patch only; patched = bench patch + patch.diff.
#
# This is a from-scratch Godot build (SCons) - expect ~15-25 min per build on a modern multi-core
# machine, not a Rust/cargo build. scons isn't preinstalled everywhere - `pip3 install scons
# --break-system-packages` if `command -v scons` fails.

repo_url := "https://github.com/godotengine/godot.git"
base_commit := "9552dfb6859a1aaba1e570b8e0ef5c599b830f19"

test: clone build-baseline bench-baseline apply build-patched bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git -C clone apply "{{justfile_directory()}}/bench/scratch_benchmark.patch"

build-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v scons >/dev/null 2>&1 || pip3 install scons --break-system-packages
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_baseline"

apply:
    git -C clone apply "{{justfile_directory()}}/patch.diff"

build-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_patched"

# XDG_DATA_HOME points at a throwaway writable dir - the binary needs SOME writable user:// dir
# to run --test at all (see ___OPTIMIZATIONS___/README.md's Environment section for why).
bench-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== baseline (before patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_baseline" --headless --test --test-case="*SCRATCH syntax highlighting*"
    done

bench-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== patched (after patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_patched" --headless --test --test-case="*SCRATCH syntax highlighting*"
    done

clean:
    rm -rf clone bin_baseline bin_patched xdg_data
