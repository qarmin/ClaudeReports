+// SCRATCH BENCHMARK for ___OPTIMIZATIONS___/001 - not a real correctness test, temporary only.
+TEST_CASE("[Modules][GDScript][Benchmark] SCRATCH syntax highlighting on a long line") {
+	CodeEdit *code_edit = memnew(CodeEdit);
+	Ref<GDScriptSyntaxHighlighter> hl;
+	hl.instantiate();
+	hl->set_text_edit(code_edit);
+
+	int n_chars = 8000;
+	String unit = "var x = 1 + 2 - 3 * 4 / 5 % 6 & 7 | 8 ^ 9 . ";
+	String long_line;
+	while (long_line.length() < n_chars) {
+		long_line += unit;
+	}
+	long_line = long_line.substr(0, n_chars);
+	code_edit->set_text(long_line);
+
+	int iterations = 10;
+	uint64_t start = OS::get_singleton()->get_ticks_usec();
+	for (int i = 0; i < iterations; i++) {
+		hl->clear_highlighting_cache();
+		hl->get_line_syntax_highlighting(0);
+	}
+	uint64_t elapsed = OS::get_singleton()->get_ticks_usec() - start;
+	MESSAGE("SCRATCH_BENCH line_len=", n_chars, " total_us=", elapsed, " us_per_iter=", (double)elapsed / iterations);
+
+	memdelete(code_edit);
+}
 #endif // TOOLS_ENABLED
 
