+// The default preview is a sizable widget gallery, but the dock is created at editor startup and
+// usually never opened, so it is only built once the dock is actually shown or otherwise used.
+void ThemeEditor::_ensure_default_preview() {
+	if (default_preview_tab) {
+		return;
+	}
+
+	default_preview_tab = memnew(DefaultThemeEditorPreview);
+	default_preview_tab->set_preview_theme(theme);
+	preview_tabs_content->add_child(default_preview_tab);
+	// Preview tabs are matched with their contents by index, and the default preview is always tab 0.
+	preview_tabs_content->move_child(default_preview_tab, 0);
+	default_preview_tab->connect("control_picked", callable_mp(this, &ThemeEditor::_preview_control_picked));
+	default_preview_tab->set_visible(preview_tabs->get_current_tab() == 0);
+}
