+// Only multiline string cells use this editor, so most Trees never need it - and a TextEdit is by
+// far the most expensive part of the inline cell editor (see ___OPTIMIZATIONS___/044).
+TextEdit *Tree::_ensure_text_editor() {
+	if (!text_editor) {
+		text_editor = memnew(TextEdit);
+		text_editor->set_v_size_flags(SIZE_EXPAND_FILL);
+		text_editor->hide();
+		popup_editor_vb->add_child(text_editor);
+		text_editor->connect(SceneStringName(gui_input), callable_mp(this, &Tree::_text_editor_gui_input));
+	}
+	return text_editor;
+}
