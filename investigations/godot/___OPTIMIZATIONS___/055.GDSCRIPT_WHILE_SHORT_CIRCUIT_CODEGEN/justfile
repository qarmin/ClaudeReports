# Self-contained reproduction for this candidate.
#
# IMPORTANT: this candidate's own patch.diff extends candidate 048's codegen helpers (PR
# godotengine/godot#120660) to `while` loops - it cannot apply or build without 048's patch
# applied FIRST. A copy of 048's patch is kept alongside this one as prerequisite_048_patch.diff
# specifically so this folder is still self-contained (no need to go find candidate 048's own
# folder) - `apply` below applies both in the correct order.
#
# Reaches the patched code via the gdbench harness copied in from
# ___OPTIMIZATIONS___/harness/gdbench/ (untracked in the main repo, built by this workspace - see
# SKILL.md's "Bench harnesses" / shape-3 justfile pattern). Self-contained only given the whole
# ___OPTIMIZATIONS___ folder kept together, not in isolation.
#
# From-scratch SCons build, ~15-25 min. `pip3 install scons --break-system-packages` if missing.

repo_url := "https://github.com/godotengine/godot.git"
base_commit := "9552dfb6859a1aaba1e570b8e0ef5c599b830f19"
harness_dir := "../harness/gdbench"

test: clone build-baseline bench-baseline apply build-patched bench-patched verify-correctness

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/gdbench_harness

# Baseline for THIS candidate is "048 alone" (its own marginal contribution), not pristine HEAD -
# candidate 048's own folder measures against pristine separately.
build-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v scons >/dev/null 2>&1 || pip3 install scons --break-system-packages
    export PATH="$HOME/.local/bin:$PATH"
    git -C clone apply "{{justfile_directory()}}/prerequisite_048_patch.diff"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_baseline"

apply:
    git -C clone apply "{{justfile_directory()}}/patch.diff"

build-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.local/bin:$PATH"
    cd clone
    scons -j"$(nproc)" platform=linuxbsd target=editor tests=yes
    cp bin/godot.linuxbsd.editor.x86_64 "{{justfile_directory()}}/bin_patched"

bench-baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== baseline (048 alone, before this candidate's patch) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_baseline" --headless --path clone/gdbench_harness --script bench.gd -- while_logic_and while_logic_or
    done

bench-patched:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    echo "=== patched (048 + this candidate) ==="
    for i in 1 2 3; do
      "{{justfile_directory()}}/bin_patched" --headless --path clone/gdbench_harness --script bench.gd -- while_logic_and while_logic_or
    done

verify-correctness:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{justfile_directory()}}/xdg_data"
    export XDG_DATA_HOME="{{justfile_directory()}}/xdg_data"
    cp "{{justfile_directory()}}/bench/while_short_circuit_test.gd" clone/gdbench_harness/
    echo "=== patched correctness (baseline/048-alone has no short-circuit while codegen to check) ==="
    "{{justfile_directory()}}/bin_patched" --headless --path clone/gdbench_harness --script while_short_circuit_test.gd

clean:
    rm -rf clone bin_baseline bin_patched xdg_data
