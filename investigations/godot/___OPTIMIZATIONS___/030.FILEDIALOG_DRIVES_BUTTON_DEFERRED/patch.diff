+// The drives MenuButton is only ever shown by _update_drives(), which runs when the dialog is
+// actually used (a directory change or an invalidate), not when it is constructed - and only
+// creates the button when the filesystem reports at least one drive for the current root prefix.
+// A dialog that is never opened therefore never builds it.
+void FileDialog::_ensure_drives() {
+	if (drives) {
+		return;
+	}
+
+	drives = memnew(MenuButton);
+	drives->set_flat(false);
+	drives->get_popup()->connect("index_pressed", callable_mp(this, &FileDialog::_select_drive));
+	drives->set_accessibility_name(ETR("Drive"));
+	drives_container->add_child(drives);
+}
