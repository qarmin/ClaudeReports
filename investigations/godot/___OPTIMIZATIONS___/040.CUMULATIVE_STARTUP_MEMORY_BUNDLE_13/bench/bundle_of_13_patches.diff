+AnimationTreeNodeEditorPlugin *AnimationTreeEditor::_ensure_editor_for(const Ref<AnimationNode> &p_node) {
+	if (p_node.is_null()) {
+		return nullptr;
+	}
+
+	// Reuse an already-constructed editor if one exists (also covers editors registered
+	// externally via add_plugin(), e.g. by a GDExtension).
+	for (int i = 0; i < editors.size(); i++) {
+		if (editors[i]->can_edit(p_node)) {
+			return editors[i];
+		}
+	}
+
+	// None of the built-in sub-editors are constructed yet - lazily build exactly the one that
+	// matches this node's type, instead of all 4 unconditionally at plugin startup.
+	AnimationTreeNodeEditorPlugin *new_editor = nullptr;
+	if (Ref<AnimationNodeBlendTree>(p_node).is_valid()) {
+		new_editor = memnew(AnimationNodeBlendTreeEditor);
+	} else if (Ref<AnimationNodeBlendSpace1D>(p_node).is_valid()) {
+		new_editor = memnew(AnimationNodeBlendSpace1DEditor);
+	} else if (Ref<AnimationNodeBlendSpace2D>(p_node).is_valid()) {
+		new_editor = memnew(AnimationNodeBlendSpace2DEditor);
+	} else if (Ref<AnimationNodeStateMachine>(p_node).is_valid()) {
+		new_editor = memnew(AnimationNodeStateMachineEditor);
+	}
+
+	if (new_editor) {
+		add_plugin(new_editor);
+	}
+	return new_editor;
+}
