+/// Generate a Bézier path that fits the source curve, writing it into `result`.
+///
+/// This is [`fit_to_bezpath`] with a caller-provided output path: the previous contents of
+/// `result` are discarded and replaced with the fitted path, but its allocation is reused. A
+/// caller that fits many curves in a loop (stroke expansion, path simplification) can therefore
+/// hold one `BezPath` and pay for at most one allocation overall instead of one per fit. This
+/// mirrors the convention of [`offset_cubic`].
+///
+/// See [`fit_to_bezpath`] for the semantics of the fit itself and of the `accuracy` parameter;
+/// the output is identical.
+///
+/// [`offset_cubic`]: crate::offset::offset_cubic
+pub fn fit_to_bezpath_into(source: &impl ParamCurveFit, accuracy: f64, result: &mut BezPath) {
+    result.truncate(0);
+    fit_to_bezpath_rec(source, 0.0..1.0, accuracy, result);
+}
