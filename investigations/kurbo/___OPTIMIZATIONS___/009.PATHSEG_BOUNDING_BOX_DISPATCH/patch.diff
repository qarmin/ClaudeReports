+
+    /// Dispatch to the concrete curve's own bounding box.
+    ///
+    /// Without this, the default implementation runs against `PathSeg` itself, which means the
+    /// per-variant match is re-done for every `eval` inside the loop, and any specialized
+    /// `bounding_box` on the concrete curve type is never reached.
+    fn bounding_box(&self) -> Rect {
+        // Fully qualified: `Line`/`QuadBez`/`CubicBez` also have an inherent `Shape::bounding_box`.
+        match *self {
+            PathSeg::Line(line) => ParamCurveExtrema::bounding_box(&line),
+            PathSeg::Quad(quad) => ParamCurveExtrema::bounding_box(&quad),
+            PathSeg::Cubic(cubic) => ParamCurveExtrema::bounding_box(&cubic),
+        }
+    }
 }
 
