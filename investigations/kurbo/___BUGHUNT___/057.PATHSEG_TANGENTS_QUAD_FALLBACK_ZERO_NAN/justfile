# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including attached to a GitHub issue) and
# `just test` still works, with no dependency on the main project checkout this candidate was
# originally found in.
#
# repo_url/base_commit read via `git remote get-url origin` / `git rev-parse HEAD` in the main
# project, at the moment patch.diff was captured - patch.diff is a diff against that exact commit
# and may stop applying cleanly once the main branch moves on.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (non-zero exit, "REPRODUCED" lines, NaN values printed). The leading `-` lets `just test` keep
# going into `apply`/`reproduce-after` even though this step is expected to exit non-zero here.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug (exit 0,
# finite values printed).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
