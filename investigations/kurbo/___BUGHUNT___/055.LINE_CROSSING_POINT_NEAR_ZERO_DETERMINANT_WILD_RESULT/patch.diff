diff --git a/kurbo/src/line.rs b/kurbo/src/line.rs
index 8f8ee2a..03092fb 100644
--- a/kurbo/src/line.rs
+++ b/kurbo/src/line.rs
@@ -70,6 +70,12 @@ impl Line {
             return None;
         }
         let h = ab.cross(self.p0 - other.p0) / pcd;
+        // A near-zero (but nonzero) `pcd` can make `h` overflow to +-infinity even though
+        // neither input line is degenerate; propagating that produces NaN/infinite coordinates
+        // downstream instead of a bounded result. Reject rather than return a wild point.
+        if !h.is_finite() {
+            return None;
+        }
         Some(other.p0 + cd * h)
     }
 
