diff --git a/kurbo/src/cubicbez.rs b/kurbo/src/cubicbez.rs
index 899a351..fa9b160 100644
--- a/kurbo/src/cubicbez.rs
+++ b/kurbo/src/cubicbez.rs
@@ -323,6 +323,11 @@ impl CubicBez {
     ///
     /// Rust port of cu2qu [cubic_farthest_fit_inside](https://github.com/fonttools/fonttools/blob/3b9a73ff8379ab49d3ce35aaaaf04b3a7d9d1655/Lib/fontTools/cu2qu/cu2qu.py#L281)
     fn fit_inside(&self, distance: f64) -> bool {
+        // `distance` is NaN whenever every comparison against it is false, which would otherwise
+        // make both base cases below unreachable and recurse via `subdivide()` without bound.
+        if distance.is_nan() {
+            return false;
+        }
         if self.p2.to_vec2().hypot() <= distance && self.p1.to_vec2().hypot() <= distance {
             return true;
         }
