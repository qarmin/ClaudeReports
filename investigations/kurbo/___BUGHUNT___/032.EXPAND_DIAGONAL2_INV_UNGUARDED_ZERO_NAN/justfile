# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# repo_url/base_commit read at the moment patch.diff was captured (git remote get-url origin /
# git rev-parse HEAD in the main project) - patch.diff is a diff against that exact commit and
# may stop applying cleanly once the main branch moves on.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# `-`: the repro intentionally exits non-zero when it reproduces (see repro/src/main.rs's exit
# code convention), which `just` would otherwise treat as a recipe failure and abort `just test`
# before reaching `apply`/`reproduce-after` - read the printed output rather than the recipe's
# own exit status.
#
# Build+run the standalone repro against the pristine clone - should print NaN-poisoned
# MoveTo/CurveTo elements and exit non-zero ("REPRODUCED").
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should print only finite coordinates and
# exit 0 ("did not reproduce").
reproduce-after:
    -cd repro && cargo run --release

clean:
    rm -rf clone
