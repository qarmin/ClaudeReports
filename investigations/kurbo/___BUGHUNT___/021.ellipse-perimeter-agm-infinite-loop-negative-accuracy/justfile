# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# `Ellipse::perimeter` is the public `Shape::perimeter` impl, so repro/ depends on the cloned
# `kurbo` crate directly via its public API - no internal test scaffolding needed.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug: the
# "candidate accuracy" case (default accuracy=-1.0, or pass one as `just reproduce-before` doesn't
# take args, use `cd repro && cargo run --release -- -1.0` directly for a custom value) hangs
# until the repro's own watchdog kills it after 8s and prints REPRODUCED (exit 1).
# `-` on this line: the repro intentionally exits non-zero when it reproduces (see
# repro/src/main.rs's exit code convention), which `just` would otherwise treat as a recipe
# failure and abort `just test` before reaching `apply`/`reproduce-after` - read the printed
# output rather than the recipe's own exit status.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - both calls should complete normally within
# the watchdog window (exit 0, no REPRODUCED line).
reproduce-after:
    -cd repro && cargo run --release

clean:
    rm -rf clone repro/target
