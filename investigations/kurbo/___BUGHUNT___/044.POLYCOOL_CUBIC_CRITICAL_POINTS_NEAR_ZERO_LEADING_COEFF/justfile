# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate is Not reproducible: `repro/` drives both the public `polycool::Cubic::
# roots_between` directly, and the real end-to-end `kurbo::CubicBez::nearest` entry point, with
# the innermost cubic's leading coefficient (`a = 3.0 * self.coeffs[3]` in `critical_points`)
# spanning down to 1e-320. Neither approach found a missed/spurious/out-of-range root, nor a
# meaningfully-worse-than-brute-force nearest-point result. There is no patch.diff - only
# `reproduce-before`, no `apply`/`reproduce-after`.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone. Override CUBIC_TRIALS/NEAREST_TRIALS
# env vars to change iteration counts (default 500,000 each).
reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
