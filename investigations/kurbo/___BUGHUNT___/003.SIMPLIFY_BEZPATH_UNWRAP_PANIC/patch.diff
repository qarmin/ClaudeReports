diff --git a/kurbo/src/simplify.rs b/kurbo/src/simplify.rs
index 411571e..a34def0 100644
--- a/kurbo/src/simplify.rs
+++ b/kurbo/src/simplify.rs
@@ -312,21 +312,30 @@ pub fn simplify_bezpath(
                 last_pt = Some(p);
             }
             PathEl::LineTo(p) => {
-                let last = last_pt.unwrap();
+                // A drawing command before any MoveTo has no current point to draw
+                // from; ignore it rather than panicking, consistent with how
+                // `BezPath` itself treats an uninitialized subpath.
+                let Some(last) = last_pt else {
+                    continue;
+                };
                 if last == p {
                     continue;
                 }
                 this_seg = Some(PathSeg::Line(Line::new(last, p)));
             }
             PathEl::QuadTo(p1, p2) => {
-                let last = last_pt.unwrap();
+                let Some(last) = last_pt else {
+                    continue;
+                };
                 if last == p1 && last == p2 {
                     continue;
                 }
                 this_seg = Some(PathSeg::Quad(QuadBez::new(last, p1, p2)));
             }
             PathEl::CurveTo(p1, p2, p3) => {
-                let last = last_pt.unwrap();
+                let Some(last) = last_pt else {
+                    continue;
+                };
                 if last == p1 && last == p2 && last == p3 {
                     continue;
                 }
