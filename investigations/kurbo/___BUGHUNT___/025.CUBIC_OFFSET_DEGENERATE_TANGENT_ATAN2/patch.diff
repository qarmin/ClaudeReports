-                    if d02.hypot2() > EPS { d02 } else { c.p3 - c.p0 }
+                    if d02.hypot2() > eps { d02 } else { c.p3 - c.p0 }
                 };
                 let d23 = c.p3 - c.p2;
-                let d1 = if d23.hypot2() > EPS {
+                let d1 = if d23.hypot2() > eps {
                     d23
                 } else {
                     let d13 = c.p3 - c.p1;
-                    if d13.hypot2() > EPS { d13 } else { c.p3 - c.p0 }
+                    if d13.hypot2() > eps { d13 } else { c.p3 - c.p0 }
                 };
