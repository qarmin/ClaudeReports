# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# `S`/`D_rk` (the functions this candidate is about) are fully module-private inside kurbo's
# `mindist` module - not even `pub(crate)` - so no real caller, inside or outside kurbo, can call
# them directly. repro/ instead compiles the literal, unmodified `mindist.rs` from `./clone` via
# `#[path]` (see repro/src/main.rs) and drives it through the one function that *is* reachable
# from outside the module (`pub(crate) min_dist_param`), so it always calls whatever is actually
# in ./clone.
#
# This candidate is Not reproducible (see RESULT.md for the full argument and output.txt for the
# captured run) - there is no patch.diff, only `reproduce-before`, no `apply`/`reproduce-after`.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone in both build profiles - demonstrates
# that a real, unmodified `min_dist_param` call never returns a silently-corrupted finite result
# past the known choose()-overflow threshold (candidate 019): it either panics (debug) or returns
# NaN (release), never a plausible-looking wrong finite number.
# `-` on each line: a nonzero exit means the repro's own check detected the hypothesized bug (see
# printed output) or a debug-build panic occurred (expected there) - read the output, not just
# the recipe's exit status.
reproduce-before:
    -cd repro && cargo run
    -cd repro && cargo run --release

clean:
    rm -rf clone repro/target
