# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# No patch.diff is shipped with this candidate (see RESULT.md for why: the correct-order
# behavior already exists in this exact commit as an opt-in, `StrokeOpts::stable_dash_order`,
# added by upstream PR #550 - flipping the *default* is a deliberate product/perf tradeoff the
# maintainers explicitly chose not to make, not a bounded bug fix). So this justfile only proves
# the bug exists in the default path - there is no `apply`/`reproduce-after` step.

repo_url := "https://github.com/linebender/kurbo.git"
base_commit := "ca273499e3e48bd2de6f02aa8e99a148984e45f3"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should print "REPRODUCED: ..." and
# exit non-zero (see repro/src/main.rs's exit code convention). Also demonstrates, in the same
# run, that `StrokeOpts::default().stable_dash_order(true)` (already present at base_commit)
# already produces correctly-ordered output.
reproduce-before:
    -cd repro && cargo run --release

clean:
    rm -rf clone repro/target
