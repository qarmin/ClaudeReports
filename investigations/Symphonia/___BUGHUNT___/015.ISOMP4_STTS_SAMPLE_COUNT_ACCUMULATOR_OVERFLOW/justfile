# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# NOTE: this bug is a debug-assertions-only panic (`overflow-checks = true`, set in repro/Cargo.toml's
# [profile.dev]) - it silently wraps instead of panicking in a release build, so reproduce-before/
# reproduce-after intentionally run the debug profile (`cargo run`, not `cargo run --release`).

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic with
# "attempt to add with overflow" at symphonia-format-isomp4/src/atoms/stts.rs:68.
reproduce-before:
    -cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic; seek() returns
# Err(SeekError(OutOfRange)) instead.
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf repro/target clone
