# Self-contained reproduction for candidate 022: symphonia-play's metadata printer labels
# StandardTag::PartTitle as "Part" (same label as the distinct StandardTag::Part).

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Builds the real symphonia-play binary from ./clone, crafts a real, well-formed Matroska file
# with a PART-level TITLE tag, and runs `symphonia-play --probe-only` on it for real. Prints
# "RESULT: BUG REPRODUCED" - the printed tag key is "Part", not "Part Title".
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - prints "RESULT: FIXED", the printed tag key
# is "Part Title".
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target repro/part_title.mkv
