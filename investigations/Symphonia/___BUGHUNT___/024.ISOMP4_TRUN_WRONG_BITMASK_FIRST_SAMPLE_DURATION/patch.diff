     }
 
     // Indicates if the duration of the first sample is provided.
+    //
+    // `sample_duration[0]` is only ever populated when `SAMPLE_DURATION_PRESENT` is set on the
+    // trun's own flags (see `read()`), which is mutually exclusive with reaching this check (all
+    // callers only consult this after `is_sample_duration_present()` was false). The explicit
+    // `!self.sample_duration.is_empty()` guard keeps this safe regardless of which bit of
+    // `first_sample_flags` (an ordinary ISO/IEC 14496-12 sample-flags word, unrelated to the
+    // trun's own flags) happens to be set.
     pub fn is_first_sample_duration_present(&self) -> bool {
         match self.first_sample_flags {
-            Some(flags) => flags & TrunAtom::FIRST_SAMPLE_FLAGS_PRESENT != 0,
+            Some(flags) => {
+                flags & TrunAtom::SAMPLE_DURATION_PRESENT != 0 && !self.sample_duration.is_empty()
+            }
             None => false,
         }
     }
