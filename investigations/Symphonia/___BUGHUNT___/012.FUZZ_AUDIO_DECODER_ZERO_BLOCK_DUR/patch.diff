+        // behaviour) when a codec doesn't declare one.
+        let dur = params.max_frames_per_packet.map(Duration::new).unwrap_or(Duration::ZERO);
+        let packet = Packet::new(0, Timestamp::ZERO, dur, packet_data);
         let _ = decoder.decode(&packet);
     }
 }
