 ) {
     if let Ok(mut decoder) = D::try_registry_new(params, &Default::default()) {
-        let packet = Packet::new(0, Timestamp::ZERO, Duration::ZERO, packet_data);
+        // Some decoders (e.g. ADPCM) derive the number of blocks to decode from
