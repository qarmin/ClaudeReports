# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# repo_url/base_commit were read with `git remote get-url origin` / `git rev-parse HEAD` in the
# main project, at the moment patch.diff was captured - patch.diff is a diff against that exact
# commit and may stop applying cleanly once the main branch moves on.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - it exits 0 ("REPRO CONFIRMED") when
# both cases demonstrate the bug (video track redirected via audio's CueTrackPositions, and audio
# track redirected via video's CueTrackPositions), non-zero once the bug is fixed. Against the
# pristine clone it must exit 0.
reproduce-before:
    ulimit -c 0 && cd repro && RUST_LOG=off cargo run --release -- good.mkv poisoned.mkv poisoned2.mkv

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - both cases should now report the correct
# timestamp instead of being redirected into the wrong track's cluster, so the repro's own bug
# check fails and it exits non-zero ("REPRO FAILED TO DEMONSTRATE THE BUG (or bug is fixed)") -
# the leading `-` lets `just test` finish and report that expected outcome instead of aborting.
reproduce-after:
    -ulimit -c 0 && cd repro && RUST_LOG=off cargo run --release -- good.mkv poisoned.mkv poisoned2.mkv

clean:
    rm -rf clone
