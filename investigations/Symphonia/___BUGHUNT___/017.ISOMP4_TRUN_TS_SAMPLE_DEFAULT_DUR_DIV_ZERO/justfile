# Self-contained reproduction for candidate 017 (ISOMP4_TRUN_TS_SAMPLE_DEFAULT_DUR_DIV_ZERO).
#
# This candidate is Not reproducible - there is no patch.diff, so `test` only runs the real
# end-to-end repro against a pristine clone and shows the (expected, honest-error, not
# silently-wrong) result described in RESULT.md.
#
# repro/assets/frag.mp4 is a real fragmented AAC-in-MP4 file produced by ffmpeg
# (`-movflags frag_keyframe+empty_moov+default_base_moof`). repro/assets/evil.mp4 is the same
# file with every tfhd.default_sample_duration field binary-patched to 0 - the exact crafted
# condition the candidate describes. Both are checked into this folder; no regeneration needed.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates that seeking into a
# fragmented MP4 with default_sample_duration=0 fails with an honest SeekError(OutOfRange) on
# every timestamp tried, rather than silently resolving to a wrong sample, per RESULT.md.
reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
