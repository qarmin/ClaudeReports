+// `CHAP` and `CTOC` frames may recursively contain further `CHAP`/`CTOC` frames as sub-frames.
+// Without a depth limit, a maliciously crafted tag can nest these frames deeply enough to
+// overflow the call stack well before the outer ID3v2 tag's declared size is exhausted (each
+// level only costs a small, fixed number of bytes). Cap the recursion depth to something no
+// legitimate chapter hierarchy would ever need.
+const MAX_CHAPTER_NESTING_DEPTH: u32 = 32;
+
+thread_local! {
+    static CHAPTER_NESTING_DEPTH: Cell<u32> = const { Cell::new(0) };
+}
+
+/// RAII guard that increments the chapter/TOC nesting depth counter on construction and
+/// decrements it on drop, so the counter is correctly restored even if reading returns early via
+/// `?`.
+struct ChapterNestingGuard;
+
+impl ChapterNestingGuard {
+    /// Enter a nested `CHAP`/`CTOC` frame, returning an error instead of a guard if the maximum
+    /// nesting depth has been exceeded.
+    fn enter() -> Result<Self> {
+        let depth = CHAPTER_NESTING_DEPTH.with(|d| {
+            let next = d.get() + 1;
+            d.set(next);
+            next
+        });
+
+        if depth > MAX_CHAPTER_NESTING_DEPTH {
+            return decode_error("id3v2: chapter/toc nesting is too deep");
+        }
+
+        Ok(ChapterNestingGuard)
+    }
+}
+
+impl Drop for ChapterNestingGuard {
+    fn drop(&mut self) {
+        CHAPTER_NESTING_DEPTH.with(|d| d.set(d.get() - 1));
+    }
+}
