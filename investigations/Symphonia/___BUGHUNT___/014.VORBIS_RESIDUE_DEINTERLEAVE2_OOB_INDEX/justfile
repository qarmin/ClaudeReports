    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Should panic at residue.rs:189 with "mid > len" (non-zero exit is the expected, demonstrated
# bug -- don't let it stop `just test` before reaching apply/reproduce-after).
reproduce-before:
    -cd repro && cargo run 2>&1 | tail -20

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now print "BUG NOT REPRODUCED: decode completed without panicking".
reproduce-after:
    cd repro && cargo run 2>&1 | tail -20

clean:
    rm -rf clone
