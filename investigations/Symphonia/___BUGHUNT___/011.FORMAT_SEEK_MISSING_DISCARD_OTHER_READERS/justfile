# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate is Not reproducible: no peek-then-skip-without-discard bug (the class confirmed
# in candidate 005 for symphonia-format-ogg) was found in symphonia-format-mkv's or
# symphonia-format-isomp4's own seek() implementations. There is no patch.diff, so there is only a
# `reproduce` step (no before/after).

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone. It seeks every track of a real
# two-track WebM (libvorbis) and a real two-track MP4 (AAC) across a spread of timestamps, on
# both a seekable (File) and non-seekable (ReadOnlySource) source, each call guarded by a 10s
# watchdog. Expected result: PASS (no timeout observed anywhere), matching this session's finding
# that the class of bug confirmed for symphonia-format-ogg in candidate 005 was not found here.
reproduce:
    cd repro && cargo run --release

clean:
    rm -rf clone
