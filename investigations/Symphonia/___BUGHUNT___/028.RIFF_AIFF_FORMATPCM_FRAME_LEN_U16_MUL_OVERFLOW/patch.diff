+#[test]
+fn test_high_channel_count_packet_info() {
+    // AIFF accepts any 16-bit channel count, so the frame length (channels * bytes per sample)
+    // does not fit in a u16 for large counts.
+    for (num_channels, sample_size) in [(16384, 32), (21846, 24), (u16::MAX, 32)] {
+        let format_data = CommonChunk::read_pcm_fmt(sample_size, num_channels).unwrap();
+
+        let comm = CommonChunk {
+            num_channels,
+            num_sample_frames: 4,
+            sample_size,
+            sample_rate: NonZero::new(44100).unwrap(),
+            format_data,
+        };
+
+        let packet_info = comm.packet_info().unwrap();
+
+        let bytes_per_sample = u64::from(sample_size.div_ceil(8));
+        assert_eq!(packet_info.block_size.get(), u64::from(num_channels) * bytes_per_sample);
+    }
+}
