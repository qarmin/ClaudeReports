# No patch.diff for this candidate (Not reproducible) - only the verification harness matters.
test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the verification harness against the pristine clone - should complete every case
# without a panic (see RESULT.md for why).
reproduce-before:
    cd repro && cargo run --release

clean:
