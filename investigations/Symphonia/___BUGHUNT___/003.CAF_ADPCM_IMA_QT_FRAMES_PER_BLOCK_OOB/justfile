# Self-contained, end-to-end reproduction for candidate 003: CAF -> ADPCM IMA QT OOB panic.
#
# Note: patch.diff also contains the fix for candidate 002 (MS ADPCM has the same class of bug,
# in a sibling file) since both were fixed together in one session. Applying it here also fixes
# 002's bug, but this candidate's repro/ only exercises the IMA QT / CAF path.

repo_url := "https://github.com/pdeljanov/Symphonia.git"
base_commit := "ee35874b571a35a9a6e15d3bc9a3aaf8f11fbeee"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Should panic: "index out of bounds: the len is 2 but the index is 2".
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now print a decode error, no panic.
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
