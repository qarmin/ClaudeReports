+
+#[cfg(test)]
+mod bughunt_diff_tests {
+    use super::*;
+
+    // Differential: gray-alpha premultiply/unpremultiply must equal running the RGBA path
+    // on a pixel with R=G=B=luma and the same alpha.
+    #[test]
+    fn gray_alpha_matches_rgba_reference_premultiply() {
+        for luma in 0..=255u16 {
+            for alpha in 0..=255u16 {
+                let luma = luma as u8;
+                let alpha = alpha as u8;
+                let mut la_dst = [0u8; 2];
+                premultiply_alpha_gray_alpha_row_impl(&mut la_dst, &[luma, alpha]);
+
+                let mut rgba_dst = [0u8; 4];
+                premultiply_alpha_rgba_row_impl(&mut rgba_dst, &[luma, luma, luma, alpha]);
+
+                assert_eq!(
+                    la_dst[0], rgba_dst[0],
+                    "premultiply mismatch luma={luma} alpha={alpha}: la={la_dst:?} rgba={rgba_dst:?}"
+                );
+                assert_eq!(
+                    la_dst[1], rgba_dst[3],
+                    "premultiply alpha-channel mismatch luma={luma} alpha={alpha}: la={la_dst:?} rgba={rgba_dst:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn gray_alpha_matches_rgba_reference_unpremultiply() {
+        for pixel in 0..=255u16 {
+            for alpha in 0..=255u16 {
+                let pixel = pixel as u8;
+                let alpha = alpha as u8;
+                let mut la = [pixel, alpha];
+                unpremultiply_alpha_gray_alpha_row_impl(&mut la);
+
+                let mut rgba = [pixel, pixel, pixel, alpha];
+                unpremultiply_alpha_rgba_row_impl(&mut rgba);
+
+                assert_eq!(
+                    la[0], rgba[0],
+                    "unpremultiply mismatch pixel={pixel} alpha={alpha}: la={la:?} rgba={rgba:?}"
+                );
+            }
+        }
+    }
+}
