+/// `_mm256_dpwssd_avx_epi32` (VEX, requires only the narrow `avxvnni` extension found on Alder
+/// Lake+/Sierra Forest) and `_mm256_dpwssd_epi32` (EVEX, requires `avx512vnni`+`avx512vl`, found
+/// on Skylake-X/Cascade Lake/Ice Lake Xeon/Zen4) compute identical results - callers pick the
+/// branch matching the CPU features they've already runtime-detected.
+#[inline(always)]
+unsafe fn dpwssd_dispatch256<const USE_AVX512VNNI: bool>(
+    src: __m256i,
+    a: __m256i,
+    b: __m256i,
+) -> __m256i {
+    unsafe {
+        if USE_AVX512VNNI {
+            _mm256_dpwssd_epi32(src, a, b)
+        } else {
+            _mm256_dpwssd_avx_epi32(src, a, b)
+        }
+    }
+}
+
+#[inline(always)]
+unsafe fn dpwssd_dispatch128<const USE_AVX512VNNI: bool>(
+    src: __m128i,
+    a: __m128i,
+    b: __m128i,
+) -> __m128i {
+    unsafe {
+        if USE_AVX512VNNI {
+            _mm_dpwssd_epi32(src, a, b)
+        } else {
+            _mm_dpwssd_avx_epi32(src, a, b)
+        }
+    }
+}
