# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
# That means this whole folder can be copied anywhere (including posted standalone, e.g.
# attached to a GitHub issue/PR) and `just test` still works, with no dependency on the
# main project checkout this candidate was originally found in.
#
# Note: patch.diff bundles the SAME thing as candidate 005's patch.diff against pristine
# master (candidate 002's not-yet-merged SSE4.1 kernel as a prerequisite, plus candidate 005's
# own AVX2 kernel + factory wiring) - byte-identical, unchanged. This candidate only adds a new
# criterion bench case (bench_addition.diff) to re-measure that same, unmodified patch under a
# genuinely wide (kernel_size=96) Lanczos3 filter instead of the existing narrow-filter case.

repo_url := "https://github.com/awxkee/pic-scale.git"
base_commit := "7eec7cfde2aed58a1606a48b5c7bd084536f9624"

# Full cycle: clone at the pinned commit, apply the patch + the bench addition, build, run
# the bench, check bit-exactness.
test: clone apply bench correctness

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    # Adds the "Pic scale CbCr10 wide filter: Lanczos 3" criterion case (bit_depth=10,
    # PreferSpeed, 1/16 downscale -> kernel_size=96 taps, so the AVX2 16-tap loop fires ~6
    # times per output pixel instead of ~0-1 times like the existing "Pic scale CbCr10:
    # Lanczos 3" case at 1/4 downscale, kernel_size=24). This is the gap flagged in
    # ___OPTIMIZATIONS___/IDEAS.md against app/benches/resize_cbcr/main.rs. Measurement-only,
    # not committed to the main tree - reverted with the rest of the working tree at the end
    # of every session (see ../README.md).
    cd clone && git apply "{{justfile_directory()}}/bench_addition.diff"
    # app/Cargo.toml's default pic-scale feature list has no "avx"/"sse", so the bench never
    # reaches src/avx2/ at all otherwise.
    cd clone && sed -i 's/"colorspaces", "rdm", "nightly_i8mm", "nightly_f16"/"colorspaces", "rdm", "nightly_i8mm", "nightly_f16", "avx", "sse"/' app/Cargo.toml

# The compiled criterion binary needs `--bench` as its first argument to actually measure and
# print `time:   [...]` (otherwise it just lists available cases) - run from `clone/app` as the
# working directory, since the bench opens `../assets/...` relative to cwd.
bench:
    cd clone && cargo bench -p app --bench resize_cbcr -- --bench "Pic scale CbCr10 wide filter: Lanczos 3"

# Bit-exact correctness check: candidate 005's synthetic-case sweep (u16 CbCr sources, several
# bit depths/sizes/ratios/strategies, including extreme-downscale cases specifically chosen to
# push bounds_size past 16 taps/output pixel) hashes the resampled output. Points at ./clone
# (built with this candidate's apply recipe already run, avx+sse both active) and should print
# the same FINAL_HASH candidate 005 and this candidate's own RESULT.md recorded
# (12406396843747482019).
correctness:
    cd bit_exact_check && cargo run --release

clean:
    rm -rf clone bit_exact_check/target
