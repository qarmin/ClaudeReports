+// AVX2 horizontal convolution for 2-channel (CbCr) `u16` images with `bit_depth <= 12`.
+//
+// Widens `src/sse/cbcr_u16_lb.rs`'s "reorder taps into per-channel groups via `shuffle_epi8`,
+// then `madd_epi16`" trick to 256-bit. Unlike `avx2/cbcr8.rs`'s `u8` widening (which needs a
+// zero-extend to reach 16-bit lanes and so can pack 16 taps into a single 256-bit register), a
+// `u16` tap here already occupies a full 16-bit lane, so one `__m256i` load only covers the same
+// 8 taps the SSE kernel's `conv_cb_cr16_8` split across two separate `__m128i` loads (taps 0-3 in
+// the low 128 bits, taps 4-7 in the high 128 bits - contiguous in memory, so a single 256-bit load
+// gets both halves at once). The win here is instruction count, not taps-per-load: one
+// `_mm256_shuffle_epi8`/`_mm256_madd_epi16` pair replaces the two separate 128-bit shuffle+madd
+// pairs the SSE kernel needed for the same 8 taps, since `_mm256_shuffle_epi8` shuffles each lane
+// independently. `idx_deinterleave256` is a plain broadcast of the SSE control mask (both lanes
+// need the identical per-group reorder); the weight mask is *not* a plain broadcast - its low lane
+// carries the SSE kernel's `weights_lo` pattern and its high lane carries `weights_hi`, so a single
+// `_mm256_shuffle_epi8` against a broadcast-replicated raw-weight register produces both `w0` and
+// `w1` (as the two lanes of one `__m256i`) in one instruction. The 16-tap batch below repeats this
+// twice (taps 0-7, then 8-15) and defers folding lane0+lane1 together until the whole tap loop is
+// done, rather than folding after every 8 taps, to avoid a cross-lane op on the hot path.
+
+#[cfg(target_arch = "x86")]
+use std::arch::x86::*;
+#[cfg(target_arch = "x86_64")]
+use std::arch::x86_64::*;
+
+use crate::filter_weights::FilterWeights;
+use crate::sse::shuffle;
+use crate::support::{PRECISION, ROUNDING_CONST};
+
+#[inline]
+#[target_feature(enable = "avx2")]
+fn conv_cb_cr16_1(start_x: usize, src: &[u16], weight0: __m128i, store_0: __m128i) -> __m128i {
+    unsafe {
+        const CN: usize = 2;
+        let src_ptr = src.get_unchecked((start_x * CN)..).as_ptr();
+        let vl = _mm_loadu_si32(src_ptr.cast());
+        let widened = _mm_unpacklo_epi16(vl, _mm_setzero_si128());
+        _mm_add_epi32(store_0, _mm_madd_epi16(widened, weight0))
+    }
+}
+
+#[inline]
+#[target_feature(enable = "avx2")]
+fn conv_cb_cr16_2(
+    start_x: usize,
+    src: &[u16],
+    weight0: __m128i,
+    store_0: __m128i,
+    sh: __m128i,
+) -> __m128i {
+    unsafe {
+        const CN: usize = 2;
+        let src_ptr = src.get_unchecked((start_x * CN)..).as_ptr();
+        let vl = _mm_loadu_si64(src_ptr.cast());
+        let lo = _mm_shuffle_epi8(vl, sh);
+        _mm_add_epi32(store_0, _mm_madd_epi16(lo, weight0))
+    }
+}
+
+#[inline]
+#[target_feature(enable = "avx2")]
+fn conv_cb_cr16_4(
+    start_x: usize,
+    src: &[u16],
+    weight0: __m128i,
+    store_0: __m128i,
+    sh: __m128i,
+) -> __m128i {
+    unsafe {
+        const CN: usize = 2;
+        let src_ptr = src.get_unchecked((start_x * CN)..).as_ptr();
+        let vl = _mm_loadu_si128(src_ptr.cast());
+        let lo = _mm_shuffle_epi8(vl, sh);
+        _mm_add_epi32(store_0, _mm_madd_epi16(lo, weight0))
+    }
+}
+
+#[inline]
+#[target_feature(enable = "avx2")]
+fn conv_cb_cr16_8(
+    store_0: __m128i,
+    start_x: usize,
+    src: &[u16],
+    w0: __m128i,
+    w1: __m128i,
+    sh: __m128i,
+) -> __m128i {
+    unsafe {
+        const CN: usize = 2;
+        let src_ptr = src.get_unchecked((start_x * CN)..);
+        let values0 = _mm_loadu_si128(src_ptr.as_ptr().cast());
+        let values1 = _mm_loadu_si128(src_ptr.get_unchecked(8..).as_ptr().cast());
+        let lo = _mm_shuffle_epi8(values0, sh);
+        let hi = _mm_shuffle_epi8(values1, sh);
+        let p = _mm_add_epi32(store_0, _mm_madd_epi16(lo, w0));
+        _mm_add_epi32(p, _mm_madd_epi16(hi, w1))
+    }
+}
+
+#[inline]
+#[target_feature(enable = "avx2")]
+fn conv_cb_cr16_16(
+    store_256: __m256i,
+    start_x: usize,
+    src: &[u16],
+    raw_w_a: __m128i,
+    raw_w_b: __m128i,
+    idx256: __m256i,
+    w_mask256: __m256i,
+) -> __m256i {
+    unsafe {
+        const CN: usize = 2;
+        let src_ptr = src.get_unchecked((start_x * CN)..);
+        let values_a = _mm256_loadu_si256(src_ptr.as_ptr().cast());
+        let values_b = _mm256_loadu_si256(src_ptr.get_unchecked(16..).as_ptr().cast());
+        let r_a = _mm256_shuffle_epi8(values_a, idx256);
+        let r_b = _mm256_shuffle_epi8(values_b, idx256);
+        let w_a = _mm256_shuffle_epi8(_mm256_broadcastsi128_si256(raw_w_a), w_mask256);
+        let w_b = _mm256_shuffle_epi8(_mm256_broadcastsi128_si256(raw_w_b), w_mask256);
+        let p = _mm256_add_epi32(store_256, _mm256_madd_epi16(r_a, w_a));
+        _mm256_add_epi32(p, _mm256_madd_epi16(r_b, w_b))
+    }
+}
+
+#[inline(always)]
+fn fold_store_256(store256: __m256i) -> __m128i {
+    unsafe {
+        _mm_add_epi32(
+            _mm256_castsi256_si128(store256),
+            _mm256_extracti128_si256::<1>(store256),
+        )
+    }
+}
+
+#[inline(always)]
+fn reduce_store_cbcr16<const PREC: i32>(store: __m128i, v_max_colors: __m128i) -> __m128i {
+    unsafe {
+        let shuf = _mm_shuffle_epi32::<{ shuffle(1, 0, 3, 2) }>(store);
+        let summed = _mm_add_epi32(store, shuf);
+        let shifted = _mm_srai_epi32::<PREC>(summed);
+        _mm_min_epi16(_mm_packus_epi32(shifted, shifted), v_max_colors)
+    }
+}
+
+pub(crate) fn convolve_horizontal_cbcr_avx_rows_4_lb_u16(
+    src: &[u16],
+    src_stride: usize,
+    dst: &mut [u16],
+    dst_stride: usize,
+    filter_weights: &FilterWeights<i16>,
+    bit_depth: u32,
+) {
+    unsafe {
+        convolve_horizontal_cbcr_avx_rows_4_lb_u16_impl(
+            src,
+            src_stride,
+            dst,
+            dst_stride,
+            filter_weights,
+            bit_depth,
+        );
+    }
+}
+
+#[target_feature(enable = "avx2")]
+fn convolve_horizontal_cbcr_avx_rows_4_lb_u16_impl(
+    src: &[u16],
+    src_stride: usize,
+    dst: &mut [u16],
+    dst_stride: usize,
+    filter_weights: &FilterWeights<i16>,
+    bit_depth: u32,
+) {
+    unsafe {
+        assert!((1..=16).contains(&bit_depth));
+        const CN: usize = 2;
+
+        let idx_deinterleave =
+            _mm_setr_epi8(0, 1, 4, 5, 2, 3, 6, 7, 8, 9, 12, 13, 10, 11, 14, 15);
+        let idx_deinterleave256 = _mm256_broadcastsi128_si256(idx_deinterleave);
+
+        let weights_lo = _mm_setr_epi8(0, 1, 2, 3, 0, 1, 2, 3, 4, 5, 6, 7, 4, 5, 6, 7);
+        let weights_hi = _mm_setr_epi8(8, 9, 10, 11, 8, 9, 10, 11, 12, 13, 14, 15, 12, 13, 14, 15);
+        let w_mask256 = _mm256_setr_epi8(
+            0, 1, 2, 3, 0, 1, 2, 3, 4, 5, 6, 7, 4, 5, 6, 7, 8, 9, 10, 11, 8, 9, 10, 11, 12, 13, 14,
+            15, 12, 13, 14, 15,
+        );
+
+        let vld = _mm_setr_epi32(ROUNDING_CONST, ROUNDING_CONST, 0, 0);
+        let vld256 = _mm256_setr_epi32(ROUNDING_CONST, ROUNDING_CONST, 0, 0, 0, 0, 0, 0);
+        let v_max_colors = _mm_set1_epi16((1i16 << bit_depth) - 1);
+
+        let (row0_ref, rest) = dst.split_at_mut(dst_stride);
+        let (row1_ref, rest) = rest.split_at_mut(dst_stride);
+        let (row2_ref, row3_ref) = rest.split_at_mut(dst_stride);
+
+        let iter_row0 = row0_ref.as_chunks_mut::<CN>().0;
+        let iter_row1 = row1_ref.as_chunks_mut::<CN>().0;
+        let iter_row2 = row2_ref.as_chunks_mut::<CN>().0;
+        let iter_row3 = row3_ref.as_chunks_mut::<CN>().0;
+
+        for (((((chunk0, chunk1), chunk2), chunk3), &bounds), weights) in iter_row0
+            .iter_mut()
+            .zip(iter_row1.iter_mut())
+            .zip(iter_row2.iter_mut())
+            .zip(iter_row3.iter_mut())
+            .zip(filter_weights.bounds.iter())
+            .zip(
+                filter_weights
+                    .weights
+                    .chunks_exact(filter_weights.aligned_size),
+            )
+        {
+            let mut jx = 0usize;
+
+            let bounds_size = bounds.size;
+
+            let src0 = src;
+            let src1 = src0.get_unchecked(src_stride..);
+            let src2 = src1.get_unchecked(src_stride..);
+            let src3 = src2.get_unchecked(src_stride..);
+
+            let mut store0_256 = vld256;
+            let mut store1_256 = vld256;
+            let mut store2_256 = vld256;
+            let mut store3_256 = vld256;
+
+            while jx + 16 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let raw_w_full = _mm256_loadu_si256(w_ptr.cast());
+                let raw_w_a = _mm256_castsi256_si128(raw_w_full);
+                let raw_w_b = _mm256_extracti128_si256::<1>(raw_w_full);
+                let bounds_start = bounds.start + jx;
+
+                store0_256 = conv_cb_cr16_16(
+                    store0_256,
+                    bounds_start,
+                    src0,
+                    raw_w_a,
+                    raw_w_b,
+                    idx_deinterleave256,
+                    w_mask256,
+                );
+                store1_256 = conv_cb_cr16_16(
+                    store1_256,
+                    bounds_start,
+                    src1,
+                    raw_w_a,
+                    raw_w_b,
+                    idx_deinterleave256,
+                    w_mask256,
+                );
+                store2_256 = conv_cb_cr16_16(
+                    store2_256,
+                    bounds_start,
+                    src2,
+                    raw_w_a,
+                    raw_w_b,
+                    idx_deinterleave256,
+                    w_mask256,
+                );
+                store3_256 = conv_cb_cr16_16(
+                    store3_256,
+                    bounds_start,
+                    src3,
+                    raw_w_a,
+                    raw_w_b,
+                    idx_deinterleave256,
+                    w_mask256,
+                );
+                jx += 16;
+            }
+
+            let mut store_0 = fold_store_256(store0_256);
+            let mut store_1 = fold_store_256(store1_256);
+            let mut store_2 = fold_store_256(store2_256);
+            let mut store_3 = fold_store_256(store3_256);
+
+            if jx == 0 {
+                store_0 = vld;
+                store_1 = vld;
+                store_2 = vld;
+                store_3 = vld;
+            }
+
+            while jx + 8 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let raw_w = _mm_loadu_si128(w_ptr.cast());
+                let w0 = _mm_shuffle_epi8(raw_w, weights_lo);
+                let w1 = _mm_shuffle_epi8(raw_w, weights_hi);
+                let bounds_start = bounds.start + jx;
+
+                store_0 = conv_cb_cr16_8(store_0, bounds_start, src0, w0, w1, idx_deinterleave);
+                store_1 = conv_cb_cr16_8(store_1, bounds_start, src1, w0, w1, idx_deinterleave);
+                store_2 = conv_cb_cr16_8(store_2, bounds_start, src2, w0, w1, idx_deinterleave);
+                store_3 = conv_cb_cr16_8(store_3, bounds_start, src3, w0, w1, idx_deinterleave);
+                jx += 8;
+            }
+
+            while jx + 4 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let w0 = _mm_shuffle_epi8(_mm_loadu_si64(w_ptr.cast()), weights_lo);
+                let bounds_start = bounds.start + jx;
+
+                store_0 = conv_cb_cr16_4(bounds_start, src0, w0, store_0, idx_deinterleave);
+                store_1 = conv_cb_cr16_4(bounds_start, src1, w0, store_1, idx_deinterleave);
+                store_2 = conv_cb_cr16_4(bounds_start, src2, w0, store_2, idx_deinterleave);
+                store_3 = conv_cb_cr16_4(bounds_start, src3, w0, store_3, idx_deinterleave);
+                jx += 4;
+            }
+
+            while jx + 2 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let w0 = _mm_shuffle_epi8(_mm_loadu_si32(w_ptr.cast()), weights_lo);
+                let bounds_start = bounds.start + jx;
+
+                store_0 = conv_cb_cr16_2(bounds_start, src0, w0, store_0, idx_deinterleave);
+                store_1 = conv_cb_cr16_2(bounds_start, src1, w0, store_1, idx_deinterleave);
+                store_2 = conv_cb_cr16_2(bounds_start, src2, w0, store_2, idx_deinterleave);
+                store_3 = conv_cb_cr16_2(bounds_start, src3, w0, store_3, idx_deinterleave);
+                jx += 2;
+            }
+
+            while jx < bounds_size {
+                let w_ptr = *weights.get_unchecked(jx);
+                let w0 = _mm_set1_epi16(w_ptr);
+                let bounds_start = bounds.start + jx;
+
+                store_0 = conv_cb_cr16_1(bounds_start, src0, w0, store_0);
+                store_1 = conv_cb_cr16_1(bounds_start, src1, w0, store_1);
+                store_2 = conv_cb_cr16_1(bounds_start, src2, w0, store_2);
+                store_3 = conv_cb_cr16_1(bounds_start, src3, w0, store_3);
+                jx += 1;
+            }
+
+            _mm_storeu_si32(
+                chunk0.as_mut_ptr().cast(),
+                reduce_store_cbcr16::<PRECISION>(store_0, v_max_colors),
+            );
+            _mm_storeu_si32(
+                chunk1.as_mut_ptr().cast(),
+                reduce_store_cbcr16::<PRECISION>(store_1, v_max_colors),
+            );
+            _mm_storeu_si32(
+                chunk2.as_mut_ptr().cast(),
+                reduce_store_cbcr16::<PRECISION>(store_2, v_max_colors),
+            );
+            _mm_storeu_si32(
+                chunk3.as_mut_ptr().cast(),
+                reduce_store_cbcr16::<PRECISION>(store_3, v_max_colors),
+            );
+        }
+    }
+}
+
+pub(crate) fn convolve_horizontal_cbcr_avx_u16_lb_row(
+    src: &[u16],
+    dst: &mut [u16],
+    filter_weights: &FilterWeights<i16>,
+    bit_depth: u32,
+) {
+    unsafe {
+        convolve_horizontal_cbcr_avx_u16_lb_row_impl(src, dst, filter_weights, bit_depth);
+    }
+}
+
+#[target_feature(enable = "avx2")]
+fn convolve_horizontal_cbcr_avx_u16_lb_row_impl(
+    src: &[u16],
+    dst: &mut [u16],
+    filter_weights: &FilterWeights<i16>,
+    bit_depth: u32,
+) {
+    unsafe {
+        const CN: usize = 2;
+
+        let idx_deinterleave =
+            _mm_setr_epi8(0, 1, 4, 5, 2, 3, 6, 7, 8, 9, 12, 13, 10, 11, 14, 15);
+        let idx_deinterleave256 = _mm256_broadcastsi128_si256(idx_deinterleave);
+
+        let weights_lo = _mm_setr_epi8(0, 1, 2, 3, 0, 1, 2, 3, 4, 5, 6, 7, 4, 5, 6, 7);
+        let weights_hi = _mm_setr_epi8(8, 9, 10, 11, 8, 9, 10, 11, 12, 13, 14, 15, 12, 13, 14, 15);
+        let w_mask256 = _mm256_setr_epi8(
+            0, 1, 2, 3, 0, 1, 2, 3, 4, 5, 6, 7, 4, 5, 6, 7, 8, 9, 10, 11, 8, 9, 10, 11, 12, 13, 14,
+            15, 12, 13, 14, 15,
+        );
+
+        let vld = _mm_setr_epi32(ROUNDING_CONST, ROUNDING_CONST, 0, 0);
+        let vld256 = _mm256_setr_epi32(ROUNDING_CONST, ROUNDING_CONST, 0, 0, 0, 0, 0, 0);
+        let v_max_colors = _mm_set1_epi16((1i16 << bit_depth) - 1);
+
+        for ((dst, &bounds), weights) in dst
+            .as_chunks_mut::<CN>()
+            .0
+            .iter_mut()
+            .zip(filter_weights.bounds.iter())
+            .zip(
+                filter_weights
+                    .weights
+                    .chunks_exact(filter_weights.aligned_size),
+            )
+        {
+            let bounds_size = bounds.size;
+            let mut jx = 0usize;
+            let mut store256 = vld256;
+
+            while jx + 16 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let raw_w_full = _mm256_loadu_si256(w_ptr.cast());
+                let raw_w_a = _mm256_castsi256_si128(raw_w_full);
+                let raw_w_b = _mm256_extracti128_si256::<1>(raw_w_full);
+                store256 = conv_cb_cr16_16(
+                    store256,
+                    bounds.start + jx,
+                    src,
+                    raw_w_a,
+                    raw_w_b,
+                    idx_deinterleave256,
+                    w_mask256,
+                );
+                jx += 16;
+            }
+
+            let mut store = if jx == 0 { vld } else { fold_store_256(store256) };
+
+            while jx + 8 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let raw_w = _mm_loadu_si128(w_ptr.cast());
+                let w0 = _mm_shuffle_epi8(raw_w, weights_lo);
+                let w1 = _mm_shuffle_epi8(raw_w, weights_hi);
+                store = conv_cb_cr16_8(store, bounds.start + jx, src, w0, w1, idx_deinterleave);
+                jx += 8;
+            }
+
+            while jx + 4 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let w0 = _mm_shuffle_epi8(_mm_loadu_si64(w_ptr.cast()), weights_lo);
+                store = conv_cb_cr16_4(bounds.start + jx, src, w0, store, idx_deinterleave);
+                jx += 4;
+            }
+
+            while jx + 2 <= bounds_size {
+                let w_ptr = weights.get_unchecked(jx..).as_ptr();
+                let w0 = _mm_shuffle_epi8(_mm_loadu_si32(w_ptr.cast()), weights_lo);
+                store = conv_cb_cr16_2(bounds.start + jx, src, w0, store, idx_deinterleave);
+                jx += 2;
+            }
+
+            while jx < bounds_size {
+                let w_ptr = *weights.get_unchecked(jx);
+                let w0 = _mm_set1_epi16(w_ptr);
+                store = conv_cb_cr16_1(bounds.start + jx, src, w0, store);
+                jx += 1;
+            }
+
+            _mm_storeu_si32(
+                dst.as_mut_ptr().cast(),
+                reduce_store_cbcr16::<PRECISION>(store, v_max_colors),
+            );
+        }
+    }
+}
