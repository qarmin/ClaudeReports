diff --git a/jxl/src/bh_fuzz.rs b/jxl/src/bh_fuzz.rs
new file mode 100644
index 0000000..1701360
--- /dev/null
+++ b/jxl/src/bh_fuzz.rs
@@ -0,0 +1,70 @@
+#![allow(dead_code, unused_imports)]
+use crate::bit_reader::BitReader;
+use crate::features::patches::PatchesDictionary;
+use crate::features::spline::Splines;
+use crate::frame::ReferenceFrame;
+use crate::headers::bit_depth::BitDepth;
+use crate::headers::extra_channels::{ExtraChannel, ExtraChannelInfo};
+use crate::image::Image;
+
+pub fn patches(data: &[u8]) {
+    if data.len() < 16 {
+        return;
+    }
+    let (cfg, rest) = data.split_at(16);
+    let xsize = 1 + (u16::from_le_bytes([cfg[0], cfg[1]]) as usize % 300);
+    let ysize = 1 + (u16::from_le_bytes([cfg[2], cfg[3]]) as usize % 300);
+    let nec = (cfg[4] % 3) as usize;
+    let mut refs: Vec<Option<ReferenceFrame>> = vec![];
+    for i in 0..4 {
+        let w = 1 + (cfg[5 + i] as usize * (xsize + 20)) / 255;
+        let h = 1 + (cfg[9 + i] as usize * (ysize + 20)) / 255;
+        let shrink_ec = false;
+        if cfg[14] & (1 << i) != 0 {
+            refs.push(None);
+            continue;
+        }
+        let mut frame = vec![];
+        for c in 0..3 + nec {
+            let (cw, ch) = if c >= 3 && shrink_ec { (w.div_ceil(2), h.div_ceil(2)) } else { (w, h) };
+            match Image::<f32>::new((cw, ch)) {
+                Ok(img) => frame.push(img),
+                Err(_) => return,
+            }
+        }
+        refs.push(Some(ReferenceFrame { frame, saved_before_color_transform: cfg[15] & (1 << i) == 0 }));
+    }
+    let mut br = BitReader::new(rest);
+    let Ok(dict) = PatchesDictionary::read_internal(&mut br, xsize, ysize, nec, &refs, false) else { return };
+    let eci: Vec<ExtraChannelInfo> = (0..nec)
+        .map(|i| ExtraChannelInfo::new(false, ExtraChannel::Alpha, BitDepth::f32(), 0, String::new(), i % 2 == 0, None, None))
+        .collect();
+    let chunk = 1 + (cfg[4] as usize / 3) % xsize;
+    let mut pr = vec![];
+    let mut scratch = vec![];
+    for y in 0..ysize {
+        let mut x0 = 0;
+        while x0 < xsize {
+            let n = chunk.min(xsize - x0);
+            let mut chans: Vec<Vec<f32>> = (0..3 + nec).map(|_| vec![0.5f32; n + 16]).collect();
+            let mut rows: Vec<&mut [f32]> = chans.iter_mut().map(|c| &mut c[..]).collect();
+            dict.add_one_row(&mut rows, (x0, y), n, &eci, &refs, &mut pr, &mut scratch);
+            x0 += n;
+        }
+    }
+}
+
+pub fn splines(data: &[u8]) {
+    if data.len() < 8 {
+        return;
+    }
+    let (cfg, rest) = data.split_at(8);
+    let xsize = 1 + (u16::from_le_bytes([cfg[0], cfg[1]]) as u64 % 2000);
+    let ysize = 1 + (u16::from_le_bytes([cfg[2], cfg[3]]) as u64 % 2000);
+    let mut br = BitReader::new(rest);
+    let Ok(mut s) = Splines::read(&mut br, (xsize * ysize) as u32) else { return };
+    let cc = crate::frame::color_correlation_map::ColorCorrelationParams::default();
+    if s.initialize_draw_cache(xsize, ysize, &cc, cfg[4] & 1 != 0, cfg[4] & 2 != 0).is_err() {
+        return;
+    }
+}
