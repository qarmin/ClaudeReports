+use criterion::{criterion_group, criterion_main, Criterion};
+use pic_scale_safe::{premultiply_la8, premultiply_rgba16, premultiply_rgba8, unpremultiply_rgba8};
+use std::hint::black_box;
+
+pub fn criterion_benchmark(c: &mut Criterion) {
+    // 1920x1080 RGBA8, matching the size a downstream consumer (`image`) measured this at.
+    let src: Vec<u8> = (0..1920 * 1080 * 4).map(|i| (i % 256) as u8).collect();
+
+    c.bench_function("premultiply_rgba8 1920x1080", |b| {
+        b.iter_batched(
+            || src.clone(),
+            |mut buf| {
+                premultiply_rgba8(black_box(&mut buf));
+                buf
+            },
+            criterion::BatchSize::LargeInput,
+        )
+    });
+
+    let premultiplied: Vec<u8> = {
+        let mut buf = src.clone();
+        premultiply_rgba8(&mut buf);
+        buf
+    };
+
+    c.bench_function("unpremultiply_rgba8 1920x1080", |b| {
+        b.iter_batched(
+            || premultiplied.clone(),
+            |mut buf| {
+                unpremultiply_rgba8(black_box(&mut buf));
+                buf
+            },
+            criterion::BatchSize::LargeInput,
+        )
+    });
+
+    let src_la: Vec<u8> = (0..1920 * 1080 * 2).map(|i| (i % 256) as u8).collect();
+    c.bench_function("premultiply_la8 1920x1080", |b| {
+        b.iter_batched(
+            || src_la.clone(),
+            |mut buf| {
+                premultiply_la8(black_box(&mut buf));
+                buf
+            },
+            criterion::BatchSize::LargeInput,
+        )
+    });
+
+    let src16: Vec<u16> = (0..1920 * 1080 * 4).map(|i| (i % 1024) as u16).collect();
+    c.bench_function("premultiply_rgba16 1920x1080 bd10", |b| {
+        b.iter_batched(
+            || src16.clone(),
+            |mut buf| {
+                premultiply_rgba16(black_box(&mut buf), 10);
+                buf
+            },
+            criterion::BatchSize::LargeInput,
+        )
+    });
+}
+
+criterion_group!(benches, criterion_benchmark);
+criterion_main!(benches);
