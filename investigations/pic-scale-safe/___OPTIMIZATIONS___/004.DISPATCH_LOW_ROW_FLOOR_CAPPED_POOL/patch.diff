--- /dev/null
+++ b/src/thread_pool.rs
@@ -0,0 +1,28 @@
+// ___OPTIMIZATIONS___/035.VENDORED_DISPATCH_PER_FILTER_THREAD_CAP: a per-filter capped-size
+// rayon pool used by the fixed/floating point dispatch sites (fixed_point_dispatch.rs,
+// floating_point_dispatch.rs) instead of the flat `dst_height >= 32` serial-or-full-pool gate
+// candidate 034 measured as a multi-core regression for CatmullRom/Gaussian/Lanczos3. `N=6` for
+// CatmullRom/Gaussian and `N=4` for everything else mirrors the caller-side pools already
+// validated in candidates 023/026/027/029.
+use crate::sampler::ResamplingFunction;
+use std::sync::OnceLock;
+
+pub(crate) fn pool_for_filter(resampling_function: ResamplingFunction) -> &'static rayon::ThreadPool {
+    static POOL_N4: OnceLock<rayon::ThreadPool> = OnceLock::new();
+    static POOL_N6: OnceLock<rayon::ThreadPool> = OnceLock::new();
+
+    match resampling_function {
+        ResamplingFunction::CatmullRom | ResamplingFunction::Gaussian => POOL_N6.get_or_init(|| {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(6)
+                .build()
+                .expect("failed to build capped-thread pool")
+        }),
+        _ => POOL_N4.get_or_init(|| {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(4)
+                .build()
+                .expect("failed to build capped-thread pool")
+        }),
+    }
+}
