# Self-contained reproduction for this candidate. Clones pic-scale-safe at the pinned commit,
# applies patch.diff, and runs this crate's own criterion bench (app/benches/resize_rgb) before
# and after so the reader gets a real before/after from a fresh clone.
#
# NOTE: this candidate's own RESULT.md numbers come from `image` repo's ___OPTIMIZATIONS___
# workspace (a different bench harness/scenario entirely - see RESULT.md's own header). This
# justfile's `bench` step exercises THIS crate's own bench suite instead, since that's the only
# harness available from a fresh clone of this repo. Treat this justfile's own output as a sanity
# check that the patch still builds and behaves reasonably, not as a reproduction of RESULT.md's
# numbers.

repo_url := "https://github.com/awxkee/pic-scale-safe.git"
base_commit := "b50e020d72a1c0063f39c2c0166343d4e44790ca"

test: clone build-baseline apply bench-patched

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    @echo "=== baseline (before patch) ==="
    cd clone/app && cargo bench --bench resize_rgb

bench-patched:
    @echo "=== patched (after patch) ==="
    cd clone/app && cargo bench --bench resize_rgb

clean:
    rm -rf clone
