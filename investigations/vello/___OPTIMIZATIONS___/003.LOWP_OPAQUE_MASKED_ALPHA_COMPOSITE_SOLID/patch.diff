+/// Builds a per-pixel AA-coverage mask (`Tile::HEIGHT` bytes per pixel column) with a mix of
+/// full and partial coverage values, representative of an anti-aliased fill's edge pixels.
+fn mask_alphas(width: u16) -> Vec<u8> {
+    (0..usize::from(width) * Tile::HEIGHT as usize)
+        .map(|i| (i * 37 % 256) as u8)
+        .collect()
 }
 
