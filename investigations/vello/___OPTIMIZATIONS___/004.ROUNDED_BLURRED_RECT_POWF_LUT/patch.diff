+    //   d = (x^p + y^p)^(1/p)
+    //     = (max_fact^p + min_fact^p)^(1/p)
+    //     = (max_fact^p * (1 + (min_fact / max_fact)^p))^(1/p)
+    //     = max_fact * (1 + t^p)^(1/p), where t = min_fact / max_fact.
