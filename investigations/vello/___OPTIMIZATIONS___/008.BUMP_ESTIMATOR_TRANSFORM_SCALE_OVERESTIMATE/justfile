# Self-contained reproduction for candidate 008 (BUMP_ESTIMATOR_TRANSFORM_SCALE_OVERESTIMATE).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored). `bench/` is a standalone crate (nothing in the main repo already
# exercises vello_encoding::BumpEstimator) depending on `{ path = "../clone/vello" }`.
#
# repo_url/base_commit were read via `git remote get-url origin` / `git rev-parse HEAD` in the
# main project at the moment patch.diff was captured.
#
# NOTE: this repo is configured for Git LFS (`vello_tests/snapshots/*.png`, etc), but nothing
# this justfile touches (vello/vello_encoding source, no LFS assets) actually needs it - `clone`
# below disables the LFS smudge/clean/process filters outright so this works whether or not
# `git-lfs` is installed on the machine running it (a bare `git clone`/`git checkout` hard-fails
# instead of just warning when `git-lfs` is missing but the filter is still configured globally).

repo_url := "git@github.com:linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"
git_no_lfs := "-c filter.lfs.smudge=cat -c filter.lfs.clean=cat -c filter.lfs.process= -c filter.lfs.required=false"

# Full cycle: clone at the pinned commit, build a BASELINE binary before touching anything,
# apply the patch, build a PATCHED binary, then run both and print both results.
test: clone build-baseline bench-baseline apply build-patched bench-patched compare

clone:
    rm -rf clone
    git {{git_no_lfs}} clone {{repo_url}} clone
    cd clone && git {{git_no_lfs}} checkout {{base_commit}}

apply:
    cd clone && git {{git_no_lfs}} apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd bench && cargo build --release
    cp bench/target/release/bump_est_bench ./bin_baseline

build-patched:
    cd bench && cargo build --release
    cp bench/target/release/bump_est_bench ./bin_patched

# "size" mode prints the estimated bump-allocator buffer total (bytes) for a representative
# stroke-heavy scene (400 five-pointed stars + 400 wavy cubic curves, round caps/joins) under a
# handful of transforms - this is the accuracy/memory dimension. "perf" mode times building +
# estimating that same scene, single-core - this is the CPU-cost dimension.
bench-baseline:
    @echo "=== baseline (before patch) - size ==="
    ./bin_baseline size
    @echo "=== baseline (before patch) - perf (single-core, taskset -c 0) ==="
    taskset -c 0 ./bin_baseline perf 400

bench-patched:
    @echo "=== patched (after patch) - size ==="
    ./bin_patched size
    @echo "=== patched (after patch) - perf (single-core, taskset -c 0) ==="
    taskset -c 0 ./bin_patched perf 400

compare:
    @echo "=== correctness: vello/vello_encoding test suite, patched ==="
    cd clone && cargo test -p vello_encoding --features bump_estimate -p vello --features bump_estimate

clean:
    rm -rf clone bin_baseline bin_patched bench/target
