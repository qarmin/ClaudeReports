# Self-contained reproduction for candidate 009 (vello_hybrid bilinear + Extend::Pad
# image sampling disagrees with vello_cpu - https://github.com/linebender/vello/issues/1590).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Needs a working wgpu backend (Vulkan/Metal/DX12) to create a GPU device. On a machine with
# a real GPU this works out of the box. In a headless/CI-like environment without one, point
# VK_ICD_FILENAMES at a software Vulkan ICD (e.g. swiftshader or Mesa lavapipe) before running
# `just test`, for example:
#   VK_ICD_FILENAMES=/path/to/vk_swiftshader_icd.json just test

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should print "REPRODUCED"
# and exit non-zero (CPU and Hybrid disagree under Extend::Pad bilinear sampling).
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should print "NOT REPRODUCED" and
# exit 0 (CPU and Hybrid now agree).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
