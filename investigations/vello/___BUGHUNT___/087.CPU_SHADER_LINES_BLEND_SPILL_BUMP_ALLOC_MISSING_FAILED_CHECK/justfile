# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# What this demonstrates: vello_shaders' CPU-shader-shim `write_line` (vello_shaders/src/cpu/
# flatten.rs) panics with an index-out-of-bounds when a real scene's flattened-line demand exceeds
# the `lines` buffer's fixed hand-picked capacity (vello_encoding::config::BufferSizes::new,
# 1<<21 = 2,097,152) - a condition the real GPU path (flatten.wgsl's own write_line) handles safely
# via an explicit `if line_ix < config.lines_size` guard before ever indexing into the buffer.
# `patch.diff` adds the same guard to the CPU shim.
#
# The candidate's other named suspect, the `blend_spill` buffer, turned out not to apply at all -
# see RESULT.md: the CPU shim never implements the `fine` rasterization stage (fine.rs's fine_main
# is dead/draft code, never wired up), so there is no CPU-shim `blend_spill` write to have a
# missing check. No repro is provided for it because there is nothing to reproduce.
#
# This machine has no real GPU: point VK_ICD_FILENAMES at a software Vulkan ICD (e.g. Google's
# SwiftShader) to get a real wgpu::Device without real GPU hardware. Any real GPU backend
# (Vulkan/Metal/DX12/GL) exercises the exact same GPU/CPU-shim dispatch code in vello_shaders; on
# a machine with a real GPU, VK_ICD_FILENAMES can simply be dropped (or WGPU_BACKEND unset to let
# wgpu pick the first working backend).

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"
git_no_lfs := "git -c filter.lfs.smudge= -c filter.lfs.clean= -c filter.lfs.process= -c filter.lfs.required=false"

export WGPU_BACKEND := "vulkan"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    {{git_no_lfs}} clone {{repo_url}} clone
    cd clone && {{git_no_lfs}} checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone (expected: one panic, at
# flatten.rs:90).
# Requires VK_ICD_FILENAMES to point at a working Vulkan ICD if there's no real GPU (see header
# comment above) - e.g.:
#   VK_ICD_FILENAMES=/path/to/vk_swiftshader_icd.json just test
reproduce-before:
    cd repro && cargo run --release --bin lines_overflow

apply:
    cd clone && {{git_no_lfs}} apply ../patch.diff

# Re-run against the patched clone. Expected: the original panic at flatten.rs:90 is gone, but the
# same scene now panics one stage later at path_count.rs:150 (a different, already-known and
# unfixed sibling bug - see this workspace's own candidate 066) - this is expected and does not
# indicate the patch failed; it demonstrates this fix is scoped to the `lines` buffer specifically,
# not a systemic fix for the whole CPU shim.
reproduce-after:
    cd repro && cargo run --release --bin lines_overflow

clean:
    rm -rf clone repro/target repro/Cargo.lock
