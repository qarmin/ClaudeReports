# Self-contained reproduction for candidate 013 (IMAGE_CACHE_DEALLOCATE_U16_WRAP).
# Status: Not reproducible - see RESULT.md. `repro/` sweeps a boundary-focused set of
# (width, padding) inputs through the real, public `ImageCache::allocate`/`deallocate` API with
# `overflow-checks = true` forced on in both profiles, and finds zero overflows/panics - so there
# is no patch.diff and no `apply`/`reproduce-after` step.
#
# Note: this environment's git-lfs binary may be missing, which makes a plain `git clone`/
# `git checkout` of this repo fail on its LFS-tracked PNG test snapshots. The repro never touches
# those files, so `clone` disables the LFS filter outright (`-c filter.lfs.*`) to stay robust
# regardless of whether git-lfs is installed on the machine running this.

# https (not the ssh form `git remote get-url origin` actually returns) so `just clone` works
# without an ssh key/agent configured.
repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

test: clone reproduce-before

clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - sweeps allocate()/deallocate()
# boundary inputs and should report zero overflows/panics (see RESULT.md).
reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
