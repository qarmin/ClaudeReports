# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Status: Not reproducible - there is no bounded fix, so there is no `apply`/`reproduce-after`
# step. `just test` just proves the isolated `Add` impl panics (Part 1) and that the real public
# entry points a scene author would use never reach it, even at near-u16::MAX sizes (Part 2).

repo_url := "https://github.com/linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

test: clone reproduce-before

# The `-c filter.lfs...` overrides disable this repo's Git LFS smudge filter (this repo is
# configured for LFS but doesn't actually need it for any file this repro touches) - without them,
# `git clone`/`checkout` abort with "the remote end hung up unexpectedly" on any machine without
# the `git-lfs` binary installed.
clone:
    rm -rf clone
    git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge=cat -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

reproduce-before:
    cd repro && cargo run --release

clean:
    rm -rf clone
