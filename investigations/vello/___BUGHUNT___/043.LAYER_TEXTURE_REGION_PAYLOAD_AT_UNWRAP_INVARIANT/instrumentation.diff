+        // Directly demonstrates that violating the documented invariant ("only sample values
+        // that are within the layer bbox") does make `payload_at` panic, as the comment warns -
+        // confirming the fuzz/manual-construction tests in `schedule_tests.rs` were exercising a
+        // check that actually bites when the invariant is broken.
+        let region = layer(RectU16::new(20, 20, 30, 30));
+
+        // x = 10 is less than layer_bbox.x0 = 20, so shift.0 = 0 - 20 = -20, and
+        // 10 + (-20) = -10, which does not fit in a u16 -> `unwrap()` panics.
+        let _ = region.payload_at(10, 25);
+    }
