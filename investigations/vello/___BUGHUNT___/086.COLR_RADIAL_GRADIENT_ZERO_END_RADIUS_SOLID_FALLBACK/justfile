# Self-contained reproduction for candidate 086: COLR_RADIAL_GRADIENT_ZERO_END_RADIUS_SOLID_FALLBACK.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "git@github.com:linebender/vello.git"
base_commit := "7516831426fb70f36d62c521c5477f6a7265b36a"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the divergence
# (vello_cpu/glifo renders a flat solid fill; classic vello's real GPU render shows an actual
# gradient).
reproduce-before:
    cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - the two renderers should now agree (both show
# real gradient color variation, near-identical pixel/color counts).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
