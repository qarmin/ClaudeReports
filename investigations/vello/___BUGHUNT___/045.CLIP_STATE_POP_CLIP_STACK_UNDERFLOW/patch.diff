diff --git a/sparse_strips/vello_common/src/clip.rs b/sparse_strips/vello_common/src/clip.rs
index c3050633..3ddf6c75 100644
--- a/sparse_strips/vello_common/src/clip.rs
+++ b/sparse_strips/vello_common/src/clip.rs
@@ -126,9 +126,17 @@ impl ClipContext {
     }
 
     /// Pop the least recent clip path.
+    ///
+    /// # Panics
+    ///
+    /// Panics if there is no clip path currently pushed, i.e. if this method is called more
+    /// often than [`Self::push_clip`].
     #[inline]
     pub fn pop_clip(&mut self) {
-        let data = self.clip_stack.pop().expect("clip stack underflowed");
+        let data = self
+            .clip_stack
+            .pop()
+            .expect("pop_clip called without a matching push_clip");
         self.storage.strips.truncate(data.strip_start as usize);
         self.storage.alphas.truncate(data.alpha_start as usize);
     }
@@ -272,8 +280,16 @@ impl ClipState {
     }
 
     /// Pop the active clip path.
+    ///
+    /// # Panics
+    ///
+    /// Panics if there is no clip path currently pushed, i.e. if this method is called more
+    /// often than [`Self::push_clip`].
     pub fn pop_clip(&mut self) {
-        let raw_clip = self.raw_clips.pop().expect("clip stack underflowed");
+        let raw_clip = self
+            .raw_clips
+            .pop()
+            .expect("pop_clip called without a matching push_clip");
         self.path_elements.truncate(raw_clip.path.start);
         self.context.pop_clip();
         self.revision = self.revision.wrapping_add(1);
diff --git a/sparse_strips/vello_cpu/src/render.rs b/sparse_strips/vello_cpu/src/render.rs
index d604c5d5..4495cdff 100644
--- a/sparse_strips/vello_cpu/src/render.rs
+++ b/sparse_strips/vello_cpu/src/render.rs
@@ -737,6 +737,11 @@ impl RenderContext {
     ///
     /// Note that unlike `push_clip_layer`, it is permissible to have pending
     /// pushed clip paths before finishing the rendering operation.
+    ///
+    /// # Panics
+    ///
+    /// Panics if there is no clip path currently pushed, i.e. if this method is called more
+    /// often than [`Self::push_clip_path`].
     pub fn pop_clip_path(&mut self) {
         self.dispatcher.pop_clip_path();
     }
