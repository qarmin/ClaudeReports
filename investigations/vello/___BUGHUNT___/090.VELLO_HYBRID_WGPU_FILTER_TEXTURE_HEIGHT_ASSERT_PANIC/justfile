# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# NOTE: `reproduce-before`/`reproduce-after` push 5.7 million filter layers into a single
# `vello_hybrid::Scene` and render it through a real (software) Vulkan adapter - `reproduce-before`
# panics quickly (the assert fires during scheduling, before the expensive per-layer render
# passes), but `reproduce-after` must actually execute all 5.7M layers' filter passes to prove
# nothing panics, which takes on the order of 5-10 minutes under a software (CPU) Vulkan
# implementation like SwiftShader. Requires a real Vulkan adapter: set VK_ICD_FILENAMES to a
# usable ICD (e.g. a SwiftShader build) if the default system Vulkan loader doesn't already have
# one registered.

repo_url := "https://github.com/linebender/vello.git"
base_commit := "75168314"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

# The -c overrides (not a persistent git config change) skip git-lfs smudging for this clone
# only: this repo's LFS-tracked assets are unrelated snapshot PNGs, not anything this repro needs,
# and environments without the git-lfs binary installed would otherwise fail the whole checkout.
clone:
    rm -rf clone
    git -c filter.lfs.smudge= -c filter.lfs.process= -c filter.lfs.required=false clone {{repo_url}} clone
    cd clone && git -c filter.lfs.smudge= -c filter.lfs.process= -c filter.lfs.required=false checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (panics with "Filter texture height exceeds resource texture dimensions"). The leading `-`
# tells `just` not to abort the `test` chain on this recipe's expected nonzero (panic) exit code.
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic (takes several
# minutes, see the note above).
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone
