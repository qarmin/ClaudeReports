    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates the bug is NOT present.
reproduce:
    cd repro && cargo run --release

# Optional: prove the finding's causal mechanism by reintroducing the exact pre-fix `closed`-flag
# bug (see RESULT.md's "Root cause") into the clone's own flatten_simd.rs, re-running the same
# repro/ (now expected to print FAIL / write an unbounded-fill funky_scene.png), then reverting.
test-historical-bug: clone
    cd clone && git apply "{{justfile_directory()}}/historical_bug.patch"
    -cd repro && cargo run --release
    cd clone && git checkout -- sparse_strips/vello_common/src/flatten_simd.rs

clean:
