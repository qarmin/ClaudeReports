+#[derive(Default, Clone, Copy)]
+pub(super) struct ParagraphMetrics {
+    /// `parley::Layout::full_width()` of the broken lines.
+    pub(super) width: f32,
+    /// `parley::Layout::height()` of the broken lines.
+    pub(super) height: f32,
+    pub(super) line_count: usize,
 }
 
 pub(super) struct TextParagraph {
     pub(super) range: Range<usize>,
     pub(super) y: PhysicalLength,
-    pub(super) layout: parley::Layout<Brush>,
+    /// Valid once the breaking pass has run over this paragraph; see [`ParagraphMetrics`].
+    pub(super) metrics: ParagraphMetrics,
+    /// The shaped and broken glyphs, or `None` when they were dropped (or never produced) because
+    /// the paragraph is far from anything that has to be painted. Boxed so an unshaped paragraph
+    /// costs a pointer rather than a whole `parley::Layout`, of which a large document has one per
+    /// line. Interior mutability because [`super::layout::Layout::glyphs`] re-shapes on demand,
+    /// from behind the `&Layout` that every consumer gets.
+    glyphs: RefCell<Option<alloc::boxed::Box<parley::Layout<Brush>>>>,
     pub(super) links: std::vec::Vec<(Range<usize>, std::string::String)>,
     /// Byte ranges within the paragraph's text that carry `Style::Code`. Drawn with a
     /// translucent rounded background by `draw` for visual parity with common markdown
     /// renderers.
     pub(super) code_ranges: std::vec::Vec<Range<usize>>,
 }
+
+impl TextParagraph {
+    /// A paragraph whose glyphs have not been produced yet. Only plain text can be built this way:
+    /// re-shaping needs nothing but `range` and the document text, whereas a styled paragraph also
+    /// carries formatting spans (see [`PlainParagraphSource`]).
+    pub(super) fn unshaped(range: Range<usize>) -> Self {
+        Self {
+            range,
+            y: PhysicalLength::default(),
+            metrics: ParagraphMetrics::default(),
+            glyphs: RefCell::new(None),
+            links: Default::default(),
+            code_ranges: Default::default(),
+        }
+    }
+
+    /// The shaped glyphs, if this paragraph is currently holding them. Reach for
+    /// [`super::layout::Layout::glyphs`] instead unless the paragraph is known to be shaped: it
+    /// re-shapes on demand, which is the whole point of the glyphs being droppable.
+    pub(super) fn glyphs(&self) -> Option<core::cell::Ref<'_, parley::Layout<Brush>>> {
+        core::cell::Ref::filter_map(self.glyphs.borrow(), |glyphs| {
+            glyphs.as_deref()
+        })
+        .ok()
+    }
+
+    /// The shaped glyphs for the breaking pass, which owns the paragraphs and is the only place
+    /// they are mutated.
+    pub(super) fn glyphs_mut(&mut self) -> Option<&mut parley::Layout<Brush>> {
+        self.glyphs.get_mut().as_deref_mut()
+    }
+
+    pub(super) fn is_shaped(&self) -> bool {
+        self.glyphs.borrow().is_some()
+    }
+
+    pub(super) fn set_glyphs(&self, glyphs: parley::Layout<Brush>) {
+        *self.glyphs.borrow_mut() = Some(alloc::boxed::Box::new(glyphs));
+    }
+
+    pub(super) fn drop_glyphs(&self) {
+        *self.glyphs.borrow_mut() = None;
+    }
+}
