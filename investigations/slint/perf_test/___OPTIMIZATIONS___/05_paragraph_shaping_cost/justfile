# Stage breakdown of parley's per-paragraph cost, with exact live-byte accounting.
run:
    cd {{ justfile_directory() }}/parley_stage_bench && cargo run --release -- 100000 100

# Per-character vs per-paragraph: same 10 MB of text in different line lengths
run-shapes:
    #!/usr/bin/env bash
    cd {{ justfile_directory() }}/parley_stage_bench
    for args in "100000 100" "10000 1000" "1000 10000" "100000 20"; do
        cargo run --release -q -- $args | grep -E "paragraphs x|^build|^retained"
    done
