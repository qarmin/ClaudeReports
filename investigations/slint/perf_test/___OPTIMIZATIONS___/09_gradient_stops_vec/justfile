harness := justfile_directory() + "/../.."
bin := justfile_directory() + "/../../../target/rdebug/perf_test"

# Gradient scene: allocations per frame and the site ranking. Needs a display; see run-xvfb.
run: build
    {{ bin }} --mode rects --count 3000 --gradient --frames 8
    {{ bin }} --mode rects --count 3000 --gradient --frames 6 --alloc-profile 3 | sed -n '/allocation sites/,/^$/p' | head -14

run-xvfb: build
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode rects --count 3000 --gradient --frames 8
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode rects --count 3000 --gradient --frames 6 --alloc-profile 3 | sed -n '/allocation sites/,/^$/p' | head -14

build:
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test
