harness := justfile_directory() + "/../.."
bin := justfile_directory() + "/../../../target/rdebug/perf_test"

# Gradient vs solid: the extra tessellation shows up as femtovg path cache allocations
run: build
    {{ bin }} --mode rects --count 3000 --gradient --frames 8
    {{ bin }} --mode rects --count 3000 --frames 8

run-xvfb: build
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode rects --count 3000 --gradient --frames 8
    LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -s "-screen 0 1280x900x24" {{ bin }} --mode rects --count 3000 --frames 8

build:
    cd {{ harness }} && cargo build --profile rdebug --bin perf_test
