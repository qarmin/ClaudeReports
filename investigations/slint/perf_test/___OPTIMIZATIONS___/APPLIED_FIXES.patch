+/// Dismantling keeps the paragraphs that asked for glyphs, plus a margin either side, and drops
+/// the rest -- that window is the entire memory story of this candidate.
+#[test]
+fn dismantling_keeps_only_a_window_of_shaped_paragraphs() {
+    let text = long_document();
+    let plain = PlainOrStyledText::Plain(text.as_str().into());
+    let builder = super::shaping::plain_builder_for_tests();
+    let font_ctx = RefCell::new(FontContext::new(test_font_context()));
+    let source = super::shaping::PlainParagraphSource::new(&builder, &plain, &font_ctx)
+        .expect("plain text has a paragraph source");
+    let mut paragraphs =
+        paragraph_ranges(&text).map(super::shaping::TextParagraph::unshaped).collect::<Vec<_>>();
+    let mut line_breaking = None;
+
+    // (paragraphs to ask for, paragraphs expected to hold glyphs afterwards). The margin is 64
+    // either side of everything asked for *in this pass*, but it only protects glyphs from being
+    // dropped -- it never shapes ahead.
+    let passes = [
+        (100..110, std::vec![100..110]),
+        // Still within 150 - 64, so the first window survives a pass that moved on.
+        (150..160, std::vec![100..110, 150..160]),
+        // 0 + 64 no longer reaches either of them.
+        (0..1, std::vec![0..1]),
+    ];
+
+    for (asked_for, expected) in passes {
+        let layout = layout(
+            &builder,
+            &mut font_ctx.borrow_mut(),
+            paragraphs,
+            ScaleFactor::new(1.0),
+            LayoutOptions::default(),
+            line_breaking,
+            Some(&source),
+        );
+        for index in asked_for.clone() {
+            assert!(layout.glyphs(index).is_some(), "paragraph {index} should shape on demand");
+        }
+        (paragraphs, line_breaking) = {
+            let (paragraphs, retained) = layout.dismantle();
+            (paragraphs, Some(retained))
+        };
+
+        for (index, paragraph) in paragraphs.iter().enumerate() {
+            let expected = expected.iter().any(|range| range.contains(&index));
+            assert_eq!(
+                paragraph.is_shaped(),
+                expected,
+                "paragraph {index} after asking for {asked_for:?}"
+            );
+        }
+    }
+}
+
+/// A document short enough to keep every paragraph's glyphs must not pay for any of the above.
+#[test]
+fn short_documents_keep_every_paragraph_shaped() {
+    let layout = layout_text("one\ntwo\nthree");
+    assert!(layout.paragraphs.iter().all(|paragraph| paragraph.is_shaped()));
+    let (paragraphs, _) = layout.dismantle();
+    assert!(paragraphs.iter().all(|paragraph| paragraph.is_shaped()));
+}
+
+/// Wrapped text keeps every paragraph's glyphs, however long the document.
+///
+/// Under `word-wrap` the line breaking itself depends on the width, so the metrics of a pass are
+/// only valid for the width it ran at. Dropping the glyphs would mean re-shaping the whole document
+/// on every width change - and a window resize is one width change per frame of the drag, measured
+/// at 96 ms with the glyphs kept against 1.79 s without.
+#[test]
+fn wrapped_documents_keep_every_paragraph_shaped() {
+    let text = long_document();
+    let plain = PlainOrStyledText::Plain(text.as_str().into());
+
+    for (wrap, expect_shaped) in
+        [(TextWrap::NoWrap, false), (TextWrap::WordWrap, true), (TextWrap::CharWrap, true)]
+    {
+        let builder = super::shaping::builder_for_tests(wrap);
+        let font_ctx = RefCell::new(FontContext::new(test_font_context()));
+        let source = super::shaping::PlainParagraphSource::new(&builder, &plain, &font_ctx)
+            .expect("plain text has a paragraph source");
+        let unshaped = paragraph_ranges(&text)
+            .map(super::shaping::TextParagraph::unshaped)
+            .collect::<Vec<_>>();
+        let layout = layout(
+            &builder,
+            &mut font_ctx.borrow_mut(),
+            unshaped,
+            ScaleFactor::new(1.0),
+            LayoutOptions { max_width: Some(LogicalLength::new(200.0)), ..Default::default() },
+            None,
+            Some(&source),
+        );
+        assert_eq!(
+            layout.paragraphs.iter().all(|paragraph| paragraph.is_shaped()),
+            expect_shaped,
+            "{wrap:?}"
+        );
+    }
+}
+
+/// `max-lines` and `overflow: elide` derive their cut from per-line metrics of paragraphs anywhere
+/// in the document, which don't survive dropping the glyphs.
+#[test]
+fn line_limited_and_elided_documents_keep_every_paragraph_shaped() {
+    let text = long_document();
+    let plain = PlainOrStyledText::Plain(text.as_str().into());
+    let builder = super::shaping::plain_builder_for_tests();
+
+    for options in [
+        LayoutOptions { max_lines: Some(10), ..Default::default() },
+        LayoutOptions {
+            text_overflow: TextOverflow::Elide,
+            max_width: Some(LogicalLength::new(200.0)),
+            max_height: Some(LogicalLength::new(100.0)),
+            ..Default::default()
+        },
+    ] {
+        let font_ctx = RefCell::new(FontContext::new(test_font_context()));
+        let source = super::shaping::PlainParagraphSource::new(&builder, &plain, &font_ctx)
+            .expect("plain text has a paragraph source");
+        let unshaped = paragraph_ranges(&text)
+            .map(super::shaping::TextParagraph::unshaped)
+            .collect::<Vec<_>>();
+        let layout = layout(
+            &builder,
+            &mut font_ctx.borrow_mut(),
+            unshaped,
+            ScaleFactor::new(1.0),
+            options,
+            None,
+            Some(&source),
+        );
+        assert!(layout.paragraphs.iter().all(|paragraph| paragraph.is_shaped()));
+    }
+}
