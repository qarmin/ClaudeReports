+        ScaleFactor::new(1.0),
+        LayoutOptions::default(),
+        None,
+        None,
+    );
+
+    let font_ctx = RefCell::new(FontContext::new(test_font_context()));
+    let plain = PlainOrStyledText::Plain(text.as_str().into());
+    let source = super::shaping::PlainParagraphSource::new(&builder, &plain, &font_ctx)
+        .expect("plain text has a paragraph source");
+    let unshaped =
+        paragraph_ranges(&text).map(super::shaping::TextParagraph::unshaped).collect::<Vec<_>>();
+    let lazy = layout(
+        &builder,
+        &mut font_ctx.borrow_mut(),
+        unshaped,
+        ScaleFactor::new(1.0),
+        LayoutOptions::default(),
+        None,
+        Some(&source),
+    );
+
+    // Otherwise the comparison below is between two eagerly shaped documents and proves nothing.
+    assert_eq!(
+        lazy.paragraphs.iter().filter(|paragraph| paragraph.is_shaped()).count(),
+        0,
+        "the metrics pass should have dropped every paragraph's glyphs"
+    );
+
+    assert_eq!(eager.paragraphs.len(), lazy.paragraphs.len());
+    assert_eq!(eager.height, lazy.height);
+    assert_eq!(eager.max_width, lazy.max_width);
+    for (index, (eager_paragraph, lazy_paragraph)) in
+        eager.paragraphs.iter().zip(lazy.paragraphs.iter()).enumerate()
+    {
+        assert_eq!(eager_paragraph.range, lazy_paragraph.range, "paragraph {index}");
+        assert_eq!(eager_paragraph.y, lazy_paragraph.y, "paragraph {index}");
+        assert_eq!(eager_paragraph.metrics.width, lazy_paragraph.metrics.width, "paragraph {index}");
+        assert_eq!(
+            eager_paragraph.metrics.height,
+            lazy_paragraph.metrics.height,
+            "paragraph {index}"
+        );
+        assert_eq!(
+            eager_paragraph.metrics.line_count,
+            lazy_paragraph.metrics.line_count,
+            "paragraph {index}"
+        );
+    }
+
+    for offset in offsets {
+        assert_eq!(
+            eager.cursor_rect_for_byte_offset(offset, cursor_width),
+            lazy.cursor_rect_for_byte_offset(offset, cursor_width),
+            "cursor rect at {offset}"
+        );
+    }
+    for y in [0.0, 10.0, 500.0, 3000.0] {
+        for x in [0.0, 25.0, 400.0] {
+            let point = PhysicalPoint::new(x, y);
+            assert_eq!(
+                eager.byte_offset_from_point(point),
+                lazy.byte_offset_from_point(point),
+                "byte offset at {point:?}"
+            );
+        }
+    }
+
+    let band = PhysicalLength::new(0.0)..PhysicalLength::new(f32::INFINITY);
+    let selection = 40..600;
+    assert_eq!(
+        std::format!("{:?}", eager.selection_geometry(selection.clone(), &band)),
+        std::format!("{:?}", lazy.selection_geometry(selection, &band)),
+    );
+}
