+/// A `femtovg::Path` borrowed from a thread-local pool and returned, cleared, on drop.
+/// Deref-coerces to `&femtovg::Path`, so call sites pass `&path` as before.
+struct ScratchPath(Option<femtovg::Path>);
+
+impl ScratchPath {
+    fn new() -> Self {
+        Self(Some(
+            PATH_POOL.with(|pool| pool.borrow_mut().pop()).unwrap_or_default(),
+        ))
+    }
+}
+
+impl core::ops::Deref for ScratchPath {
+    type Target = femtovg::Path;
+    fn deref(&self) -> &femtovg::Path {
+        self.0.as_ref().expect("the path is only taken in Drop")
+    }
+}
+
+impl core::ops::DerefMut for ScratchPath {
+    fn deref_mut(&mut self) -> &mut femtovg::Path {
+        self.0.as_mut().expect("the path is only taken in Drop")
+    }
+}
+
+impl Drop for ScratchPath {
+    /// Bounded so that deeply nested clips cannot make the pool grow without limit.
+    fn drop(&mut self) {
+        const POOL_LIMIT: usize = 8;
+        if let Some(mut path) = self.0.take() {
+            path.clear();
+            PATH_POOL.with(|pool| {
+                let mut pool = pool.borrow_mut();
+                if pool.len() < POOL_LIMIT {
+                    pool.push(path);
+                }
+            });
+        }
+    }
+}
