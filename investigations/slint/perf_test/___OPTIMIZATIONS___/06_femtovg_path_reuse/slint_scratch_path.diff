+/// The stops of a Slint gradient as femtovg wants them, with the extra stop at 1.0 that femtovg
+/// needs to keep the last color from being extrapolated.
+///
+/// Returns an iterator instead of a `Vec`: femtovg's `*_gradient_stops` take
+/// `impl IntoIterator`, and this runs once per gradient-filled primitive per frame, so the
+/// collect was one allocation per primitive for nothing. The stops iterator is walked twice
+/// (once for the last stop, once for the values), which is cheap - gradients have a handful of
+/// stops.
+fn gradient_stops<'a>(
+    stops: impl Iterator<Item = &'a i_slint_core::graphics::GradientStop> + Clone,
+) -> impl Iterator<Item = (f32, femtovg::Color)> {
+    let extra = stops
+        .clone()
+        .last()
+        .filter(|last| last.position != 1.0)
+        .map(|last| (1.0, to_femtovg_color(&last.color)));
+    stops.map(|stop| (stop.position, to_femtovg_color(&stop.color))).chain(extra)
+}
+
+std::thread_local! {
+    /// Scratch paths handed out by [`ScratchPath`]. Building a `femtovg::Path` allocates its verb
+    /// and coordinate vectors, and the renderer builds one per rectangle per frame, so the vectors
+    /// (and, with femtovg's `PathCache` reuse, the tessellation buffers) are recycled instead.
+    static PATH_POOL: RefCell<Vec<femtovg::Path>> = const { RefCell::new(Vec::new()) };
+}
+
+/// A `femtovg::Path` borrowed from a thread-local pool and returned, cleared, on drop.
+/// Deref-coerces to `&femtovg::Path`, so call sites pass `&path` as before.
+struct ScratchPath(Option<femtovg::Path>);
+
+impl ScratchPath {
+    fn new() -> Self {
+        Self(Some(PATH_POOL.with(|pool| pool.borrow_mut().pop()).unwrap_or_else(femtovg::Path::new)))
+    }
+}
+
+impl core::ops::Deref for ScratchPath {
+    type Target = femtovg::Path;
+    fn deref(&self) -> &femtovg::Path {
+        self.0.as_ref().expect("the path is only taken in Drop")
+    }
+}
+
+impl core::ops::DerefMut for ScratchPath {
+    fn deref_mut(&mut self) -> &mut femtovg::Path {
+        self.0.as_mut().expect("the path is only taken in Drop")
+    }
+}
+
+impl Drop for ScratchPath {
+    /// Bounded so that deeply nested clips cannot make the pool grow without limit.
+    fn drop(&mut self) {
+        const POOL_LIMIT: usize = 8;
+        if let Some(mut path) = self.0.take() {
+            path.clear();
+            PATH_POOL.with(|pool| {
+                let mut pool = pool.borrow_mut();
+                if pool.len() < POOL_LIMIT {
+                    pool.push(path);
+                }
+            });
+        }
+    }
+}
