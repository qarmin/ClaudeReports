+    /// Removes all verbs and coordinates, keeping the allocated capacity so that the path can
+    /// be filled again without reallocating. Callers that draw many short-lived paths per
+    /// frame (a UI toolkit drawing one path per rectangle, say) can keep one path around
+    /// instead of allocating a new one per primitive.
+    pub fn clear(&mut self) {
+        self.verbs.clear();
+        self.coords.clear();
+        self.last_pos = Position::default();
+        // The tessellation cache belongs to the geometry that was just discarded.
+        *self.cache.borrow_mut() = None;
+    }
