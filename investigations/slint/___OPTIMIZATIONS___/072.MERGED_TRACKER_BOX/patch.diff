+    /// Builds `trackers` in its final, permanent heap location (the `Box` is never moved out of
+    /// before being handed to `PartialRendererCache::insert`) and evaluates `geom_tracker` only
+    /// once it is there - evaluating (and thus registering dependencies) against a temporary
+    /// address that is moved afterward is unsound, see the module-level safety note above.
+    fn new<T: ItemRendererFeatures>(
+        item_rc: &ItemRc,
+        window_adapter: &Rc<dyn WindowAdapter>,
+        sibling_index: u16,
+    ) -> (Self, CachedItemBoundingBoxAndTransform) {
+        let trackers = Box::pin(PartialRenderingCachedDataTrackers {
+            tracker: None,
+            geom_tracker: PropertyTracker::default(),
+        });
+        let new_geom = trackers
+            .as_ref()
+            .project_ref()
+            .geom_tracker
+            .evaluate_if_dirty(|| {
+                CachedItemBoundingBoxAndTransform::new::<T>(item_rc, window_adapter, sibling_index)
+            })
+            .expect("a freshly created PropertyTracker is always dirty");
+        (Self { data: new_geom.clone(), trackers }, new_geom)
     }
 }
 
