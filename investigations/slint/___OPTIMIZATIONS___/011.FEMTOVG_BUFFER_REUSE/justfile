# This candidate's patch (patch.diff) targets `src/path.rs` in the femtovg
# CRATE's own source - the vendored dependency (https://github.com/femtovg/femtovg), NOT the
# main slint repo. See ~/.claude/skills/perf-optimize/SKILL.md's "Vendoring a suspect
# dependency" section for the concept. Uses femtovg_repo_url/femtovg_base_commit below, not
# slint's.

femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "5191ec901a677b0148e3608f3529fb21369039e4"

# Full cycle: clone femtovg at the pinned commit, apply the patch, run femtovg's own tests.
test: clone apply check

clone:
    rm -rf clone
    git clone {{femtovg_repo_url}} clone
    cd clone && git checkout {{femtovg_base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

check:
    cd clone && cargo test --lib

# The full effect (allocations/frame in perf_test's `rects`/`list` scenes through
# i-slint-renderer-femtovg) additionally needs candidate 006's patch.diff applied to
# a main-slint-repo clone with `[patch.crates-io] femtovg = { path = "<this clone>" }`, plus
# perf_test/ copied in manually (untracked in the main repo's git history). See
# ../006.FEMTOVG_PATH_REUSE/justfile for the slint-side half of this.
bench:
    @echo "See the comment above check/bench in this justfile: this half only proves femtovg's"
    @echo "own tests pass with the patch. The perf_test allocation numbers need candidate 006's"
    @echo "slint-side patch applied on top, in a main-slint-repo clone patched to use this one."

clean:
    rm -rf clone
