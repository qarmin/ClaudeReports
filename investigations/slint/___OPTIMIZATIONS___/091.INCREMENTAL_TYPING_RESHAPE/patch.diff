+/// previous shape's paragraphs. Anything that can change the *bytes* of a shaped
+/// [`parley::Layout`] belongs here. Scale factor and wrap mode are deliberately excluded: the
+/// cache entry is evicted whole whenever either changes (see `cache.rs`), so
+/// [`shape_paragraphs_incremental`] never even runs with stale ones of those.
+#[derive(Clone, PartialEq)]
+pub(super) struct ShapeFingerprint {
+    text: crate::SharedString,
+    font_request: Option<FontRequest>,
+    stroke: Option<TextStrokeStyle>,
+}
+
+/// Reuses every paragraph whose bytes provably match between `old_text` and `new_text` -- because
+/// it lies entirely within their common byte prefix or suffix -- and reshapes only what's left in
+/// between. A single-character edit therefore reshapes exactly one paragraph instead of the whole
+/// document, no matter how large the document is.
+///
+/// Byte offsets only, never `str` slicing at the prefix/suffix boundary itself: every slice this
+/// function actually takes is bounded by a `paragraph_ranges` result, which is always aligned to a
+/// `'\n'` (so always a valid UTF-8 boundary) regardless of where the raw byte diff landed.
+fn reshape_diff(
+    layout_builder: &LayoutWithoutLineBreaksBuilder,
+    font_context: &mut parley::FontContext,
+    new_text: &crate::SharedString,
+    old_text: &crate::SharedString,
+    old_paragraphs: Vec<TextParagraph>,
+    link_color: Color,
+) -> Vec<TextParagraph> {
+    let old_bytes = old_text.as_bytes();
+    let new_bytes = new_text.as_bytes();
+
+    let prefix = old_bytes.iter().zip(new_bytes.iter()).take_while(|(a, b)| a == b).count();
+    let suffix = old_bytes[prefix..]
+        .iter()
+        .rev()
+        .zip(new_bytes[prefix..].iter().rev())
+        .take_while(|(a, b)| a == b)
+        .count();
+
+    let new_ranges: alloc::vec::Vec<Range<usize>> = paragraph_ranges(new_text).collect();
+
+    let delta = new_bytes.len() as isize - old_bytes.len() as isize;
+    let shift = |range: Range<usize>| -> Range<usize> {
+        let apply = |x: usize| (x as isize + delta) as usize;
+        apply(range.start)..apply(range.end)
+    };
+
+    // Leading paragraphs entirely within the common prefix: same index, same range, in both old
+    // and new text, so their shaped layout is still exactly right. `range.end <= prefix` alone
+    // isn't enough -- a *shorter* new paragraph at the same index can still end inside the common
+    // prefix while its old counterpart (whose own content actually changed) extended past it, so
+    // the ranges have to agree too, not just the new one's end.
+    let mut lead = 0usize;
+    while lead < old_paragraphs.len()
+        && lead < new_ranges.len()
+        && new_ranges[lead] == old_paragraphs[lead].range
+        && new_ranges[lead].end <= prefix
+    {
+        lead += 1;
+    }
+
+    // Trailing paragraphs entirely within the common suffix: same content, shifted by however
+    // much the edit changed the document's total length. Symmetric caveat to `lead`: the very
+    // first paragraph has no real delimiting `'\n'` before it (just the start of the document),
+    // so an edit at the very start can make its bytes look like a "common suffix" of themselves
+    // while actually belonging to a differently-bounded paragraph in the new text (the inserted
+    // text merges into it, with no newline of its own) -- the shifted range has to still match
+    // the new paragraph at that position, not just have content-identical bytes.
+    let suffix_start = old_bytes.len() - suffix;
+    let mut tail = 0usize;
+    while tail < old_paragraphs.len() - lead
+        && tail < new_ranges.len() - lead
+        && old_paragraphs[old_paragraphs.len() - 1 - tail].range.start >= suffix_start
+        && shift(old_paragraphs[old_paragraphs.len() - 1 - tail].range.clone())
+            == new_ranges[new_ranges.len() - 1 - tail]
+    {
+        tail += 1;
+    }
+
+    let mut old_iter = old_paragraphs.into_iter();
+    let mut result = Vec::with_capacity(new_ranges.len());
+    result.extend((&mut old_iter).take(lead));
+
+    // The middle paragraphs the diff determined actually changed: drop their stale old shapes...
+    for _ in 0..(old_iter.len() - tail) {
+        old_iter.next();
+    }
+    // ...and reshape the corresponding new ranges in their place.
+    for range in &new_ranges[lead..new_ranges.len() - tail] {
+        let text_slice = &new_text[range.clone()];
+        result.push(shape_one_paragraph(
+            layout_builder,
+            font_context,
+            text_slice,
+            range.clone(),
+            Default::default(),
+            Default::default(),
+            link_color,
+        ));
+    }
+
+    result.extend(old_iter.map(|mut p| {
+        p.range = shift(p.range);
+        p
+    }));
+
+    result
+}
