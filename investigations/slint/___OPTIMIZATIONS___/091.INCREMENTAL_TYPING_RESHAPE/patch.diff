+/// Shapes one paragraph's text into a [`TextParagraph`]. Shared by [`create_text_paragraphs`]
+/// (every paragraph, from scratch) and [`reshape_diff`] (only the paragraph(s) an edit actually
+/// touched), so the two can never disagree about what "shaping a paragraph" means.
+fn shape_one_paragraph(
+    layout_builder: &LayoutWithoutLineBreaksBuilder,
+    font_context: &mut parley::FontContext,
+    text: &str,
+    range: Range<usize>,
+    formatting: Vec<i_slint_common::styled_text::FormattedSpan>,
+    links: Vec<(Range<usize>, std::string::String)>,
+    link_color: Color,
+) -> TextParagraph {
+    let code_ranges: alloc::vec::Vec<Range<usize>> = formatting
+        .iter()
+        .filter(|s| matches!(s.style, i_slint_common::styled_text::Style::Code))
+        .map(|s| s.range.clone())
+        .collect();
+
+    let layout = layout_builder.build(font_context, text, formatting, Some(link_color));
+
+    TextParagraph { range, y: PhysicalLength::default(), layout, links, code_ranges }
+}
