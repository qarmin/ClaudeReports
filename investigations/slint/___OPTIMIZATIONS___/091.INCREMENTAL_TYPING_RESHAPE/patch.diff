+/// Shapes `text` the way [`shape_paragraphs`] does, but reuses as much of `previous` as an edit
+/// allows -- see [`reshape_diff`]. Falls back to a full reshape whenever incremental reuse isn't
+/// safe: styled text (paragraphs carry formatting that isn't representable as a byte diff), no
+/// previous shape to diff against, or anything other than the text itself changed since (the
+/// previous shape's [`ShapeFingerprint`] no longer matches).
+pub(super) fn shape_paragraphs_incremental(
+    text: Pin<&dyn crate::item_rendering::RenderString>,
+    item_rc: Option<&crate::item_tree::ItemRc>,
+    text_wrap: TextWrap,
+    scale_factor: ScaleFactor,
+    font_context: &mut parley::FontContext,
+    previous: Option<(Vec<TextParagraph>, ShapeFingerprint)>,
+) -> (Vec<TextParagraph>, Option<ShapeFingerprint>) {
+    let builder = shaping_builder(text, item_rc, text_wrap, scale_factor);
+    let link_color = text.link_color();
+    let new_text = text.text();
+
+    let PlainOrStyledText::Plain(new_plain) = &new_text else {
+        return (create_text_paragraphs(&builder, font_context, new_text, link_color), None);
+    };
+
+    let fingerprint = ShapeFingerprint {
+        text: new_plain.clone(),
+        font_request: builder.font_request.clone(),
+        stroke: builder.stroke,
+    };
+
+    let reusable = previous.filter(|(_, old_fp)| {
+        old_fp.font_request == fingerprint.font_request && old_fp.stroke == fingerprint.stroke
+    });
+
+    let paragraphs = match reusable {
+        Some((old_paragraphs, old_fp)) => reshape_diff(
+            &builder,
+            font_context,
+            new_plain,
+            &old_fp.text,
+            old_paragraphs,
+            link_color,
+        ),
+        None => create_text_paragraphs(
+            &builder,
+            font_context,
+            PlainOrStyledText::Plain(new_plain.clone()),
+            link_color,
+        ),
+    };
+
+    (paragraphs, Some(fingerprint))
+}
