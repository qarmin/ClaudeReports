# This candidate has no patch.diff, and never should: the mitigation it found - position a row's
# children explicitly instead of through a `HorizontalLayout` (candidate 001's `FlatRecordRow`) -
# is an app-level `.slint` authoring pattern, not a change to the Slint library or a dependency it
# vendors. A patch.diff only makes sense against the tested project itself; the test harness
# (`../harness/perf_test/ui/shared.slint`) simply has this row style built in directly, the same
# as any other. `just test` builds the harness once and reproduces the finding by comparing the
# two row styles it already offers, under live off-screen mutation.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

test: clone build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

build:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test

# RESULT.md's headline: 200 off-screen rows changed/frame costs +6.8ms with `layout` rows,
# ~nothing with `flat` rows (10000 rows, 10 frames).
bench:
    @echo "=== layout rows, 200 off-screen rows changed/frame ==="
    ./clone/target/rdebug/perf_test --bench --mode scroll --count 10000 --row-style layout \
        --mutate 200 --mutate-mode changed-offscreen --frames 10
    @echo "=== flat rows, same mutation ==="
    ./clone/target/rdebug/perf_test --bench --mode scroll --count 10000 --row-style flat \
        --mutate 200 --mutate-mode changed-offscreen --frames 10

clean:
    rm -rf clone
