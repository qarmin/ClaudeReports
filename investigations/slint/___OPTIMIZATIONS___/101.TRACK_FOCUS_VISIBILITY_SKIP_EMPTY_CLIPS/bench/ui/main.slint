// Minimal scene for candidate 055 (Window::move_focus cycle detection): a flat grid of plain
// Rectangles, none of which can ever accept keyboard focus. Deliberately has none of the
// widgets (Button/TextInput/...) that perf_test's own scenes always wrap content in - those
// grab focus within a handful of steps regardless of scene size, which hides the O(N^2) cost
// this candidate is about. `focusable` optionally adds one FocusScope, for the correctness
// check that Tab still finds the same item after the patch.
export component MainWindow inherits Window {
    in property <int> count: 1000;
    in property <bool> focusable: false;
    out property <bool> scope-has-focus: fs.has-focus;
    preferred-width: 400px;
    preferred-height: 400px;

    for index in root.count: Rectangle {
        x: mod(index, 20) * 4px;
        y: floor(index / 20) * 4px;
        width: 3px;
        height: 3px;
        background: mod(index, 2) == 0 ? #102030 : #304050;
    }

    // Always instantiated (referencing a conditional element's property from outside its `if`
    // is rejected by the compiler) but hidden unless `focusable`: an invisible item cannot
    // receive TabNavigation focus (`is_visible_or_clipped_by_flickable()` is false), so with
    // `focusable: false` this still counts as one extra traversal step but never gets accepted -
    // preserving the "nothing in the scene is focusable" worst case.
    fs := FocusScope {
        visible: root.focusable;
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
    }
}
