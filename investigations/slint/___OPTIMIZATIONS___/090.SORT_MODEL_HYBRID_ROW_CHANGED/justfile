# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench (baseline + patched).
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Builds the bench against the (already patched) clone and runs the same max_delta sweep used
# in RESULT.md. To compare against baseline, run `just clone && just bench` (skip `apply`)
# first, save the binary, then `just apply && just bench`.
bench:
    cd bench && cargo build --release
    ./bench/target/release/bench_sort_model_row_changed 200000 5000 15 1 0
    ./bench/target/release/bench_sort_model_row_changed 200000 5000 15 1 50
    ./bench/target/release/bench_sort_model_row_changed 200000 5000 15 1 100000
    ./bench/target/release/bench_sort_model_row_changed 200000 5000 15 1 150000

clean:
    rm -rf clone bench/target
