# Self-contained reproduction for this candidate.
#
# Needs a real Qt 6 installed and on PATH (qmake reachable) - the i-slint-backend-qt crate
# links against it at build time. If you don't have a system Qt, aqtinstall works without root,
# e.g.:
#   python3 -m venv /tmp/aqt && /tmp/aqt/bin/pip install aqtinstall
#   /tmp/aqt/bin/aqt install-qt linux desktop 6.5.3 gcc_64 -O /tmp/Qt
#   export PATH="/tmp/Qt/6.5.3/gcc_64/bin:$PATH"
#   export LD_LIBRARY_PATH="/tmp/Qt/6.5.3/gcc_64/lib:$LD_LIBRARY_PATH"
#
# The bench binary itself needs no display: run it with QT_QPA_PLATFORM=offscreen.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"

# Full cycle: clone at the pinned commit, apply the fix + the bench-probe scaffolding, build, run.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Two patches: patch.diff is the actual proposed fix (qt_window.rs's draw_image_direct texture
# cache); bench/bench_probe.patch is measurement-only scaffolding (a `bench-probe` cargo feature
# exposing the otherwise-pub(crate) `image_to_pixmap`/`cached_image_to_pixmap` so this
# out-of-crate probe can time them directly) - never intended to ship, kept separate so
# patch.diff alone is postable as-is (e.g. attached to a GitHub issue/PR).
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"
    cd clone && git apply "{{justfile_directory()}}/bench/bench_probe.patch"

bench:
    cd bench && cargo build --release --target-dir target
    QT_QPA_PLATFORM=offscreen ./bench/target/release/qt_draw_image_direct_probe "{{justfile_directory()}}/testdata/shapes.svg" 128 uncached 200
    QT_QPA_PLATFORM=offscreen ./bench/target/release/qt_draw_image_direct_probe "{{justfile_directory()}}/testdata/shapes.svg" 128 cached 200

clean:
    rm -rf clone bench/target
