+        // `Rgba` arm in the software renderer.
         Image(ImageInner::EmbeddedImage {
             cache_key: ImageCacheKey::Invalid,
-            buffer: SharedImageBuffer::RGBA8(buffer),
+            buffer: SharedImageBuffer::RGBA8Premultiplied(SharedPixelBuffer {
+                width: buffer.width,
+                height: buffer.height,
+                data: buffer.data.into_iter().map(Self::rgba_to_premultiplied_rgba).collect(),
+            }),
         })
     }
 
