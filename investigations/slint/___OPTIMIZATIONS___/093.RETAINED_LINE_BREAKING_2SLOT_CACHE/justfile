# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# This candidate is built ON TOP OF candidates 091 (INCREMENTAL_TYPING_RESHAPE) and 092
# (RETAINED_LINE_BREAKING_ACROSS_RESHAPE): patch.diff bundles all three against pristine
# base_commit, the same "self-contained against master" convention 073/092 used, because a
# dirty range to reuse doesn't exist without 091's incremental reshape, and this candidate's
# whole premise is 092's own "what's not done" finding.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone at the pinned commit, apply the patch, build, run the bench.
test: clone apply bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# perf_test is the project's existing bench harness (see the workspace README.md); it is not
# shipped in this pinned clone, so this recipe expects it to be copied in separately if you want
# to actually run it standalone. The command below is exactly what this candidate was measured
# with, against `<clone>/perf_test` once copied there.
bench:
    cd clone/perf_test && RENDERER=software cargo build --profile rdebug --bin perf_test --features software
    # A: build with 091+092 only (see ../092.RETAINED_LINE_BREAKING_ACROSS_RESHAPE/patch.diff)
    # B: build with 091+092+093 (this patch.diff) -- compare with tools/paired.sh, e.g.:
    #   RUNS=9 FRAMES=8 taskset -c 3 bash ___OPTIMIZATIONS___/tools/paired.sh A B -- \
    #     --mode text --count 10000 --type-text --scroll-step 0
    echo "see comment above: build A (092-only) and B (this patch) and diff with tools/paired.sh"

clean:
    rm -rf clone
