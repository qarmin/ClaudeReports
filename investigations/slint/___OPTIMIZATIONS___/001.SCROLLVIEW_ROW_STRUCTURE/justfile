# This candidate has no patch.diff, and never should: the finding is an app-level `.slint`
# authoring pattern (how to structure a row so a non-virtualized ScrollView doesn't shape
# off-screen text), not a change to the Slint library or any of its dependencies. A patch.diff
# only makes sense against something the reader would apply to their own copy of the *tested*
# project (slint) or a dependency it vendors (e.g. femtovg) - never against the test harness
# itself. `FlatRecordRow`/`ClippedRecordRow` are simply built into the shared harness directly
# (`../harness/perf_test/ui/shared.slint`), the same way any other row style there is - not
# "patched in" to demonstrate a result.
#
# Reproducing the finding is a straight comparison between row styles the harness already offers.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

test: clone build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

build:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test

# RESULT.md's headline number is the FIRST frame (startup cost of shaping every row's text vs.
# only the visible ones), at 100000 rows.
bench:
    @echo "=== layout (Rectangle + HorizontalLayout + 3 Texts - the original row) ==="
    ./clone/target/rdebug/perf_test --bench --mode scroll --count 100000 --row-style layout --frames 3
    @echo "=== flat (same 3 Texts, positioned explicitly) ==="
    ./clone/target/rdebug/perf_test --bench --mode scroll --count 100000 --row-style flat --frames 3
    @echo "=== clipped (layout + clip: true) ==="
    ./clone/target/rdebug/perf_test --bench --mode scroll --count 100000 --row-style clipped --frames 3

clean:
    rm -rf clone
