+
+#[test]
+fn test_sort_model_row_added_index_adjustment() {
+    // `row_added` skips its index-adjustment scan when the rows were appended, because no existing
+    // mapping entry can then need adjusting. This pins that the skip is only taken when it is
+    // correct: inserting in the middle or at the front still has to shift the entries above it.
+    use tests_helper::*;
+
+    for insert_at in [0usize, 3, 7, 10] {
+        let origin = Rc::new(VecModel::from(alloc::vec![50, 10, 40, 20, 30, 90, 60, 80, 70, 0]));
+        let sorted = Rc::new(SortModel::new_ascending(origin.clone()));
+        let checker = ModelChecker::new(sorted.clone());
+
+        // The values are chosen so the new rows land in the middle of the sorted order, which is
+        // where a stale mapping index would show up as a wrong value rather than a panic.
+        origin.insert(insert_at, 35);
+        origin.insert(insert_at, 45);
+        checker.check();
+
+        assert_eq!(
+            (0..sorted.row_count()).filter_map(|row| sorted.row_data(row)).collect::<alloc::vec::Vec<_>>(),
+            alloc::vec![0, 10, 20, 30, 35, 40, 45, 50, 60, 70, 80, 90],
+            "inserting at {insert_at}"
+        );
+    }
+
+    // Appending: the skipped path.
+    let origin = Rc::new(VecModel::from(alloc::vec![50, 10, 40, 20, 30]));
+    let sorted = Rc::new(SortModel::new_ascending(origin.clone()));
+    let checker = ModelChecker::new(sorted.clone());
+    origin.push(35);
+    origin.push(5);
+    origin.push(100);
+    checker.check();
+    assert_eq!(
+        (0..sorted.row_count()).filter_map(|row| sorted.row_data(row)).collect::<alloc::vec::Vec<_>>(),
+        alloc::vec![5, 10, 20, 30, 35, 40, 50, 100]
+    );
+}
