// Standalone bench for candidate 100 (absolute_clip_rect_and_geometry redundant
// recomputation of nested clipping ancestor chains): each ClipChainN wraps a single
// focusable TextInput in N levels of `clip: true` Rectangle. is_visible() (called on
// the focus item by process_mouse_input/process_key_event on every single mouse move
// or key press) walks this whole chain, and the pre-patch implementation recomputed
// overlapping sub-chains recursively - O(2^N) in N. Generated, not hand-written: Slint
// has no recursion, so each nesting depth needs its own unrolled component.
//
// All ClipChainN instances are always present (only the active depth's is `visible`) -
// referencing a conditional element's property from outside its `if` is rejected by
// the compiler (same constraint noted in candidate 055's bench), and an invisible
// item cannot receive TabNavigation focus, so the inactive chains never interfere.

component ClipChain5 inherits Rectangle {
    out property <bool> leaf-has-focus: leaf.has-focus;
    Rectangle {
        clip: true;
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        Rectangle {
            clip: true;
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            Rectangle {
                clip: true;
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                Rectangle {
                    clip: true;
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    Rectangle {
                        clip: true;
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        leaf := TextInput {
                            x: 0px; y: 0px; width: 40px; height: 20px;
                        }
                    }
                }
            }
        }
    }
}

