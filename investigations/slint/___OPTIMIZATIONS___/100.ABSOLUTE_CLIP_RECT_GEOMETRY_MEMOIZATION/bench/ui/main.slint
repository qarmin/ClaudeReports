export component MainWindow inherits Window {
    in property <int> depth: 5;
    out property <bool> leaf-has-focus: c5.leaf-has-focus || c12.leaf-has-focus || c18.leaf-has-focus || c20.leaf-has-focus || c22.leaf-has-focus;
    preferred-width: 200px;
    preferred-height: 200px;
    c5 := ClipChain5 { visible: root.depth == 5; }
    c12 := ClipChain12 { visible: root.depth == 12; }
    c18 := ClipChain18 { visible: root.depth == 18; }
    c20 := ClipChain20 { visible: root.depth == 20; }
    c22 := ClipChain22 { visible: root.depth == 22; }
}
