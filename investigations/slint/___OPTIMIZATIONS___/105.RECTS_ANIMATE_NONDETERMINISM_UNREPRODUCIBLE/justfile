# Self-contained reproduction for this candidate.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# This is an investigation candidate: patch.diff is empty (no product source changed). It re-runs
# `perf_test --bench --mode rects --animate` repeatedly to check whether candidate 102's reported
# run-to-run pixel non-determinism at that scene reproduces. perf_test/ itself is not part of the
# tracked slint repo (an untracked harness maintained across this ___OPTIMIZATIONS___ workspace's
# sessions, including candidate 102's already-permanent BenchPlatform virtual-clock fix in
# `perf_test/src/bench.rs`) - clone it from the same origin this session used.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

test: clone apply check

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

# patch.diff is empty - nothing to apply to the cloned repo's tracked history. perf_test/ (with
# candidate 102's BenchPlatform virtual-clock fix already permanently in place) needs to come from
# your own checkout's untracked perf_test/ directory, copied into clone/perf_test, to reproduce
# this exactly.
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Reproduces this candidate's RESULT.md table: repeated `--bench --mode rects --animate` snapshots
# at the exact frame count (30) candidate 102 reported the largest divergence (12908px) at,
# compared by hash. This session found all hashes identical (1 distinct hash across 20-30 runs);
# candidate 102 reported thousands of differing pixels at this same scenario.
check:
    cd clone/perf_test && cargo build --bin perf_test --profile rdebug --features software
    mkdir -p /tmp/105_check
    for r in $(seq 1 20); do \
        ./clone/target/rdebug/perf_test --bench --mode rects --animate --count 2000 --frames 30 \
            --snapshot /tmp/105_check/r$r.ppm >/dev/null; \
    done
    @echo "Distinct hashes across 20 runs (1 = fully deterministic in this environment):"
    sha256sum /tmp/105_check/r*.ppm | awk '{print $1}' | sort -u | wc -l

clean:
    rm -rf clone
