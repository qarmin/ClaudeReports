+// Rebuilds `reverse_mapping` (row -> position in `mapping`) from scratch. O(n), same order as
+// the sort / bulk-splice operations that already dominate the callers of this function.
+fn rebuild_reverse_mapping(mapping: &[usize], reverse_mapping: &mut Vec<usize>) {
+    reverse_mapping.clear();
+    reverse_mapping.resize(mapping.len(), 0);
+    for (position, &row) in mapping.iter().enumerate() {
+        reverse_mapping[row] = position;
+    }
