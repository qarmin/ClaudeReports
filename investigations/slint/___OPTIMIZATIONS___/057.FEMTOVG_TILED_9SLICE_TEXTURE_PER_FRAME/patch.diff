+/// Identifies a clipped/tiled texture derived from a base image, so that repeated
+/// draws of the same source with the same tiling geometry can reuse one GPU texture
+/// instead of re-blitting it on every frame.
+#[derive(PartialEq, Eq, Hash)]
+pub struct TiledTextureCacheKey {
+    source_image_id: femtovg::ImageId,
+    clip_rect: IntRect,
+    texture_width: usize,
+    texture_height: usize,
+    rendering: ImageRendering,
+}
+
+impl TiledTextureCacheKey {
+    pub fn new(
+        source_image_id: femtovg::ImageId,
+        clip_rect: IntRect,
+        texture_width: usize,
+        texture_height: usize,
+        rendering: ImageRendering,
+    ) -> Self {
+        Self { source_image_id, clip_rect, texture_width, texture_height, rendering }
+    }
+}
+
+// Cache for the clipped/tiled textures created by `draw_image_impl` for
+// `ImageTiling::Repeat`/`Round`. Unlike `TextureCache`, nothing outside of this cache
+// keeps these textures alive, so entries are retained across frames by marking them
+// used on lookup and pruning whatever wasn't looked up in `drain()` (called once per
+// frame, mirroring `TextureCache::drain()`).
+pub struct TiledTextureCache<R: femtovg::Renderer + TextureImporter>(
+    HashMap<TiledTextureCacheKey, (Rc<Texture<R>>, bool)>,
+);
+
+impl<R: femtovg::Renderer + TextureImporter> Default for TiledTextureCache<R> {
+    fn default() -> Self {
+        Self(Default::default())
+    }
+}
+
+impl<R: femtovg::Renderer + TextureImporter> TiledTextureCache<R> {
+    pub(crate) fn lookup_or_create(
+        &mut self,
+        cache_key: TiledTextureCacheKey,
+        image_create_fn: impl FnOnce() -> Option<Rc<Texture<R>>>,
+    ) -> Option<Rc<Texture<R>>> {
+        if let Some((texture, used)) = self.0.get_mut(&cache_key) {
+            *used = true;
+            return Some(texture.clone());
+        }
+        let new_texture = image_create_fn()?;
+        self.0.insert(cache_key, (new_texture.clone(), true));
+        Some(new_texture)
+    }
+
+    pub(crate) fn drain(&mut self) {
+        self.0.retain(|_, (_, used)| core::mem::take(used));
+    }
+
+    pub(crate) fn clear(&mut self) {
+        self.0.clear();
+    }
+}
