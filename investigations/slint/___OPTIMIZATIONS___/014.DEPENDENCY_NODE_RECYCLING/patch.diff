+    /// A pool of unlinked nodes kept for reuse, owned by the caller rather than by any one list.
+    ///
+    /// A binding re-reads the same properties every time it is evaluated, so freeing its whole
+    /// dependency list and allocating an identical one on the next evaluation is pure churn -- and
+    /// that is where essentially all of a frame's allocations come from (92-100% of every scene
+    /// measured). [`SingleLinkedListPinHead::recycle_into`] unlinks the nodes without giving the
+    /// memory back, and [`SingleLinkedListPinHead::push_front`] takes from the pool first.
+    ///
+    /// The pool is deliberately *not* a second chain inside the list head: `PropertyTracker`'s
+    /// layout is mirrored by `PropertyTrackerOpaque` for the C++ API, so the head has to stay one
+    /// pointer wide. Sharing one pool across all bindings is also better than one each - a binding
+    /// that shrinks hands its nodes to the others instead of sitting on them.
+    pub struct NodePool<T>(NodePtr<T>);
+
+    impl<T> NodePool<T> {
+        pub const fn new() -> Self {
+            Self(None)
+        }
+    }
+
+    impl<T> Default for NodePool<T> {
+        fn default() -> Self {
+            Self::new()
+        }
+    }
+
+    impl<T> Drop for NodePool<T> {
+        fn drop(&mut self) {
+            free_chain(self.0.take());
+        }
+    }
+
+    /// Frees a chain of nodes, dropping each value in place first.
+    fn free_chain<T>(mut cur: NodePtr<T>) {
+        // Iterative to avoid stack overflow on long chains.
+        while let Some(node) = cur {
+            // Safety: we own this node; drop_in_place keeps the value at its pinned address.
+            unsafe {
+                cur = (*node.as_ptr()).next;
+                core::ptr::drop_in_place(&raw mut (*node.as_ptr()).value);
+                alloc::alloc::dealloc(
+                    node.as_ptr().cast(),
+                    core::alloc::Layout::new::<SingleLinkedListPinNode<T>>(),
+                );
+            }
+        }
+    }
