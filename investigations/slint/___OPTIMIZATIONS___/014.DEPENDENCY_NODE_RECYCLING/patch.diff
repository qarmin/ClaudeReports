 type DependencyListHead = dependency_tracker::DependencyListHead<*const BindingHolder>;
 type DependencyNode = dependency_tracker::DependencyNode<*const BindingHolder>;
+type NodePool = single_linked_list_pin::NodePool<DependencyNode>;
+
+/// Unlinked dependency nodes kept for reuse, shared by every binding on this thread.
+///
+/// See [`single_linked_list_pin::NodePool`] for why it lives here rather than inside each list.
+/// Follows the same `std` / `unsafe-single-threaded` split as [`current_binding_storage`].
+pub(crate) mod node_pool {
+    use super::NodePool;
+    use core::cell::RefCell;
+
+    #[cfg(feature = "std")]
+    std::thread_local! {
+        static POOL: RefCell<NodePool> = RefCell::new(NodePool::default());
+    }
+
+    #[cfg(feature = "std")]
+    pub(super) fn with<R>(f: impl FnOnce(&mut NodePool) -> R) -> R {
+        // A thread-local destructor can run while a binding is still being torn down; falling back
+        // to a fresh pool then just means those nodes are allocated and freed normally.
+        match POOL.try_with(|pool| pool.as_ptr()) {
+            // Safety: the pool is thread-local and `f` cannot re-enter `with` - `push_front` and
+            // `recycle_into` only touch the nodes.
+            Ok(pool) => f(unsafe { &mut *pool }),
+            // A thread-local destructor can run while a binding is still being torn down; falling
+            // back to a fresh pool then just means those nodes are allocated and freed normally.
+            Err(_) => f(&mut NodePool::default()),
+        }
+    }
+
+    #[cfg(not(feature = "std"))]
+    struct PoolCell(RefCell<NodePool>);
+    // Safety: the unsafe-single-threaded feature means only one thread accesses this
+    #[cfg(not(feature = "std"))]
+    unsafe impl Send for PoolCell {}
+    #[cfg(not(feature = "std"))]
+    unsafe impl Sync for PoolCell {}
+
+    #[cfg(not(feature = "std"))]
+    static POOL: PoolCell = PoolCell(RefCell::new(NodePool::new()));
+
+    #[cfg(not(feature = "std"))]
+    pub(super) fn with<R>(f: impl FnOnce(&mut NodePool) -> R) -> R {
+        f(&mut POOL.0.borrow_mut())
+    }
+}
 
