+            head.push_front(x, &mut pool);
+        }
+        // Same three allocations, new values: nothing was returned to the allocator.
+        let mut second_round = addresses(&head);
+        second_round.sort_unstable();
+        assert_eq!(first_round, second_round);
+        assert_eq!(
+            head.iter().map(|x: Pin<&i32>| *x.get_ref()).collect::<std::vec::Vec<i32>>(),
+            std::vec![6, 5, 4]
