# Self-contained reproduction for candidate 098.TEXTINPUT_VERTICALLAYOUT_NOWRAP_FASTPATH.
# harness note (added by a bulk fix - see ../README.md's "Reproducing a candidate
# standalone" section): perf_test is untracked in the main repo, so `clone:` below now
# copies it in from ../harness/perf_test automatically - no manual copy step needed.
# femtovg is cloned fresh too (perf_test's Cargo.toml unconditionally patches it).
#
# `patch.diff` touches only the main slint tree (internal/core/items/text.rs). `perf_test/` is
# untracked in the main slint repo - `clone:` copies it in from ../harness/perf_test, which
# already has `RowStyle.vertical-fixed-input` (and 070's `vertical-fixed`) built in - no overlay
# needed. Headless software renderer (`--bench`), no display needed.

repo_url := "https://github.com/slint-ui/slint.git"
base_commit := "cdb6c43f7ba9826cf0ec453d6e09c5a9a6975f25"
femtovg_repo_url := "https://github.com/femtovg/femtovg"
femtovg_base_commit := "df54a3c880863582f4338afa26a44fea3398b880"

# Full cycle: clone, build a BASELINE binary before touching anything, apply the patch, build a
# PATCHED binary, then run both and print both results.
test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    git clone {{femtovg_repo_url}} clone/femtovg
    cd clone/femtovg && git checkout {{femtovg_base_commit}}
    cp -r "{{justfile_directory()}}/../harness/perf_test" clone/perf_test

build-baseline:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test
    cp clone/target/rdebug/perf_test ./perf_test_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/perf_test && cargo build --profile rdebug --bin perf_test
    cp clone/target/rdebug/perf_test ./perf_test_patched

bench:
    @echo "=== baseline ==="
    ./perf_test_baseline --bench --mode scroll --row-style vertical-fixed-input --count 20000 --frames 3
    @echo "=== patched (font-metrics fast path for TextInput) ==="
    ./perf_test_patched --bench --mode scroll --row-style vertical-fixed-input --count 20000 --frames 3

# Correctness probe: a VerticalLayout of fixed-width NoWrap TextInputs covering the styling axes
# candidate 070 checked, plus a password-masking case specific to TextInput. Drop into
# clone/perf_test/src/bin/ (register it in Cargo.toml's [[bin]] list if the manifest lists bins
# explicitly) and run against a baseline-built and a patched-built i-slint-core; the printed
# FNV-1a pixel hash must match. See probe/textinput_probe.rs and RESULT.md.
probe:
    @echo "See probe/textinput_probe.rs - drop it into clone/perf_test/src/bin/ to rerun the confirmation."

clean:
    rm -rf clone perf_test_baseline perf_test_patched
