import { Palette } from "std-widgets.slint";

// A grid of layout containers, to measure the layout solver itself rather than what it lays out.
// Children are plain rectangles with no text, so nothing here shapes: the only variable is how much
// work the solver does for a given number of children and a given layout kind.
//
// Nothing else in this project isolates the solver. `scroll --row-style layout` measures a layout
// *and* three `Text` items, and candidate 44 showed the text dominates.
export component LayoutModePage inherits Rectangle {
    // How many containers.
    in property <int> count;
    // How many children in each container.
    in property <int> children-count: 4;
    // 0 = HorizontalLayout, 1 = VerticalLayout, 2 = GridLayout, 3 = no layout (explicit positions).
    in property <int> kind;
    // Give one child `horizontal-stretch`, so the solver has space to distribute rather than a
    // sequence of fixed boxes.
    in property <bool> stretch;
    in-out property <length> scroll-y;

    property <length> cell-width: 200px;
    property <length> cell-height: 40px;
    property <int> columns: max(1, floor(self.width / self.cell-width));

    clip: true;

    for index in root.count: Rectangle {
        x: mod(index, root.columns) * root.cell-width;
        y: floor(index / root.columns) * root.cell-height + mod(root.scroll-y, root.cell-height);
        width: root.cell-width - 4px;
        height: root.cell-height - 4px;
        background: mod(index, 2) == 0 ? Palette.alternate-background : Palette.control-background;

        if root.kind == 0: HorizontalLayout {
            spacing: 2px;
            for child in root.children-count: Rectangle {
                width: 20px;
                horizontal-stretch: root.stretch && child == 0 ? 1 : 0;
                background: Palette.accent-background;
            }
        }

        if root.kind == 1: VerticalLayout {
            spacing: 2px;
            for child in root.children-count: Rectangle {
                height: 4px;
                vertical-stretch: root.stretch && child == 0 ? 1 : 0;
                background: Palette.accent-background;
            }
        }

        if root.kind == 2: GridLayout {
            spacing: 2px;
            Row {
                for child in root.children-count: Rectangle {
                    width: 20px;
                    horizontal-stretch: root.stretch && child == 0 ? 1 : 0;
                    background: Palette.accent-background;
                }
            }
        }

        // The control: the same children, positioned explicitly, so the difference is the solver.
        if root.kind == 3: Rectangle {
            for child in root.children-count: Rectangle {
                x: child * 22px;
                y: 0;
                width: 20px;
                height: parent.height;
                background: Palette.accent-background;
            }
        }
    }
}
