+/// A slab-like arena that hands out `usize` indices for inserted values, like `slab::Slab`, but
+/// (unlike `slab::Slab`'s single contiguous, reallocating `Vec`) never moves an already-inserted
+/// value in memory for as long as it stays occupied: growth only ever appends a new,
+/// independently heap-allocated fixed-size chunk (existing chunks, and everything in them, are
+/// left untouched), and freeing a slot drops its value in place instead of moving it out.
+///
+/// This is required so `PartialRenderingCachedData`'s `PropertyTracker` fields can live inline
+/// (unboxed) below: `PropertyTracker` is `!Unpin` and self-referential (once
+/// `register_as_dependency_to_current_binding` runs, the property being read stores a raw
+/// pointer back into this tracker's own memory), so moving a live one anywhere - even
+/// transiently on the way to being dropped - would leave that external pointer dangling. See
+/// `___OPTIMIZATIONS___/071.INLINE_GEOM_TRACKER` for a build that stored the tracker inline in
+/// `slab::Slab` directly and crashed for exactly this reason.
+mod chunked_arena {
+    use alloc::boxed::Box;
+    use alloc::vec::Vec;
+
+    const CHUNK_SIZE: usize = 256;
+
+    enum Slot<T> {
+        /// Not occupied; holds the index of the next vacant slot (or `chunks.len() * CHUNK_SIZE`,
+        /// i.e. one past the end, if this was the last slot handed out by `grow()` so far).
+        Vacant(usize),
+        Occupied(T),
+    }
+
+    pub struct ChunkedArena<T> {
+        chunks: Vec<Box<[Slot<T>; CHUNK_SIZE]>>,
+        next_free: usize,
+    }
+
+    impl<T> Default for ChunkedArena<T> {
+        fn default() -> Self {
+            Self { chunks: Vec::new(), next_free: 0 }
+        }
+    }
+
+    impl<T> ChunkedArena<T> {
+        fn slot_mut(&mut self, index: usize) -> Option<&mut Slot<T>> {
+            self.chunks.get_mut(index / CHUNK_SIZE)?.get_mut(index % CHUNK_SIZE)
+        }
+
+        fn grow(&mut self) {
+            let base = self.chunks.len() * CHUNK_SIZE;
+            self.chunks.push(Box::new(core::array::from_fn(|i| Slot::Vacant(base + i + 1))));
+        }
+
+        /// Inserts `value` and returns its index. `value` itself is moved once here, which is
+        /// only sound because a just-constructed value (e.g. a fresh `PropertyTracker`) has not
+        /// yet had any dependency registered against its address - see this module's docs.
+        pub fn insert(&mut self, value: T) -> usize {
+            if self.next_free >= self.chunks.len() * CHUNK_SIZE {
+                self.grow();
+            }
+            let index = self.next_free;
+            let next_free = match self.slot_mut(index).expect("just grown, index is in bounds") {
+                Slot::Vacant(next) => *next,
+                Slot::Occupied(_) => unreachable!("free list points at an occupied slot"),
+            };
+            *self.slot_mut(index).expect("checked above") = Slot::Occupied(value);
+            self.next_free = next_free;
+            index
+        }
+
+        pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
+            match self.slot_mut(index)? {
+                Slot::Occupied(value) => Some(value),
+                Slot::Vacant(_) => None,
+            }
+        }
+
+        /// Drops the value at `index` in place and returns the slot to the free list. Never
+        /// moves the value (unlike e.g. `slab::Slab::remove`, which hands the removed value back
+        /// by value) - required for soundness, see this module's docs.
+        #[allow(unsafe_code)]
+        pub fn free(&mut self, index: usize) {
+            let next_free = self.next_free;
+            let slot = self.slot_mut(index).expect("free() of an out-of-range index");
+            if matches!(slot, Slot::Vacant(_)) {
+                panic!("double free of a chunked_arena slot");
+            }
+            // Safety: `slot` is `Slot::Occupied(value)` (checked above). `ptr::drop_in_place`
+            // runs `value`'s destructor at its permanent address without moving it anywhere
+            // first, satisfying `Pin`'s contract for the whole time a dependency could have been
+            // registered against it. The following `ptr::write` only overwrites bytes that are
+            // now logically uninitialized since the destructor already ran - the same thing safe
+            // code does implicitly on every `*place = new_value` that drops an old value in place.
+            unsafe {
+                let ptr = slot as *mut Slot<T>;
+                if let Slot::Occupied(value) = &mut *ptr {
+                    core::ptr::drop_in_place(value as *mut T);
+                }
+                core::ptr::write(ptr, Slot::Vacant(next_free));
+            }
+            self.next_free = index;
+        }
+
+        /// Drops every occupied value in place - safe because `Vec::clear` drops its elements in
+        /// place without ever moving them (same as dropping the whole `ChunkedArena`).
+        pub fn clear(&mut self) {
+            self.chunks.clear();
+            self.next_free = 0;
+        }
+    }
+}
