+/// The stops of a Slint gradient as femtovg wants them, with the extra stop at 1.0 that femtovg
+/// needs to keep the last color from being extrapolated.
+///
+/// Returns an iterator instead of a `Vec`: femtovg's `*_gradient_stops` take
+/// `impl IntoIterator`, and this runs once per gradient-filled primitive per frame, so the
+/// collect was one allocation per primitive for nothing. The stops iterator is walked twice
+/// (once for the last stop, once for the values), which is cheap - gradients have a handful of
+/// stops.
+fn gradient_stops<'a>(
+    stops: impl Iterator<Item = &'a i_slint_core::graphics::GradientStop> + Clone,
+) -> impl Iterator<Item = (f32, femtovg::Color)> {
+    let extra = stops
+        .clone()
+        .last()
+        .filter(|last| last.position != 1.0)
+        .map(|last| (1.0, to_femtovg_color(&last.color)));
+    stops.map(|stop| (stop.position, to_femtovg_color(&stop.color))).chain(extra)
+}
