+/// Whether `bounds` (the union of a `Clip` item's children's own bounding rects, in the same
+/// coordinate space as `clip_rect`) reaches into any of the four corner squares that `radius`
+/// actually rounds off. If none of the four do, a rounded clip of `clip_rect`/`radius` and a plain
+/// rectangular clip of `clip_rect` produce identical pixels, since a rounded rect and its bounding
+/// rect only ever differ inside those corner squares.
+fn corner_box_reachable(
+    bounds: LogicalRect,
+    clip_rect: LogicalRect,
+    radius: LogicalBorderRadius,
+) -> bool {
+    let corner_touches = |x: i_slint_core::Coord, y: i_slint_core::Coord, r: i_slint_core::Coord| {
+        r > 0 as i_slint_core::Coord
+            && bounds.intersects(&LogicalRect::new(LogicalPoint::new(x, y), LogicalSize::new(r, r)))
+    };
+    corner_touches(clip_rect.origin.x, clip_rect.origin.y, radius.top_left)
+        || corner_touches(
+            clip_rect.max_x() - radius.top_right,
+            clip_rect.origin.y,
+            radius.top_right,
+        )
+        || corner_touches(
+            clip_rect.max_x() - radius.bottom_right,
+            clip_rect.max_y() - radius.bottom_right,
+            radius.bottom_right,
+        )
+        || corner_touches(
+            clip_rect.origin.x,
+            clip_rect.max_y() - radius.bottom_left,
+            radius.bottom_left,
+        )
+}
