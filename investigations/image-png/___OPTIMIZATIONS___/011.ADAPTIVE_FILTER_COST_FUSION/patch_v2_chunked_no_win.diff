+/// Same selection logic as [`adaptive_filter`], specialized for a per-byte additive cost (the
+/// `sum_buffer` heuristic used by [`Filter::Adaptive`]). Unlike `adaptive_filter`, the cost of
+/// each candidate row is accumulated while `filter_internal_with_cost` writes `output`, instead
+/// of a second full traversal of `output` afterwards - `sum_buffer`'s cost is exactly the sum of
+/// a per-byte function, so it can be folded into the write loop without changing the result.
+fn adaptive_filter_sum(
+    bpp: usize,
+    len: usize,
+    previous: &[u8],
+    current: &[u8],
+    output: &mut [u8],
+) -> RowFilter {
+    use RowFilter::*;
+
+    #[inline(always)]
+    fn byte_cost(b: u8) -> u64 {
+        u64::from((b as i8).unsigned_abs())
+    }
+
+    let mut min_cost: u64 = u64::MAX;
+    let mut filter_choice = RowFilter::NoFilter;
+    for &filter in [Up, Sub, Avg, Paeth].iter() {
+        let (_, cost) =
+            filter_internal_with_cost(filter, bpp, len, previous, current, output, byte_cost);
+        if cost <= min_cost {
+            min_cost = cost;
+            filter_choice = filter;
+
+            if cost == 0 {
+                return filter_choice;
+            }
+        }
+    }
+    if filter_choice != Paeth {
+        filter_internal(filter_choice, bpp, len, previous, current, output);
+    }
+    filter_choice
+}
