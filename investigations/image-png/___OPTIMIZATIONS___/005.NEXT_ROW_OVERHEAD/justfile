# Self-contained reproduction for this candidate.
#
# Pure measurement/characterization - no patch.diff, `read_row` is already shipped public API.
# `just test` clones the repo at base_commit, builds the standalone bench (./bench/, depending on
# `{ path = "../clone" }` rewritten below), and runs it against 3 real corpus files spanning the
# row-count range.

repo_url := "https://github.com/image-rs/image-png.git"
base_commit := "05ccdb9c8ae7fc50f4787ba2888a1c515adad944"

test: clone build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/bench" clone/bench
    sed -i 's|path = "../../.."|path = ".."|' clone/bench/Cargo.toml

build:
    cd clone/bench && cargo build --release

bench:
    @echo "=== next_row/next_interlaced_row overhead over read_row (rotated per iteration) ==="
    ulimit -c 0 && ./clone/bench/target/release/next_row_overhead_bench --iters 300 --input clone/tests/benches/kodim02.png
    ulimit -c 0 && ./clone/bench/target/release/next_row_overhead_bench --iters 300 --input "clone/tests/benches/Lohengrin_-_Illustrated_Sporting_and_Dramatic_News.png"
    ulimit -c 0 && ./clone/bench/target/release/next_row_overhead_bench --iters 2000 --input clone/tests/benches/tango-icon-address-book-new-16.png

clean:
    rm -rf clone
