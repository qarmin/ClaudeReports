# Self-contained reproduction for this candidate.
#
# This is a pure measurement/characterization - no patch.diff, because DecodeOptions::ignore_crc
# already exists in shipped code and needs no source change to compare against. `just test` clones
# the repo at base_commit, builds the standalone bench (./bench/, depending on `{ path = "../clone" }`
# rewritten below), and runs it once - the bench itself does the ignore_crc=true/false comparison
# internally (alternating per iteration), so there's no separate baseline/patched build step here.

repo_url := "https://github.com/image-rs/image-png.git"
base_commit := "05ccdb9c8ae7fc50f4787ba2888a1c515adad944"

test: clone build bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    cp -r "{{justfile_directory()}}/bench" clone/bench
    sed -i 's|path = "../../.."|path = ".."|' clone/bench/Cargo.toml

build:
    cd clone/bench && cargo build --release

bench:
    @echo "=== CRC verification cost on the decode path (ignore_crc=false vs true, alternated per iteration) ==="
    ulimit -c 0 && ./clone/bench/target/release/crc_cost_bench --corpus clone/tests/benches --iters 60

clean:
    rm -rf clone
