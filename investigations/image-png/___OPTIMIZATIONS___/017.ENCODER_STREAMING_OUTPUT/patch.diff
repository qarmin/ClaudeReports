+/// Which kind of PNG chunk a [`ChunkStreamWriter`] is currently emitting into.
+enum ChunkSink<'a> {
+    Idat,
+    Fdat(&'a mut u32),
+}
+
+/// Buffers compressed image data and emits it as a sequence of IDAT/fdAT chunks as soon as
+/// [`STREAM_CHUNK_CAP`] bytes have accumulated, instead of requiring the whole compressed stream
+/// to be held in memory before any chunk can be written.
+struct ChunkStreamWriter<'a, 'w, W: Write> {
+    w: &'w mut W,
+    kind: ChunkSink<'a>,
+    buffer: Vec<u8>,
+}
+
+const STREAM_CHUNK_CAP: usize = 64 * 1024;
+
+impl<'a, 'w, W: Write> ChunkStreamWriter<'a, 'w, W> {
+    fn new(w: &'w mut W, kind: ChunkSink<'a>) -> Self {
+        ChunkStreamWriter {
+            w,
+            kind,
+            buffer: Vec::with_capacity(STREAM_CHUNK_CAP),
+        }
+    }
+
+    /// Writes out whatever is currently buffered as one chunk, if any.
+    fn flush_chunk(&mut self) -> Result<()> {
+        if self.buffer.is_empty() {
+            return Ok(());
+        }
+        match &mut self.kind {
+            ChunkSink::Idat => write_chunk(&mut *self.w, chunk::IDAT, &self.buffer)?,
+            ChunkSink::Fdat(sequence_number) => {
+                write_fdat_chunk(&mut *self.w, **sequence_number, &self.buffer)?;
+                **sequence_number = sequence_number.wrapping_add(1);
+            }
+        }
+        self.buffer.clear();
+        Ok(())
+    }
+}
+
+impl<W: Write> Write for ChunkStreamWriter<'_, '_, W> {
+    fn write(&mut self, mut data: &[u8]) -> io::Result<usize> {
+        let total = data.len();
+        while !data.is_empty() {
+            let space = STREAM_CHUNK_CAP - self.buffer.len();
+            let take = space.min(data.len());
+            self.buffer.extend_from_slice(&data[..take]);
+            data = &data[take..];
+            if self.buffer.len() == STREAM_CHUNK_CAP {
+                self.flush_chunk()?;
+            }
+        }
+        Ok(total)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
