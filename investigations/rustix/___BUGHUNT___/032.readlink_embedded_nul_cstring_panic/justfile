# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# A genuine end-to-end repro (a real FUSE daemon, or a mounted corrupted on-disk image, making
# the real `readlink(2)` syscall return bytes with an embedded NUL) was found infeasible in the
# sandboxed container this candidate was investigated in (no /dev/fuse, no root, no loop devices,
# blocked unprivileged user namespaces - see RESULT.md section 11 justification). `mock.patch`
# stands in for that unavailable second participant: it mocks only the single lowest-level
# syscall wrapper for one magic path, in the cloned source, before building - every other line
# exercised (rustix::fs::readlink's real public API, the real `_readlink` loop, the real
# `CString::new(...).unwrap()`) is the exact, unmodified source being tested.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, mock the syscall boundary, prove the bug exists, apply the real
# fix, prove it's gone.
test: clone mock reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Mock only the syscall boundary (stands in for the FUSE daemon / corrupted on-disk image this
# sandbox can't run for real) - never the vulnerable `_readlink` logic itself.
mock:
    cd clone && git apply "{{justfile_directory()}}/mock.patch"

# Build+run the standalone repro against the pristine (mocked-syscall-only) clone - should panic.
# (prefixed with `-`: this step is EXPECTED to exit non-zero/panic - that's the bug reproducing -
# `just` must not treat that as a reason to abort the rest of the `test` chain)
reproduce-before:
    -ulimit -c 0 && cd repro && cargo run

# Apply the real fix (to the unmodified `_readlink` logic, on top of the syscall mock).
apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic.
reproduce-after:
    ulimit -c 0 && cd repro && cargo run

clean:
    rm -rf clone repro/target
