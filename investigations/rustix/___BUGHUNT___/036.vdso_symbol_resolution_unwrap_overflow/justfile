# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# The affected code (`Vdso`/`Vdso::sym()`) is `pub(super)` with no public entry point at all (see
# repro/README.md) - so there's no standalone external `repro/` crate here. Instead,
# `repro/add_test.patch` adds one `#[cfg(test)]` test directly into the clone's own
# `src/backend/linux_raw/vdso.rs`, and this justfile runs that test via `cargo test` against the
# clone.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, add the repro test, prove the bug exists, apply the fix, prove it's gone.
test: clone add-test reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

add-test:
    cd clone && git apply "{{justfile_directory()}}/repro/add_test.patch"

# Should FAIL (panic) on the pristine (unpatched) tree - that's the bug.
reproduce-before:
    cd clone && cargo test --lib --features time,stdio,fs backend::vdso::tests::test_vdso_sym_overflow || true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Should now PASS (no panic, returns a null pointer) on the patched tree.
reproduce-after:
    cd clone && cargo test --lib --features time,stdio,fs backend::vdso::tests::test_vdso_sym_overflow

clean:
    rm -rf clone
