+
+    /// Resolve a candidate symbol's `st_value` into a usable address,
+    /// returning `None` if the address space arithmetic overflows (a bogus
+    /// `st_value` from a corrupted/adversarial vDSO) or if the resulting
+    /// address falls outside the vDSO's own loaded range - both are treated
+    /// identically as "this symbol can't be trusted", since there's no
+    /// `sum` to compare against `load_addr`/`load_end` at all when the
+    /// address computation itself overflowed.
+    unsafe fn checked_sym_addr(&self, st_value: usize) -> Option<*mut c::c_void> {
+        let sum = self.addr_from_elf(st_value)?;
+        if sum as usize >= self.load_addr as usize && sum as usize <= self.load_end as usize {
+            Some(sum as *mut c::c_void)
+        } else {
+            None
+        }
+    }
