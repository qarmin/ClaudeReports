# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Like candidate 081, this bug lives entirely inside rustix's own test code (unit-test and
# integration-test, both unreachable through any public API), so `repro/check.sh` operates
# directly on a path to a rustix checkout (the `./clone` this justfile produces) rather than
# being its own separate Cargo crate with rustix as a path dependency.
#
# Requires: a `wasm32-wasip1` Rust target (installed automatically by `repro/check.sh` via
# `rustup target add wasm32-wasip1` - prebuilt std, no nightly/`-Zbuild-std` needed).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build the real, unmodified rustix test suite for the real wasm32-wasip1 target against the
# pristine clone - should fail to compile with st_atime/st_mtime/st_ctime field errors
# attributed to tests/fs/negative_timestamp.rs and tests/fs/y2038.rs.
reproduce-before:
    bash repro/check.sh clone

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same check again, now against the patched clone - the st_atime/st_mtime/st_ctime errors in
# tests/fs/negative_timestamp.rs and tests/fs/y2038.rs should be gone (the separate,
# already-recorded candidate 081 instance in src/fs/constants.rs, and other unrelated
# pre-existing wasi gaps, are expected to remain - see RESULT.md).
reproduce-after:
    bash repro/check.sh clone

clean:
    rm -rf clone
