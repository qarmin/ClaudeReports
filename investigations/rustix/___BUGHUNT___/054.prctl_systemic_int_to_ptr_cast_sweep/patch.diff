+/// Build a `*mut c_void` whose bit pattern is `value`, for `prctl` operand
+/// slots where the kernel reinterprets the argument as an integer and never
+/// dereferences it (e.g. sub-operation codes, capability/feature numbers,
+/// lengths, pids). This exists purely to smuggle an integer through an
+/// FFI signature typed as a pointer.
+///
+/// A bare `value as *mut c_void` cast fabricates a pointer with no real
+/// provenance, which Miri's strict-provenance checks reject as UB even
+/// though the pointer is never dereferenced. `core::ptr::without_provenance_mut`
+/// is the strict-provenance-safe way to build one, but it wasn't stabilized
+/// until Rust 1.84, newer than this crate's MSRV — so it's only used under
+/// Miri (which always runs on a recent nightly); real (non-Miri) builds keep
+/// the plain integer-to-pointer cast, byte-for-byte unchanged.
+#[inline]
+pub(crate) fn int_to_ptr(value: usize) -> *mut c_void {
+    #[cfg(miri)]
+    {
+        core::ptr::without_provenance_mut(value)
+    }
+    #[cfg(not(miri))]
+    {
+        value as *mut c_void
+    }
+}
+
 #[inline]
 pub(crate) unsafe fn prctl_1arg(option: c_int) -> io::Result<c_int> {
     const NULL: *mut c_void = null_mut();
