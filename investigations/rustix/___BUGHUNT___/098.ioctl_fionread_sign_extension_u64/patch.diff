diff --git a/src/io/ioctl.rs b/src/io/ioctl.rs
index 33bf07cf..d7f69f04 100644
--- a/src/io/ioctl.rs
+++ b/src/io/ioctl.rs
@@ -93,6 +93,10 @@ pub fn ioctl_fionread<Fd: AsFd>(fd: Fd) -> io::Result<u64> {
     // SAFETY: `FIONREAD` is a getter opcode that gets a `c_int`.
     unsafe {
         let ctl = ioctl::Getter::<{ c::FIONREAD }, c::c_int>::new();
-        ioctl::ioctl(fd, ctl).map(|n| n as u64)
+        // `n` may be a negative `c_int` produced by the OS truncating/wrapping a count that
+        // doesn't fit in 32 bits (see the doc comment above). Go through `u32` first so that
+        // case degrades to the documented wrapped value instead of sign-extending into a
+        // value near `u64::MAX`.
+        ioctl::ioctl(fd, ctl).map(|n| n as u32 as u64)
     }
 }
