# Self-contained reproduction for candidate 063
# (ucred_niche_violation_scm_credentials).
#
# The actual bug only manifests as Undefined Behavior under Miri (it's a
# construct-an-invalid-niche-value bug, not an externally visible crash in a
# plain build - see RESULT.md section "Confirmation" for why). So, unlike
# the default template, `reproduce-before`/`reproduce-after` here run the
# Miri binary and assert on its exit code; `reproduce-real` (not part of the
# default `test` chain) separately runs the real end-to-end socketpair
# binary for supporting evidence, which never fails either before or after
# the fix (see its own module doc comment).
#
# Requires a nightly toolchain with the `miri` component installed
# (`rustup component add miri --toolchain nightly`).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists under Miri, apply the
# fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the Miri check against the pristine clone - should abort with
# "constructing invalid value ... encountered 0, but expected something
# greater or equal to 1".
reproduce-before:
    ulimit -c 0 && cd repro && \
    RUSTFLAGS="--cfg rustix_no_linux_raw" MIRIFLAGS="-Zmiri-disable-stacked-borrows" \
    cargo +nightly miri run --bin miri_check; \
    test $? -ne 0 && echo "REPRODUCED (Miri aborted, as expected pre-fix)" || \
    (echo "DID NOT REPRODUCE - unexpected, investigate" && exit 1)

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same Miri check again, now against the patched clone - should run clean
# (prints "FIXED: pid=0 credentials message was safely skipped", exit 0).
reproduce-after:
    ulimit -c 0 && cd repro && \
    RUSTFLAGS="--cfg rustix_no_linux_raw" MIRIFLAGS="-Zmiri-disable-stacked-borrows" \
    cargo +nightly miri run --bin miri_check

# Supporting evidence only (not part of `test`): the real end-to-end
# socketpair/sendmsg/recvmsg capture. Never fails either before or after the
# fix - the bug it's demonstrating is invisible outside Miri by nature; read
# its printed BUG:/FIXED: line instead of its exit code.
reproduce-real:
    cd repro && cargo run --bin end_to_end

clean:
    rm -rf clone
