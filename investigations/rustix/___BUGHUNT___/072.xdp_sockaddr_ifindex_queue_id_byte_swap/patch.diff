diff --git a/src/backend/libc/net/read_sockaddr.rs b/src/backend/libc/net/read_sockaddr.rs
index 5f8c48ec..911cd105 100644
--- a/src/backend/libc/net/read_sockaddr.rs
+++ b/src/backend/libc/net/read_sockaddr.rs
@@ -245,10 +245,14 @@ pub(crate) fn read_sockaddr_xdp(addr: &SocketAddrAny) -> Result<SocketAddrXdp, E
     // This ignores the `sxdp_shared_umem_fd` field, which is only expected to
     // be significant in `bind` calls, and not returned from `acceptfrom` or
     // `recvmsg` or similar.
+    //
+    // `sxdp_ifindex`/`sxdp_queue_id` are plain host-endian integers per
+    // `include/uapi/linux/if_xdp.h` (never transmitted over the wire), so no
+    // byte-swap is applied here, matching the write side in `net/types.rs`.
     Ok(SocketAddrXdp::new(
         SocketAddrXdpFlags::from_bits_retain(decode.sxdp_flags),
-        u32::from_be(decode.sxdp_ifindex),
-        u32::from_be(decode.sxdp_queue_id),
+        decode.sxdp_ifindex,
+        decode.sxdp_queue_id,
     ))
 }
 
