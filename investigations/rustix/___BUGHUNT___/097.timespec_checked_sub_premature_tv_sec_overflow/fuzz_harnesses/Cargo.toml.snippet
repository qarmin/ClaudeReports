[package]
name = "rustix-fuzz"
version = "0.0.0"
publish = false
edition = "2021"

[package.metadata]
cargo-fuzz = true

[dependencies]
libfuzzer-sys = "0.4"

[dependencies.rustix]
path = ".."
features = ["std", "fs", "net", "time", "mount", "all-apis"]

[[bin]]
name = "fuzz_arg"
path = "fuzz_targets/fuzz_arg.rs"
test = false
doc = false
bench = false

[[bin]]
name = "fuzz_timespec"
path = "fuzz_targets/fuzz_timespec.rs"
test = false
doc = false
bench = false
