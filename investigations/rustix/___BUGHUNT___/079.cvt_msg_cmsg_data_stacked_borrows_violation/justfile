# Self-contained reproduction for candidate 079
# (cvt_msg_cmsg_data_stacked_borrows_violation).
#
# Like candidate 063's own justfile, the bug only manifests as Undefined
# Behavior under Miri (it's a Stacked Borrows violation, not an externally
# visible crash in a plain build - see RESULT.md "Fully reproducible" for
# why). So `reproduce-before`/`reproduce-after` run the Miri binary and
# assert on its exit code; `reproduce-real` (not part of the default `test`
# chain) separately runs the real end-to-end socketpair binary for
# supporting evidence (it never crashes either before or after the fix, by
# construction - it's real-syscall-only, and Miri itself cannot execute
# those syscalls at all, confirmed directly in RESULT.md).
#
# Requires a nightly toolchain with the `miri` component installed
# (`rustup component add miri --toolchain nightly`).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists under Miri, apply the
# fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the Miri check against the pristine clone - should abort with
# "trying to retag from <N> for Unique permission ... tag does not exist in
# the borrow stack for this location" at src/net/send_recv/msg.rs's
# `slice::from_raw_parts_mut` call inside `cvt_msg`.
reproduce-before:
    ulimit -c 0 && cd repro && \
    RUSTFLAGS="--cfg rustix_no_linux_raw" \
    cargo +nightly miri run --bin miri_check; \
    test $? -ne 0 && echo "REPRODUCED (Miri aborted, as expected pre-fix)" || \
    (echo "DID NOT REPRODUCE - unexpected, investigate" && exit 1)

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same Miri check again, now against the patched clone - should run clean
# (prints "FIXED: reached past cvt_msg without a Stacked Borrows abort,
# fd=...", exit 0).
reproduce-after:
    ulimit -c 0 && cd repro && \
    RUSTFLAGS="--cfg rustix_no_linux_raw" \
    cargo +nightly miri run --bin miri_check

# Supporting evidence only (not part of `test`): the real end-to-end
# socketpair/sendmsg/recvmsg capture. Never crashes either before or after
# the fix in a plain build - the bug it demonstrates is invisible outside
# Miri by nature (CONFIRMATION.md section 2); read its printed bytes instead
# of its exit code. Separately: attempting to run this same real round trip
# itself under Miri (`RUSTFLAGS="--cfg rustix_no_linux_raw" MIRIFLAGS="-Zmiri-disable-isolation"
# cargo +nightly miri run --bin end_to_end`) demonstrates Miri cannot
# execute rustix's real sendmsg/recvmsg syscalls at all (aborts on "can't
# call foreign function `sendmsg`" before ever reaching `cvt_msg`) - this is
# exactly why `miri_check` exists as a separate binary using genuine
# captured bytes instead.
reproduce-real:
    cd repro && cargo run --bin end_to_end

clean:
    rm -rf clone
