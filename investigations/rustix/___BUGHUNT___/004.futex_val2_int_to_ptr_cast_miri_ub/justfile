# This candidate's bug only manifests under Miri's strict-provenance check,
# not as a real crash on real hardware - the "before"/"after" comparison is
# Miri's own diagnostic output, not a process exit code.

repo_url := "git@github.com:bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Forces the libc backend (Miri can't execute linux_raw's inline-asm
# syscalls at all) and Miri's strict-provenance checker, which is what
# turns the integer-to-pointer cast into a hard error.
reproduce-before:
    cd repro && RUSTFLAGS="--cfg rustix_no_linux_raw" MIRIFLAGS="-Zmiri-strict-provenance" cargo +nightly miri run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

reproduce-after:
    cd repro && RUSTFLAGS="--cfg rustix_no_linux_raw" MIRIFLAGS="-Zmiri-strict-provenance" cargo +nightly miri run

clean:
    rm -rf clone
