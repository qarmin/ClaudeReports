# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# ADAPT note: the bug lives in a `#[cfg(any(windows, target_os = "wasi"))]` branch, which the
# native host (x86_64-unknown-linux-gnu in this session) can't hit directly. The repro is built
# for `wasm32-wasip1` instead (a real affected target) and run under a real `wasmtime`, rather than
# the template's default `cargo run --release` against the host.
#
# Requires: `rustup target add wasm32-wasip1`, and a `wasmtime` binary on PATH (install via
# https://wasmtime.dev/install.sh if not already present).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro (wasm32-wasip1, under wasmtime) against the pristine clone -
# should demonstrate the bug: `after remove(10): [5, 0]` instead of `[5, 15]`, exit code 1.
# (trailing `echo` so the repro's own nonzero exit doesn't abort the `test` chain before `apply`
# gets a chance to run)
reproduce-before:
    cd repro && cargo build --target wasm32-wasip1
    wasmtime run repro/target/wasm32-wasip1/debug/repro102.wasm; echo "exit: $?"

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer demonstrate the bug:
# `after remove(10): [5, 15]`, exit code 0.
reproduce-after:
    cd repro && cargo build --target wasm32-wasip1
    wasmtime run repro/target/wasm32-wasip1/debug/repro102.wasm; echo "exit: $?"

clean:
    rm -rf clone repro/target
