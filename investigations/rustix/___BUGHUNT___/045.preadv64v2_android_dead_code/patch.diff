@@ -404,6 +404,15 @@ pub(super) use readwrite_pv64v2::{preadv64v2 as preadv2, pwritev64v2 as pwritev2
 
 // On non-glibc, assume we don't have `pwritev2`/`preadv2` in libc and use
 // `c::syscall` instead.
+//
+// On Android specifically, this module currently has no caller:
+// `io::syscalls::{preadv2,pwritev2}` are gated to `not(target_os =
+// "android")` (see fda7cbe6) to avoid requiring `ReadWriteFlags` support
+// from linux-raw-sys on Android. The Android branch is kept rather than
+// removed in case that gate is lifted again; suppress the resulting
+// dead-code warning instead of letting it mask a real future regression
+// if someone "cleans up" what looks like unused code.
+#[cfg_attr(target_os = "android", allow(dead_code))]
 #[cfg(any(
     target_os = "android",
