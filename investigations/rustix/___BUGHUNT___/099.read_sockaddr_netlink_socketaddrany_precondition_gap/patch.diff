diff --git a/src/backend/libc/net/read_sockaddr.rs b/src/backend/libc/net/read_sockaddr.rs
index 5f8c48ec..e89f89d7 100644
--- a/src/backend/libc/net/read_sockaddr.rs
+++ b/src/backend/libc/net/read_sockaddr.rs
@@ -258,7 +258,12 @@ pub(crate) fn read_sockaddr_netlink(addr: &SocketAddrAny) -> Result<SocketAddrNe
     if addr.address_family() != AddressFamily::NETLINK {
         return Err(Errno::AFNOSUPPORT);
     }
-    assert!(addr.addr_len() as usize >= size_of::<c::sockaddr_nl>());
+    // `SocketAddrAny::new`/`read` only guarantee `addr_len` is at least the 2-byte
+    // `sockaddr_header` (just `sa_family`), not a full `sockaddr_nl` - don't assume a
+    // `NETLINK`-tagged address is always long enough to read as one.
+    if (addr.addr_len() as usize) < size_of::<c::sockaddr_nl>() {
+        return Err(Errno::INVAL);
+    }
     let decode = unsafe { &*addr.as_ptr().cast::<c::sockaddr_nl>() };
     Ok(SocketAddrNetlink::new(decode.nl_pid, decode.nl_groups))
 }
