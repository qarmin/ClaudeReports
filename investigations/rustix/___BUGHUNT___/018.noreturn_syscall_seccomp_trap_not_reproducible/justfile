repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Structurally different from other candidates: the function under test
# (`exit_group`) lives in a `pub(crate)`-private module, so the repro can't
# be an external crate depending on rustix's public API - it has to be a
# unit test living inside rustix's own source tree. `test` clones, patches in
# the test (repro/test_addition.diff), and runs it - EXPECTED SUCCESS means
# the test process dies via SIGILL (signal 4), not a normal pass/fail. See
# repro/run.sh and RESULT.md for the full explanation.
test: clone apply-test run

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

apply-test:
    cd clone && git apply "{{justfile_directory()}}/repro/test_addition.diff"

run:
    cd clone && bash "{{justfile_directory()}}/repro/run.sh"

clean:
    rm -rf clone
