# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# Requires: gcc (to build the LD_PRELOAD shim), a glibc-based x86_64 Linux host (the shim
# intercepts glibc's statvfs64/fstatvfs64 symbols - see repro/shim.c and RESULT.md for why both
# the plain and `64`-suffixed symbols matter here).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Builds the real rustix example (examples/statvfs_check.rs, copied in by check.sh) against the
# pristine clone, forcing the libc backend (RUSTFLAGS=--cfg=rustix_use_libc) so this also runs on
# x86_64 Linux, and runs it 3x under the real LD_PRELOAD shim - should show "BUG REPRODUCED" for
# both statvfs and fstatvfs on all 3 runs.
reproduce-before:
    bash repro/check.sh clone before

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same check again, now against the patched clone - should show "CORRECT" (no "BUG REPRODUCED")
# for both statvfs and fstatvfs on all 3 runs.
reproduce-after:
    bash repro/check.sh clone after

clean:
    rm -rf clone repro/libstatvfsshim.so
