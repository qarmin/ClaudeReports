+/// The union of `StatxFlags` bits that rustix currently has a named variant
+/// for.
+///
+/// `StatxFlags::all()` can't be used for this purpose: since `StatxFlags`
+/// opts in to bitflags' "externally defined flags" support (so that unknown
+/// kernel-defined bits round-trip through `from_bits_retain`/`bits()`
+/// unchanged), `StatxFlags::all().bits()` is `u32::MAX`, not the set of
+/// currently-named bits. Masking a caller-supplied request against this
+/// constant (rather than against `StatxFlags::all()`) is what keeps unknown
+/// mask bits from reaching the kernel; see the callers in
+/// `backend::linux_raw::fs::syscalls::statx` and
+/// `backend::libc::fs::syscalls::statx`.
+pub(crate) const KNOWN_STATX_FLAGS: u32 = StatxFlags::TYPE.bits()
+    | StatxFlags::MODE.bits()
+    | StatxFlags::NLINK.bits()
+    | StatxFlags::UID.bits()
+    | StatxFlags::GID.bits()
+    | StatxFlags::ATIME.bits()
+    | StatxFlags::MTIME.bits()
+    | StatxFlags::CTIME.bits()
+    | StatxFlags::INO.bits()
+    | StatxFlags::SIZE.bits()
+    | StatxFlags::BLOCKS.bits()
+    | StatxFlags::BASIC_STATS.bits()
+    | StatxFlags::BTIME.bits()
+    | StatxFlags::MNT_ID.bits()
+    | StatxFlags::DIOALIGN.bits();
+
 bitflags! {
     /// `STATX_ATTR_*` flags for use with [`Statx`].
