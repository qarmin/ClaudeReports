repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone build-shim reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Compiles the LD_PRELOAD shim that stands in for a real out-of-tree TCP congestion-control
# kernel module whose name fills all 16 TCP_CA_NAME_MAX bytes with no trailing NUL - see
# RESULT.md's "Fully reproducible" section for why a real kernel module can't be built/loaded
# here (no CAP_SYS_MODULE/root in the sandbox this was investigated in).
build-shim:
    gcc -shared -fPIC -o repro/shim/fake_congestion.so repro/shim/fake_congestion.c -ldl

# Builds with the libc backend (`use-libc` feature) specifically: the default linux_raw backend
# makes the getsockopt syscall directly and would bypass the LD_PRELOAD shim entirely.
reproduce-before:
    ulimit -c 0 && cd repro && cargo build --release
    ulimit -c 0 && cd repro && ./target/release/repro
    @echo "--- now with the shim (fakes the kernel's response) - expected to panic ---"
    -ulimit -c 0 && cd repro && LD_PRELOAD=./shim/fake_congestion.so ./target/release/repro

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

reproduce-after:
    ulimit -c 0 && cd repro && touch src/main.rs && cargo build --release
    ulimit -c 0 && cd repro && ./target/release/repro
    @echo "--- now with the shim (fakes the kernel's response) - should no longer panic ---"
    ulimit -c 0 && cd repro && LD_PRELOAD=./shim/fake_congestion.so ./target/release/repro

clean:
    rm -rf clone repro/target repro/shim/*.so
