# Self-contained verification for this candidate.
#
# This candidate is a meta-check, not a code bug: it verifies that `___ISSUES___/bugs/` (the
# triaged-issue output a prior `gh-issues-prs-check` run would leave behind) does not exist in a
# fresh checkout of this repo. There is no `repro/` crate and no `patch.diff` - "Not reproducible"
# here means "the claimed absence is independently confirmed true, and the underlying gap it
# would represent is independently confirmed already closed", not "the bug didn't trigger".
#
# Fill in repo_url/base_commit read once with `git remote get-url origin` / `git rev-parse HEAD`
# in the main project, at the moment this candidate was written up.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

test: clone check

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Real check against the fresh clone: confirms ___ISSUES___/bugs/ (and ___ISSUES___/ entirely)
# genuinely does not exist, and that it was never a tracked path in this repo's history.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd clone
    echo "--- ls ___ISSUES___/bugs/ ---"
    ls ___ISSUES___/bugs/ 2>&1 || true
    echo "--- ls ___ISSUES___/ ---"
    ls ___ISSUES___/ 2>&1 || true
    echo "--- git log --all -- '___ISSUES___*' (expect no output: never tracked) ---"
    git log --all --oneline -- '___ISSUES___*' || true
    echo "--- done: both paths absent and untracked, as RESULT.md states ---"

clean:
    rm -rf clone
