# Status: Not reproducible - no patch.diff exists, so there is no apply/reproduce-after step.
# `repro` spawns real child processes via std::process::Command and calls rustix's real public
# Pid::from_child on each one (the genuine end-to-end path); `boundary_mechanism` is a separate,
# clearly-labeled non-reproduction that only documents the root-cause mechanism in isolation (see
# RESULT.md and CONFIRMATION.md section 11 for why that one doesn't count as a confirmation).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

reproduce:
    cd repro && cargo build --release
    echo "=== Real end-to-end attempt: 2000 real child processes via std::process::Command ==="
    ./repro/target/release/repro
    echo "=== Root-cause mechanism only (NOT a reproduction - see RESULT.md) ==="
    ./repro/target/release/boundary_mechanism

clean:
    rm -rf clone repro/target
