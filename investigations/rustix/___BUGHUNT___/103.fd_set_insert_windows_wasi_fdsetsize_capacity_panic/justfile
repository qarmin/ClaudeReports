repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone, cross-interpreted under Miri for
# both affected targets (wasm32-wasip1, x86_64-pc-windows-gnu) - should demonstrate the panic.
reproduce-before:
    ./repro/run.sh before

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic on either target.
reproduce-after:
    ./repro/run.sh after

clean:
    rm -rf clone
