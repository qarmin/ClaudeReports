+#[cfg(test)]
+mod tests {
+    use super::vdso_sym_is_ok;
+    use core::ptr::null_mut;
+
+    // Candidate 047: `init()` used to hardcode "trust it unconditionally"
+    // (no null check at all) for several call sites, assuming every vDSO
+    // that passes ELF-header validation necessarily exports the exact
+    // expected symbol+version. `vdso_sym_is_ok` is what all of them route
+    // through now; this is the fixed behavior, exercised directly against
+    // the real function `init()` itself calls (not a frozen copy of it).
+    #[test]
+    fn vdso_sym_is_ok_rejects_null_and_accepts_nonnull() {
+        assert!(!vdso_sym_is_ok(null_mut::<u8>()));
+        let mut x = 0u8;
+        assert!(vdso_sym_is_ok(core::ptr::from_mut(&mut x)));
+    }
+}
