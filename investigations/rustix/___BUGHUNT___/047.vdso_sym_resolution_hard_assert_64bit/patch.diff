+/// Whether a vDSO-resolved symbol pointer should be trusted and stored, or
+/// treated as "this vDSO doesn't export that symbol" and left to the
+/// syscall fallback `minimal_init` already installed.
+///
+/// A vDSO that passes ELF-header validation (`vdso::Vdso::new()` returned
+/// `Some`) doesn't necessarily export every symbol+version this crate looks
+/// up afterward - a vDSO that's genuinely minimal (a sandboxed kernel like
+/// gVisor/runsc, certain emulators) can map successfully while still
+/// lacking a given symbol, which makes `Vdso::sym()` legitimately return a
+/// null pointer. `init()` below used to special-case this per
+/// architecture, several call sites hardcoding "trust it unconditionally"
+/// with no null check at all, so a genuinely missing symbol hit a hard
+/// (non-`debug_assert`) `assert!` right after and aborted the whole
+/// process, instead of falling back gracefully the way every other call
+/// site already did.
+fn vdso_sym_is_ok<T>(ptr: *mut T) -> bool {
+    !ptr.is_null()
+}
+
 fn init() {
     minimal_init();
 
