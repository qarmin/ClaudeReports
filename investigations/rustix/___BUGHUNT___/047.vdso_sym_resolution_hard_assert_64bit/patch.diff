+            if vdso_sym_is_ok(ptr) {
                 // Store the computed function addresses in static storage so
                 // that we don't need to compute them again (but if we do, it
                 // doesn't hurt anything).
@@ -576,32 +581,11 @@ fn init() {
             #[cfg(target_arch = "s390x")]
