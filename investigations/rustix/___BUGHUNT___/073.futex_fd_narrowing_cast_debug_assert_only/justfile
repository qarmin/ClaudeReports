# Self-contained reproduction attempt for this candidate.
#
# Status: Not reproducible - no patch.diff exists, so there is no apply/reproduce-after step.
# `repro` calls rustix's real public `futex::fd()` (the exact suspect function, exercising the
# real kernel syscall); `boundary_mechanism` is a separate, clearly-labeled non-reproduction that
# only documents the root-cause mechanism in isolation (see RESULT.md and CONFIRMATION.md section
# 11 for why that one doesn't count as a confirmation).

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

test: clone reproduce

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

reproduce:
    cd repro && cargo build --release
    echo "=== Real end-to-end attempt: rustix::thread::futex::fd() over a real syscall ==="
    ./repro/target/release/repro
    echo "=== Root-cause mechanism only (NOT a reproduction - see RESULT.md) ==="
    cd repro && cargo build
    ./repro/target/debug/boundary_mechanism || true
    ./repro/target/release/boundary_mechanism

clean:
    rm -rf clone repro/target
