repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists (sendfile unreachable on Android), apply the
# fix, prove it's gone, without touching the native host build's own correctness.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# This is a compile-time missing-API bug (not a runtime crash), so the real repro action is
# cross-type-checking repro/'s own use of the public `rustix::fs::sendfile` API against an
# Android target - an Android binary can't run directly on this host anyway, and the bug is
# fully visible from whether the symbol resolves at all. Installs the target via rustup first
# (idempotent, no-op if already installed). Expected to FAIL here (prints the real compile error
# demonstrating the bug) - `|| true` keeps `just test`'s chain going so `reproduce-after` still
# runs; the printed `E0425`/"configured out" diagnostic is the actual evidence.
reproduce-before:
    rustup target add x86_64-linux-android
    cd repro && (cargo check --target x86_64-linux-android && echo "UNEXPECTED: compiled cleanly before the patch" || echo "REPRODUCED: sendfile unreachable on Android, see E0425 above")

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Must now succeed (bug fixed) - this recipe genuinely fails `just test` if it doesn't.
reproduce-after:
    cd repro && cargo check --target x86_64-linux-android
    @echo "FIXED: sendfile now resolves and type-checks for Android"
    # Sanity: the native host build (unaffected by this bug either way) still works too.
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target repro/Cargo.lock
