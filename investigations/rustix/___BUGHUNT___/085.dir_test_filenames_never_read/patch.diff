diff --git a/tests/fs/dir.rs b/tests/fs/dir.rs
index 195898ec..1dca62ec 100644
--- a/tests/fs/dir.rs
+++ b/tests/fs/dir.rs
@@ -136,6 +136,21 @@ fn test_dir_seek() {
     }
 
     assert_eq!(entries, entries2);
+
+    // Confirm that every name we actually read back (on either pass) is
+    // either a special entry or one of the files we really created, so a
+    // name-parsing bug that corrupts entries identically on every read
+    // (and would otherwise be invisible to the `entries == entries2` check
+    // above) gets caught too.
+    let filenames: std::collections::HashSet<&str> =
+        filenames.iter().map(String::as_str).collect();
+    for name in entries.iter().chain(entries2.iter()) {
+        assert!(
+            name == "." || name == ".." || filenames.contains(name.as_str()),
+            "unexpected directory entry name: {:?}",
+            name
+        );
+    }
 }
 
 #[test]
