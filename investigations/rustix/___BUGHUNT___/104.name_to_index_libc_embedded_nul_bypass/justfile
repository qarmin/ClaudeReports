repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone, both backends.
# - the default build (linux_raw backend) should reject "lo\0evil" with NODEV.
# - the `use-libc` build (libc backend) is expected to WRONGLY resolve "lo\0evil" to
#   the real "lo" interface - that's the bug.
reproduce-before:
    ulimit -c 0 && cd repro && cargo build --release
    ulimit -c 0 && cd repro && echo "--- linux_raw backend (expected: rejects embedded-NUL name) ---" && ./target/release/repro
    ulimit -c 0 && cd repro && cargo build --release --features use-libc
    @echo "--- libc backend (expected, pre-fix: WRONGLY accepts embedded-NUL name) ---"
    -ulimit -c 0 && cd repro && ./target/release/repro

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - the libc backend should now also reject
# "lo\0evil" with NODEV, matching linux_raw.
reproduce-after:
    ulimit -c 0 && cd repro && touch src/main.rs && cargo build --release
    ulimit -c 0 && cd repro && echo "--- linux_raw backend (still rejects) ---" && ./target/release/repro
    ulimit -c 0 && cd repro && touch src/main.rs && cargo build --release --features use-libc
    ulimit -c 0 && cd repro && echo "--- libc backend (now fixed, rejects too) ---" && ./target/release/repro

clean:
    rm -rf clone repro/target
