# Self-contained reproduction for candidate 078
# (ucred_uid_gid_negative_one_invariant_bypass).
#
# The bug only manifests in a RELEASE build (in debug, `debug_assert_ne!` already panics at
# construction time, same observable shape as the fixed behavior) - see RESULT.md's
# "Confirmation" notes. `reproduce-before`/`reproduce-after` therefore always build with
# `cargo run --release`.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the repro against the pristine clone, release build - should print "BUG: ..." and
# exit 1.
reproduce-before:
    ulimit -c 0 && cd repro && \
    cargo run --release --quiet --bin fchown_bypass; \
    test $? -eq 1 && echo "REPRODUCED (exit 1, as expected pre-fix)" || \
    (echo "DID NOT REPRODUCE - unexpected, investigate" && exit 1)

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone, release build - should print "FIXED: ..." and
# exit 0.
reproduce-after:
    ulimit -c 0 && cd repro && \
    cargo run --release --quiet --bin fchown_bypass; \
    test $? -eq 0 && echo "FIXED (exit 0, as expected post-fix)" || \
    (echo "STILL REPRODUCES - unexpected, investigate" && exit 1)

clean:
    rm -rf clone
