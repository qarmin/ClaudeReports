# Self-contained reproduction for candidate 027.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should demonstrate the bug
# (a debug-build double panic that aborts the process, or a release-build panic once the
# real `Drop` re-`drain()`s the corrupted bookkeeping - see repro/src/main.rs's own doc
# comment for exactly what's real vs. simulated and why).
reproduce-before:
    ulimit -c 0 && cd repro && cargo run

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - should no longer panic/abort.
reproduce-after:
    ulimit -c 0 && cd repro && cargo run

clean:
    rm -rf clone
