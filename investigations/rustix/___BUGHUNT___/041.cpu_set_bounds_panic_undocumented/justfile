# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# This candidate needs no mocked second participant: the bug is in how `rustix::thread::CpuSet`'s
# own public API (`set`/`unset`/`is_set`) reacts to an out-of-range `usize` the caller passes
# directly - no syscall, peer, or external input is involved at all.

repo_url := "https://github.com/bytecodealliance/rustix.git"
base_commit := "287214b889865d8e1406a0ee71cc409b6f6191c8"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should panic (REPRODUCED).
# (prefixed with `-`: this step is EXPECTED to exit non-zero/panic - that's the bug reproducing -
# `just` must not treat that as a reason to abort the rest of the `test` chain)
reproduce-before:
    -ulimit -c 0 && cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone. An out-of-range CPU id still panics (that part
# is intentional, documented behavior post-fix - the fix is about message consistency and
# documentation, not turning the panic into a non-panicking Result) - but now with the clear,
# consistent "cpu out of bounds" message instead of the generic, undocumented one, so the repro's
# own check (see repro/src/main.rs) now reports "did not reproduce" and exits 0.
reproduce-after:
    ulimit -c 0 && cd repro && cargo run --release

clean:
    rm -rf clone repro/target repro/Cargo.lock
