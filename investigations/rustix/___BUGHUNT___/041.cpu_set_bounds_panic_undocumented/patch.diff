 use super::types::RawCpuSet;
 use core::mem::{size_of, size_of_val};
 
+/// The number of CPUs representable by a `RawCpuSet`, matching
+/// `backend::thread::types::CPU_SETSIZE`'s definition.
+const CPU_SETSIZE: usize = 8 * size_of::<RawCpuSet>();
+
 #[inline]
 pub(crate) fn CPU_SET(cpu: usize, cpuset: &mut RawCpuSet) {
+    assert!(
+        cpu < CPU_SETSIZE,
+        "cpu out of bounds: the cpu max is {CPU_SETSIZE} but the cpu is {cpu}"
+    );
     let size_in_bits = 8 * size_of_val(&cpuset.bits[0]); // 32, 64 etc
     let (idx, offset) = (cpu / size_in_bits, cpu % size_in_bits);
     cpuset.bits[idx] |= 1 << offset
