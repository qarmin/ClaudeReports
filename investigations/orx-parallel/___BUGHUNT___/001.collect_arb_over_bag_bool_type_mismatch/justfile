# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.

repo_url := "https://github.com/orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

# Full cycle: clone pristine, prove the bug exists, apply the fix, prove it's gone.
test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - this is a straight `cargo build`
# failure (E0308) inside orx-parallel's own source when the `experimental` feature is enabled,
# so `cargo run` here never even reaches main() while the bug is present. The leading `-` lets
# `just test`'s chain continue into `apply`/`reproduce-after` despite this step's expected
# non-zero exit (cargo's own compile-error exit code, not this recipe demonstrating success).
reproduce-before:
    -cd repro && cargo run --release

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Same repro again, now against the patched clone - the dependency should build and the binary
# should run and print "did not reproduce".
reproduce-after:
    cd repro && cargo run --release

clean:
    rm -rf clone repro/target
