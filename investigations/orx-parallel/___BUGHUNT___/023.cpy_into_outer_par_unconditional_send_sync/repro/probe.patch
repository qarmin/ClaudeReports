@@ -66,9 +66,94 @@ pub fn into_outer_par<'a, T, M, F, R>(
 
     let par = ops.into_par().runner(runner);
     par.for_each(|op: Cpy<T>| {
+        #[cfg(test)]
+        std::eprintln!("bughunt023-thread {:?}", std::thread::current().id());
         let Cpy { src, dst, len } = op;
