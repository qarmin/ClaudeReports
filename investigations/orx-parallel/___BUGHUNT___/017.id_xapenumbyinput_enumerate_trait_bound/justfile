# Self-contained reproduction attempt for this candidate.
#
# Status: Not reproducible (see RESULT.md) - there is no patch.diff. `reproduce-before` runs all
# three scenario binaries against the pristine clone: `filter_then_enumerate` and
# `filter_map_use_new_then_enumerate` are *expected* to fail to compile (that is the observed
# behavior this candidate documents), `map_then_enumerate_control` is expected to compile and run
# correctly (control experiment proving `Id<I>`'s own `XapEnumByInput` impl is not restrictive
# anywhere it is actually reachable).

repo_url := "git@github.com:orxfun/orx-parallel.git"
base_commit := "b9214fbeb714e4bb8f8858676a818cef2f21b097"

# Full cycle: clone pristine, run all three scenarios.
test: clone reproduce-before

clone:
    rm -rf clone
    mkdir -p clone
    git clone {{repo_url}} clone/orx-parallel
    cd clone/orx-parallel && git checkout {{base_commit}}

# `|| true` on the two expected-to-fail builds keeps the recipe going so the real compiler errors
# get printed for both, matching output.txt; the control scenario is run (not just built), since
# it is expected to succeed.
reproduce-before:
    cd repro && cargo build --bin filter_then_enumerate 2>&1 | grep -A3 "^error\[" || true
    cd repro && cargo run --bin map_then_enumerate_control
    cd repro && cargo build --bin filter_map_use_new_then_enumerate 2>&1 | grep -A3 "^error\[" || true

clean:
    rm -rf clone
