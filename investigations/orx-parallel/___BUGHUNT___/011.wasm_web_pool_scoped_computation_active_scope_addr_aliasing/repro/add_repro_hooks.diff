diff --git a/src/pool/pool_impl/wasm_web.rs b/src/pool/pool_impl/wasm_web.rs
index 648b5c63..1287643a 100644
--- a/src/pool/pool_impl/wasm_web.rs
+++ b/src/pool/pool_impl/wasm_web.rs
@@ -481,3 +481,36 @@ impl ParThreadPool for &WasmWebPool {
 pub fn init_wasm_parallel_runtime(num_threads: u32) -> js_sys::Promise {
     init_wasm_thread_pool(num_threads as usize)
 }
+
+/// TEMPORARY bug-hunt investigation hook (candidate 011,
+/// wasm_web_pool_scoped_computation_active_scope_addr_aliasing) - not part of the
+/// public API, reverted before this investigation concludes. Bypasses the
+/// JS-dependent worker bootstrap (start_workers) so the pure-Rust scope-runtime
+/// logic can be exercised directly under a non-browser wasm host.
+#[cfg(all(feature = "wasm", target_arch = "wasm32", target_feature = "atomics"))]
+pub fn __bughunt_repro_nested_scope(nested: bool) -> u32 {
+    __bughunt_repro_nested_scope_depth(if nested { 2 } else { 1 })
+}
+
+/// Same hook as above, generalized to `depth` levels of nesting (depth=1 means a
+/// single, non-nested scope) so the fix can be checked beyond the 2-level case
+/// the original repro used.
+pub fn __bughunt_repro_nested_scope_depth(depth: u32) -> u32 {
+    let num_threads = NonZeroUsize::new(1).expect("1");
+    WASM_WEB3_THREAD_POOL_NUM_THREADS.store(1, Ordering::SeqCst);
+    let _ = WASM_WEB3_RUNTIME.get_or_init(|| init_runtime(num_threads));
+    WASM_WEB3_THREAD_POOL_STATE.store(WASM_WEB3_THREAD_POOL_INITIALIZED, Ordering::SeqCst);
+
+    fn recurse(remaining_depth: u32) {
+        if remaining_depth == 0 {
+            return;
+        }
+        let pool: &'static mut WasmWebPool = Box::leak(Box::new(WasmWebPool::new(1usize)));
+        <WasmWebPool as ParThreadPool>::scoped_computation(pool, |_scope| {
+            recurse(remaining_depth - 1);
+        });
+    }
+
+    recurse(depth);
+    0
+}
