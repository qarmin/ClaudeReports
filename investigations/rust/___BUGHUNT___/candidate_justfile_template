# Self-contained reproduction for this candidate. Copy into NNN.NAME/justfile and fill in the
# ADAPT markers. Unlike the standard bug-hunt candidate_justfile, this one does NOT clone
# rust-lang/rust and does NOT apply a patch.diff - nothing in this workspace ever touches that
# checkout. All it needs is `rustup` and the files already in this folder, so the folder is
# postable standalone (e.g. attached to the GitHub issue) and `just repro` still works.

# ADAPT: the exact toolchain(s) this candidate needs, e.g. "nightly" or "nightly-2026-09-11".
toolchain := "nightly"

# Installs the toolchain if missing, then builds+runs the repro and prints its output.
repro:
    #!/usr/bin/env bash
    set -euo pipefail
    rustup toolchain install {{toolchain}} --profile minimal -c rustc -c cargo >/dev/null 2>&1 || true
    ulimit -c 0
    # ADAPT: replace with the exact command from RESULT.md / output.txt, e.g.:
    #   rustup run {{toolchain}} rustc -O repro/repro.rs -o /tmp/repro_NNN && /tmp/repro_NNN
    echo "ADAPT ME: fill in the real repro command (see RESULT.md)"

# For a bisected candidate: re-run against the "first bad" and a known-good toolchain side by
# side. ADAPT or delete if bisection wasn't performed / didn't pin specific toolchains.
bisect-check good_toolchain bad_toolchain:
    #!/usr/bin/env bash
    set -euo pipefail
    for tc in {{good_toolchain}} {{bad_toolchain}}; do
      rustup toolchain install "$tc" --profile minimal -c rustc >/dev/null 2>&1 || true
      echo "--- $tc ---"
      # ADAPT: same repro command as above, with the toolchain substituted in.
    done
