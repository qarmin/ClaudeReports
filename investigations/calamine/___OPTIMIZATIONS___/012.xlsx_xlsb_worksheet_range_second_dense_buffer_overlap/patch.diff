+impl<'c> Range<DataRef<'c>> {
+    /// Converts a dense `Range<DataRef>` into `Range<Data>` by writing each converted value back
+    /// into the same backing allocation, cell by cell, instead of the
+    /// `.into_iter().map(Into::into).collect()` used at every XLSX/XLSB `worksheet_range()` call
+    /// site. `DataRef` and `Data` have the same size and alignment (asserted below), so reusing
+    /// the allocation is sound: each slot is read exactly once, converted, and overwritten before
+    /// the loop advances, so no slot is ever read after being overwritten and no destructor runs
+    /// twice.
+    pub(crate) fn into_data_in_place(self) -> Range<Data> {
+        const _: () = assert!(mem::size_of::<DataRef>() == mem::size_of::<Data>());
+        const _: () = assert!(mem::align_of::<DataRef>() == mem::align_of::<Data>());
+
+        let mut inner = mem::ManuallyDrop::new(self.inner);
+        let len = inner.len();
+        let cap = inner.capacity();
+        let ptr = inner.as_mut_ptr();
+        // SAFETY: `ptr`/`len`/`cap` came from a live `Vec<DataRef>` that is never touched again
+        // after this point (it's wrapped in `ManuallyDrop`). Each of the `len` slots is read
+        // exactly once via `ptr::read` (taking ownership without running `DataRef`'s destructor
+        // at the old location) and immediately overwritten with a same-size/align `Data` value
+        // via `ptr::write` before any other slot is touched, so the buffer ends up fully
+        // initialized as `[Data; len]` and `Vec::from_raw_parts` reconstructs it with the same
+        // allocation, length and capacity the original `Vec<DataRef>` had.
+        unsafe {
+            for i in 0..len {
+                let slot = ptr.add(i);
+                let old = ptr::read(slot);
+                let new: Data = old.into();
+                ptr::write(slot.cast::<Data>(), new);
+            }
+            Range {
+                start: self.start,
+                end: self.end,
+                inner: Vec::from_raw_parts(ptr.cast::<Data>(), len, cap),
+            }
+        }
+    }
+}
