# Self-contained reproduction for this candidate.
#
# This candidate's own bench need is the `rss_probe` harness built for this whole
# ___OPTIMIZATIONS___ workspace (shape 3 from the template comment: the harness is untracked in
# the main calamine repo, so a fresh `git clone` of repo_url will never contain it). That makes
# this folder self-contained given the whole ___OPTIMIZATIONS___ folder kept together, not as a
# fully isolated single subfolder - see ../README.md for what the harness does and why it exists.
#
# `testdata/poc.xlsx` (the crash-triggering file, 1964 bytes) is copied in directly. The large
# real-world file used for the "legitimate input is unaffected" measurement
# (`big_300k_rows.xlsx`, ~20MB) is NOT duplicated into this folder - `bench` re-downloads it from
# the same public URL documented in ../README.md.

repo_url := "https://github.com/tafia/calamine.git"
base_commit := "5c02e86e99ec5c1fb1dcc15e64c2bbaf19bff60d"
harness_dir := "../harness/rss_probe"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/rss_probe
    curl -sL -o testdata/big_300k_rows.xlsx https://test-files.sheetjs.com/8-by-300000-cells.xlsx

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_baseline

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_patched

bench:
    @echo "=== baseline (before patch): PoC file, range mode ==="
    @echo "expected to ABORT the process (attempted ~549 GB allocation) - bounded to a safe"
    @echo "address-space limit here so the failure is observed instead of stressing the host"
    ( ulimit -v 4000000; ./rss_probe_baseline range testdata/poc.xlsx ) || echo "(aborted as expected, exit $?)"
    @echo ""
    @echo "=== baseline (before patch): big real file, range mode ==="
    ./rss_probe_baseline range testdata/big_300k_rows.xlsx
    @echo ""
    @echo "=== patched (after patch): PoC file, range mode ==="
    @echo "expected to return cleanly now (Err(CellLimitExceeded), rss_probe just skips it)"
    ./rss_probe_patched range testdata/poc.xlsx
    @echo ""
    @echo "=== patched (after patch): big real file, range mode ==="
    @echo "expect peak_rss_kb/cells/sig to match the baseline run above"
    ./rss_probe_patched range testdata/big_300k_rows.xlsx

clean:
    rm -rf clone rss_probe_baseline rss_probe_patched testdata/big_300k_rows.xlsx
