+                // observable effect on the final bounding box is forcing the start row down to
+                // `header_row_idx` (its column is always already within [col_lo, col_hi], since
+                // it reuses a real cell's column) - reproduced directly here without needing to
+                // materialize the synthetic cell itself. `header_row_idx >= dims.start.0` is
+                // guaranteed by the `header_ok` check above, so this can't push row_lo out of
+                // the pre-sized grid's row range.
+                if any && row_lo != header_row_idx {
+                    row_lo = header_row_idx;
+                }
+            }
+        }
+
+        if !any {
+            return Ok(Range::empty());
+        }
+
+        if row_lo == dims.start.0 && row_hi == dims.end.0 && col_lo == dims.start.1 && col_hi == dims.end.1 {
+            return Ok(Range {
+                start: dims.start,
+                end: dims.end,
+                inner: grid,
+            });
+        }
+
+        // Declared dims were looser than the actual used range (e.g. trailing empty rows/cols
+        // within the declared box, or a HeaderRow::Row forcing the start row down) - crop into a
+        // tightly-sized buffer matching from_sparse()'s own bounding-box semantics, then drop the
+        // larger `grid`. Cells outside [dims.start, dims.end] (rows added only by the
+        // header_row_idx-forced start, when header_row_idx < the lowest real cell row) stay
+        // T::default() since `grid` never had data for them either.
+        let crop_rows = (row_hi - row_lo) as usize + 1;
+        let crop_cols = (col_hi - col_lo) as usize + 1;
+        let mut cropped = vec![T::default(); crop_rows.saturating_mul(crop_cols)];
+        for r in 0..crop_rows {
+            let abs_row = row_lo + r as u32;
+            if abs_row < dims.start.0 || abs_row > dims.end.0 {
+                continue;
+            }
+            let src_row = (abs_row - dims.start.0) as usize;
+            let src_start = src_row * cols + (col_lo - dims.start.1) as usize;
+            let dst_start = r * crop_cols;
+            cropped[dst_start..dst_start + crop_cols]
+                .clone_from_slice(&grid[src_start..src_start + crop_cols]);
+        }
+        Ok(Range {
+            start: (row_lo, col_lo),
+            end: (row_hi, col_hi),
+            inner: cropped,
+        })
+    }
