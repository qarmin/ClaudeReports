+    /// Shared tail of [`Range::from_sparse_dense_hint()`]'s fallback path: continues consuming
+    /// `next_cell` (starting from whatever `cells` already holds, possibly non-empty if a
+    /// direct-write attempt salvaged some cells before bailing out) exactly the way every
+    /// XLSX/XLSB `worksheet_range_ref()` used to build its sparse `Vec<Cell<T>>` inline, then
+    /// finishes with the plain [`Range::from_sparse()`].
+    fn collect_sparse<E>(
+        header_row: HeaderRow,
+        mut cells: Vec<Cell<T>>,
+        mut next_cell: impl FnMut() -> Result<Option<Cell<T>>, E>,
+    ) -> Result<Range<T>, E> {
+        match header_row {
+            HeaderRow::FirstNonEmptyRow => loop {
+                match next_cell()? {
+                    Some(cell) if cell.val == T::default() => (),
+                    Some(cell) => cells.push(cell),
+                    None => break,
+                }
+            },
+            HeaderRow::Row(header_row_idx) => {
+                loop {
+                    match next_cell()? {
+                        Some(cell) if cell.val == T::default() => (),
+                        Some(cell) if cell.pos.0 >= header_row_idx => cells.push(cell),
+                        Some(_) => (),
+                        None => break,
+                    }
+                }
+                if cells.first().is_some_and(|c| c.pos.0 != header_row_idx) {
+                    cells.insert(
+                        0,
+                        Cell {
+                            pos: (header_row_idx, cells.first().expect("cells should not be empty").pos.1),
+                            val: T::default(),
+                        },
+                    );
+                }
+            }
+        }
+        Ok(Range::from_sparse(cells))
+    }
