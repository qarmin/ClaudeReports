+/// Builds a [`Range`] from cells discovered one at a time, interleaved with unrelated records in
+/// a single-pass parser (XLS's per-sheet BIFF record loop, which can't collect a dedicated
+/// `Vec<Cell<T>>` up front the way XLSX/XLSB's cell-only stream does). Writes straight into a
+/// dense buffer pre-sized from an optional file-declared dimension hint, avoiding [`Range::from_sparse()`]'s
+/// sparse-then-dense double allocation for the common case where that hint is accurate.
+///
+/// Never trusts the hint for correctness: every cell is bounds-checked as it's pushed. If a cell
+/// ever falls outside the hint (a wrong/mismatched/absent `Dimensions` record), this reconstructs
+/// a sparse `Vec<Cell<T>>` from whatever the dense buffer already holds and falls back to
+/// [`Range::from_sparse()`]'s exact behavior for the remaining pushes.
+pub(crate) struct DenseRangeBuilder<T: CellType> {
+    dense: Option<DenseRangeState<T>>,
+    sparse: Vec<Cell<T>>,
+    max_cells: usize,
+}
+
+struct DenseRangeState<T> {
+    dims: Dimensions,
+    cols: usize,
+    grid: Vec<T>,
+    any: bool,
+    row_lo: u32,
+    row_hi: u32,
+    col_lo: u32,
+    col_hi: u32,
+}
+
+impl<T: CellType> DenseRangeBuilder<T> {
+    pub(crate) fn new(max_cells: usize) -> Self {
+        DenseRangeBuilder {
+            dense: None,
+            sparse: Vec::new(),
+            max_cells,
+        }
+    }
+
+    /// Only takes effect the first time it's called, before any cell has been pushed - a real
+    /// BIFF8 `Dimensions` record always precedes cell records, so this is the only case that
+    /// matters; a hint arriving late or twice is silently ignored rather than risking dropping
+    /// already-buffered sparse cells.
+    pub(crate) fn set_dims_hint(&mut self, dims: Dimensions) {
+        if self.dense.is_some() || !self.sparse.is_empty() {
+            return;
+        }
+        if dims.end.0 < dims.start.0 || dims.end.1 < dims.start.1 {
+            return;
+        }
+        let cols = (dims.end.1 - dims.start.1) as usize + 1;
+        let rows = (dims.end.0 - dims.start.0) as usize + 1;
+        let len = cols.saturating_mul(rows);
+        if len == 0 || len > self.max_cells {
+            self.sparse.reserve(len.min(self.max_cells));
+            return;
+        }
+        self.dense = Some(DenseRangeState {
+            dims,
+            cols,
+            grid: vec![T::default(); len],
+            any: false,
+            row_lo: u32::MAX,
+            row_hi: 0,
+            col_lo: u32::MAX,
+            col_hi: 0,
+        });
+    }
+
+    pub(crate) fn push(&mut self, cell: Cell<T>) {
+        let Some(d) = self.dense.as_mut() else {
+            self.sparse.push(cell);
+            return;
+        };
+        let (r, c) = cell.pos;
+        if r < d.dims.start.0 || r > d.dims.end.0 || c < d.dims.start.1 || c > d.dims.end.1 {
+            self.bail_to_sparse(cell);
+            return;
+        }
+        let idx = (r - d.dims.start.0) as usize * d.cols + (c - d.dims.start.1) as usize;
+        d.grid[idx] = cell.val;
+        d.any = true;
+        d.row_lo = min(d.row_lo, r);
+        d.row_hi = max(d.row_hi, r);
+        d.col_lo = min(d.col_lo, c);
+        d.col_hi = max(d.col_hi, c);
+    }
+
+    fn bail_to_sparse(&mut self, mismatched: Cell<T>) {
+        let d = self.dense.take().expect("dense state present, checked by caller");
+        self.sparse
+            .reserve(d.grid.iter().filter(|v| **v != T::default()).count() + 1);
+        for (idx, v) in d.grid.into_iter().enumerate() {
+            if v != T::default() {
+                let pos = (
+                    d.dims.start.0 + (idx / d.cols) as u32,
+                    d.dims.start.1 + (idx % d.cols) as u32,
+                );
+                self.sparse.push(Cell { pos, val: v });
+            }
+        }
+        self.sparse.push(mismatched);
+    }
+
+    pub(crate) fn finish(self) -> Range<T> {
+        let Some(d) = self.dense else {
+            return Range::from_sparse(self.sparse);
+        };
+        if !d.any {
+            return Range::empty();
+        }
+        if d.row_lo == d.dims.start.0
+            && d.row_hi == d.dims.end.0
+            && d.col_lo == d.dims.start.1
+            && d.col_hi == d.dims.end.1
+        {
+            return Range {
+                start: d.dims.start,
+                end: d.dims.end,
+                inner: d.grid,
+            };
+        }
+        // Declared dims were looser than the actual used range (e.g. trailing empty rows/cols
+        // within the declared box) - crop into a tightly-sized buffer matching from_sparse()'s
+        // own bounding-box semantics, then drop the larger `grid`.
+        let crop_rows = (d.row_hi - d.row_lo) as usize + 1;
+        let crop_cols = (d.col_hi - d.col_lo) as usize + 1;
+        let mut cropped = vec![T::default(); crop_rows.saturating_mul(crop_cols)];
+        for r in 0..crop_rows {
+            let abs_row = d.row_lo + r as u32;
+            let src_row = (abs_row - d.dims.start.0) as usize;
+            let src_start = src_row * d.cols + (d.col_lo - d.dims.start.1) as usize;
+            let dst_start = r * crop_cols;
+            cropped[dst_start..dst_start + crop_cols]
+                .clone_from_slice(&d.grid[src_start..src_start + crop_cols]);
+        }
+        Range {
+            start: (d.row_lo, d.col_lo),
+            end: (d.row_hi, d.col_hi),
+            inner: cropped,
+        }
+    }
+}
