# Self-contained reproduction for this candidate.
#
# IMPORTANT: this candidate DEPENDS ON candidate 001 (../001.xlsx_xlsb_dense_range_cell_cap/) -
# it reuses MAX_DENSE_RANGE_CELLS, which 001's patch adds to src/xlsx/mod.rs. `apply` applies
# BOTH patches, in order, not just this folder's own patch.diff.
#
# Uses the `rss_probe` harness from ../harness/rss_probe (untracked in the main calamine repo -
# see ../README.md). Self-contained given the whole ___OPTIMIZATIONS___ folder kept together.
#
# `testdata/poc.xlsx` (2253 bytes) is copied in directly. No large real-world file needed to be
# duplicated here - `bench` re-downloads big_300k_rows.xlsx from the public URL in ../README.md.

repo_url := "https://github.com/tafia/calamine.git"
base_commit := "5c02e86e99ec5c1fb1dcc15e64c2bbaf19bff60d"
harness_dir := "../harness/rss_probe"
candidate_001_patch := "../001.xlsx_xlsb_dense_range_cell_cap/patch.diff"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/rss_probe
    curl -sL -o testdata/big_300k_rows.xlsx https://test-files.sheetjs.com/8-by-300000-cells.xlsx

apply:
    cd clone && git apply "{{justfile_directory()}}/{{candidate_001_patch}}"
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_baseline

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_patched

bench:
    @echo "=== baseline: poc.xlsx, open mode ==="
    @echo "expected to ABORT the process (attempted ~96 GB reserve) - bounded address space"
    ( ulimit -v 4000000; ./rss_probe_baseline open testdata/poc.xlsx ) || echo "(aborted as expected, exit $?)"
    @echo ""
    @echo "=== baseline: big real file, range mode ==="
    ./rss_probe_baseline range testdata/big_300k_rows.xlsx
    @echo ""
    @echo "=== patched: poc.xlsx, open mode ==="
    @echo "expected to return cleanly now"
    ./rss_probe_patched open testdata/poc.xlsx
    @echo ""
    @echo "=== patched: big real file, range mode ==="
    @echo "expect peak_rss_kb/cells/sig to match the baseline run above"
    ./rss_probe_patched range testdata/big_300k_rows.xlsx

clean:
    rm -rf clone rss_probe_baseline rss_probe_patched testdata/big_300k_rows.xlsx
