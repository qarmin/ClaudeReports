# Self-contained reproduction for this candidate.
#
# Fixes candidate 018's own found regression: candidate 006's `Xlsx::worksheet_range()` override
# (written before candidate 017's `from_sparse_dense_hint()` existed) made 017's fix unreachable
# for XLSX. This candidate's own patch.diff = candidate 018's combined 017+006 patch, plus a
# 13/-75 line change deleting that stale override (see incremental_xlsx_mod.diff in this folder
# for just that increment, isolated).
#
# Three variants are built: baseline (no patches), 018 (017+006, the regression), and this
# candidate's own patch (017+006+override-fix) - so the reader can see the regression reproduce
# and then see it fixed, on the same fixture.
#
# Uses the `rss_probe` harness from ../harness/rss_probe (untracked in the main calamine repo -
# see ../README.md) - self-contained given the whole ___OPTIMIZATIONS___ folder kept together.

repo_url := "https://github.com/tafia/calamine.git"
base_commit := "5c02e86e99ec5c1fb1dcc15e64c2bbaf19bff60d"
harness_dir := "../harness/rss_probe"
patch_018 := "../018.data_string_arc_interning_remeasure_after_from_sparse_fix/patch.diff"

test: clone build-baseline apply-018 build-018 apply-019 build-019 bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/rss_probe
    curl -sL -o clone/big_300k_rows.xlsx https://test-files.sheetjs.com/8-by-300000-cells.xlsx

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_baseline

# 018 (the regression): apply on the pristine clone, build, snapshot the binary, then revert so
# apply-019 below starts from the same pristine state (git apply needs a pristine tree).
apply-018:
    cd clone && git apply "{{justfile_directory()}}/{{patch_018}}"

build-018:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_018_regressed
    cd clone && git checkout -- .

apply-019:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-019:
    cd clone/___OPTIMIZATIONS___/harness/rss_probe && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/rss_probe/target/release/rss_probe ./rss_probe_019_fixed

bench:
    @echo "=== XLSX (real file) - expect: baseline high, 018 REGRESSES back to baseline, 019 much lower than both ==="
    ./rss_probe_baseline range clone/big_300k_rows.xlsx
    ./rss_probe_018_regressed range clone/big_300k_rows.xlsx
    ./rss_probe_019_fixed range clone/big_300k_rows.xlsx

clean:
    rm -rf clone rss_probe_baseline rss_probe_018_regressed rss_probe_019_fixed
