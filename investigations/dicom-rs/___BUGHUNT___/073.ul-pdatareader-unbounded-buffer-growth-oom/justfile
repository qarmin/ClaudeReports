# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in.
#
# Real end-to-end reproduction (per CONFIRMATION.md section 11): the victim is a real
# `PDataReader` wrapping a real `TcpStream`; the attacker is a genuinely separate thread
# communicating only via a real loopback TCP socket (see repro/src/main.rs for details).

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"

test: clone reproduce-before apply reproduce-after

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - should exit non-zero (bug
# reproduced: unbounded buffer growth before finally erroring on disconnect).
reproduce-before:
    cd repro && cargo run; test "$?" -ne 0 && echo "(non-zero exit expected here: bug reproduced)"; true

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

# Confirm the fix: repro now runs cleanly (exit 0, the oversized PDU is rejected early).
reproduce-after:
    cd repro && cargo run

clean:
    rm -rf clone
