+/// Checks whether `s` only contains characters permitted by PS3.5 6.2's UI (Unique Identifier)
+/// VR character repertoire (digits, '.', and padding), the same check used when reading a UID
+/// value directly out of the file meta group.
+fn is_uid_conformant(s: &str) -> bool {
+    s.chars()
+        .all(|c| c == '.' || c.is_ascii_digit() || c == '\0' || c.is_ascii_whitespace())
+}
