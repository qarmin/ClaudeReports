+    /// Resize `self.buffer` to `len` bytes, failing gracefully instead of aborting the process
+    /// when `len` (which comes straight from an untrusted, attacker-controlled element header,
+    /// up to ~4 GiB) can't actually be allocated - matches the `try_reserve_exact` pattern
+    /// already used for the same reason in `object::meta::read_str_body`.
+    fn checked_resize_buffer(&mut self, len: usize) -> Result<()> {
+        self.buffer.clear();
+        self.buffer
+            .try_reserve_exact(len)
+            .map_err(|_| std::io::Error::other("value length too large to allocate"))
+            .context(ReadValueDataSnafu {
+                position: self.position,
+            })?;
+        self.buffer.resize_with(len, Default::default);
+        Ok(())
+    }
+
+    /// Allocate a zero-filled `SmallVec` of `n` elements, failing gracefully instead of
+    /// aborting the process when `n` (derived from an untrusted, attacker-controlled element
+    /// header) can't actually be allocated. See `checked_resize_buffer` for the same reasoning.
+    fn checked_alloc_smallvec<T>(&self, n: usize) -> Result<smallvec::SmallVec<[T; 2]>>
+    where
+        T: Copy + Default,
+    {
+        let mut v: smallvec::SmallVec<[T; 2]> = smallvec::SmallVec::new();
+        v.try_reserve_exact(n)
+            .map_err(|_| std::io::Error::other("value length too large to allocate"))
+            .context(ReadValueDataSnafu {
+                position: self.position,
+            })?;
+        v.resize(n, T::default());
+        Ok(v)
+    }
