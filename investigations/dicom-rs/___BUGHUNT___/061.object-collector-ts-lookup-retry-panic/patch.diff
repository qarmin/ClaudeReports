+    #[test]
+    fn ts_lookup_panic_repro() {
+        let encoded: Vec<u8> = vec![0u8; 16];
+        let reader = BufReader::new(std::io::Cursor::new(&encoded));
+        let mut collector = DicomCollector::new_with_ts(reader, "1.2.3.4.not.a.real.ts");
