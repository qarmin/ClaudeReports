+/// Reads the given attribute out of every item of `PerFrameFunctionalGroupsSequence`, in frame
+/// order. Returns `None` (rather than a shorter list) if the sequence is empty, or if *any* item
+/// is missing the attribute - a per-frame array is only meaningful if each of its entries lines
+/// up with the frame it was read from; silently dropping absent items would misalign every
+/// subsequent entry against the wrong frame index for callers that assume `result[i]` belongs to
+/// frame `i` (see the length-mismatch fallback in `DecodedPixelData`'s accessor methods, which
+/// this keeps from ever being reached due to a *misaligned*, as opposed to genuinely absent,
+/// per-frame array).
 fn get_from_per_frame<D: DataDictionary + Clone>(
     obj: &FileDicomObject<InMemDicomObject<D>>,
     selector: [Tag; 2],
-) -> Option<impl Iterator<Item = &InMemElement<D>>> {
-    let mut items = obj
-        .get(tags::PER_FRAME_FUNCTIONAL_GROUPS_SEQUENCE)?
-        .items()?
-        .iter()
-        .filter_map(move |item| item.get(selector[0])?.items()?.first()?.get(selector[1]))
-        .peekable();
+) -> Option<Vec<&InMemElement<D>>> {
+    let items = obj.get(tags::PER_FRAME_FUNCTIONAL_GROUPS_SEQUENCE)?.items()?;
+
+    if items.is_empty() {
+        return None;
+    }
 
-    items.peek().is_some().then_some(items)
+    items
+        .iter()
+        .map(|item| item.get(selector[0])?.items()?.first()?.get(selector[1]))
+        .collect()
 }
 
