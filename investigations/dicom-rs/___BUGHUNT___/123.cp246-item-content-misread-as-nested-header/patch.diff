+    /// The number of bytes remaining in the innermost currently open
+    /// item/sequence, according to its own declared (defined) length -
+    /// `None` if there is no enclosing container or its length is
+    /// undefined (in which case there is nothing to bound against here).
+    fn remaining_bytes_in_container(&self) -> Option<u64> {
+        let sd = self.seq_delimiters.last()?;
+        let len = sd.len.get()?;
+        let end_of_sequence = sd.base_offset + len as u64;
+        let bytes_read = self.parser.position();
+        Some(end_of_sequence.saturating_sub(bytes_read))
+    }
+
     fn read_value(&mut self, header: &DataElementHeader) -> Result<PrimitiveValue> {
+        // Guard against a declared value length that would read past the
+        // bounds of the immediately enclosing item/sequence (only
+        // meaningful when that container itself has a defined length).
+        // This is most easily triggered by CP-246-style undefined-length
+        // private elements (turned into a pseudo-sequence with one
+        // explicit-length item) whose actual content is opaque binary
+        // data, not a nested data set - bytes that happen to look like a
+        // plausible tag+length pair are otherwise read as a real element
+        // header, and the resulting bogus, oversized length then drives an
+        // attempt to read arbitrarily far past this item (and often past
+        // EOF), surfacing only as a generic, hard-to-diagnose I/O error.
+        if let Some(len) = header.len.get() {
+            if let Some(remaining) = self.remaining_bytes_in_container() {
+                if len as u64 > remaining {
+                    return ElementLengthExceedsContainerSnafu {
+                        tag: header.tag,
+                        len,
+                        remaining,
+                    }
+                    .fail();
+                }
+            }
+        }
+
