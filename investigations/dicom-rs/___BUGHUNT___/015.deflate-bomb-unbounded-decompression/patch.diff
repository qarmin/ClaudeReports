+/// Compute the number of bytes one decoded frame is expected to occupy, from the object's own
+/// declared dimensions - used to bound decompression below, so a small, highly-compressible
+/// fragment (a "decompression bomb") can't force an arbitrarily large allocation/copy.
+fn expected_frame_size(src: &dyn PixelDataObject) -> DecodeResult<u64> {
+    let cols = src
+        .cols()
+        .context(decode_error::MissingAttributeSnafu { name: "Columns" })?;
+    let rows = src
+        .rows()
+        .context(decode_error::MissingAttributeSnafu { name: "Rows" })?;
+    let samples_per_pixel = src
+        .samples_per_pixel()
+        .context(decode_error::MissingAttributeSnafu {
+            name: "SamplesPerPixel",
+        })?;
+    let bits_allocated = src
+        .bits_allocated()
+        .context(decode_error::MissingAttributeSnafu {
+            name: "BitsAllocated",
+        })?;
+    let bytes_per_sample = (bits_allocated as u64).div_ceil(8);
+    Ok(cols as u64 * rows as u64 * samples_per_pixel as u64 * bytes_per_sample)
+}
