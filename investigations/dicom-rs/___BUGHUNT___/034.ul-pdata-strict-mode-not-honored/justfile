# Self-contained reproduction for this candidate.
#
# Everything this needs is either already in this folder, or fetched by `just clone` into
# ./clone (gitignored) - nothing in this justfile reaches outside the folder it lives in. That
# means this whole folder can be copied anywhere (including posted standalone, e.g. attached to a
# GitHub issue) and `just test` still works, with no dependency on the main project checkout this
# candidate was originally found in.
#
# No patch.diff for this candidate - Confirmed, but no safe bounded fix was found this session
# (see RESULT.md). Only the "before" reproduction is provided.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"

test: clone reproduce-before

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}

# Build+run the standalone repro against the pristine clone - demonstrates that
# PDataReader accepts a P-Data-TF PDU far larger than the negotiated max_pdu_length
# (non-zero exit: bug reproduced).
reproduce-before:
    cd repro && cargo run --release; test "$?" -ne 0 && echo "(non-zero exit expected here: bug reproduced)"; true

clean:
    rm -rf clone
