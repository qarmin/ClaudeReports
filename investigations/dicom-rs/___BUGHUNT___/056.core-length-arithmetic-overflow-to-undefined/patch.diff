+                let o = (len as i64 + rhs as i64).clamp(0, UNDEFINED_LEN as i64 - 1) as u32;
                 Length(o)
             }
         }
@@ -1259,12 +1260,11 @@ impl std::ops::SubAssign<Length> for Length {
