+/// Determine the number of bits that the entries of `lut` actually span,
+/// which is not always the depth that its _LUT Descriptor_ declares.
+///
+/// Devices have been observed declaring a wider bit depth than their LUT data
+/// actually uses (e.g. 16 bits declared for data that only ever spans 12) -
+/// taking the declared depth at face value under-scales such a LUT into a
+/// small fraction of the output range. The declared depth still wins when the
+/// data exceeds it (so entries are never shifted out of range), and when the
+/// data is all zeroes (which says nothing about the real depth).
+fn effective_bits_stored(lut: &VoiLut) -> u16 {
+    let declared = lut.bits_stored as u16;
+    let max = lut.data.iter().copied().max().unwrap_or(0);
+    let used = (u16::BITS - max.leading_zeros()) as u16;
+
+    if used == 0 || used > declared {
+        declared
+    } else {
+        used
+    }
+}
