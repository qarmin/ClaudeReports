diff --git a/encoding/src/text.rs b/encoding/src/text.rs
index 4e3f9220..e273c248 100644
--- a/encoding/src/text.rs
+++ b/encoding/src/text.rs
@@ -362,7 +362,12 @@ macro_rules! decl_character_set {
             }
 
             fn encode(&self, text: &str) -> EncodeResult<Vec<u8>> {
-                $val.encode(text, EncoderTrap::Strict)
+                // `Replace` instead of `Strict`: some byte sequences that a codec's own
+                // decode table accepts (e.g. Shift-JIS/CP932's IBM-extension range under
+                // WINDOWS_31J) map to characters that the same codec's encode table can't
+                // represent, and a decoded value that legitimately round-tripped through
+                // `decode` should not fail to write back out over that asymmetry.
+                $val.encode(text, EncoderTrap::Replace)
                     .map_err(|message| EncodeCustomSnafu { message }.build())
             }
         }
@@ -387,8 +392,10 @@ impl TextCodec for DefaultCharacterSetCodec {
     }
 
     fn encode(&self, text: &str) -> EncodeResult<Vec<u8>> {
+        // See the comment on the `decl_character_set!` macro's `encode` for why
+        // `Replace` is used here instead of `Strict`.
         ISO_8859_1
-            .encode(text, EncoderTrap::Strict)
+            .encode(text, EncoderTrap::Replace)
             .map_err(|message| EncodeCustomSnafu { message }.build())
     }
 }
