+impl PartialEq for DataElementHeader {
+    /// Two headers are equal if their tag, VR, and length all match.
+    ///
+    /// Length comparison uses [`Length::inner_eq`] rather than `==`, since
+    /// `Length`'s own `PartialEq` considers two undefined lengths to never
+    /// be equal (mirroring the fact that an undefined length carries no
+    /// comparable value) - which would otherwise make a header with an
+    /// undefined length (ubiquitous for `SQ` elements and encapsulated
+    /// pixel data) never equal to itself.
+    fn eq(&self, other: &Self) -> bool {
+        self.tag == other.tag && self.vr == other.vr && self.len.inner_eq(other.len)
+    }
+}
