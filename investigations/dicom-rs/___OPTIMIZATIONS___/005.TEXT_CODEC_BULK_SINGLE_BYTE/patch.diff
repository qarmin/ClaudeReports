+/// Bulk single-byte decode, bypassing `encoding`'s generic virtual-dispatch machinery. Only valid for genuine `SingleByteEncoding` instances (ISO-8859-1..8, WINDOWS_874).
+fn fast_singlebyte_decode(enc: &SingleByteEncoding, text: &[u8]) -> String {
+    let mut out = String::with_capacity(text.len());
+    for &byte in text {
+        if byte <= 0x7f {
+            out.push(byte as char);
+        } else {
+            let code = (enc.index_forward)(byte);
+            if code != 0xffff {
+                out.push(char::from_u32(code as u32).expect("valid codepoint from index_forward"));
+            } else {
+                let o0 = byte & 7;
+                let o1 = (byte & 56) >> 3;
+                let o2 = (byte & 192) >> 6;
+                out.push('\\');
+                out.push((o2 + b'0') as char);
+                out.push((o1 + b'0') as char);
+                out.push((o0 + b'0') as char);
+            }
+        }
+    }
+    out
+}
+
+/// Bulk single-byte encode, the `EncoderTrap::Strict` counterpart of [`fast_singlebyte_decode`].
+fn fast_singlebyte_encode(enc: &SingleByteEncoding, text: &str) -> EncodeResult<Vec<u8>> {
+    let mut out = Vec::with_capacity(text.len());
+    for ch in text.chars() {
+        if ch <= '\u{7f}' {
+            out.push(ch as u8);
+        } else {
+            let index = (enc.index_backward)(ch as u32);
+            if index != 0 {
+                out.push(index);
+            } else {
+                return EncodeCustomSnafu {
+                    message: format!("unrepresentable character '{ch}'"),
+                }
+                .fail();
+            }
+        }
+    }
+    Ok(out)
+}
