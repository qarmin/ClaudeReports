+/// Same as [`decl_character_set`], but uses the bulk fast path for a genuine `SingleByteEncoding`.
+macro_rules! decl_singlebyte_character_set {
+    ($typ: ident, $term: literal, $val: expr) => {
+        #[derive(Debug, Default, Copy, Clone, Eq, Hash, PartialEq)]
+        #[doc = "Data type for the "]
+        #[doc = $term]
+        #[doc = "character set encoding."]
+        pub struct $typ;
+
+        impl TextCodec for $typ {
+            fn name(&self) -> Cow<'static, str> {
+                Cow::Borrowed($term)
+            }
+
+            fn decode(&self, text: &[u8]) -> DecodeResult<String> {
+                Ok(fast_singlebyte_decode($val, text))
+            }
+
+            fn encode(&self, text: &str) -> EncodeResult<Vec<u8>> {
+                fast_singlebyte_encode($val, text)
+            }
+        }
+    };
+}
