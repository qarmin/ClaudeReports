# Self-contained reproduction for candidate 001.INMEMFRAGMENT_ARC.
#
# This candidate's harness is dicom-rs's own bench_pipeline, built by this ___OPTIMIZATIONS___
# workspace itself and untracked in the main dicom-rs repo (see SKILL.md's "Bench harnesses" /
# "shape 3" pattern) - so a fresh `git clone` of repo_url alone will never contain it. This
# folder is self-contained given the WHOLE ___OPTIMIZATIONS___ folder kept together (the
# harness is copied in from ../harness/bench_pipeline as part of `clone`), not as a fully
# isolated single subfolder.
#
# `just test` clones dicom-rs at base_commit, builds a baseline binary, applies patch.diff,
# builds a patched binary, then runs both via tools/paired.sh and prints real before/after
# numbers - no manual steps required.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline
    # the copied harness's Cargo.toml points at ../../../{object,core,...} relative to its own
    # location, which still resolves correctly under clone/___OPTIMIZATIONS___/harness/bench_pipeline

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

bench:
    #!/usr/bin/env bash
    set -euo pipefail
    cp "{{justfile_directory()}}/testdata/color3d_jpeg_baseline.dcm" clone/color3d_jpeg_baseline.dcm 2>/dev/null || true
    echo "=== paired write-only comparison (RUNS=${RUNS:-9}) ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched \
        -- write-only clone/color3d_jpeg_baseline.dcm 500

clean:
    rm -rf clone bin_baseline bin_patched
