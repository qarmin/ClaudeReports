+                    return Poll::Ready(Err(std::io::Error::new(
+                        std::io::ErrorKind::WriteZero,
+                        "failed to write whole buffer",
+                    )));
+                }
+                Poll::Ready(Ok(n)) => {
+                    payload_pos += n;
+                    if payload_pos == payload_len {
+                        // `self.buffer` was never extended for this PDU, nothing to truncate.
+                        w.state = WriteState::Ready;
+                        return Poll::Ready(Ok(payload_len));
+                    }
+                }
+                Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+                Poll::Pending => {
+                    w.state = WriteState::WritingDirect {
+                        header_pos: PDU_PDV_HEADER_SIZE,
+                        payload_pos,
+                        payload_len,
+                    };
+                    return Poll::Pending;
+                }
+            }
+        }
+    }
