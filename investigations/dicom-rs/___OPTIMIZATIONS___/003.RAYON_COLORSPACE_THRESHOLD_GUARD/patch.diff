+// Below this many pixels, rayon's own per-call dispatch overhead (par_chunks_mut spawning /
+// work-stealing setup) costs more than the sequential per-pixel arithmetic it would save -
+// measured crossover on a 24-core box sits between 10,000 and 20,000 pixels for this function.
+#[cfg(feature = "rayon")]
+const COLORSPACE_RAYON_PIXEL_THRESHOLD: usize = 16_384;
+
+// Caches whether this process has more than one available core - on a single-core (or
+// affinity-restricted to one core) host, dispatching to rayon can never pay for its own
+// overhead regardless of input size.
+#[cfg(feature = "rayon")]
+fn rayon_worth_it() -> bool {
+    use std::sync::OnceLock;
+    static WORTH_IT: OnceLock<bool> = OnceLock::new();
+    *WORTH_IT.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(|n| n.get() > 1)
+            .unwrap_or(false)
+    })
+}
