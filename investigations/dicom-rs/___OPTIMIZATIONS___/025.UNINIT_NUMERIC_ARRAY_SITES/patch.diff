+/// Allocates a `SmallVec` of the given length without zero-initializing it, for a caller that is
+/// about to fully overwrite every element via a `decode_*_into` call that writes every `dst`
+/// element in order - `smallvec![0; n]` pays a real, measured memset cost for content that gets
+/// fully discarded a few instructions later. Sound for any `T: Copy` with no `Drop` glue (all of
+/// `u16`/`u32`/`u64`/`i16`/`i32`/`i64`/`f32`/`f64` here): if the subsequent write is interrupted
+/// by an error, the partially-written `SmallVec` is dropped without any of its elements ever
+/// being read by safe code, and every bit pattern is already a valid value for these types, so no
+/// uninitialized-memory read ever occurs. Self-contained duplicate of candidate 009's own helper
+/// of the same name, per this workspace's "one fix per candidate" discipline.
+#[inline]
+fn uninit_smallvec<T: Copy, A: Array<Item = T>>(len: usize) -> SmallVec<A> {
+    let mut v: SmallVec<A> = SmallVec::with_capacity(len);
+    // SAFETY: see function doc - T has no Drop glue and every bit pattern is a valid T.
+    unsafe {
+        v.set_len(len);
+    }
+    v
+}
