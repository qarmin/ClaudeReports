+/// Allocates a `Vec<T>` without zero-initializing it, for a caller about to fully overwrite every element.
+fn uninit_vec<T: Copy>(len: usize) -> Vec<T> {
+    let mut v: Vec<T> = Vec::with_capacity(len);
+    // SAFETY: T: Copy with no Drop glue and every bit pattern valid; caller fully overwrites before reading.
+    unsafe {
+        v.set_len(len);
+    }
+    v
+}
