-    let mut pixel_array: Vec<u16> = vec![0; data.len() / 2];
+    let mut pixel_array: Vec<u16> = uninit_vec(data.len() / 2);
     NativeEndian::read_u16_into(data, &mut pixel_array);
     pixel_array
 }
