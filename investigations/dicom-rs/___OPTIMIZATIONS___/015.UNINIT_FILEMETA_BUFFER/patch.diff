+/// Reads exactly `len` bytes from `source` into a freshly-allocated buffer, without zero-initializing it first.
+fn read_exact_uninit<S: Read>(source: &mut S, len: usize) -> Result<Vec<u8>> {
+    let mut v = Vec::new();
+    v.try_reserve_exact(len).context(AllocationSizeSnafu)?;
+    // SAFETY: capacity is now >= len (just reserved above); see function doc.
+    unsafe {
+        v.set_len(len);
+    }
+    source.read_exact(&mut v).context(ReadValueDataSnafu)?;
+    Ok(v)
+}
