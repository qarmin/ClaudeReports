+/// Maps each packed byte to its 8 unpacked bits (LSB first), so `unpack_overlay_bits` can process a whole byte per lookup instead of one shift-and-mask per bit.
+const UNPACK_BITS_TABLE: [[u8; 8]; 256] = {
+    let mut table = [[0u8; 8]; 256];
+    let mut byte = 0usize;
+    while byte < 256 {
+        let mut bit = 0usize;
+        while bit < 8 {
+            table[byte][bit] = ((byte >> bit) & 1) as u8;
+            bit += 1;
+        }
+        byte += 1;
+    }
+    table
+};
+
