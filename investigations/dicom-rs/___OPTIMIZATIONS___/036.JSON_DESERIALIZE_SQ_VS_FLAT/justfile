# Self-contained reproduction for candidate 036.JSON_DESERIALIZE_SQ_VS_FLAT.
#
# Re-applies candidate 026's own patch.diff unchanged (see RESULT.md - no new library source
# change here; this candidate isolates how much of that fix's win is SQ-recursion vs. flat
# multi-element cost, via a new gen-flat harness mode compared against the existing seq_10k.dcm
# fixture at the same total element count). Uses dicom-rs's own bench_pipeline harness (untracked
# in the main repo - see SKILL.md's "shape 3" pattern), self-contained given the WHOLE
# ___OPTIMIZATIONS___ folder kept together.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched genfixtures bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline
    rm -rf clone/___OPTIMIZATIONS___/harness/bench_pipeline/target

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

genfixtures:
    ./bin_baseline gen-flat testdata_flat20k.dcm 20000
    ./bin_baseline gen-seq testdata_seq10k.dcm 10000

bench:
    @echo "=== json-decode, 20,000 flat top-level elements (no SQ) ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- json-decode testdata_flat20k.dcm 15
    @echo "=== json-decode, 10,000 SQ items x 2 elements = 20,000 total elements ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- json-decode testdata_seq10k.dcm 15

clean:
    rm -rf clone bin_baseline bin_patched testdata_flat20k.dcm testdata_seq10k.dcm
