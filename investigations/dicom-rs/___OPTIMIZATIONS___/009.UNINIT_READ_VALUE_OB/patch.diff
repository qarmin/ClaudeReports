+/// Allocates a `SmallVec` without zero-initializing it, for a caller about to fully overwrite every element. Sound for `T: Copy` with no `Drop` glue and every bit pattern valid.
+#[inline]
+fn uninit_smallvec<T: Copy, A: Array<Item = T>>(len: usize) -> SmallVec<A> {
+    let mut v: SmallVec<A> = SmallVec::with_capacity(len);
+    // SAFETY: see function doc - T has no Drop glue and every bit pattern is a valid T.
+    unsafe {
+        v.set_len(len);
+    }
+    v
+}
