# Self-contained reproduction for candidate 039.RAYON_LUT_GUARD_16BIT_RGB_PLAIN.
#
# Re-applies candidate 006's own patch.diff unchanged (see RESULT.md - no new library source
# change here; this candidate measures the previously-untimed 16-bit-plain non-monochrome RGB
# site via the existing gen-ybr harness mode against a 16-bit source). Uses dicom-rs's own
# bench_pipeline harness (untracked in the main repo - see SKILL.md's "shape 3" pattern),
# self-contained given the WHOLE ___OPTIMIZATIONS___ folder kept together.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched genfixtures bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline
    rm -rf clone/___OPTIMIZATIONS___/harness/bench_pipeline/target

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

# dicom-test-files' path() resolves its cache dir by walking UP from the running executable's own
# path until it finds a "target" path component - must run from inside clone's own target/release/
# (not the ./bin_baseline copy at this folder's top level), same reasoning as candidate 034.
genfixtures:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && ./target/release/bench gen-ybr pydicom/SC_rgb_16bit.dcm "{{justfile_directory()}}/testdata_below.dcm" 1
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && ./target/release/bench gen-ybr pydicom/SC_rgb_16bit.dcm "{{justfile_directory()}}/testdata_above.dcm" 100

bench:
    @echo "=== below threshold, 10,000px ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- tovec testdata_below.dcm 30
    @echo "=== above threshold, 1,000,000px ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- tovec testdata_above.dcm 15

clean:
    rm -rf clone bin_baseline bin_patched testdata_below.dcm testdata_above.dcm
