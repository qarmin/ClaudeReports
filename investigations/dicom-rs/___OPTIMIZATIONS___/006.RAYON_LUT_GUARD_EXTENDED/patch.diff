+// Below this many samples, rayon's own per-call dispatch overhead costs more than the
+// sequential LUT-mapped/numeric-conversion work it would save - reusing the same order-of-
+// magnitude threshold measured for convert_colorspace_u8/u16, since these sites do comparably
+// cheap per-element work (a LUT lookup or a numeric cast).
+#[cfg(feature = "rayon")]
+const LUT_RAYON_PIXEL_THRESHOLD: usize = 16_384;
+
+// Caches whether this process has more than one available core - on a single-core (or
+// affinity-restricted to one core) host, dispatching to rayon can never pay for its own
+// overhead regardless of input size.
+#[cfg(feature = "rayon")]
+fn rayon_worth_it() -> bool {
+    use std::sync::OnceLock;
+    static WORTH_IT: OnceLock<bool> = OnceLock::new();
+    *WORTH_IT.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(|n| n.get() > 1)
+            .unwrap_or(false)
+    })
+}
