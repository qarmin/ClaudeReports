+/// Table-driven fallback (candidate 022): one input byte -> 8 output bytes
+/// via a single lookup, instead of a bit-at-a-time shift-and-mask.
+fn unpack_overlay_bits_table(packed: &[u8], num_pixels: usize) -> Vec<u8> {
+    let full_bytes = num_pixels / 8;
+    let mut out = Vec::with_capacity(num_pixels);
+    for &b in &packed[..full_bytes] {
+        out.extend_from_slice(&UNPACK_BITS_TABLE[b as usize]);
+    }
+    let rem = num_pixels - full_bytes * 8;
+    if rem > 0 {
+        out.extend_from_slice(&UNPACK_BITS_TABLE[packed[full_bytes] as usize][..rem]);
+    }
+    out
+}
+
+/// `pdep`-based bit expansion (BMI2): depositing the 8 packed bits of a byte
+/// into the low bit of each of the 8 bytes of a `u64` reproduces exactly the
+/// same LSB-first unpacked output as the table lookup, in a single
+/// instruction with no memory access - a wider-than-byte replacement for
+/// candidate 022's per-byte table lookup.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "bmi2")]
+unsafe fn unpack_overlay_bits_bmi2(packed: &[u8], num_pixels: usize) -> Vec<u8> {
+    use std::arch::x86_64::_pdep_u64;
+
+    const MASK: u64 = 0x0101_0101_0101_0101;
+
+    let full_bytes = num_pixels / 8;
+    let mut out = Vec::with_capacity(num_pixels);
+    for &b in &packed[..full_bytes] {
+        let expanded = _pdep_u64(b as u64, MASK);
+        out.extend_from_slice(&expanded.to_le_bytes());
+    }
+    let rem = num_pixels - full_bytes * 8;
+    if rem > 0 {
+        let expanded = _pdep_u64(packed[full_bytes] as u64, MASK).to_le_bytes();
+        out.extend_from_slice(&expanded[..rem]);
+    }
+    out
 }
 
