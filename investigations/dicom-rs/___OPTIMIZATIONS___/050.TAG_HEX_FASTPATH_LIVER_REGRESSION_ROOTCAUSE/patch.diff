index 55a5638d..8747fe8b 100644
--- a/json/src/ser/mod.rs
+++ b/json/src/ser/mod.rs
@@ -313,6 +313,22 @@ impl From<Tag> for DicomJson<Tag> {
     }
 }
 
+/// Encode a tag as the 8 uppercase hex digit bytes DICOM JSON uses for element keys and AT values, without going through `core::fmt`'s `Formatter` machinery.
+pub(crate) fn tag_hex_bytes(tag: Tag) -> [u8; 8] {
+    const HEX: &[u8; 16] = b"0123456789ABCDEF";
+    let Tag(g, e) = tag;
+    [
+        HEX[(g >> 12 & 0xF) as usize],
+        HEX[(g >> 8 & 0xF) as usize],
+        HEX[(g >> 4 & 0xF) as usize],
+        HEX[(g & 0xF) as usize],
+        HEX[(e >> 12 & 0xF) as usize],
+        HEX[(e >> 8 & 0xF) as usize],
+        HEX[(e >> 4 & 0xF) as usize],
+        HEX[(e & 0xF) as usize],
+    ]
+}
+
 impl Serialize for DicomJson<Tag> {
     /// Serializes the DICOM tag as a single string in uppercase hexadecimal,
     /// with no separators or delimiters (`"GGGGEEEE"`).
@@ -320,8 +336,10 @@ impl Serialize for DicomJson<Tag> {
     where
         S: Serializer,
     {
-        let Tag(g, e) = self.0;
-        serializer.serialize_str(&format!("{g:04X}{e:04X}"))
+        let buf = tag_hex_bytes(self.0);
+        // SAFETY: every byte in `buf` is an ASCII hex digit from `HEX` above, always valid UTF-8.
+        let s = unsafe { std::str::from_utf8_unchecked(&buf) };
+        serializer.serialize_str(s)
     }
 }
 
