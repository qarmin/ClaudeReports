 #[cfg(feature = "rayon")]
-use rayon::iter::{IntoParallelIterator, ParallelIterator};
+use rayon::iter::{IntoParallelIterator, IntoParallelRefIterator, ParallelIterator};
 use snafu::{OptionExt, Snafu};
 
+// Below this many samples, rayon's own per-call dispatch overhead costs more than the
+// sequential min/max scan it would save - same threshold/guard pattern as
+// `LUT_RAYON_SIZE_THRESHOLD` below, kept separate since the two folds have different per-element
+// costs (a `to_f64` conversion plus two comparisons here, vs. a rescale/VOI float calculation
+// plus a `NumCast` conversion there).
+#[cfg(feature = "rayon")]
+const NORMALIZE_RAYON_SIZE_THRESHOLD: usize = 16_384;
+
+#[cfg(feature = "rayon")]
+fn rayon_worth_it_normalize() -> bool {
+    use std::sync::OnceLock;
+    static WORTH_IT: OnceLock<bool> = OnceLock::new();
+    *WORTH_IT.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(|n| n.get() > 1)
+            .unwrap_or(false)
+    })
+}
+
+// Single-pass min/max fold over the samples, converted to `f64` (candidate 018's fusion),
+// dispatched to rayon above a size threshold on multi-core hosts (candidate 012's pattern).
+fn min_max_f64<S: ToPrimitive + Copy + Sync>(samples: &[S]) -> (f64, f64) {
+    #[cfg(feature = "rayon")]
+    {
+        if rayon_worth_it_normalize() && samples.len() >= NORMALIZE_RAYON_SIZE_THRESHOLD {
+            return samples
+                .par_iter()
+                .filter_map(|v| v.to_f64())
+                .fold(
+                    || (f64::MAX, f64::MIN),
+                    |(min, max), v| (min.min(v), max.max(v)),
+                )
+                .reduce(
+                    || (f64::MAX, f64::MIN),
+                    |(min1, max1), (min2, max2)| (min1.min(min2), max1.max(max2)),
+                );
+        }
+    }
+    samples.iter().filter_map(|v| v.to_f64()).fold(
+        (f64::MAX, f64::MIN),
+        |(min, max), v| (min.min(v), max.max(v)),
+    )
+}
