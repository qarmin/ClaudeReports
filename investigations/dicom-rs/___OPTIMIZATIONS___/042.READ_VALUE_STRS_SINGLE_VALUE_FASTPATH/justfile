# Self-contained reproduction for candidate 042.READ_VALUE_STRS_SINGLE_VALUE_FASTPATH.
#
# patch.diff is a real, new fix to parser/src/stateful/decode.rs (not a re-application of an
# earlier candidate's patch). Uses dicom-rs's own bench_pipeline harness (untracked in the main
# repo - see SKILL.md's "shape 3" pattern), self-contained given the WHOLE ___OPTIMIZATIONS___
# folder kept together.

repo_url := "https://github.com/Enet4/dicom-rs.git"
base_commit := "df2b9e4236298efa3fa37a1f360fc4bf284d586a"
harness_dir := "../harness/bench_pipeline"

test: clone build-baseline apply build-patched genfixtures bench

clone:
    rm -rf clone
    git clone {{repo_url}} clone
    cd clone && git checkout {{base_commit}}
    mkdir -p clone/___OPTIMIZATIONS___/harness
    cp -r "{{justfile_directory()}}/{{harness_dir}}" clone/___OPTIMIZATIONS___/harness/bench_pipeline
    rm -rf clone/___OPTIMIZATIONS___/harness/bench_pipeline/target

build-baseline:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_baseline

apply:
    cd clone && git apply "{{justfile_directory()}}/patch.diff"

build-patched:
    cd clone/___OPTIMIZATIONS___/harness/bench_pipeline && cargo build --release
    cp clone/___OPTIMIZATIONS___/harness/bench_pipeline/target/release/bench ./bin_patched

genfixtures:
    ./bin_baseline gen-seq testdata_seq10k.dcm 10000
    ./bin_baseline gen-seq testdata_seq10k_long1000.dcm 10000 1000

bench:
    @echo "=== parse, seq_10k.dcm (short single-value strings) ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- parse testdata_seq10k.dcm 50
    @echo "=== parse, seq_10k_long1000.dcm (1000B single-value strings) ==="
    RUNS="${RUNS:-9}" "{{justfile_directory()}}/../tools/paired.sh" ./bin_baseline ./bin_patched -- parse testdata_seq10k_long1000.dcm 50

clean:
    rm -rf clone bin_baseline bin_patched testdata_seq10k.dcm testdata_seq10k_long1000.dcm
