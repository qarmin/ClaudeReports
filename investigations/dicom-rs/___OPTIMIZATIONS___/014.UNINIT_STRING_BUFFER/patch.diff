+    /// Resizes `self.buffer` to `len` bytes without zero-initializing it, for a caller about to fully overwrite it via `read_exact`.
+    #[inline]
+    fn resize_buffer_uninit(&mut self, len: usize) {
+        self.buffer.clear();
+        self.buffer.reserve(len);
+        // SAFETY: capacity is now >= len; bytes are either fully written by read_exact or never read (u8 has no Drop glue, every bit pattern valid).
+        unsafe {
+            self.buffer.set_len(len);
+        }
+    }
