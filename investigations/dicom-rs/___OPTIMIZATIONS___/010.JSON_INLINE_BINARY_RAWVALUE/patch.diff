-        serializer.serialize_str(&str)
+
+        // Below this length, RawValue's extra allocation costs more than the escape scan it avoids (measured).
+        const RAW_VALUE_MIN_LEN: usize = 64;
+        if str.len() < RAW_VALUE_MIN_LEN {
+            return serializer.serialize_str(&str);
+        }
+
+        // The base64 alphabet never needs JSON escaping, so quoting it directly and handing it to
+        // serde_json as a RawValue skips the generic per-byte escape scan, a real measured hot spot.
+        let mut raw = String::with_capacity(str.len() + 2);
+        raw.push('"');
+        raw.push_str(&str);
+        raw.push('"');
+        // SAFETY: `raw` is always `"` + base64-alphabet-only bytes + `"`, a well-formed JSON string.
+        let raw_value = unsafe { serde_json::value::RawValue::from_string_unchecked(raw) };
+        raw_value.serialize(serializer)
     }
