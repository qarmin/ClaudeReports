+
+        // Below this length, the extra allocation/boxing the RawValue path below needs costs
+        // more than the escape scan it avoids (measured: a real, small regression on tiny/absent
+        // inline binary content) - only worth it once there's enough content for the per-byte
+        // escape check to dominate.
+        const RAW_VALUE_MIN_LEN: usize = 64;
+        if str.len() < RAW_VALUE_MIN_LEN {
+            return serializer.serialize_str(&str);
+        }
+
+        // The base64 alphabet (`A-Za-z0-9+/=`) never contains a byte that needs JSON escaping
+        // (no quote, backslash, or control character), so wrapping it in quotes already
+        // produces a single well-formed JSON string value with no surrounding whitespace -
+        // handing that to serde_json as a `RawValue` lets it copy the bytes directly into the
+        // output instead of re-scanning every byte through `serialize_str`'s generic per-byte
+        // escape check, a real, measured hot spot for sizeable inline binary values. Using the
+        // `_unchecked` constructor (skipping `RawValue::from_string`'s own re-parse, which would
+        // otherwise cost about as much as the scan being avoided) is sound here specifically
+        // because the base64 alphabet guarantee above is unconditional, not data-dependent.
+        let mut raw = String::with_capacity(str.len() + 2);
+        raw.push('"');
+        raw.push_str(&str);
+        raw.push('"');
+        // SAFETY: `raw` is exactly `"` + base64-alphabet-only bytes + `"`, which is always a
+        // single well-formed JSON string value with no leading/trailing whitespace.
+        let raw_value = unsafe { serde_json::value::RawValue::from_string_unchecked(raw) };
+        raw_value.serialize(serializer)
     }
