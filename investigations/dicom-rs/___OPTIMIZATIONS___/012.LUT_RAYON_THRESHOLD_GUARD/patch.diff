 use crate::{Rescale, WindowLevelTransform, transform::VoiLutTransform};
 
+// Below this many table entries, rayon's own per-call dispatch overhead costs more than the
+// sequential per-entry work (a rescale/VOI float calculation plus a NumCast conversion) it would
+// save - an 8-bit LUT (256 entries) is always below this; a 16-bit LUT (65,536 entries) is always
+// above it, so this only changes behavior for unusually small `bits_stored` values.
+#[cfg(feature = "rayon")]
+const LUT_RAYON_SIZE_THRESHOLD: usize = 16_384;
+
+// Caches whether this process has more than one available core - on a single-core (or
+// affinity-restricted to one core) host, dispatching to rayon can never pay for its own
+// overhead regardless of input size.
+#[cfg(feature = "rayon")]
+fn rayon_worth_it() -> bool {
+    use std::sync::OnceLock;
+    static WORTH_IT: OnceLock<bool> = OnceLock::new();
+    *WORTH_IT.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(|n| n.get() > 1)
+            .unwrap_or(false)
+    })
+}
