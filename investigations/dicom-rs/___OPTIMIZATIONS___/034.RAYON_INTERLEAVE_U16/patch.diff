+// Skip rayon on a single-core host - dispatch overhead can never pay for itself there.
+#[cfg(all(feature = "rayon", feature = "image"))]
+fn rayon_worth_it() -> bool {
+    use std::sync::OnceLock;
+    static WORTH_IT: OnceLock<bool> = OnceLock::new();
+    *WORTH_IT.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(|n| n.get() > 1)
+            .unwrap_or(false)
+    })
+}
+
+// Copy-only work, so the rayon threshold sits far higher than convert_colorspace's (~150-200x, measured).
+#[cfg(all(feature = "rayon", feature = "image"))]
+const INTERLEAVE_RAYON_PIXEL_THRESHOLD: usize = 3_000_000;
+
 #[cfg(feature = "image")]
-fn interleave<T: Copy>(data: &[T]) -> Vec<T> {
+fn interleave<T: Copy + Default + Send + Sync>(data: &[T]) -> Vec<T> {
     debug_assert_eq!(data.len() % 3, 0);
     let component_len = data.len() / 3;
     let r = &data[..component_len];
     let g = &data[component_len..2 * component_len];
     let b = &data[2 * component_len..];
+
+    #[cfg(feature = "rayon")]
+    {
+        if rayon_worth_it() && component_len >= INTERLEAVE_RAYON_PIXEL_THRESHOLD {
+            // Collect into Vec<[T; 3]> (rayon's indexed collect, no pre-zeroing pass) then reinterpret as Vec<T> - safe, same layout for T: Copy.
+            let chunks: Vec<[T; 3]> = (0..component_len)
+                .into_par_iter()
+                .map(|i| [r[i], g[i], b[i]])
+                .collect();
+            let mut chunks = std::mem::ManuallyDrop::new(chunks);
+            let ptr = chunks.as_mut_ptr() as *mut T;
+            let len = chunks.len() * 3;
+            let cap = chunks.capacity() * 3;
+            return unsafe { Vec::from_raw_parts(ptr, len, cap) };
+        }
+    }
+
     r.iter()
         .zip(g.iter())
         .zip(b.iter())
